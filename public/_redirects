# Cloudflare Pages redirects
# Syntaxe: /source /destination [status]

# API routes vers l'app (proxy)
/api/* https://app.optibilan.com/api/* 200

# Assets statiques avec cache long
/assets/* /assets/:splat 200
/*.png /:splat 200
/*.svg /:splat 200
/*.ico /:splat 200
/*.webmanifest /:splat 200
/*.xml /:splat 200

# Pages légales (statiques) - français vers anglais
/mentions-legales /legal/mentions 200
/cgv /legal/cgv 200
/confidentialite /legal/confidentialite 200
/sous-traitance /legal/sous-traitance 200

# Routes françaises vers anglais (SEO)
/produit /product/overview 301
/solutions /solutions 200
/securite /security 301
/tarifs /pricing 301
/blog /blog 200
/contact /contact 200
/features /product/overview 301

# Redirections legacy
