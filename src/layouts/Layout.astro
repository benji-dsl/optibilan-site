---
import {
  SITE_URL,
  HTML_LANG,
  OG_LOCALE,
  localeOf,
  normalizePath,
  localizePath,
  otherLocale,
} from '../i18n/config';
import { hasEnglishVersion } from '../i18n/routes';
import ConsentBanner from '../components/ConsentBanner.astro';
import { resolveGa4Id } from '../config/analytics';
import {
  organizationJsonLd,
  websiteJsonLd,
  softwareApplicationJsonLd,
} from '../i18n/jsonld';

interface Props {
  title: string;
  description: string;
  /** Force la langue. Par defaut deduite de l'URL (/en/... -> en). */
  lang?: 'fr' | 'en';
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noIndex?: boolean;
  jsonLd?: object | object[];
  heroImage?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  section?: string;
  tags?: string[];
}

const {
  title,
  description,
  lang,
  canonical,
  ogImage,
  ogType = 'website',
  noIndex = false,
  jsonLd,
  heroImage,
  publishedTime,
  modifiedTime,
  author,
  section,
  tags,
} = Astro.props;

const SITE_NAME = 'Optibilan';

// Langue de la page : deduite de l'URL (/en/...), surchargeable par la prop lang.
const locale = localeOf(lang ?? Astro.currentLocale);

// Chemin canonique, toujours sous sa forme FR ("/product/nutrition/"),
// que la page soit francaise ou anglaise. Une seule source de verite.
const currentPath = normalizePath(canonical ?? Astro.url.pathname);

// Canonical : l'URL de la page dans SA langue.
const fullUrl = `${SITE_URL}${localizePath(currentPath, locale)}`;
const frUrl = `${SITE_URL}${localizePath(currentPath, 'fr')}`;
const enUrl = `${SITE_URL}${localizePath(currentPath, 'en')}`;

// On n'annonce une version anglaise que si elle existe reellement :
// un hreflang vers un 404 est un soft 404.
const translated = locale === 'en' || hasEnglishVersion(currentPath);
const alternateLocale = otherLocale(locale);

// Image sociale par defaut : celle de la langue de la page.
const ogImageResolved =
  ogImage ?? (locale === 'en' ? '/og/en/default.png' : '/og-default.png');
const fullOgImage = ogImageResolved.startsWith('http') ? ogImageResolved : `${SITE_URL}${ogImageResolved}`;
const toJsonLd = (obj) => JSON.stringify(obj).replace(/</g, '\\u003c');

// GA4 Measurement ID - replace with actual ID when available
const GA4_ID = resolveGa4Id(import.meta.env.PUBLIC_GA4_ID);
// PostHog - replace with actual key when available
const POSTHOG_KEY = (import.meta.env.PUBLIC_POSTHOG_KEY || '').trim();

import '../styles/global.css';
---

<!doctype html>
<html lang={HTML_LANG[locale]} {...(GA4_ID ? { 'data-ga4': GA4_ID } : {})}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/optibilan-favicon.svg" />
    <link rel="icon" href="/optibilan-favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {/* Validation Google Search Console (propriete https://optibilan.com/) */}
    <meta name="google-site-verification" content="HRHk81-jUTHn6nyz7SA_rYXwKvky0ldvCwAI7gNEaQM" />
    <meta name="theme-color" content="#F7F5F1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#23211C" media="(prefers-color-scheme: dark)" />

    {heroImage && <link rel="preload" as="image" href={heroImage} fetchpriority="high" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    {!noIndex && <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />}

    <link rel="canonical" href={fullUrl} />
    {translated ? (
      <>
        <link rel="alternate" hreflang="fr" href={frUrl} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="x-default" href={frUrl} />
      </>
    ) : (
      <>
        <link rel="alternate" hreflang={HTML_LANG[locale]} href={fullUrl} />
        <link rel="alternate" hreflang="x-default" href={fullUrl} />
      </>
    )}

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {translated && <meta property="og:locale:alternate" content={OG_LOCALE[alternateLocale]} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {author && <meta property="article:author" content={author} />}
    {section && <meta property="article:section" content={section} />}
    {tags && tags.map(tag => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@optibilan" />
    <meta name="twitter:creator" content="@benjaminsant" />
    <meta name="twitter:url" content={fullUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Fonts: self-hosted (variable woff2, cached immutable via _headers) -->
    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/playfair-display-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    <!-- DNS Prefetch for external resources -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://eu.i.posthog.com" />

    {/* JSON-LD echappe : un '<' non echappe peut cloturer <script> prematurement et corrompre le HTML */}
    <script type="application/ld+json" set:html={toJsonLd(organizationJsonLd(locale))}></script>
    <script type="application/ld+json" set:html={toJsonLd(websiteJsonLd(locale))}></script>
    <script type="application/ld+json" set:html={toJsonLd(softwareApplicationJsonLd(locale))}></script>

    {jsonLd && <script type="application/ld+json" set:html={toJsonLd(jsonLd)}></script>}

    {POSTHOG_KEY !== 'phc_XXXXXXXXXX' && (
    <>
    <!-- PostHog -->
    <script is:inline>
      !function(){var t=document.createElement("script");t.async=!0,t.src="https://eu.i.posthog.com/static/array.js",document.head.appendChild(t)}();
      window.posthog=window.posthog||[];window.posthog.push(["init",POSTHOG_KEY,{api_host:"https://eu.i.posthog.com",capture_pageview:true,capture_pageleave:true,persist:true,disable_session_recording:false,property_allowlist:["$current_url","$host","$pathname","$referrer","$browser","$os","$device_type"]}]);
    </script>
    </>
    )}

    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </head>
  <body class="font-sans antialiased bg-papier text-encre">
    <!-- Lien d'evitement : premier element focusable, visible seulement au clavier -->
    <a href="#contenu" class="skip-link">{locale === 'en' ? 'Skip to content' : 'Aller au contenu'}</a>
    <slot />
    {GA4_ID && <ConsentBanner />}
    <script>
      import '@/scripts/analytics';
    </script>
  </body>
</html>