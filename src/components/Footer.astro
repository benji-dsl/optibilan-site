---
import Icon from './Icon.astro';

const footerLinks = {
  produit: [
    { href: '/product/overview', label: 'Fonctionnalités' },
    { href: '/product/check-ins', label: 'Bilans' },
    { href: '/product/nutrition', label: 'Nutrition' },
    { href: '/product/training', label: 'Sport' },
    { href: '/product/health', label: 'Santé' },
    { href: '/product/white-label', label: 'Marque blanche' },
  ],
  solutions: [
    { href: '/solutions/coaches', label: 'Indépendants' },
    { href: '/solutions/nutrition', label: 'Nutritionnistes' },
    { href: '/solutions/mental', label: 'Prépa mentale' },
    { href: '/solutions/cabinets', label: 'Cabinets' },
  ],
  confiance: [
    { href: '/security', label: 'Sécurité' },
    { href: '/legal/confidentialite', label: 'Confidentialité' },
    { href: '/legal/sous-traitance', label: 'Sous-traitants' },
  ],
  legal: [
    { href: '/legal/mentions', label: 'Mentions légales' },
    { href: '/legal/confidentialite', label: 'Confidentialité' },
    { href: '/legal/cgv', label: 'CGU' },
    { href: '/legal/cookies', label: 'Cookies' },
  ],
};

const socialLinks = [
  { href: 'https://twitter.com/optibilan', label: 'Twitter', icon: 'twitter' as const },
  { href: 'https://linkedin.com/company/optibilan', label: 'LinkedIn', icon: 'linkedin' as const },
  { href: 'https://github.com/optibilan', label: 'GitHub', icon: 'github' as const },
  { href: 'https://youtube.com/@optibilan', label: 'YouTube', icon: 'youtube' as const },
];
---

<footer class="bg-encre text-craie" role="contentinfo">
  <div class="container py-12 md:py-16 lg:py-20">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8 md:gap-10">
      <!-- Colonne 1 : Produit -->
      <nav aria-label="Produit">
        <h3 class="font-semibold text-craie mb-4">Produit</h3>
        <ul class="space-y-3">
          {footerLinks.produit.map(link => (
            <li><a href={link.href} class="text-sm hover:text-bleu-signature transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <!-- Colonne 2 : Solutions -->
      <nav aria-label="Solutions">
        <h3 class="font-semibold text-craie mb-4">Solutions</h3>
        <ul class="space-y-3">
          {footerLinks.solutions.map(link => (
            <li><a href={link.href} class="text-sm hover:text-bleu-signature transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <!-- Colonne 3 : Confiance -->
      <nav aria-label="Confiance">
        <h3 class="font-semibold text-craie mb-4">Confiance</h3>
        <ul class="space-y-3">
          {footerLinks.confiance.map(link => (
            <li><a href={link.href} class="text-sm hover:text-bleu-signature transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <!-- Colonne 4 : Légal -->
      <nav aria-label="Légal">
        <h3 class="font-semibold text-craie mb-4">Légal</h3>
        <ul class="space-y-3">
          {footerLinks.legal.map(link => (
            <li><a href={link.href} class="text-sm hover:text-bleu-signature transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <!-- Colonne 5 : Brand -->
      <div class="col-span-2 lg:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-4" aria-label="Optibilan - Accueil">
          <Icon name="logo" class="w-9 h-9 text-bleu-signature" />
          <span class="font-display font-bold text-xl text-craie">Optibilan</span>
        </a>
        <div class="flex gap-4">
          {socialLinks.map(social => (
            <a href={social.href} target="_blank" rel="noopener noreferrer" class="text-craie/50 hover:text-bleu-signature transition-colors" aria-label={social.label} title={social.label}>
              <Icon name={social.icon} class="w-5 h-5" />
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-10 md:mt-12 pt-8 border-t border-encre/20">
      <p class="text-center text-craie/60 text-sm leading-relaxed max-w-3xl mx-auto mb-8">
        La plateforme de pilotage des accompagnements santé & performance. Multi-tenant, marque blanche, Protection des données, contrôle des accès et traçabilité.
      </p>
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-craie/40 text-sm">
          {new Date().getFullYear()} Elite Longevity LLC. Tous droits reserves.
        </p>
        <div class="flex items-center gap-6 text-sm text-craie/40">
          <a href="/legal/mentions" class="hover:text-bleu-signature transition-colors">Mentions legales</a>
          <a href="/legal/confidentialite" class="hover:text-bleu-signature transition-colors">Confidentialite</a>
          <a href="/legal/cgv" class="hover:text-bleu-signature transition-colors">CGU</a>
          <a href="/legal/cookies" class="hover:text-bleu-signature transition-colors">Cookies</a>
        </div>
      </div>
    </div>
  </div>
</footer>
