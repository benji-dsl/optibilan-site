---
import Icon from './Icon.astro';

const footerLinks = {
  produit: [
    { href: '/fonctionnalites', label: 'Fonctionnalités' },
    { href: '/tarifs', label: 'Tarifs' },
    { href: '/integrations', label: 'Intégrations' },
    { href: '/changelog', label: 'Changelog' },
    { href: '/roadmap', label: 'Roadmap' },
  ],
  ressources: [
    { href: '/docs', label: 'Documentation' },
    { href: '/blog', label: 'Blog' },
    { href: '/guides', label: 'Guides' },
    { href: '/webinaires', label: 'Webinaires' },
    { href: '/communaute', label: 'Communauté' },
  ],
  entreprise: [
    { href: '/a-propos', label: 'À propos' },
    { href: '/carrieres', label: 'Carrières' },
    { href: '/presse', label: 'Presse' },
    { href: '/partenaires', label: 'Partenaires' },
    { href: '/contact', label: 'Contact' },
  ],
  legal: [
    { href: '/mentions-legales', label: 'Mentions légales' },
    { href: '/cgv', label: 'CGV' },
    { href: '/confidentialite', label: 'Confidentialité' },
    { href: '/sous-traitance', label: 'Sous-traitance' },
    { href: '/securite', label: 'Sécurité' },
  ],
};

const socialLinks = [
  { href: 'https://twitter.com/optibilan', label: 'Twitter', icon: 'twitter' as const },
  { href: 'https://linkedin.com/company/optibilan', label: 'LinkedIn', icon: 'linkedin' as const },
  { href: 'https://github.com/optibilan', label: 'GitHub', icon: 'github' as const },
  { href: 'https://youtube.com/@optibilan', label: 'YouTube', icon: 'youtube' as const },
];
---

<footer class="bg-encre text-craie" role="contentinfo">
  <div class="container py-16 md:py-24 lg:py-32">
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-8 md:gap-12">
      <div class="col-span-2 lg:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-6" aria-label="Optibilan - Accueil">
          <Icon name="logo" class="w-9 h-9 text-bleu-signature" />
          <span class="font-display font-bold text-xl text-craie">Optibilan</span>
        </a>
        <p class="text-craie/60 text-sm leading-relaxed mb-6 max-w-xs">
          Le SaaS de suivi coaching pour cabinets, studios et coachs indépendants. Multi-tenant, marque blanche, RGPD by design.
        </p>
        <div class="flex gap-4">
          {socialLinks.map(social => (
            <a href={social.href} target="_blank" rel="noopener noreferrer" class="text-craie/50 hover:text-bleu-signature transition-colors" aria-label={social.label} title={social.label}>
              <Icon name={social.icon} class="w-5 h-5" />
            </a>
          ))}
        </div>
      </div>

      <nav aria-label="Produit">
        <h3 class="font-semibold text-craie mb-4">Produit</h3>
        <ul class="space-y-3">
          {footerLinks.produit.map(link => (
            <li><a href={link.href} class="text-sm hover:text-bleu-signature transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Ressources">
        <h3 class="font-semibold text-craie mb-4">Ressources</h3>
        <ul class="space-y-3">
          {footerLinks.ressources.map(link => (
            <li><a href={link.href} class="text-sm hover:text-bleu-signature transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Entreprise">
        <h3 class="font-semibold text-craie mb-4">Entreprise</h3>
        <ul class="space-y-3">
          {footerLinks.entreprise.map(link => (
            <li><a href={link.href} class="text-sm hover:text-bleu-signature transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Légal">
        <h3 class="font-semibold text-craie mb-4">Légal</h3>
        <ul class="space-y-3">
          {footerLinks.legal.map(link => (
            <li><a href={link.href} class="text-sm hover:text-bleu-signature transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="mt-12 md:mt-16 pt-8 border-t border-encre/20">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-craie/40 text-sm">
          © {new Date().getFullYear()} Optibilan. Tous droits réservés.
        </p>
        <div class="flex items-center gap-6 text-sm text-craie/40">
          <a href="/mentions-legales" class="hover:text-bleu-signature transition-colors">Mentions légales</a>
          <a href="/confidentialite" class="hover:text-bleu-signature transition-colors">Confidentialité</a>
          <a href="/cgv" class="hover:text-bleu-signature transition-colors">CGV</a>
        </div>
      </div>
    </div>
  </div>
</footer>