---
import Icon from './Icon.astro';
import { localeOf, localizePath } from '../i18n/config';
import { t } from '../i18n/ui';

const locale = localeOf(Astro.currentLocale);
const d = t(locale).footer;
const lp = (href: string) => localizePath(href, locale);

const columns = [
  {
    title: d.product,
    links: [
      { href: '/product/overview/', label: d.features },
      { href: '/product/check-ins/', label: d.checkins },
      { href: '/product/nutrition/', label: d.nutrition },
      { href: '/product/training/', label: d.training },
      { href: '/product/health/', label: d.health },
      { href: '/product/white-label/', label: d.whitelabel },
      { href: '/docs/', label: d.api },
      { href: '/newsletter/', label: d.newsletter },
    ],
  },
  {
    title: d.solutions,
    links: [
      { href: '/solutions/', label: d.solutionsAll },
      { href: '/solutions/coaches/', label: d.independents },
      { href: '/solutions/nutrition/', label: d.nutritionists },
      { href: '/solutions/medecin/', label: d.doctors },
      { href: '/solutions/cabinets/', label: d.practices },
    ],
  },
  {
    title: d.trust,
    links: [
      { href: '/security/', label: d.security },
      { href: '/legal/confidentialite/', label: d.privacy },
      { href: '/legal/cookies/', label: d.cookies },
      { href: '/legal/sous-traitance/', label: d.subprocessors },
    ],
  },
  {
    title: d.legal,
    links: [
      { href: '/legal/mentions/', label: d.notice },
      { href: '/legal/cgv/', label: d.terms },
    ],
  },
];

const socialLinks = [
  { href: 'https://twitter.com/optibilan', label: 'Twitter', icon: 'twitter' as const },
  { href: 'https://linkedin.com/company/optibilan', label: 'LinkedIn', icon: 'linkedin' as const },
  { href: 'https://github.com/optibilan', label: 'GitHub', icon: 'github' as const },
  { href: 'https://youtube.com/@optibilan', label: 'YouTube', icon: 'youtube' as const },
];
---

<footer class="bg-encre text-craie" role="contentinfo">
  <div class="container py-12 md:py-16 lg:py-20">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8 md:gap-10">
      {columns.map((column) => (
        <nav aria-label={column.title}>
          <h2 class="font-semibold text-craie mb-4">{column.title}</h2>
          <ul class="space-y-3">
            {column.links.map((link) => (
              <li><a href={lp(link.href)} class="text-sm hover:text-bleu-signature transition-colors">{link.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}

      <!-- Brand -->
      <div class="col-span-2 lg:col-span-1">
        <a href={lp('/')} class="inline-block mb-4" aria-label={t(locale).nav.home}>
          <img src="/optibilan-logo-horizontal.png" alt="Optibilan" width="220" height="88" class="h-9 w-auto" loading="lazy" decoding="async" />
        </a>
        <div class="flex gap-4">
          {socialLinks.map(social => (
            <a href={social.href} target="_blank" rel="noopener noreferrer" class="text-craie/50 hover:text-bleu-signature transition-colors" aria-label={social.label} title={social.label}>
              <Icon name={social.icon} class="w-5 h-5" />
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-10 md:mt-12 pt-8 border-t border-encre/20">
      <p class="text-center text-craie/60 text-sm leading-relaxed max-w-3xl mx-auto mb-8">
        {d.baseline}
      </p>
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-craie/40 text-sm">
          {new Date().getFullYear()} Elite Longevity LLC. {d.rights}
        </p>
        <div class="flex items-center gap-6 text-sm text-craie/40">
          <a href={lp('/legal/mentions/')} class="hover:text-bleu-signature transition-colors">{d.notice}</a>
          <a href={lp('/legal/confidentialite/')} class="hover:text-bleu-signature transition-colors">{d.privacy}</a>
          <a href={lp('/legal/cgv/')} class="hover:text-bleu-signature transition-colors">{d.terms}</a>
          <a href={lp('/legal/cookies/')} class="hover:text-bleu-signature transition-colors">{d.cookies}</a>
        </div>
      </div>
    </div>
  </div>
</footer>
