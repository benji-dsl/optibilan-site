---
import Icon from './Icon.astro';

const footerLinks = {
  produit: [
    { href: '/product/overview', label: 'Vue d\'ensemble' },
    { href: '/product/check-ins', label: 'Bilans & progression' },
    { href: '/product/nutrition', label: 'Nutrition' },
    { href: '/product/training', label: 'Sport & programmes' },
    { href: '/product/health', label: 'Santé & biomarqueurs' },
    { href: '/product/mental', label: 'Préparation mentale' },
    { href: '/product/engagement', label: 'Engagement & habitudes' },
    { href: '/product/crm', label: 'Journal & CRM' },
    { href: '/product/agenda', label: 'Agenda & appels' },
    { href: '/product/ai', label: 'IA & Automatisations' },
    { href: '/product/white-label', label: 'Marque blanche' },
    { href: '/product/integrations', label: 'Intégrations & API' },
    { href: '/product/admin', label: 'Administration' },
  ],
  solutions: [
    { href: '/solutions/coaches', label: 'Coach sportif' },
    { href: '/solutions/nutrition', label: 'Nutritionniste / Diététicien' },
    { href: '/solutions/mental', label: 'Préparateur mental' },
    { href: '/solutions/cabinets', label: 'Cabinet / Équipe' },
  ],
  securite: [
    { href: '/security', label: 'Sécurité & conformité' },
    { href: '/legal/confidentialite', label: 'RGPD & Confidentialité' },
    { href: '/legal/sous-traitance', label: 'Sous-traitants' },
  ],
  ressources: [
    { href: '/help', label: 'Centre d\'aide' },
    { href: '/docs', label: 'API & Documentation' },
    { href: '/blog', label: 'Blog' },
    { href: '/contact', label: 'Contact & Support' },
  ],
  entreprise: [
    { href: '/contact', label: 'Contact' },
  ],
  legal: [
    { href: '/legal/mentions', label: 'Mentions légales' },
    { href: '/legal/cgv', label: 'CGV' },
    { href: '/legal/confidentialite', label: 'Confidentialité' },
    { href: '/legal/sous-traitance', label: 'Sous-traitance' },
  ],
};

const socialLinks = [
  { href: 'https://twitter.com/optibilan', label: 'Twitter', icon: 'twitter' as const },
  { href: 'https://linkedin.com/company/optibilan', label: 'LinkedIn', icon: 'linkedin' as const },
  { href: 'https://github.com/optibilan', label: 'GitHub', icon: 'github' as const },
  { href: 'https://youtube.com/@optibilan', label: 'YouTube', icon: 'youtube' as const },
];
---

<footer class="bg-encre text-craie" role="contentinfo">
  <div class="container py-16 md:py-24 lg:py-32">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8 md:gap-12">
      <div class="col-span-2 lg:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-6" aria-label="Optibilan - Accueil">
          <Icon name="logo" class="w-9 h-9 text-bleu-signature" />
          <span class="font-display font-bold text-xl text-craie">Optibilan</span>
        </a>
        <p class="text-craie/60 text-sm leading-relaxed mb-6 max-w-xs">
          La plateforme de pilotage des accompagnements santé & performance. Multi-tenant, marque blanche, RGPD/HDS by design.
        </p>
        <div class="flex gap-4">
          {socialLinks.map(social => (
            <a href={social.href} target="_blank" rel="noopener noreferrer" class="text-craie/50 hover:text-bleu-signature transition-colors" aria-label={social.label} title={social.label}>
              <Icon name={social.icon} class="w-5 h-5" />
            </a>
          ))}
        </div>
      </div>

      <nav aria-label="Produit">
        <h3 class="font-semibold text-craie mb-4">Produit</h3>
        <ul class="space-y-3">
          {footerLinks.produit.map(link => (
            <li><a href={link.href} class="text-sm hover:text-bleu-signature transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Solutions">
        <h3 class="font-semibold text-craie mb-4">Solutions</h3>
        <ul class="space-y-3">
          {footerLinks.solutions.map(link => (
            <li><a href={link.href} class="text-sm hover:text-bleu-signature transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Sécurité">
        <h3 class="font-semibold text-craie mb-4">Sécurité</h3>
        <ul class="space-y-3">
          {footerLinks.securite.map(link => (
            <li><a href={link.href} class="text-sm hover:text-bleu-signature transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Ressources">
        <h3 class="font-semibold text-craie mb-4">Ressources</h3>
        <ul class="space-y-3">
          {footerLinks.ressources.map(link => (
            <li><a href={link.href} class="text-sm hover:text-bleu-signature transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Légal">
        <h3 class="font-semibold text-craie mb-4">Légal</h3>
        <ul class="space-y-3">
          {footerLinks.legal.map(link => (
            <li><a href={link.href} class="text-sm hover:text-bleu-signature transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="mt-12 md:mt-16 pt-8 border-t border-encre/20">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-craie/40 text-sm">
          © {new Date().getFullYear()} Optibilan. Tous droits réservés.
        </p>
        <div class="flex items-center gap-6 text-sm text-craie/40">
          <a href="/legal/mentions" class="hover:text-bleu-signature transition-colors">Mentions légales</a>
          <a href="/legal/confidentialite" class="hover:text-bleu-signature transition-colors">Confidentialité</a>
          <a href="/legal/cgv" class="hover:text-bleu-signature transition-colors">CGV</a>
          <a href="/legal/sous-traitance" class="hover:text-bleu-signature transition-colors">Sous-traitance</a>
        </div>
      </div>
    </div>
  </div>
</footer>