---
const footerLinks = {
  produit: [
    { href: '/fonctionnalites', label: 'Fonctionnalités' },
    { href: '/tarifs', label: 'Tarifs' },
    { href: '/integrations', label: 'Intégrations' },
    { href: '/changelog', label: 'Changelog' },
    { href: '/roadmap', label: 'Roadmap' },
  ],
  ressources: [
    { href: '/docs', label: 'Documentation' },
    { href: '/blog', label: 'Blog' },
    { href: '/guides', label: 'Guides' },
    { href: '/webinaires', label: 'Webinaires' },
    { href: '/communaute', label: 'Communauté' },
  ],
  entreprise: [
    { href: '/a-propos', label: 'À propos' },
    { href: '/carrieres', label: 'Carrières' },
    { href: '/presse', label: 'Presse' },
    { href: '/partenaires', label: 'Partenaires' },
    { href: '/contact', label: 'Contact' },
  ],
  legal: [
    { href: '/mentions-legales', label: 'Mentions légales' },
    { href: '/cgv', label: 'CGV' },
    { href: '/confidentialite', label: 'Confidentialité' },
    { href: '/sous-traitance', label: 'Sous-traitance' },
    { href: '/securite', label: 'Sécurité' },
  ],
};

const socialLinks = [
  { href: 'https://twitter.com/optibilan', label: 'Twitter', icon: 'twitter' },
  { href: 'https://linkedin.com/company/optibilan', label: 'LinkedIn', icon: 'linkedin' },
  { href: 'https://github.com/optibilan', label: 'GitHub', icon: 'github' },
  { href: 'https://youtube.com/@optibilan', label: 'YouTube', icon: 'youtube' },
];

const icons = {
  twitter: '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 9.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>',
  linkedin: '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>',
  github: '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>',
  youtube: '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 7.684 0 12 0 12s0 4.316.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 16.316 24 12 24 12s0-4.316-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>',
};
---

<footer class="bg-ink-950 text-ink-300" role="contentinfo">
  <div class="container py-16 md:py-24 lg:py-32">
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-8 md:gap-12">
      <div class="col-span-2 lg:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-6" aria-label="Optibilan - Accueil">
          <svg class="w-9 h-9 text-primary-400" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <rect width="32" height="32" rx="8" class="fill-primary-600"/>
            <path d="M8 16L14 22L24 10" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="font-display font-bold text-xl text-white">Optibilan</span>
        </a>
        <p class="text-ink-400 text-sm leading-relaxed mb-6 max-w-xs">
          Le SaaS de suivi coaching pour cabinets, studios et coachs indépendants. Multi-tenant, marque blanche, RGPD by design.
        </p>
        <div class="flex gap-4">
          {socialLinks.map(social => (
            <a href={social.href} target="_blank" rel="noopener noreferrer" class="text-ink-500 hover:text-gold-400 transition-colors" aria-label={social.label} title={social.label}>
              {icons[social.icon]}
            </a>
          ))}
        </div>
      </div>

      <nav aria-label="Produit">
        <h3 class="font-semibold text-white mb-4">Produit</h3>
        <ul class="space-y-3">
          {footerLinks.produit.map(link => (
            <li><a href={link.href} class="text-sm hover:text-gold-400 transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Ressources">
        <h3 class="font-semibold text-white mb-4">Ressources</h3>
        <ul class="space-y-3">
          {footerLinks.ressources.map(link => (
            <li><a href={link.href} class="text-sm hover:text-gold-400 transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Entreprise">
        <h3 class="font-semibold text-white mb-4">Entreprise</h3>
        <ul class="space-y-3">
          {footerLinks.entreprise.map(link => (
            <li><a href={link.href} class="text-sm hover:text-gold-400 transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Légal">
        <h3 class="font-semibold text-white mb-4">Légal</h3>
        <ul class="space-y-3">
          {footerLinks.legal.map(link => (
            <li><a href={link.href} class="text-sm hover:text-gold-400 transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="mt-12 md:mt-16 pt-8 border-t border-ink-800">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-ink-500 text-sm">
          © {new Date().getFullYear()} Optibilan. Tous droits réservés.
        </p>
        <div class="flex items-center gap-6 text-sm text-ink-500">
          <a href="/mentions-legales" class="hover:text-gold-400 transition-colors">Mentions légales</a>
          <a href="/confidentialite" class="hover:text-gold-400 transition-colors">Confidentialité</a>
          <a href="/cgv" class="hover:text-gold-400 transition-colors">CGV</a>
        </div>
      </div>
    </div>
  </div>
</footer>