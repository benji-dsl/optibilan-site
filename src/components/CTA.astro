---
import Icon from './Icon.astro';

interface Props {
  title?: string;
  subtitle?: string;
  primaryCTA?: { href: string; label: string };
  secondaryCTA?: { href: string; label: string };
  variant?: 'primary' | 'gold' | 'minimal';
}

const {
  title = 'Prêt à simplifier votre suivi coaching ?',
  subtitle = 'Rejoignez des centaines de coachs, kinés, diététiciens et préparateurs mentaux qui font confiance à Optibilan.',
  primaryCTA = { href: 'https://app.optibilan.com/inscription', label: 'Lancer mon essai gratuit' },
  secondaryCTA = { href: '/contact', label: 'Parler à l\'équipe' },
  variant = 'primary',
} = Astro.props;

const variants = {
  primary: 'bg-gradient-to-br from-primary-600 via-primary-700 to-primary-800',
  gold: 'bg-gradient-to-br from-gold-500 via-gold-600 to-gold-700',
  minimal: 'bg-ink-950',
};
---

<section class={`section ${variants[variant]} rounded-3xl relative overflow-hidden`} aria-labelledby="cta-title">
  {variant !== 'minimal' && (
    <>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-primary-500/20 via-transparent to-transparent" aria-hidden="true"></div>
      <div class="absolute top-0 right-0 w-96 h-96 bg-primary-400/10 rounded-full blur-3xl" aria-hidden="true"></div>
      <div class="absolute bottom-0 left-0 w-96 h-96 bg-gold-400/10 rounded-full blur-3xl" aria-hidden="true"></div>
    </>
  )}

  <div class="container relative text-center max-w-3xl mx-auto">
    <h2 id="cta-title" class="font-display text-3xl md:text-4xl font-bold mb-4 {variant !== 'minimal' ? 'text-white' : 'text-white'}">
      {title}
    </h2>
    <p class="text-lg mb-8 {variant !== 'minimal' ? 'text-primary-50' : 'text-ink-300'} max-w-2xl mx-auto">
      {subtitle}
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href={primaryCTA.href} class={
        variant === 'primary' ? 'btn-gold text-lg px-8 py-4' :
        variant === 'gold' ? 'btn-primary text-lg px-8 py-4' :
        'bg-white text-ink-900 hover:bg-ink-100 text-lg px-8 py-4 rounded-xl font-semibold transition-colors'
      }>
        {primaryCTA.label}
        <Icon name="arrowRight" class="w-5 h-5" />
      </a>
      <a href={secondaryCTA.href} class={
        variant !== 'minimal' ? 'btn-secondary text-lg px-8 py-4 border-white/30 text-white hover:bg-white/10' :
        'btn-secondary text-lg px-8 py-4'
      }>
        {secondaryCTA.label}
      </a>
    </div>
    <p class="mt-6 text-sm {variant !== 'minimal' ? 'text-primary-100' : 'text-ink-500'}">
      30 jours gratuits · Aucune carte bancaire · Annulation en 1 clic
    </p>
  </div>
</section>