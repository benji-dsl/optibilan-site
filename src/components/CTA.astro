---
import Icon from './Icon.astro';

interface Props {
  title?: string;
  subtitle?: string;
  primaryCTA?: { href: string; label: string };
  secondaryCTA?: { href: string; label: string };
  variant?: 'primary' | 'gold' | 'minimal';
}

const {
  title = 'Prêt à structurer votre cabinet ?',
  subtitle = 'Rejoignez 150+ cabinets qui ont choisi Optibilan pour professionnaliser leur suivi.',
  primaryCTA = { href: 'https://app.optibilan.com/inscription', label: 'Lancer mon essai gratuit' },
  secondaryCTA = { href: '/contact', label: 'Parler à l\'équipe' },
  variant = 'primary',
} = Astro.props;

const variants = {
  primary: 'bg-gradient-to-br from-bleu-signature via-bleu-lecture to-indigo',
  gold: 'bg-gradient-to-br from-bleu-signature to-bleu-lecture',
  minimal: 'bg-encre',
};
---

<section class={`section ${variants[variant]} rounded-card-lg relative overflow-hidden`} aria-labelledby="cta-title">
  {variant !== 'minimal' && (
    <>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-bleu-signature/20 via-transparent to-transparent" aria-hidden="true"></div>
      <div class="absolute top-0 right-0 w-96 h-96 bg-bleu-signature/10 rounded-full blur-3xl" aria-hidden="true"></div>
      <div class="absolute bottom-0 left-0 w-96 h-96 bg-bleu-signature/10 rounded-full blur-3xl" aria-hidden="true"></div>
    </>
  )}

  <div class="container relative text-center max-w-3xl mx-auto">
    <h2 id="cta-title" class="font-display text-3xl md:text-4xl font-bold mb-4 text-craie">
      {title}
    </h2>
    <p class="text-lg mb-8 text-craie/80 max-w-2xl mx-auto">
      {subtitle}
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href={primaryCTA.href} class={
        variant === 'primary' ? 'btn-primary text-lg px-8 py-4' :
        variant === 'gold' ? 'btn-primary text-lg px-8 py-4' :
        'bg-blanc text-encre hover:bg-encre/5 text-lg px-8 py-4 rounded-pill font-semibold transition-colors'
      }>
        {primaryCTA.label}
        <Icon name="arrowRight" class="w-5 h-5" />
      </a>
      <a href={secondaryCTA.href} class={
        variant !== 'minimal' ? 'btn-secondary text-lg px-8 py-4 border-craie/30 text-craie hover:bg-craie/10' :
        'btn-secondary text-lg px-8 py-4'
      }>
        {secondaryCTA.label}
      </a>
    </div>
    <p class="mt-6 text-sm text-craie/60">
      30 jours gratuits · Aucune carte bancaire · Annulation en 1 clic
    </p>
  </div>
</section>