---
import Icon from './Icon.astro';

interface Props {
  title?: string;
  subtitle?: string;
  plans?: Array<{
    name: string;
    tagline: string;
    priceMonthly: number;
    priceYearly: number;
    features: string[];
    cta: { href: string; label: string };
    popular?: boolean;
    limits?: {
      clients: number | 'illimité';
      staff: number | 'illimité';
      aiMessages: number | 'illimité';
      api: boolean;
      whiteLabel: boolean;
    };
  }>;
}

const defaultPlans = [
  {
    name: 'Solo',
    tagline: 'Coach indépendant',
    priceMonthly: 49,
    priceYearly: 39,
    features: [
      'Jusqu\'à 30 coachés',
      '1 accès coach (vous)',
      'Bilans, photos, journal',
      'Nutrition & sport',
      'Assistant IA (1 000 msg/mois)',
      'Export RGPD',
      'Support email',
    ],
    cta: { href: '/checkout/solo', label: 'Démarrer gratuitement' },
    limits: { clients: 30, staff: 1, aiMessages: 1000, api: false, whiteLabel: false },
  },
  {
    name: 'Studio',
    tagline: 'Petite équipe (2-5)',
    priceMonthly: 149,
    priceYearly: 119,
    features: [
      'Jusqu\'à 150 coachés',
      'Jusqu\'à 5 accès staff',
      'Prépa mentale & santé',
      'Templates nutrition/sport',
      'Assistant IA (5 000 msg/mois)',
      'API REST (120 req/min)',
      'Webhooks + Slack',
      'Marque blanche avancée',
      'Support prioritaire',
    ],
    cta: { href: '/checkout/studio', label: 'Démarrer gratuitement' },
    popular: true,
    limits: { clients: 150, staff: 5, aiMessages: 5000, api: true, whiteLabel: true },
  },
  {
    name: 'Cabinet',
    tagline: 'Structure 5+ coachs',
    priceMonthly: 349,
    priceYearly: 279,
    features: [
      'Coachés illimités',
      'Accès staff illimités',
      'Multi-spécialités (coach/mental/diet)',
      'Assistant IA (20 000 msg/mois)',
      'API sans limite pratique',
      'SSO / SAML (bientôt)',
      'Audit trail complet',
      'SLA & support dédié',
      'Onboarding équipe offert',
    ],
    cta: { href: '/checkout/cabinet', label: 'Démarrer gratuitement' },
    limits: { clients: 'illimité', staff: 'illimité', aiMessages: 20000, api: true, whiteLabel: true },
  },
];

const {
  title = 'Des offres qui grandissent avec vous',
  subtitle = '30 jours d\'essai gratuit, sans CB. Changez d\'offre à tout moment.',
  plans,
} = Astro.props;

const displayPlans = plans && plans.length > 0 ? plans : defaultPlans;
---

<section class="section bg-sable" aria-labelledby="pricing-title">
  <div class="container">
    <header class="text-center max-w-3xl mx-auto mb-12">
      <h2 id="pricing-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
        {title}
      </h2>
      <p class="text-lg text-encre/60">
        {subtitle}
      </p>
    </header>

    <div class="mb-10 flex justify-center">
      <div class="inline-flex items-center gap-2 p-1 bg-blanc rounded-pill border border-encre/10 shadow-sm">
        <button id="monthly-btn" class="px-4 py-2 rounded-pill text-sm font-medium text-craie bg-bleu-signature text-craie shadow-sm" aria-pressed="true" data-period="monthly">Mensuel</button>
        <button id="yearly-btn" class="px-4 py-2 rounded-pill text-sm font-medium text-encre/60 hover:text-encre" aria-pressed="false" data-period="yearly">
          Annuel
          <span class="ml-2 px-2 py-0.5 text-xs font-bold text-bordeaux bg-rose-bordeaux rounded-full">-20%</span>
        </button>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
      {displayPlans.map((plan, index) => (
        <article class={`relative flex flex-col ${plan.popular ? 'ring-2 ring-bleu-signature shadow-card' : 'border border-encre/10 shadow-card'} rounded-card-lg`} style="background-color: var(--color-sable);" data-plan={plan.name}>
          {plan.popular && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 bg-bleu-signature text-craie text-xs font-semibold rounded-full">
              Le plus choisi
            </div>
          )}
          <div class="mb-6">
            <h3 class="text-xl font-bold text-encre mb-1">{plan.name}</h3>
            <p class="text-sm text-encre/50">{plan.tagline}</p>
          </div>

<div class="mb-6" data-price-container>
              <div class="flex items-baseline gap-1" data-monthly>
                <span class="text-4xl font-bold text-encre">{plan.priceMonthly}</span>
                <span class="text-encre/50">€/mois</span>
              </div>
              <div class="flex items-baseline gap-1 hidden" data-yearly>
                <span class="text-4xl font-bold text-encre">{plan.priceYearly}</span>
                <span class="text-encre/50">€/mois</span>
              </div>
              <p class="text-sm text-encre/50 mt-1" data-yearly-note hidden>
                Facturé {plan.priceYearly * 12}€ / an
              </p>
            </div>

          <ul class="flex-1 space-y-3 mb-8" role="list">
            {plan.features.map(feature => (
              <li class="flex items-start gap-3 text-sm text-encre/60">
                <Icon name="check" class="w-5 h-5 text-bleu-signature flex-shrink-0 mt-0.5" />
                {feature}
              </li>
            ))}
          </ul>

          <a href={plan.cta.href} class="btn-primary w-full group py-3 px-5 text-base font-semibold rounded-xl transition-all duration-200">
            {plan.cta.label}
            <Icon name="arrowRight" class="w-5 h-5 ml-2 transition-transform group-hover:translate-x-1 inline-block" />
          </a>
        </article>
      ))}
    </div>

    <p class="text-center text-sm text-encre/50 mt-10">
      Annulation simple en un clic.
    </p>
  </div>
</section>

<script is:inline>
  const monthlyBtn = document.getElementById('monthly-btn');
  const yearlyBtn = document.getElementById('yearly-btn');
  const monthlyPrices = document.querySelectorAll('[data-monthly]');
  const yearlyPrices = document.querySelectorAll('[data-yearly]');
  const yearlyNotes = document.querySelectorAll('[data-yearly-note]');

  function setPeriod(period) {
    const isYearly = period === 'yearly';
    monthlyBtn?.classList.toggle('bg-bleu-signature', !isYearly);
    monthlyBtn?.classList.toggle('text-craie', !isYearly);
    monthlyBtn?.classList.toggle('shadow-sm', !isYearly);
    monthlyBtn?.classList.toggle('bg-blanc', isYearly);
    monthlyBtn?.classList.toggle('text-encre/60', isYearly);
    monthlyBtn?.setAttribute('aria-pressed', String(!isYearly));

    yearlyBtn?.classList.toggle('bg-bleu-signature', isYearly);
    yearlyBtn?.classList.toggle('text-craie', isYearly);
    yearlyBtn?.classList.toggle('shadow-sm', isYearly);
    yearlyBtn?.classList.toggle('text-encre/60', !isYearly);
    yearlyBtn?.setAttribute('aria-pressed', String(isYearly));

    monthlyPrices.forEach(el => el.classList.toggle('hidden', isYearly));
    yearlyPrices.forEach(el => el.classList.toggle('hidden', !isYearly));
    yearlyNotes.forEach(el => el.classList.toggle('hidden', !isYearly));
  }

  monthlyBtn?.addEventListener('click', () => setPeriod('monthly'));
  yearlyBtn?.addEventListener('click', () => setPeriod('yearly'));
</script>