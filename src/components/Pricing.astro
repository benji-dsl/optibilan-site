---
import Icon from './Icon.astro';

interface Props {
  title?: string;
  subtitle?: string;
  plans?: Array<{
    name: string;
    tagline: string;
    priceMonthly: number;
    priceYearly: number;
    features: string[];
    cta: { href: string; label: string };
    popular?: boolean;
    limits?: {
      clients: number | 'illimité';
      staff: number | 'illimité';
      aiMessages: number | 'illimité';
      api: boolean;
      whiteLabel: boolean;
    };
  }>;
}

const defaultPlans = [
  {
    name: 'Solo',
    tagline: 'Coach indépendant',
    priceMonthly: 49,
    priceYearly: 39,
    features: [
      'Jusqu\'à 30 coachés',
      '1 accès coach (vous)',
      'Bilans, photos, journal',
      'Nutrition & sport',
      'Assistant IA (1 000 msg/mois)',
      'Marque blanche basique',
      'Export RGPD',
      'Support email',
    ],
    cta: { href: 'https://app.optibilan.com/inscription?plan=SOLO', label: 'Rejoindre Optibilan' },
    limits: { clients: 30, staff: 1, aiMessages: 1000, api: false, whiteLabel: false },
  },
  {
    name: 'Studio',
    tagline: 'Petite équipe (2-5)',
    priceMonthly: 149,
    priceYearly: 119,
    features: [
      'Jusqu\'à 150 coachés',
      'Jusqu\'à 5 accès staff',
      'Tout Solo +',
      'Prépa mentale & santé',
      'Templates nutrition/sport',
      'Assistant IA (5 000 msg/mois)',
      'API REST (120 req/min)',
      'Webhooks + Slack',
      'Marque blanche avancée',
      'Support prioritaire',
    ],
    cta: { href: 'https://app.optibilan.com/inscription?plan=STUDIO', label: 'Rejoindre Optibilan' },
    popular: true,
    limits: { clients: 150, staff: 5, aiMessages: 5000, api: true, whiteLabel: true },
  },
  {
    name: 'Cabinet',
    tagline: 'Structure 5+ coachs',
    priceMonthly: 349,
    priceYearly: 279,
    features: [
      'Coachés illimités',
      'Accès staff illimités',
      'Tout Studio +',
      'Multi-spécialités (coach/mental/diet)',
      'Assistant IA (20 000 msg/mois)',
      'API sans limite pratique',
      'SSO / SAML (bientôt)',
      'Audit trail complet',
      'SLA & support dédié',
      'Onboarding équipe offert',
    ],
    cta: { href: 'https://calendly.com/optibilan/demo', label: 'Rejoindre Optibilan' },
    limits: { clients: 'illimité', staff: 'illimité', aiMessages: 20000, api: true, whiteLabel: true },
  },
];

const {
  title,
  subtitle,
  plans,
} = Astro.props;

const displayPlans = plans && plans.length > 0 ? plans : defaultPlans;
---

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
  {displayPlans.map((plan, index) => (
    <article class={`relative card flex flex-col ${plan.popular ? 'ring-2 ring-bleu-signature shadow-card' : ''}`} data-plan={plan.name}>
      {plan.popular && (
        <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 bg-bleu-signature text-craie text-xs font-semibold rounded-full">
          Le plus choisi
        </div>
      )}
      <div class="mb-6">
        <h3 class="text-xl font-bold text-encre mb-1">{plan.name}</h3>
        <p class="text-sm text-encre/50">{plan.tagline}</p>
      </div>

<div class="mb-6" data-price-container>
              <div class="flex items-baseline gap-1" data-monthly>
                <span class="text-4xl font-bold text-encre">{plan.priceMonthly}</span>
                <span class="text-encre/50">€/mois</span>
              </div>
              <div class="flex items-baseline gap-1 hidden" data-yearly>
                <span class="text-4xl font-bold text-encre">{plan.priceYearly}</span>
                <span class="text-encre/50">€/mois</span>
              </div>
              <p class="text-sm text-encre/50 mt-1" data-yearly-note hidden>
                Facturé {plan.priceYearly * 12}€ / an
              </p>
            </div>

          <ul class="flex-1 space-y-3 mb-8" role="list">
            {plan.features.map(feature => (
              <li class="flex items-start gap-3 text-sm text-encre/60">
                <Icon name="check" class="w-5 h-5 text-bleu-signature flex-shrink-0 mt-0.5" />
                {feature}
              </li>
            ))}
          </ul>

          <a href={plan.cta.href} class={plan.popular ? 'btn-primary w-full' : 'btn-secondary w-full'}>
            {plan.cta.label}
          </a>

          {plan.limits && (
            <details class="mt-6 pt-6 border-t border-encre/10 group">
              <summary class="flex items-center justify-between cursor-pointer text-sm font-medium text-encre/70 hover:text-encre">
                <span>Détails des limites</span>
                <Icon name="chevronDown" class="w-5 h-5 text-encre/40 transition-transform group-open:rotate-180" />
              </summary>
              <div class="mt-4 grid grid-cols-2 gap-3 text-sm">
                <div class="text-encre/50">Coachés</div>
                <div class="font-medium text-encre">{plan.limits.clients}</div>
                <div class="text-encre/50">Accès staff</div>
                <div class="font-medium text-encre">{plan.limits.staff}</div>
                <div class="text-encre/50">Messages IA/mois</div>
                <div class="font-medium text-encre">{plan.limits.aiMessages === 'illimité' ? 'Illimité' : plan.limits.aiMessages.toLocaleString()}</div>
                <div class="text-encre/50">API REST</div>
                <div class="font-medium text-encre">{plan.limits.api ? 'Incluse' : 'Non'}</div>
                <div class="text-encre/50">Marque blanche</div>
                <div class="font-medium text-encre">{plan.limits.whiteLabel ? 'Avancée' : 'Basique'}</div>
              </div>
            </details>
          )}
        </article>
  ))}
</div>