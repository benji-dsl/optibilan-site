---
import Icon from './Icon.astro';

interface Props {
  href: string;
  label: string;
  variant?: 'primary' | 'secondary';
  icon?: 'arrowRight' | 'arrowDown' | 'sparkles' | 'chart' | 'document';
}

const {
  href,
  label,
  variant = 'secondary',
  icon = 'arrowRight',
} = Astro.props;
---

<a 
  href={href}
  class="discover-cta group inline-flex items-center gap-2 text-sm font-semibold transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2"
>
  <span class="font-semibold group-hover:translate-x-[-2px] transition-transform duration-200">{label}</span>
  <Icon 
    name={icon} 
    class="w-4 h-4 transition-transform duration-200 ease-out group-hover:translate-x-1"
    aria-hidden="true"
  />
</a>

<style is:global>
  .discover-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: 40px;
    padding: 0 16px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
    transition: all 150ms ease;
    white-space: nowrap;
    letter-spacing: 0.01em;
    color: var(--color-vert);
    background: transparent;
    border: none;
  }
  
  .discover-cta:hover {
    color: var(--color-vert-fonce);
  }
  
  .discover-cta:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }
  
  .discover-cta:active {
    transform: scale(0.98);
    transition: all 50ms ease;
  }
</style>