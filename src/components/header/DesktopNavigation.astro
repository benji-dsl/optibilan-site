---
import Icon from '../Icon.astro';
---

<div class="hidden lg:flex items-center gap-2.5">
  <!-- ACCCOMPAGNER dropdown -->
  <div class="relative" data-dropdown>
    <button
      class="flex items-center gap-1 px-2.5 py-2 text-sm font-medium text-encre/60 hover:text-encre rounded-lg transition-colors"
      aria-haspopup="true"
      aria-expanded="false"
      aria-label="Menu Accompagner"
      data-dropdown-trigger
      type="button"
    >
      Accompagner
      <Icon name="chevronDown" class="w-4 h-4 transition-transform duration-200" data-dropdown-icon />
    </button>
    <div
      class="absolute left-0 top-full mt-2 w-60 opacity-0 invisible transition-all duration-200 bg-blanc rounded-xl border border-encre/10 shadow-elevated p-2 z-[110]"
      role="menu"
      data-dropdown-menu
      style="transform: translateY(4px);"
    >
      <div class="space-y-1">
        <a href="/product/check-ins/" class="block px-3 py-2 rounded-lg hover:bg-papier transition-colors" role="menuitem">
          <span class="block text-sm font-medium text-encre">Bilans</span>
        </a>
        <a href="/product/nutrition/" class="block px-3 py-2 rounded-lg hover:bg-papier transition-colors" role="menuitem">
          <span class="block text-sm font-medium text-encre">Nutrition</span>
        </a>
        <a href="/product/training/" class="block px-3 py-2 rounded-lg hover:bg-papier transition-colors" role="menuitem">
          <span class="block text-sm font-medium text-encre">Sport</span>
        </a>
        <a href="/product/mental/" class="block px-3 py-2 rounded-lg hover:bg-papier transition-colors" role="menuitem">
          <span class="block text-sm font-medium text-encre">Préparation mentale</span>
        </a>
      </div>
    </div>
  </div>

  <!-- SUIVRE dropdown -->
  <div class="relative" data-dropdown>
    <button
      class="flex items-center gap-1 px-2.5 py-2 text-sm font-medium text-encre/60 hover:text-encre rounded-lg transition-colors"
      aria-haspopup="true"
      aria-expanded="false"
      aria-label="Menu Suivre"
      data-dropdown-trigger
      type="button"
    >
      Suivre
      <Icon name="chevronDown" class="w-4 h-4 transition-transform duration-200" data-dropdown-icon />
    </button>
    <div
      class="absolute left-0 top-full mt-2 w-60 opacity-0 invisible transition-all duration-200 bg-blanc rounded-xl border border-encre/10 shadow-elevated p-2 z-[110]"
      role="menu"
      data-dropdown-menu
      style="transform: translateY(4px);"
    >
      <div class="space-y-1">
        <a href="/product/health/" class="block px-3 py-2 rounded-lg hover:bg-papier transition-colors" role="menuitem">
          <span class="block text-sm font-medium text-encre">Santé</span>
        </a>
        <a href="/product/engagement/" class="block px-3 py-2 rounded-lg hover:bg-papier transition-colors" role="menuitem">
          <span class="block text-sm font-medium text-encre">Habitudes</span>
        </a>
      </div>
    </div>
  </div>

  <!-- AUTOMATISER dropdown -->
  <div class="relative" data-dropdown>
    <button
      class="flex items-center gap-1 px-2.5 py-2 text-sm font-medium text-encre/60 hover:text-encre rounded-lg transition-colors"
      aria-haspopup="true"
      aria-expanded="false"
      aria-label="Menu Automatiser"
      data-dropdown-trigger
      type="button"
    >
      Automatiser
      <Icon name="chevronDown" class="w-4 h-4 transition-transform duration-200" data-dropdown-icon />
    </button>
    <div
      class="absolute left-0 top-full mt-2 w-64 opacity-0 invisible transition-all duration-200 bg-blanc rounded-xl border border-encre/10 shadow-elevated p-2 z-[110]"
      role="menu"
      data-dropdown-menu
      style="transform: translateY(4px);"
    >
      <div class="space-y-1">
        <a href="/product/ai/" class="block px-3 py-2 rounded-lg hover:bg-papier transition-colors" role="menuitem">
          <span class="block text-sm font-medium text-encre">IA & Automatisations</span>
        </a>
        <a href="/product/integrations/" class="block px-3 py-2 rounded-lg hover:bg-papier transition-colors" role="menuitem">
          <span class="block text-sm font-medium text-encre">Intégrations & API</span>
        </a>
      </div>
    </div>
  </div>

  <!-- PERSONNALISER dropdown -->
  <div class="relative" data-dropdown>
    <button
      class="flex items-center gap-1 px-2.5 py-2 text-sm font-medium text-encre/60 hover:text-encre rounded-lg transition-colors"
      aria-haspopup="true"
      aria-expanded="false"
      aria-label="Menu Personnaliser"
      data-dropdown-trigger
      type="button"
    >
      Personnaliser
      <Icon name="chevronDown" class="w-4 h-4 transition-transform duration-200" data-dropdown-icon />
    </button>
    <div
      class="absolute left-0 top-full mt-2 w-60 opacity-0 invisible transition-all duration-200 bg-blanc rounded-xl border border-encre/10 shadow-elevated p-2 z-[110]"
      role="menu"
      data-dropdown-menu
      style="transform: translateY(4px);"
    >
      <div class="space-y-1">
        <a href="/product/white-label/" class="block px-3 py-2 rounded-lg hover:bg-papier transition-colors" role="menuitem">
