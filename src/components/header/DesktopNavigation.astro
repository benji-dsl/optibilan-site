---
import Icon from '../Icon.astro';
import LanguageSwitcher from '../LanguageSwitcher.astro';
import { localeOf, localizePath } from '../../i18n/config';
import { productGroups, solutionLinks, mainLinks } from '../../i18n/nav';
import { t } from '../../i18n/ui';

const locale = localeOf(Astro.currentLocale);
const d = t(locale);
const lp = (href: string) => localizePath(href, locale);

// Le blog n'existe qu'en francais : on n'envoie pas les visiteurs anglais vers un 404.
const blogHref = '/blog/';

const groups = productGroups(locale);
const solutions = solutionLinks(locale);
const mains = mainLinks(locale);
---

<div class="hidden md:flex items-center gap-4">
  <!-- PRODUIT dropdown -->
  <div class="relative" data-dropdown>
    <button
      class="flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-encre/60 hover:text-encre rounded-lg transition-colors"
      aria-haspopup="true"
      aria-expanded="false"
      aria-label={d.nav.productMenu}
      data-dropdown-trigger
      type="button"
    >
      {d.nav.product}
      <Icon name="chevronDown" class="w-4 h-4 transition-transform duration-200" data-dropdown-icon />
    </button>
    <div
      class="absolute left-0 top-full mt-2 w-[600px] opacity-0 invisible transition-all duration-200 bg-blanc rounded-xl border border-encre/10 shadow-elevated p-5 z-[110]"
      role="menu"
      data-dropdown-menu
      style="transform: translateY(4px);"
    >
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
        {groups.map((group) => (
          <div>
            <div class="px-2 py-2 font-semibold text-encre/50 uppercase tracking-wider text-xs border-b border-encre/10 mb-2">{group.title}</div>
            {group.links.map((link) => (
              <a href={lp(link.href)} class="block p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                <span class="block font-medium text-encre">{link.label}</span>
              </a>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- SOLUTIONS dropdown -->
  <div class="relative" data-dropdown>
    <button
      class="flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-encre/60 hover:text-encre rounded-lg transition-colors"
      aria-haspopup="true"
      aria-expanded="false"
      aria-label={d.nav.solutionsMenu}
      data-dropdown-trigger
      type="button"
    >
      {d.nav.solutions}
      <Icon name="chevronDown" class="w-4 h-4 transition-transform duration-200" data-dropdown-icon />
    </button>
    <div
      class="absolute left-0 top-full mt-2 w-[360px] opacity-0 invisible transition-all duration-200 bg-blanc rounded-xl border border-encre/10 shadow-elevated p-4 z-[110]"
      role="menu"
      data-dropdown-menu
      style="transform: translateY(4px);"
    >
      <div class="space-y-1">
        {solutions.map((link) => (
          <a href={lp(link.href)} class="block p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
            <span class="block font-medium text-encre">{link.label}</span>
          </a>
        ))}
      </div>
    </div>
  </div>

  {/* BLOG */}
  <a href={locale === 'en' ? blogHref : lp('/blog/')} class="px-3 py-2 text-sm font-medium text-encre/60 hover:text-encre rounded-lg transition-colors" aria-label={d.nav.blog}>
    {d.nav.blog}
  </a>

  {/* TARIFS / PRICING */}
  <a href={lp('/pricing/')} class="px-3 py-2 text-sm font-medium text-encre/60 hover:text-encre rounded-lg transition-colors" aria-label={d.nav.pricing}>
    {d.nav.pricing}
  </a>

  {/* CONTACT */}
  <a href={lp('/contact/')} class="px-3 py-2 text-sm font-medium text-encre/60 hover:text-encre rounded-lg transition-colors" aria-label={d.nav.contact}>
    {d.nav.contact}
  </a>
</div>

<div class="hidden md:flex items-center gap-2">
  <LanguageSwitcher class="mr-1" />
  <a href="https://app.optibilan.com/login" class="btn-header-secondary" aria-label={d.nav.login}>
    <Icon name="user" class="w-5 h-5" />
  </a>
  <a href={lp('/pricing/')} class="btn-header-primary" aria-label={d.nav.join}>
    <Icon name="arrowRight" class="w-5 h-5" />
    <span class="hidden sm:inline">{d.nav.join}</span>
  </a>
  <a href={lp('/checkout/solo/')} class="btn-header-bordeaux" aria-label={d.nav.try}>
    <span class="hidden md:inline">{d.nav.try}</span>
  </a>
</div>

<script>
  // Desktop dropdown handling - click to open/close, close on escape/outside click
  function closeAllDropdowns() {
    document.querySelectorAll('[data-dropdown-menu]').forEach(menu => {
      menu.classList.add('opacity-0', 'invisible');
      menu.classList.remove('opacity-100', 'visible');
      menu.style.transform = 'translateY(4px)';
    });
    document.querySelectorAll('[data-dropdown-trigger]').forEach(trigger => {
      trigger.setAttribute('aria-expanded', 'false');
      const icon = trigger.querySelector('[data-dropdown-icon]');
      if (icon) icon.style.transform = 'rotate(0deg)';
    });
  }

  function openDropdown(dropdown) {
    closeAllDropdowns();
    const menu = dropdown.querySelector('[data-dropdown-menu]');
    const trigger = dropdown.querySelector('[data-dropdown-trigger]');
    const icon = trigger?.querySelector('[data-dropdown-icon]');

    if (menu && trigger) {
      menu.classList.remove('opacity-0', 'invisible');
      menu.classList.add('opacity-100', 'visible');
      menu.style.transform = 'translateY(0)';
      trigger.setAttribute('aria-expanded', 'true');
      if (icon) icon.style.transform = 'rotate(180deg)';
    }
  }

  // Click on trigger to toggle dropdown
  document.querySelectorAll('[data-dropdown-trigger]').forEach(trigger => {
    trigger.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();

      const dropdown = trigger.closest('[data-dropdown]');
      const isExpanded = trigger.getAttribute('aria-expanded') === 'true';

      if (isExpanded) {
        closeAllDropdowns();
      } else {
        openDropdown(dropdown);
      }
    });
  });

  // Close on escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllDropdowns();
  });

  // Close dropdowns when clicking outside
  document.addEventListener('click', (e) => {
    if (!e.target.closest('[data-dropdown]')) closeAllDropdowns();
  });

  // Close dropdown when clicking a link inside it
  document.querySelectorAll('[data-dropdown-menu] a').forEach(link => {
    link.addEventListener('click', () => closeAllDropdowns());
  });
</script>
