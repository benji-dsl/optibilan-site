  </div>

  <!-- SOLUTIONS dropdown -->
  <div class="relative" data-dropdown>
    <button
      class="flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-encre/60 hover:text-encre rounded-lg transition-colors"
      aria-haspopup="true"
      aria-expanded="false"
      aria-label="Menu Solutions"
      data-dropdown-trigger
      type="button"
    >
      Solutions
      <Icon name="chevronDown" class="w-4 h-4 transition-transform duration-200" data-dropdown-icon />
    </button>
    <div
      class="absolute left-0 top-full mt-2 w-[360px] opacity-0 invisible transition-all duration-200 bg-blanc rounded-xl border border-encre/10 shadow-elevated p-4 z-[110]"
      role="menu"
      data-dropdown-menu
      style="transform: translateY(4px);"
    >
      <div class="space-y-1">
        <a href="/solutions/coaches/" class="block p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
          <span class="block font-medium text-encre">Coach sportif</span>
        </a>
        <a href="/solutions/nutrition/" class="block p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
          <span class="block font-medium text-encre">Nutritionniste / Diététicien</span>
        </a>
        <a href="/solutions/medecin/" class="block p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
          <span class="block font-medium text-encre">Médecin, pro de santé</span>
        </a>
        <a href="/solutions/cabinets/" class="block p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
          <span class="block font-medium text-encre">Cabinet / Équipe</span>
        </a>
      </div>
    </div>
  </div>

  <!-- BLOG -->
  <a href="/blog/" class="px-3 py-2 text-sm font-medium text-encre/60 hover:text-encre rounded-lg transition-colors" aria-label="Blog Optibilan">
    Blog
  </a>

  <!-- TARIFS -->
  <a href="/pricing/" class="px-3 py-2 text-sm font-medium text-encre/60 hover:text-encre rounded-lg transition-colors" aria-label="Tarifs Optibilan">
    Tarifs
  </a>

  <!-- CONTACT -->
  <a href="/contact/" class="px-3 py-2 text-sm font-medium text-encre/60 hover:text-encre rounded-lg transition-colors" aria-label="Contact et support">
    Contact
  </a>
</div>

<div class="hidden lg:flex items-center gap-2">
  <a href="https://app.optibilan.com/login" class="btn-header-secondary" aria-label="Connexion">
    <Icon name="user" class="w-5 h-5" />
  </a>
  <a href="/pricing/" class="btn-header-primary" aria-label="Rejoindre Optibilan">
    <Icon name="arrowRight" class="w-5 h-5" />
    <span class="hidden lg:inline">Rejoindre Optibilan</span>
  </a>
  <a href="/contact/" class="btn-header-secondary" aria-label="Essayer Optibilan">
    <Icon name="sparkles" class="w-5 h-5" />
    <span class="hidden xl:inline">Essayer Optibilan</span>
  </a>
</div>

<script>
  // Desktop dropdown handling - click to open/close, close on escape/outside click
  function closeAllDropdowns() {
    document.querySelectorAll('[data-dropdown-menu]').forEach(menu => {
      menu.classList.add('opacity-0', 'invisible');
      menu.classList.remove('opacity-100', 'visible');
      menu.style.transform = 'translateY(4px)';
    });
    document.querySelectorAll('[data-dropdown-trigger]').forEach(trigger => {
      trigger.setAttribute('aria-expanded', 'false');
      const icon = trigger.querySelector('[data-dropdown-icon]');
      if (icon) icon.style.transform = 'rotate(0deg)';
    });
  }

  function openDropdown(dropdown) {
    closeAllDropdowns();
    const menu = dropdown.querySelector('[data-dropdown-menu]');
    const trigger = dropdown.querySelector('[data-dropdown-trigger]');
    const icon = trigger?.querySelector('[data-dropdown-icon]');
    
    if (menu && trigger) {
      menu.classList.remove('opacity-0', 'invisible');
      menu.classList.add('opacity-100', 'visible');
      menu.style.transform = 'translateY(0)';
      trigger.setAttribute('aria-expanded', 'true');
      if (icon) icon.style.transform = 'rotate(180deg)';
    }
  }

  // Click on trigger to toggle dropdown
  document.querySelectorAll('[data-dropdown-trigger]').forEach(trigger => {
    trigger.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      
      const dropdown = trigger.closest('[data-dropdown]');
      const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
      
      if (isExpanded) {
        closeAllDropdowns();
      } else {
        openDropdown(dropdown);
      }
    });
  });

  // Close on escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllDropdowns();
  });

  // Close dropdowns when clicking outside
  document.addEventListener('click', (e) => {
    if (!e.target.closest('[data-dropdown]')) closeAllDropdowns();
  });

  // Close dropdown when clicking a link inside it
  document.querySelectorAll('[data-dropdown-menu] a').forEach(link => {
    link.addEventListener('click', () => closeAllDropdowns());
  });
</script>