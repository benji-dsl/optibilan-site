---
import Icon from '../Icon.astro';
---

<div class="hidden md:flex items-center gap-4">
  <!-- PRODUIT dropdown -->
  <div class="relative group" data-dropdown>
    <button class="flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-encre/60 hover:text-encre rounded-lg transition-colors" aria-haspopup="true" aria-expanded="false" aria-label="Menu Produit" data-dropdown-trigger>
      Produit
      <Icon name="chevronDown" class="w-4 h-4 transition-transform group-open:rotate-180" />
    </button>
    <div class="absolute left-0 top-full mt-2 w-[600px] opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200 bg-blanc rounded-xl border border-encre/10 shadow-elevated p-5 z-50" role="menu" data-dropdown-menu>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Accompagner -->
        <div>
          <div class="px-2 py-2 font-semibold text-encre/50 uppercase tracking-wider text-xs border-b border-encre/10 mb-2">Accompagner</div>
          <a href="/product/check-ins" class="block p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
            <span class="block font-medium text-encre">Bilans & progression</span>
          </a>
          <a href="/product/nutrition" class="block p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
            <span class="block font-medium text-encre">Nutrition</span>
          </a>
          <a href="/product/training" class="block p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
            <span class="block font-medium text-encre">Sport & programmes</span>
          </a>
          <a href="/product/mental" class="block p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
            <span class="block font-medium text-encre">Préparation mentale</span>
          </a>
        </div>
        <!-- Suivre -->
        <div>
          <div class="px-2 py-2 font-semibold text-encre/50 uppercase tracking-wider text-xs border-b border-encre/10 mb-2">Suivre</div>
          <a href="/product/health" class="block p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
            <span class="block font-medium text-encre">Santé & biomarqueurs</span>
          </a>
          <a href="/product/engagement" class="block p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
            <span class="block font-medium text-encre">Habitudes & engagement</span>
          </a>
        </div>
        <!-- Automatiser -->
        <div class="lg:col-span-2">
          <div class="px-2 py-2 font-semibold text-encre/50 uppercase tracking-wider text-xs border-b border-encre/10 mb-2">Automatiser</div>
          <a href="/product/ai" class="block p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
            <span class="block font-medium text-encre">IA & Automatisations</span>
          </a>
          <a href="/product/integrations" class="block p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
            <span class="block font-medium text-encre">Intégrations & API</span>
          </a>
        </div>
        <!-- Personnaliser -->
        <div class="lg:col-span-4">
          <div class="px-2 py-2 font-semibold text-encre/50 uppercase tracking-wider text-xs border-b border-encre/10 mb-2">Personnaliser</div>
          <a href="/product/white-label" class="block p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
            <span class="block font-medium text-encre">Marque blanche</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- SOLUTIONS dropdown -->
  <div class="relative group" data-dropdown>
    <button class="flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-encre/60 hover:text-encre rounded-lg transition-colors" aria-haspopup="true" aria-expanded="false" aria-label="Menu Solutions" data-dropdown-trigger>
      Solutions
      <Icon name="chevronDown" class="w-4 h-4 transition-transform group-open:rotate-180" />
    </button>
    <div class="absolute left-0 top-full mt-2 w-[360px] opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200 bg-blanc rounded-xl border border-encre/10 shadow-elevated p-4 z-50" role="menu">
      <div class="space-y-1">
        <a href="/solutions/coaches" class="block p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
          <span class="block font-medium text-encre">Coach sportif</span>
        </a>
        <a href="/solutions/nutrition" class="block p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
          <span class="block font-medium text-encre">Nutritionniste / Diététicien</span>
        </a>
        <a href="/solutions/mental" class="block p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
          <span class="block font-medium text-encre">Préparateur mental</span>
        </a>
        <a href="/solutions/cabinets" class="block p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
          <span class="block font-medium text-encre">Cabinet / Équipe</span>
        </a>
      </div>
    </div>
  </div>

  <!-- BLOG -->
  <a href="/blog" class="px-3 py-2 text-sm font-medium text-encre/60 hover:text-encre rounded-lg transition-colors" aria-label="Blog Optibilan">
    Blog
  </a>

  <!-- CONTACT -->
  <a href="/contact" class="px-3 py-2 text-sm font-medium text-encre/60 hover:text-encre rounded-lg transition-colors" aria-label="Contact et support">
    Contact
  </a>
</div>

<div class="hidden md:flex items-center gap-2">
  <a href="https://app.optibilan.com/login" class="btn btn-header-secondary p-2" aria-label="Connexion">
    <Icon name="user" class="w-5 h-5" />
  </a>
  <a href="https://calendly.com/optibilan/demo" class="btn btn-header-primary" aria-label="Rejoindre Optibilan">
    <Icon name="arrowRight" class="w-5 h-5" />
    <span class="hidden sm:inline">Rejoindre Optibilan</span>
  </a>
  <a href="/contact" class="btn btn-header-secondary ml-2" aria-label="Essayer Optibilan">
    <Icon name="sparkles" class="w-5 h-5" />
    <span class="hidden md:inline">Essayer Optibilan</span>
  </a>
</div>

<script is:inline>
  // Desktop dropdown handling - close on escape/outside click only
  function closeAllDropdowns() {
    document.querySelectorAll('[data-dropdown-menu]').forEach(menu => {
      menu.classList.add('opacity-0', 'invisible');
      menu.classList.remove('opacity-100', 'visible');
    });
    document.querySelectorAll('[data-dropdown-trigger]').forEach(trigger => {
      trigger.setAttribute('aria-expanded', 'false');
    });
  }

  // Close on escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllDropdowns();
  });

  // Close dropdowns when clicking outside
  document.addEventListener('click', (e) => {
    if (!e.target.closest('[data-dropdown]')) closeAllDropdowns();
  });

  // Update aria-expanded on hover/focus for accessibility
  document.querySelectorAll('[data-dropdown]').forEach(dropdown => {
    const trigger = dropdown.querySelector('[data-dropdown-trigger]');
    const menu = dropdown.querySelector('[data-dropdown-menu]');
    if (!trigger || !menu) return;

    dropdown.addEventListener('mouseenter', () => {
      trigger.setAttribute('aria-expanded', 'true');
    });
    dropdown.addEventListener('focusin', () => {
      trigger.setAttribute('aria-expanded', 'true');
    });
    dropdown.addEventListener('mouseleave', () => {
      if (!menu.matches(':hover')) trigger.setAttribute('aria-expanded', 'false');
    });
    dropdown.addEventListener('focusout', (e) => {
      if (!dropdown.contains(e.relatedTarget)) trigger.setAttribute('aria-expanded', 'false');
    });
  });
</script>

<style is:global>
  [data-header].shadow-soft {
    box-shadow: 0 2px 15px -3px rgba(0, 0, 0, 0.07), 0 10px 20px -2px rgba(0, 0, 0, 0.04);
  }
  
  /* Ensure dropdowns are above everything */
  [data-dropdown] {
    z-index: 110;
  }
  
  /* Dropdown menu animation - smooth and performant */
  [data-dropdown-menu] {
    transition: opacity 150ms ease, transform 150ms ease, visibility 150ms ease;
    transform: translateY(4px);
  }
  
  [data-dropdown]:hover [data-dropdown-menu],
  [data-dropdown]:focus-within [data-dropdown-menu] {
    transform: translateY(0);
  }
</style>