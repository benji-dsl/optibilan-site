---
interface Props {
  title?: string;
  subtitle?: string;
  features: Array<{
    icon: string;
    title: string;
    description: string;
    link?: { href: string; label: string };
  }>;
}

const {
  title = 'Tout ce qu\'il faut pour coacher sereinement',
  subtitle = 'Des modules pensés par des coachs, pour des coachs. Activez seulement ce dont vous avez besoin.',
  features,
} = Astro.props;

const icons = {
  shield: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>',
  chart: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>',
  users: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>',
  calendar: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>',
  document: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>',
  lock: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>',
  zap: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>',
  globe: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>',
  brain: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>',
};

const defaultFeatures = [
  {
    icon: 'shield',
    title: 'Multi-tenant natif',
    description: 'Chaque cabinet est isolé : données, marque, vocabulaire, modules. Impossible de fuite inter-cabinets.',
    link: { href: '/securite', label: 'Voir l\'architecture' }
  },
  {
    icon: 'chart',
    title: 'Bilans & progression',
    description: 'Bilans hebdo, mensurations, photos avant/après, biomarqueurs, score longévité. Graphiques interactifs.',
  },
  {
    icon: 'users',
    title: 'Espace coach complet',
    description: 'Cockpit, agenda, journal d\'appels, revue hebdo, jalons, templates nutrition/sport. Multi-spécialités.',
  },
  {
    icon: 'calendar',
    title: 'Appels planifiés & rappels',
    description: 'Cadence auto selon l\'offre, Slack/email/push, gestion retards, calendrier ICS partagé.',
  },
  {
    icon: 'document',
    title: 'Marque blanche totale',
    description: 'Logo, couleurs, nom assistant, vocabulaire (coaché/patient/membre), domaine, mentions légales du cabinet.',
  },
  {
    icon: 'lock',
    title: 'Sécurité & conformité',
    description: '2FA obligatoire admins, CSP stricte, SSRF protection, audit trail, export RGPD, purge paramétrable.',
  },
  {
    icon: 'zap',
    title: 'API & Webhooks',
    description: 'REST v1 + OpenAPI, clés API scopées, webhooks signés HMAC, rate-limit, sync santé (Apple Health, Oura...).',
  },
  {
    icon: 'globe',
    title: 'Déploiement souverain',
    description: 'Hébergement EU (Supabase), VPS France, données jamais aux US. Backup auto, monitoring, SLA pro.',
  },
  {
    icon: 'brain',
    title: 'Assistant IA intégrée',
    description: 'Lecture bilans, prises de sang, biomarqueurs. Prompting par cabinet, plafond mensuel par offre.',
  },
];

const displayFeatures = features.length > 0 ? features : defaultFeatures;
---

<section class="section bg-white" aria-labelledby="features-title">
  <div class="container">
    <header class="text-center max-w-3xl mx-auto mb-16">
      <h2 id="features-title" class="font-display text-3xl md:text-4xl font-bold text-ink-950 mb-4">
        {title}
      </h2>
      <p class="text-lg text-ink-600">
        {subtitle}
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {displayFeatures.map((feature, index) => (
        <article class="card-hover group">
          <div class="w-12 h-12 rounded-xl bg-primary-50 text-primary-600 flex items-center justify-center mb-4 transition-colors group-hover:bg-primary-100 group-hover:text-primary-700" aria-hidden="true">
            {icons[feature.icon] || icons.shield}
          </div>
          <h3 class="text-xl font-semibold text-ink-950 mb-2">
            {feature.title}
          </h3>
          <p class="text-ink-600 leading-relaxed mb-4">
            {feature.description}
          </p>
          {feature.link && (
            <a href={feature.link.href} class="inline-flex items-center gap-1.5 text-sm font-medium text-primary-600 hover:text-primary-700 transition-colors group">
              {feature.link.label}
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>