---
import Icon from './Icon.astro';

interface Props {
  title?: string;
  subtitle?: string;
  features?: Array<{
    icon: string;
    title: string;
    description: string;
    link?: { href: string; label: string };
  }>;
}

const defaultFeatures = [
  {
    icon: 'shield',
    title: 'Multi-tenant natif',
    description: 'Chaque cabinet est isolé : données, marque, vocabulaire, modules. Impossible de fuite inter-cabinets.',
    link: { href: '/securite/', label: 'Voir l\'architecture' }
  },
  {
    icon: 'chart',
    title: 'Bilans & progression',
    description: 'Bilans hebdo, mensurations, photos avant/après, biomarqueurs, score longévité. Graphiques interactifs, alertes d\'adhérence, export PDF.',
    link: { href: '/product/check-ins/', label: 'Voir le détail' }
  },
  {
    icon: 'users',
    title: 'Espace coach complet',
    description: 'Cockpit, agenda, journal d\'appels, revue hebdo, jalons, templates nutrition/sport. Multi-spécialités.',
    link: { href: '/product/overview/', label: 'Voir le détail' }
  },
  {
    icon: 'calendar',
    title: 'Appels planifiés & rappels',
    description: 'Cadence auto selon l\'offre, Slack/email/push, gestion retards, calendrier ICS partagé.',
    link: { href: '/product/agenda/', label: 'Voir le détail' }
  },
  {
    icon: 'document',
    title: 'Marque blanche totale',
    description: 'Logo, couleurs, nom assistant, vocabulaire (coaché/patient/membre), domaine, mentions légales du cabinet.',
    link: { href: '/product/white-label/', label: 'Voir le détail' }
  },
  {
    icon: 'lock',
    title: 'Sécurité & conformité',
    description: '2FA obligatoire admins, CSP stricte, audit trail, export RGPD, purge paramétrable.',
    link: { href: '/securite/', label: 'Voir le détail' }
  },
  {
    icon: 'zap',
    title: 'API & Automatisations',
    description: 'REST v1 + OpenAPI, clés API scopées, webhooks signés, rate-limit, sync santé (Apple Health, Oura...).',
    link: { href: '/product/integrations/', label: 'Voir le détail' }
  },
  {
    icon: 'globe',
    title: 'Hébergement EU',
    description: 'Supabase (Irlande), VPS France, backups EU. Données jamais aux US. Monitoring, SLA pro.',
    link: { href: '/securite/', label: 'Voir le détail' }
  },
  {
    icon: 'brain',
    title: 'Assistant IA intégrée',
    description: 'Lecture bilans, prises de sang, biomarqueurs. L\'IA prépare, le professionnel décide. Plafond mensuel par offre.',
    link: { href: '/product/ai/', label: 'Voir le détail' }
  },
];
---

<section class="section bg-blanc" aria-labelledby="features-title">
  <div class="container">
    <header class="text-center max-w-3xl mx-auto mb-16">
      <h2 id="features-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
        {title}
      </h2>
      <p class="text-lg text-encre/60">
        {subtitle}
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {displayFeatures.map((feature, index) => (
        <article class="card-hover group">
          <div class="icon-wrapper mb-4" aria-hidden="true">
            <Icon name={feature.icon as any} class="w-10 h-10" />
          </div>
          <h3 class="text-xl font-semibold text-encre mb-2">
            {feature.title}
          </h3>
          <p class="text-encre/60 leading-relaxed mb-4">
            {feature.description}
          </p>
          {feature.link && (
            <a href={feature.link.href} class="inline-flex items-center gap-1.5 text-sm font-medium text-bleu-signature hover:text-bleu-lecture transition-colors group">
              {feature.link.label}
              <Icon name="arrowRight" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>