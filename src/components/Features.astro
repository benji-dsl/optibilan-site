---
import Icon from './Icon.astro';

interface Props {
  title?: string;
  subtitle?: string;
  features?: Array<{
    icon: string;
    title: string;
    description: string;
    link?: { href: string; label: string };
  }>;
}

const defaultFeatures = [
  {
    icon: 'shield',
    title: 'Multi-tenant natif',
    description: 'Chaque cabinet est isolé : données, marque, vocabulaire, modules. Impossible de fuite inter-cabinets.',
    link: { href: '/securite', label: 'Voir l\'architecture' }
  },
  {
    icon: 'chart',
    title: 'Bilans & progression',
    description: 'Bilans hebdo, mensurations, photos avant/après, biomarqueurs, score longévité. Graphiques interactifs.',
  },
  {
    icon: 'users',
    title: 'Espace coach complet',
    description: 'Cockpit, agenda, journal d\'appels, revue hebdo, jalons, templates nutrition/sport. Multi-spécialités.',
  },
  {
    icon: 'calendar',
    title: 'Appels planifiés & rappels',
    description: 'Cadence auto selon l\'offre, Slack/email/push, gestion retards, calendrier ICS partagé.',
  },
  {
    icon: 'document',
    title: 'Marque blanche totale',
    description: 'Logo, couleurs, nom assistant, vocabulaire (coaché/patient/membre), domaine, mentions légales du cabinet.',
  },
  {
    icon: 'lock',
    title: 'Sécurité & conformité',
    description: '2FA obligatoire admins, CSP stricte, SSRF protection, audit trail, export RGPD, purge paramétrable.',
  },
  {
    icon: 'zap',
    title: 'API & Webhooks',
    description: 'REST v1 + OpenAPI, clés API scopées, webhooks signés HMAC, rate-limit, sync santé (Apple Health, Oura...).',
  },
  {
    icon: 'globe',
    title: 'Déploiement souverain',
    description: 'Hébergement EU (Supabase), VPS France, données jamais aux US. Backup auto, monitoring, SLA pro.',
  },
  {
    icon: 'brain',
    title: 'Assistant IA intégrée',
    description: 'Lecture bilans, prises de sang, biomarqueurs. Prompting par cabinet, plafond mensuel par offre.',
  },
];

const {
  title = 'Tout ce qu\'il faut pour coacher sereinement',
  subtitle = 'Des modules pensés par des coachs, pour des coachs. Activez seulement ce dont vous avez besoin.',
  features,
} = Astro.props;

const displayFeatures = features && features.length > 0 ? features : defaultFeatures;
---

<section class="section bg-white" aria-labelledby="features-title">
  <div class="container">
    <header class="text-center max-w-3xl mx-auto mb-16">
      <h2 id="features-title" class="font-display text-3xl md:text-4xl font-bold text-ink-950 mb-4">
        {title}
      </h2>
      <p class="text-lg text-ink-600">
        {subtitle}
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {displayFeatures.map((feature, index) => (
        <article class="card-hover group">
          <div class="icon-wrapper" aria-hidden="true">
            <Icon name={feature.icon as any} />
          </div>
          <h3 class="text-xl font-semibold text-ink-950 mb-2">
            {feature.title}
          </h3>
          <p class="text-ink-600 leading-relaxed mb-4">
            {feature.description}
          </p>
          {feature.link && (
            <a href={feature.link.href} class="inline-flex items-center gap-1.5 text-sm font-medium text-primary-600 hover:text-primary-700 transition-colors group">
              {feature.link.label}
              <Icon name="arrowRight" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>