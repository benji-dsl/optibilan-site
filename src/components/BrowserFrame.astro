---
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  aspect?: string;
  className?: string;
}

const {
  src,
  alt,
  width,
  height,
  aspect = '16/10',
  className = '',
} = Astro.props;
---

<div class={`rounded-2xl border border-encre/10 bg-blanc shadow-elevated overflow-hidden ${className}`}>
  <div class="bg-encre/5" style={`aspect-ratio: ${aspect};`}>
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      class="w-full h-full object-cover"
      loading="lazy"
      decoding="async"
    />
  </div>
</div>