---
import Icon from './Icon.astro';

interface Props {
  badges?: Array<{
    label: string;
    icon: string;
    description?: string;
  }>;
  title?: string;
}

const {
  badges = [
    { label: 'Biomarqueurs sanguins', icon: 'chart', description: 'Suivi taux, ferritine, vit D, CRP, homocysteine' },
    { label: 'Metriques quotidiennes', icon: 'activity', description: 'FCV, sommeil, HRV, charge, recuperation' },
    { label: 'Nutrition precision', icon: 'apple', description: 'Macros, micronutriments, timing, supplements' },
    { label: 'Entrainement adapte', icon: 'dumbbell', description: 'RPE, volume, intensite, progression auto' },
    { label: 'Sante cognitive', icon: 'brain', description: 'Tests cognitifs, stress, sommeil, humeur' },
  ],
  title = 'accompagnez a la meilleure longevite en bonne sante',
} = Astro.props;
---

<section class="relative py-16 bg-encre/95" aria-labelledby="trust-title">
  <div class="absolute inset-0 bg-gradient-to-r from-encre/90 via-encre/95 to-encre/90" aria-hidden="true"></div>
  
  <div class="container relative">
    <p id="trust-title" class="text-center text-sm font-semibold text-craie/50 uppercase tracking-wider mb-12">
      {title}
    </p>

    <div class="relative max-w-5xl mx-auto">
      <div class="overflow-hidden">
        <div class="flex gap-4 md:gap-6" id="trust-carousel" role="region" aria-label="Piliers longévité">
          {badges.map((badge, index) => (
            <article
              class="flex-shrink-0 w-full sm:w-[calc(50%-0.5rem)] lg:w-[calc(20%-0.8rem)] group"
              aria-label={badge.label}
              style={`animation-delay: ${index * 100}ms`}
            >
              <div class="bg-encre/80 backdrop-blur-sm rounded-2xl border border-craie/10 p-6 md:p-8 h-full flex flex-col items-center text-center transition-all duration-300 hover:border-bleu-signature/30 hover:shadow-lg hover:shadow-bleu-signature/10">
                <div class="icon-wrapper mb-4 group-hover:scale-110 transition-transform duration-300" aria-hidden="true">
                  <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-bleu-signature/20 to-bleu-lecture/20 flex items-center justify-center group-hover:from-bleu-signature/30 group-hover:to-bleu-lecture/30 transition-all duration-300">
                    <Icon name={badge.icon} class="w-7 h-7 text-bleu-signature" />
                  </div>
                </div>
                <h3 class="font-display text-lg font-semibold text-craie mb-2 text-center">{badge.label}</h3>
                <p class="text-xs text-craie/50 text-center leading-relaxed">{badge.description || ''}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
</div>
</section>

<script is:inline>
  const carousel = document.getElementById('trust-carousel');
  if (carousel) {
    let scrollInterval;
    const scrollAmount = 300;
    const scrollDelay = 4000;
    
    function autoScroll() {
      if (carousel.scrollLeft + carousel.clientWidth >= carousel.scrollWidth - 10) {
        carousel.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        carousel.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      }
    }
    
    function startAutoScroll() {
      scrollInterval = setInterval(autoScroll, scrollDelay);
    }
    
    function stopAutoScroll() {
      clearInterval(scrollInterval);
    }
    
    carousel.addEventListener('mouseenter', stopAutoScroll);
    carousel.addEventListener('mouseleave', startAutoScroll);
    carousel.addEventListener('focusin', stopAutoScroll);
    carousel.addEventListener('focusout', startAutoScroll);
    
    startAutoScroll();
  }
</script>

<style>
  @media (max-width: 768px) {
    #trust-carousel {
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }
    #trust-carousel > * {
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }
  }
</style>