---
import Icon from './Icon.astro';

interface Props {
  badges?: Array<{
    label: string;
    icon: string;
    description?: string;
  }>;
  title?: string;
}

const {
  badges = [
    { label: 'Biomarqueurs sanguins', icon: 'chart', description: 'Suivi taux, ferritine, vit D, CRP, homocystéine' },
    { label: 'Métriques quotidiennes', icon: 'activity', description: 'FCV, sommeil, HRV, charge, récupération' },
    { label: 'Nutrition précision', icon: 'apple', description: 'Macros, micronutriments, timing, suppléments' },
    { label: 'Entraînement adapté', icon: 'dumbbell', description: 'RPE, volume, intensité, progression auto' },
    { label: 'Santé cognitive', icon: 'brain', description: 'Tests cognitifs, stress, sommeil, humeur' },
  ],
  title = 'accompagnez à la meilleure longévité en bonne santé',
} = Astro.props;

// Duplicate badges for seamless infinite scroll
const allBadges = [...badges, ...badges, ...badges];
---

<section class="relative py-10 bg-gradient-to-b from-encre/95 via-encre/90 to-encre/95" aria-labelledby="trust-title">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--color-bleu-signature)_0%,_transparent_70%)] opacity-10" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-[linear-gradient(90deg,_transparent_0%,_var(--color-bleu-signature)_50%,_transparent_100%)] opacity-5" aria-hidden="true"></div>
  
  <div class="container relative">
    <p id="trust-title" class="text-center text-xs font-semibold text-craie/50 uppercase tracking-wider mb-8">
      {title}
    </p>

    <div class="relative max-w-7xl mx-auto">
      <div class="overflow-hidden" style="mask-image: linear-gradient(90deg, transparent, black 20%, black 80%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, black 20%, black 80%, transparent);">
        <div class="flex gap-4 md:gap-6" id="trust-carousel" role="region" aria-label="Piliers longévité" style="animation: scroll 30s linear infinite;">
          {allBadges.map((badge, index) => (
            <article
              class="flex-shrink-0 w-full sm:w-[calc(50%-0.5rem)] lg:w-[calc(20%-0.8rem)] group"
              aria-label={badge.label}
            >
              <div class="bg-blanc/5 backdrop-blur-sm rounded-2xl border border-craie/10 p-5 md:p-6 h-full flex flex-col items-center text-center transition-all duration-300 hover:border-bleu-signature/30 hover:shadow-lg hover:shadow-bleu-signature/10 hover:bg-blanc/10">
                <div class="icon-wrapper mb-3 group-hover:scale-110 transition-transform duration-300" aria-hidden="true">
                  <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-bleu-signature/20 to-bleu-lecture/20 flex items-center justify-center group-hover:from-bleu-signature/30 group-hover:to-bleu-lecture/30 transition-all duration-300">
                    <Icon name={badge.icon} class="w-6 h-6 text-bleu-signature" />
                  </div>
                </div>
                <h3 class="font-display text-base font-semibold text-craie mb-1.5 text-center">{badge.label}</h3>
                <p class="text-xs text-craie/50 text-center leading-relaxed">{badge.description || ''}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-66.66%); }
  }
  
  #trust-carousel {
    animation: scroll 30s linear infinite;
    will-change: transform;
  }
  
  #trust-carousel:hover {
    animation-play-state: paused;
  }
  
  @media (prefers-reduced-motion: reduce) {
    #trust-carousel {
      animation: none;
    }
  }
  
  @media (max-width: 768px) {
    #trust-carousel {
      animation-duration: 40s;
    }
  }
</style>