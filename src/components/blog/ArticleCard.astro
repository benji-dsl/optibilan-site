---
import Icon from '../Icon.astro';
import { CATEGORY_MAP, type OptibilanArticle } from '@/utils/wordpress';

interface Props {
  article: OptibilanArticle;
}

const { article } = Astro.props;
const catInfo = CATEGORY_MAP[article.category] ?? CATEGORY_MAP.coaching;
const color = catInfo.color;

function formatDate(dateStr: string) {
  try {
    return new Date(dateStr).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
  } catch {
    return dateStr;
  }
}
---

<article class="card-hover group relative overflow-hidden h-full flex flex-col" style={`--accent: var(--color-${color})`}>
  {article.featuredImage && (
    <a href={`/blog/${article.slug}/`} class="block aspect-[2/1] overflow-hidden bg-encre/5" tabindex="-1" aria-hidden="true">
      <img
        src={article.featuredImage}
        alt=""
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      />
    </a>
  )}

  <div class="p-6 md:p-7 flex flex-col flex-1">
    <div class="flex items-center gap-2 mb-3 flex-wrap">
      <a
        href={`/blog/category/${article.category}/`}
        class="inline-flex items-center gap-1 px-2.5 py-1 rounded-puce text-xs font-medium hover:opacity-80"
        style={`color: var(--color-${color}); background-color: color-mix(in oklab, var(--color-${color}) 10%, transparent);`}
      >
        {article.categoryLabel || catInfo.label}
      </a>
      <time class="text-xs text-encre/40" datetime={article.date}>{formatDate(article.date)}</time>
    </div>

    <h3 class="font-display text-xl font-bold text-encre mb-3 line-clamp-2 group-hover:text-bleu-signature transition-colors">
      <a href={`/blog/${article.slug}/`}>{article.title}</a>
    </h3>

    <p class="text-encre/60 leading-relaxed mb-4 line-clamp-3 flex-1">{article.excerpt}</p>

    <div class="flex items-center justify-between pt-4 border-t border-encre/10 mt-auto">
      <div class="flex items-center gap-2 min-w-0">
        {article.authorAvatar ? (
          <img src={article.authorAvatar} alt={article.author} class="w-8 h-8 rounded-full" loading="lazy" decoding="async" />
        ) : (
          <div class="w-8 h-8 rounded-full bg-gradient-to-br from-bleu-signature to-bleu-lecture flex items-center justify-center text-craie font-bold text-xs flex-shrink-0">
            {article.author.split(' ').map(n => n[0]).join('')}
          </div>
        )}
        <span class="text-sm font-medium text-encre/70 truncate">{article.author}</span>
      </div>
      <span class="text-xs text-encre/40 flex items-center gap-1 flex-shrink-0 ml-3">
        <Icon name="clock" class="w-3 h-3" /> {article.readTime}
      </span>
    </div>
  </div>
</article>
