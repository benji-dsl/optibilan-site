---
import Icon from './Icon.astro';

interface Props {
  title?: string;
  subtitle?: string;
  pillars?: Array<{
    icon: string;
    title: string;
    description: string;
    features: string[];
    techSpecs: string[];
    color: string;
    screenshot?: string;
  }>;
}

const {
  title = "6 modules, une plateforme unifiée",
  subtitle = "Activez seulement ce dont vous avez besoin. Chaque module est complet, sans surcoût. Données de santé, IA, API - tout est intégré.",
  pillars = [
    {
      icon: "chart",
      title: "Bilans & Progression",
      description: "Le cœur du suivi : bilans hebdo guidés, mensurations, photos avant/après, score de performance. L'IA détecte les signaux faibles (stagnation, baisse motivation) avant qu'ils ne deviennent critiques.",
      features: [
        "Bilans guidés + score progression",
        "Photos avant/après alignées",
        "Détection IA signaux faibles",
        "Export PDF brandé client",
      ],
      techSpecs: [
        "30+ points de données par bilan",
        "Historique illimité, requêtables via API",
        "Webhook checkin.submitted temps réel",
      ],
      color: "bleu-signature",
    },
    {
      icon: "document",
      title: "Nutrition Complète",
      description: "Plans alimentaires individualisés (protéines/glucides/lipides/légumes/fruits/plaisirs), listes de courses auto-générées, compléments classés (indispensable/optionnel), méthodes OK/à éviter. Templates réutilisables par pathologie/objectif.",
      features: [
        "Plans macro/micro par repas",
        "Listes courses auto-générées",
        "Compléments dosés + niveau preuve",
        "Templates par pathologie/objectif",
      ],
      techSpecs: [
        "Base CIQUAL + USDA intégrée (3000+ aliments)",
        "Calcul automatique besoins (Mifflin-St Jeor + facteur activité)",
        "API nutrition : GET/POST /api/v1/clients/:id/nutrition",
      ],
      color: "bleu-lecture",
    },
    {
      icon: "zap",
      title: "Sport & Programmes",
      description: "Bibliothèque d'exercices (force/cardio/mobilité) avec vidéos, programmes types réutilisables, séances validées par le coaché avec ressenti/RPE. Import FitFocus. Suivi charge/volume/progression par exercice.",
      features: [
        "200+ exercices vidéo + régressions",
        "Création séances drag-and-drop",
        "Validation coaché charge/RPE/vidéo",
        "Progression charge/volume/1RM",
      ],
      techSpecs: [
        "Bibliothèque extensible (ajout exercices custom illimités)",
        "API sport : programmes, séances, exercices, progression",
        "Webhook session.completed pour sync externes",
      ],
      color: "indigo",
    },
    {
      icon: "brain",
      title: "Préparation Mentale",
      description: "Exercices transversaux déposés par le préparateur mental (visualisation, respiration, routine pré-compétition), bibliothèque ressources (vidéos, PDF, audio), journal d'appels dédié, suivi adhérence. Séparation stricte des données mentales (confidentialité renforcée).",
      features: [
        "Exercices : visualisation, respiration, ancrage",
        "Ressources vidéo/PDF/audio streaming",
        "Journal appels dédié + plan action",
        "Cloisonnement données mental strict",
      ],
      techSpecs: [
        "Chiffrement supplémentaire au repos pour données mentales",
        "Rôle 'préparateur mental' avec périmètre strict",
        "API mental : exercices, ressources, journal, adhérence",
      ],
      color: "bleu-ardoise",
    },
    {
      icon: "globe",
title: "Santé Connectée & Biomarqueurs",
      description: "Sync compatible Apple Health, Oura, Whoop, Garmin (via Raccourcis iOS ou n8n/Make). 130+ biomarqueurs structurés : sommeil (stades, score, régularité), VFC (rmssd, tendance), FC repos, VO2max, pas, poids, %MG. Analyses sanguines : glycémie, HbA1c, CRP, vit D, ferritine, lipidogramme, thyroïde, hormones. IA lit les PDF de labo et pré-remplit.",
      features: [
        "Sync Apple Health/Oura/Whoop/Garmin",
        "130+ biomarqueurs sanguins structurés",
        "Import PDF labo : IA extrait + signale",
        "VFC, sommeil, FC repos, VO2max unifiés",
      ],
      techSpecs: [
        "Token santé par client (hsk_...) - scope granulaire",
        "Endpoint /api/health-sync (HMAC signé) pour n8n/Make",
        "Stockage Supabase bucket privé, chiffré AES-256",
        "Hébergement EU (Supabase EU West, VPS France)",
      ],
      color: "bleu-clair",
    },
    {
icon: "lock",
      title: "Marque Blanche, API & Conformité",
      description: "Votre marque, pas la nôtre. Logo, couleurs, domaine, vocabulaire (coaché/patient/membre), assistant IA nommé, emails, mentions légales, CGV - tout est à vous. API REST v1 OpenAPI, clés scopées, webhooks HMAC. Export RGPD 1-clic (37 modèles), audit trail double niveau, purge auto. Hébergement France/EU.",
      features: [
        "Marque blanche : logo, thème, domaine, vocabulaire, IA",
        "API REST v1 OpenAPI + clés scopées",
        "Export RGPD 1-clic + audit trail",
        "Hébergement France/EU + SSO/SAML",
      ],
      techSpecs: [
        "Architecture multi-tenant fail-closed (extension Prisma tenant-guard)",
        "13/13 tests d'isolation en CI (test:isolation.mts)",
        "DPA signé, registre sous-traitants Art.28 RGPD à jour",
        "PITR 7j + snapshots quotidiens + backups chiffrés S3 EU 30j",
        "Certifications fournisseurs : SOC 2 Type II, ISO 27001, HIPAA, RGPD",
      ],
      color: "bordeaux",
    },
  ],
} = Astro.props;
---

<section class="section bg-papier" aria-labelledby="pillars-title">
  <div class="container">
    <header class="text-center max-w-3xl mx-auto mb-16">
      <h2 id="pillars-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
        {title}
      </h2>
      <p class="text-lg text-encre/60">
        {subtitle}
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {pillars.map((pillar, index) => (
        <article class="card-hover group relative overflow-hidden" style="--pillar-color: var(--color-{pillar.color})">
          <div class="absolute top-0 left-0 right-0 h-1 bg-[var(--pillar-color)] opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>

          <div class="p-6 md:p-8">
            <div class="icon-wrapper mb-4" aria-hidden="true">
              <Icon name={pillar.icon as any} class="w-10 h-10" />
            </div>

            <h3 class="font-display text-xl font-bold text-encre mb-3">
              {pillar.title}
            </h3>
            <p class="text-encre/60 leading-relaxed mb-5">
              {pillar.description}
            </p>

            <ul class="space-y-2 mb-5" role="list">
              {pillar.features.map(feature => (
                <li key={feature} class="flex items-start gap-2 text-sm text-encre/60 group">
                  <Icon name="check" class="w-4 h-4 text-[var(--pillar-color)] flex-shrink-0 mt-0.5 transition-transform group-hover:translate-x-0.5" />
                  <span>{feature}</span>
                </li>
              ))}
            </ul>

            <details class="group border-t border-encre/10 pt-4">
              <summary class="flex items-center gap-2 text-sm font-medium text-[var(--pillar-color)] cursor-pointer list-none">
                <span>Spécifications techniques</span>
                <Icon name="chevronDown" class="w-4 h-4 transition-transform group-open:rotate-180" />
              </summary>
              <ul class="mt-3 space-y-1.5 text-xs text-encre/50" role="list">
                {pillar.techSpecs.map(spec => (
                  <li key={spec} class="flex items-start gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-[var(--pillar-color)] flex-shrink-0 mt-2" />
                    <span>{spec}</span>
                  </li>
                ))}
              </ul>
            </details>

            <a href={`/fonctionnalites#${pillar.title.toLowerCase().replace(/ & /g, '-').replace(/\s+/g, '-')}`} class="inline-flex items-center gap-1.5 text-sm font-medium text-[var(--pillar-color)] hover:opacity-80 transition-opacity group mt-4 block">
              Voir le détail
              <Icon name="arrowRight" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
            </a>
          </div>
        </article>
      ))}
    </div>

    <p class="text-center text-sm text-encre/40 mt-10">
      Tous les modules inclus dans votre offre · Aucun surcoût · Activation instantanée
    </p>
  </div>
</section>