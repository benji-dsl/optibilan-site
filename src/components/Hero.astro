---
import Icon from './Icon.astro';

interface Props {
  variant?: 'home' | 'page';
  title?: string;
  subtitle?: string;
  badge?: string;
  stats?: Array<{ value: string; label: string }>;
  primaryCTA?: { href: string; label: string };
  secondaryCTA?: { href: string; label: string };
  illustration?: string; // imported SVG string
}

const {
  variant = 'home',
  title,
  subtitle,
  badge,
  stats = [],
  primaryCTA = { href: 'https://calendly.com/optibilan/demo', label: 'Rejoindre Optibilan' },
  secondaryCTA = { href: '/contact', label: 'Essai offert' },
  illustration,
} = Astro.props;

const homeTitle = title || 'Pilotez tous vos accompagnements. \nDepuis un seul endroit.';
const homeSubtitle = subtitle || "Bilans, programmes, nutrition, données de santé et suivi client réunis dans une plateforme pensée pour les professionnels de la santé et de la performance.";
const homeBadge = badge || "";
---

<section class="relative section-lg pt-32 md:pt-40 lg:pt-48 overflow-hidden" aria-labelledby="hero-title">
  <div class="absolute inset-0 bg-gradient-to-b from-papier via-papier to-blanc" aria-hidden="true"></div>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[500px] bg-gradient-radial from-bleu-clair/50 via-transparent to-transparent" aria-hidden="true"></div>

  <div class="container relative">
    <div class="max-w-3xl mx-auto text-center">
      {badge && (
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-bleu-clair text-bleu-lecture text-sm font-medium mb-8 animate-fade-in" role="status">
          <span class="w-2 h-2 rounded-full bg-bleu-signature animate-pulse" aria-hidden="true"></span>
          {badge}
        </span>
      )}

      <h1 id="hero-title" class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-encre tracking-tight leading-[1.1] mb-6 animate-slide-up">
        {homeTitle.split(/\n|\\n/).map((line, i) => (
          <span key={i} class="block">{line}</span>
        ))}
      </h1>

      <p class="text-lg md:text-xl text-encre/70 leading-relaxed mb-10 max-w-2xl mx-auto animate-slide-up delay-200">
        {homeSubtitle}
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-5 animate-slide-up delay-300">
        <a href={primaryCTA.href} class="btn btn-demo w-full sm:w-auto group text-lg px-10 py-5" data-track="hero_cta_demo">
          Rejoindre Optibilan
          <Icon name="arrowRight" class="w-6 h-6 transition-transform group-hover:translate-x-1" />
        </a>
        <a href="/contact" class="btn btn-secondary text-lg px-8 py-4" data-track="hero_cta_trial">
          Essayer Optibilan
          <Icon name="sparkles" class="w-5 h-5 ml-2 transition-transform group-hover:translate-x-1" />
        </a>
      </div>

      {variant === 'home' && (
        <div class="mt-16 relative animate-scale-in delay-500 hidden lg:block" aria-hidden="true">
          <div class="aspect-[16/10] max-w-5xl mx-auto rounded-card-lg bg-encre/5 border border-encre/10 shadow-elevated overflow-hidden relative">
            <div class="absolute inset-0 bg-gradient-to-br from-bleu-signature/5 via-transparent to-indigo/5" aria-hidden="true"></div>
            <div class="relative z-10 flex items-center justify-center h-full p-4">
              <div class="text-center max-w-md">
                <div class="aspect-video bg-encre/10 rounded-lg mb-4 border border-encre/10 flex items-center justify-center relative overflow-hidden">
                  <div class="absolute inset-0 grid grid-cols-12 gap-2 p-4 opacity-10" aria-hidden="true">
                    {[...Array(24)].map((_, i) => (
                      <div key={i} class="col-span-1 h-4 bg-bleu-signature/20 rounded animate-pulse" style={{animationDelay: `${i * 50}ms`}} />
                    ))}
                  </div>
                  <Icon name="chart" class="w-16 h-16 text-bleu-signature/30 relative z-10" />
                </div>
                <p class="text-encre/40 text-sm font-medium">Dashboard Optibilan - Bilans, programmes, nutrition, santé, suivi client</p>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  </div>
</section>