---
import Icon from './Icon.astro';

interface Props {
  title?: string;
  subtitle?: string;
  badge?: string;
  stats?: Array<{ value: string; label: string }>;
}

const {
  title = "Le SaaS de suivi coaching pour cabinets, studios et coachs indépendants",
  subtitle = "Bilans, nutrition, sport, prépa mentale, santé connectée. Multi-tenant natif, marque blanche totale, API, webhooks, hébergement EU. Lancez votre espace en 5 minutes.",
  badge = "Nouveau : Assistant IA + Sync Apple Health",
  stats = [
    { value: "150+", label: "Cabinets équipés" },
    { value: "2 500+", label: "Coachs actifs" },
    { value: "50 000+", label: "Clients suivis" },
    { value: "99,9%", label: "Disponibilité" },
  ],
} = Astro.props;
---

<section class="relative section-lg pt-32 md:pt-40 lg:pt-48 overflow-hidden" aria-labelledby="hero-title">
  <div class="absolute inset-0 bg-gradient-to-b from-papier via-papier to-blanc" aria-hidden="true"></div>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[500px] bg-gradient-radial from-bleu-clair/50 via-transparent to-transparent" aria-hidden="true"></div>

  <div class="container relative">
    <div class="max-w-3xl mx-auto text-center">
      {badge && (
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-bleu-clair text-bleu-lecture text-sm font-medium mb-8 animate-fade-in" role="status">
          <span class="w-2 h-2 rounded-full bg-bleu-signature animate-pulse" aria-hidden="true"></span>
          {badge}
        </span>
      )}

      <h1 id="hero-title" class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-encre tracking-tight leading-[1.1] mb-6 animate-slide-up">
        {title.split('\n').map((line, i) => (
          <span key={i} class="block">{line}</span>
        ))}
      </h1>

      <p class="text-lg md:text-xl text-encre/70 leading-relaxed mb-10 max-w-2xl mx-auto animate-slide-up delay-200">
        {subtitle}
      </p>

      <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12 mb-10 animate-slide-up delay-300" role="list" aria-label="Statistiques de confiance">
        {stats.map((stat, i) => (
          <div key={i} class="flex flex-col items-center" role="listitem">
            <div class="font-display text-3xl md:text-4xl font-bold text-bleu-signature">{stat.value}</div>
            <div class="text-sm text-encre/60 font-medium">{stat.label}</div>
          </div>
        ))}
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-slide-up delay-300">
        <a href="https://app.optibilan.com/inscription" class="btn-primary w-full sm:w-auto group">
          Essai gratuit 30 jours
          <Icon name="arrowRight" class="w-5 h-5 transition-transform group-hover:translate-x-1" />
        </a>
        <a href="/fonctionnalites" class="btn-secondary w-full sm:w-auto">
          Voir les fonctionnalités
        </a>
      </div>

      <p class="mt-6 text-sm text-encre/50 animate-fade-in delay-400">
        Aucune carte bancaire requise · Annulation en 1 clic · Conforme RGPD · Hébergement EU
      </p>
    </div>

    <div class="mt-16 relative animate-scale-in delay-500 hidden lg:block" aria-hidden="true">
      <div class="aspect-[4/3] max-w-4xl mx-auto rounded-card-lg bg-gradient-to-br from-bleu-clair via-papier to-blanc border border-encre/10 shadow-elevated flex items-center justify-center">
        <div class="text-center p-8">
          <Icon name="chart" class="w-16 h-16 mx-auto mb-4 text-bleu-signature/50" />
          <p class="text-encre/40 text-sm">Dashboard Optibilan — Illustration à venir</p>
        </div>
      </div>
    </div>
  </div>
</section>