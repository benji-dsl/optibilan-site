---
import Icon from './Icon.astro';

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Ils utilisent Optibilan",
  subtitle = "Retours d'expérience de professionnels qui accompagnent au quotidien.",
} = Astro.props;
---

<section class="section bg-papier" aria-labelledby="testimonials-title">
  <div class="container">
    <header class="text-center max-w-3xl mx-auto mb-12">
      <h2 id="testimonials-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
        {title}
      </h2>
      <p class="text-lg text-encre/60">
        {subtitle}
      </p>
    </header>

    <div class="text-center">
      <p class="text-encre/50 mb-4">
        Nous recueillons les retours de nos utilisateurs. Cette section sera complétée avec de vrais témoignages vérifiés.
      </p>
    </div>
  </div>
</section>