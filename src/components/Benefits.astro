---
import Icon from './Icon.astro';

interface Props {
  title?: string;
  subtitle?: string;
  benefits?: Array<{
    icon: string;
    title: string;
    description: string;
    metric: string;
    proof?: string;
  }>;
}

const {
  title = "L'impact business, mesuré",
  subtitle = "Ce que change Optibilan pour votre cabinet : du temps récupéré, de la rétention, du chiffre d'affaires. Basé sur 4 000+ transformations documentées.",
  benefits = [
    {
      icon: "chart",
      title: "Temps administratif divisé par 4",
      description: "Bilans guidés, templates réutilisables, automatisations (rappels, listes de courses, emails) : vous passez de 45 min à 10 min par client pour l'admin. Soit ~10h/semaine récupérées sur 30 clients.",
      metric: "−75% temps admin",
      proof: "~10h/semaine récupérées • 30 clients",
    },
    {
      icon: "users",
      title: "Rétention clients +40% à 6 mois",
      description: "Suivi structuré, gamification (XP, badges, habitudes), détection signaux faibles IA, rappels auto : vos clients restent engagés. La structure de l'outil a été forgée sur 4 000+ cas réels — elle fonctionne.",
      metric: "+40% rétention 6 mois",
      proof: "Basé sur 4 000+ transformations documentées",
    },
    {
      icon: "zap",
      title: "MRR multiplié sans équipe supplémentaire",
      description: "Un coach solo gère 50+ clients avec l'exigence du sur-mesure grâce à l'IA (plans, alertes, détection). Passez de 30 à 100+ clients sans embaucher. Levier direct sur votre revenu récurrent.",
      metric: "×2 à ×3 capacité coach",
      proof: "Solo : 30 → 80 clients • Studio : 150 → 300+",
    },
    {
      icon: "brain",
      title: "Décisions cliniques basées sur la data",
      description: "130+ biomarqueurs (sang, wearable, subjektif), graphiques tendances, corrélations, seuils de référence. Chaque ajustement nutrition/sport/mental part d'une mesure, pas d'un ressenti. Niveau exécutif/médical.",
      metric: "130+ biomarqueurs",
      proof: "Sang + Wearable + Subjectif unifiés",
    },
    {
      icon: "lock",
      title: "Conformité RGPD/HDS — charge mentale zéro",
      description: "Export RGPD 1-clic (37 modèles), audit trail double niveau, purge auto paramétrable, contrats/DPA intégrés, hébergement HDS France. La conformité est gérée nativement. Vous signez, on exécute.",
      metric: "Export RGPD 1-clic",
      proof: "HDS certifié • Zéro transfert hors UE",
    },
    {
      icon: "globe",
      title: "Marque blanche = valorisation de VOTRE cabinet",
      description: "Logo, couleurs, domaine, vocabulaire (coaché/patient/membre), assistant IA nommé, emails, mentions légales, CGV — 100% votre marque. Vos clients ne voient jamais Optibilan. Vous vendez VOTRE méthode à VOTRE prix.",
      metric: "100% votre identité",
      proof: "Domaine custom • Emails @votrecabinet.fr",
    },
  ],
} = Astro.props;
---

<section class="section bg-blanc" aria-labelledby="benefits-title">
  <div class="container">
    <header class="text-center max-w-3xl mx-auto mb-16">
      <h2 id="benefits-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
        {title}
      </h2>
      <p class="text-lg text-encre/60">
        {subtitle}
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {benefits.map((benefit, index) => (
        <article class="card-hover group relative p-6 md:p-8" style="animation-delay: {index * 100}ms">
          <div class="icon-wrapper mb-4" aria-hidden="true">
            <Icon name={benefit.icon as any} class="w-10 h-10" />
          </div>

          {benefit.metric && (
            <div class="absolute top-6 right-6 text-right opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <div class="font-display text-xl font-bold text-bleu-signature">{benefit.metric}</div>
            </div>
          )}

          <h3 class="font-display text-xl font-bold text-encre mb-3">
            {benefit.title}
          </h3>
          <p class="text-encre/60 leading-relaxed mb-4">
            {benefit.description}
          </p>

          {benefit.proof && (
            <p class="text-xs text-encre/40 font-medium flex items-center gap-1.5">
              <Icon name="check" class="w-3 h-3 text-emerald-500" />
              <span>{benefit.proof}</span>
            </p>
          )}
        </article>
      ))}
    </div>
  </div>
</section>