---
import Icon from './Icon.astro';

interface Props {
  title?: string;
  subtitle?: string;
  benefits?: Array<{
    icon: string;
    title: string;
    description: string;
  }>;
}

const {
  title = "Ce que change Optibilan pour votre cabinet",
  subtitle = "Moins d'admin, plus de suivi, une vision claire de chaque client.",
  benefits = [
    {
      icon: "chart",
      title: "Moins de temps sur l'admin",
      description: "Bilans guidés, templates réutilisables, rappels automatiques : vous passez moins de temps sur la paperasse et plus sur l'accompagnement.",
    },
    {
      icon: "users",
      title: "Clients plus engagés sur la durée",
      description: "Suivi structuré, habitudes, objectifs, rappels automatiques : vos clients restent accompagnés plus longtemps.",
    },
    {
      icon: "zap",
      title: "Plus de clients, même exigence",
      description: "L'IA prépare les plans, détecte les alertes, propose les ajustements. Vous gérez plus de clients sans perdre en qualité.",
    },
    {
      icon: "brain",
      title: "Une vue claire des données de chaque client",
      description: "Bilan, nutrition, sport, santé, biomarqueurs réunis en un endroit. Vous voyez les tendances, corrélations, alertes d'adhérence.",
    },
    {
      icon: "lock",
      title: "Des outils pour votre conformité",
      description: "Export RGPD, audit trail, purge auto, contrats intégrés. La conformité est facilitée, vous vous concentrez sur l'accompagnement.",
    },
    {
      icon: "globe",
      title: "Votre marque, votre méthode",
      description: "Logo, couleurs, domaine, vocabulaire, emails : vos clients ne voient que votre marque. Optibilan s'efface totalement.",
    },
  ],
} = Astro.props;
---

<section class="section bg-blanc" aria-labelledby="benefits-title">
  <div class="container">
    <header class="text-center max-w-3xl mx-auto mb-16">
      <h2 id="benefits-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
        {title}
      </h2>
      <p class="text-lg text-encre/60">
        {subtitle}
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {benefits.map((benefit, index) => (
        <article class="card-hover group relative p-6 md:p-8" style="animation-delay: {index * 100}ms">
          <div class="icon-wrapper mb-4" aria-hidden="true">
            <Icon name={benefit.icon as any} class="w-10 h-10" />
          </div>

          <h3 class="font-display text-xl font-bold text-encre mb-3">
            {benefit.title}
          </h3>
          <p class="text-encre/60 leading-relaxed">
            {benefit.description}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>