---
import Icon from './Icon.astro';

const produitLinks = {
  decouvrir: [
    { href: '/product/overview', label: 'Vue d\'ensemble', desc: 'Plateforme complète de pilotage' },
  ],
  accompagner: [
    { href: '/product/check-ins', label: 'Bilans & progression', desc: 'Suivi centralisé des accompagnements' },
    { href: '/product/nutrition', label: 'Nutrition', desc: 'Plans, habitudes, compléments, listes de courses' },
    { href: '/product/training', label: 'Sport & programmes', desc: 'Bibliothèque, séances, progression' },
    { href: '/product/mental', label: 'Préparation mentale', desc: 'Exercices, ressources, journal, adhérence' },
  ],
  suivre: [
    { href: '/product/health', label: 'Santé & biomarqueurs', desc: 'Biologie, wearables, VFC, sommeil, activité' },
    { href: '/product/engagement', label: 'Habitudes & engagement', desc: 'Objectifs, routines, rappels, progression' },
  ],
  dossier: [
    { href: '/product/crm', label: 'Dossier client', desc: 'Notes, documents, historique, pipeline' },
  ],
  automatiser: [
    { href: '/product/ai', label: 'IA & Automatisations', desc: 'Structuration, synthèses, propositions' },
    { href: '/product/integrations', label: 'Intégrations & API', desc: 'Santé, agenda, webhooks, OpenAPI, automatisation' },
  ],
  personnaliser: [
    { href: '/product/white-label', label: 'Marque blanche', desc: 'Logo, couleurs, domaine, emails, vocabulaire' },
  ],
};

const cabinetsLinks = [
  { href: '/product/crm', label: 'Équipes & permissions', desc: 'Rôles, spécialités, 2FA, administration' },
  { href: '/product/agenda', label: 'Agenda & appels', desc: 'Cadence, rappels, calendrier ICS partagé' },
  { href: '/product/admin', label: 'Administration', desc: 'Utilisateurs, modules, conformité, audit' },
];

const solutionsLinks = [
  { href: '/solutions/coaches', label: 'Coach sportif', desc: 'Programmes, bilans, progression, adhérence' },
  { href: '/solutions/nutrition', label: 'Nutritionniste / Diététicien', desc: 'Plans, habitudes, suivi, évolution, documents' },
  { href: '/solutions/mental', label: 'Préparateur mental', desc: 'Exercices, ressources, journal, adhérence, permissions' },
  { href: '/solutions/cabinets', label: 'Cabinet / Équipe', desc: 'Multi-praticiens, permissions, coordination, audit, marque blanche' },
];

const ressourcesLinks = [
  { href: '/help', label: 'Centre d\'aide', desc: 'Guides, FAQ, démarrage rapide' },
  { href: '/docs', label: 'API & Documentation', desc: 'OpenAPI, SDK, exemples, sandbox' },
  { href: '/contact', label: 'Contact & Support', desc: 'Démo, support, partenariats, presse' },
];

const ctaButtons = [
  { href: 'https://app.optibilan.com/login', icon: 'user', primary: false, ariaLabel: 'Connexion' },
  { href: 'https://calendly.com/optibilan/demo', icon: 'calendar', primary: true, ariaLabel: 'Réserver une démo' },
  { href: '/inscription', icon: 'sparkles', primary: false, ariaLabel: 'Essayer Optibilan' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-blanc/95 backdrop-blur-sm border-b border-encre/10 transition-all duration-300" data-header>
  <nav class="container" aria-label="Navigation principale">
    <div class="flex h-16 items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-2 shrink-0" aria-label="Optibilan - Accueil">
        <Icon name="logo" class="w-8 h-8 text-bleu-signature" />
        <span class="font-display font-bold text-xl text-encre">Optibilan</span>
      </a>

      <div class="hidden md:flex items-center gap-1">
        <!-- PRODUIT dropdown -->
        <div class="relative group" data-dropdown>
          <button class="flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-encre/60 hover:text-encre rounded-lg transition-colors" aria-haspopup="true" aria-expanded="false" aria-label="Menu Produit">
            Produit
            <Icon name="chevronDown" class="w-4 h-4 transition-transform group-open:rotate-180" />
          </button>
          <div class="absolute left-0 top-full mt-2 w-[600px] opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200 bg-blanc rounded-xl border border-encre/10 shadow-elevated p-4 z-50" role="menu">
            <div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
              <div class="lg:col-span-2">
                <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs">Découvrir Optibilan</div>
                {produitLinks.decouvoir.map(link => (
                  <a href={link.href} class="p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                    <span class="block font-medium text-encre">{link.label}</span>
                    <span class="block text-xs text-encre/50 mt-0.5">{link.desc}</span>
                  </a>
                ))}
              </div>
              <div>
                <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs">Accompagner</div>
                {produitLinks.accompagner.map(link => (
                  <a href={link.href} class="p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                    <span class="block font-medium text-encre">{link.label}</span>
                    <span class="block text-xs text-encre/50 mt-0.5">{link.desc}</span>
                  </a>
                ))}
              </div>
              <div>
                <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs">Suivre</div>
                {produitLinks.suivre.map(link => (
                  <a href={link.href} class="p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                    <span class="block font-medium text-encre">{link.label}</span>
                    <span class="block text-xs text-encre/50 mt-0.5">{link.desc}</span>
                  </a>
                ))}
              </div>
              <div class="lg:col-span-3">
                <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs">Dossier client</div>
                {produitLinks.dossier.map(link => (
                  <a href={link.href} class="p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                    <span class="block font-medium text-encre">{link.label}</span>
                    <span class="block text-xs text-encre/50 mt-0.5">{link.desc}</span>
                  </a>
                ))}
              </div>
              <div>
                <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs">Automatiser</div>
                {produitLinks.automatiser.map(link => (
                  <a href={link.href} class="p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                    <span class="block font-medium text-encre">{link.label}</span>
                    <span class="block text-xs text-encre/50 mt-0.5">{link.desc}</span>
                  </a>
                ))}
              </div>
              <div>
                <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs">Personnaliser</div>
                {produitLinks.personnaliser.map(link => (
                  <a href={link.href} class="p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                    <span class="block font-medium text-encre">{link.label}</span>
                    <span class="block text-xs text-encre/50 mt-0.5">{link.desc}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- SOLUTIONS dropdown -->
        <div class="relative group" data-dropdown>
          <button class="flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-encre/60 hover:text-encre rounded-lg transition-colors" aria-haspopup="true" aria-expanded="false" aria-label="Menu Solutions">
            Solutions
            <Icon name="chevronDown" class="w-4 h-4 transition-transform group-open:rotate-180" />
          </button>
          <div class="absolute left-0 top-full mt-2 w-[400px] opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200 bg-blanc rounded-xl border border-encre/10 shadow-elevated p-3 z-50" role="menu">
            <div class="grid grid-cols-1 gap-1">
              {solutionsLinks.map(link => (
                <a href={link.href} class="p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                  <span class="block font-medium text-encre">{link.label}</span>
                  <span class="block text-xs text-encre/50 mt-0.5">{link.desc}</span>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- SÉCURITÉ -->
        <a href="/security" class="px-3 py-2 text-sm font-medium text-encre/60 hover:text-encre rounded-lg transition-colors" aria-label="Sécurité et conformité">
          Sécurité
        </a>

        <!-- RESSOURCES dropdown -->
        <div class="relative group" data-dropdown>
          <button class="flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-encre/60 hover:text-encre rounded-lg transition-colors" aria-haspopup="true" aria-expanded="false" aria-label="Menu Ressources">
            Ressources
            <Icon name="chevronDown" class="w-4 h-4 transition-transform group-open:rotate-180" />
          </button>
          <div class="absolute left-0 top-full mt-2 w-[360px] opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200 bg-blanc rounded-xl border border-encre/10 shadow-elevated p-3 z-50" role="menu">
            <div class="grid grid-cols-1 gap-1">
              {ressourcesLinks.map(link => (
                <a href={link.href} class="p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                  <span class="block font-medium text-encre">{link.label}</span>
                  <span class="block text-xs text-encre/50 mt-0.5">{link.desc}</span>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- POUR LES CABINETS -->
        <div class="relative group" data-dropdown>
          <button class="flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-encre/60 hover:text-encre rounded-lg transition-colors" aria-haspopup="true" aria-expanded="false" aria-label="Menu Cabinets">
            Pour les cabinets
            <Icon name="chevronDown" class="w-4 h-4 transition-transform group-open:rotate-180" />
          </button>
          <div class="absolute left-0 top-full mt-2 w-[360px] opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200 bg-blanc rounded-xl border border-encre/10 shadow-elevated p-3 z-50" role="menu">
            <div class="grid grid-cols-1 gap-1">
              {cabinetsLinks.map(link => (
                <a href={link.href} class="p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                  <span class="block font-medium text-encre">{link.label}</span>
                  <span class="block text-xs text-encre/50 mt-0.5">{link.desc}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="hidden md:flex items-center gap-2">
        {ctaButtons.map((btn, index) => (
          <a
            href={btn.href}
            class={`btn-header-${btn.primary ? 'primary' : 'secondary'} ${btn.primary && index === 1 ? 'ml-2' : ''} ${!btn.primary ? 'p-2' : ''}`}
            data-track={`header_${btn.ariaLabel.toLowerCase().replace(/ /g, '_')}`}
            aria-label={btn.ariaLabel}
          >
            <Icon name={btn.icon} class="w-5 h-5" />
            {btn.primary && index === 1 && <span class="hidden md:inline">Réserver une démo</span>}
            {!btn.primary && index === 2 && <span class="hidden md:inline">Essayer Optibilan</span>}
          </a>
        ))}
      </div>

      <button class="md:hidden p-2 rounded-lg text-encre/60 hover:bg-encre/5" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <Icon name="menu" class="w-6 h-6" />
      </button>
    </div>

    <div class="md:hidden hidden py-4 border-t border-encre/10" id="mobile-menu" role="navigation" aria-label="Menu mobile">
      <div class="flex flex-col gap-2">
        <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs">Produit</div>
        <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs">Découvrir Optibilan</div>
        {produitLinks.decouvoir.map(link => (
          <a href={link.href} class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors" data-mobile-link>
            {link.label}
          </a>
        ))}
        <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs border-t border-encre/10 mt-2">Accompagner</div>
        {produitLinks.accompagner.map(link => (
          <a href={link.href} class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors" data-mobile-link>
            {link.label}
          </a>
        ))}
        <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs border-t border-encre/10 mt-2">Suivre</div>
        {produitLinks.suivre.map(link => (
          <a href={link.href} class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors" data-mobile-link>
            {link.label}
          </a>
        ))}
        <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs border-t border-encre/10 mt-2">Dossier client</div>
        {produitLinks.dossier.map(link => (
          <a href={link.href} class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors" data-mobile-link>
            {link.label}
          </a>
        ))}
        <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs border-t border-encre/10 mt-2">Automatiser</div>
        {produitLinks.automatiser.map(link => (
          <a href={link.href} class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors" data-mobile-link>
            {link.label}
          </a>
        ))}
        <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs border-t border-encre/10 mt-2">Personnaliser</div>
        {produitLinks.personnaliser.map(link => (
          <a href={link.href} class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors" data-mobile-link>
            {link.label}
          </a>
        ))}

        <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs border-t border-encre/10 mt-2">Solutions</div>
        {solutionsLinks.map(link => (
          <a href={link.href} class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors" data-mobile-link>
            {link.label}
          </a>
        ))}

        <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs border-t border-encre/10 mt-2">Pour les cabinets</div>
        {cabinetsLinks.map(link => (
          <a href={link.href} class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors" data-mobile-link>
            {link.label}
          </a>
        ))}

        <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs border-t border-encre/10 mt-2">Ressources</div>
        {ressourcesLinks.map(link => (
          <a href={link.href} class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors" data-mobile-link>
            {link.label}
          </a>
        ))}

        <div class="flex flex-col gap-2 pt-2 border-t border-encre/10">
          <a href="https://calendly.com/optibilan/demo" class="btn-header-primary text-center flex items-center justify-center gap-2" data-track="mobile_demo">
            <Icon name="calendar" class="w-5 h-5" />
            Réserver une démo
          </a>
          <a href="https://app.optibilan.com/login" class="btn-header-secondary text-center flex items-center justify-center gap-2">
            <Icon name="user" class="w-5 h-5" />
            Connexion
          </a>
          <a href="/inscription" class="btn-header-secondary text-center flex items-center justify-center gap-2">
            <Icon name="sparkles" class="w-5 h-5" />
            Essai offert
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  const header = document.querySelector('[data-header]');
  const toggle = document.querySelector('[data-menu-toggle]');
  const mobileMenu = document.querySelector('#mobile-menu');
  const mobileLinks = document.querySelectorAll('[data-mobile-link]');

  let lastScroll = 0;
  window.addEventListener('scroll', () => {
    const currentScroll = window.pageYOffset;
    if (currentScroll > 100) {
      header?.classList.add('shadow-soft');
      header?.classList.add('bg-blanc/98');
    } else {
      header?.classList.remove('shadow-soft');
      header?.classList.remove('bg-blanc/98');
    }
    lastScroll = currentScroll;
  });

  toggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.innerHTML = isOpen
      ? `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>`
      : `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>`;
  });

  mobileLinks?.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle.innerHTML = '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>';
    });
  });

  // Close dropdowns on escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('[data-dropdown]').forEach(d => d.blur());
    }
  });
</script>

<style is:global>
  [data-header].shadow-soft {
    box-shadow: 0 2px 15px -3px rgba(0, 0, 0, 0.07), 0 10px 20px -2px rgba(0, 0, 0, 0.04);
  }
</style>