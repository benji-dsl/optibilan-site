---
import Icon from './Icon.astro';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-blanc/95 backdrop-blur-sm border-b border-encre/10 transition-all duration-300" data-header>
  <nav class="container" aria-label="Navigation principale">
    <div class="flex h-16 items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-2 shrink-0" aria-label="Optibilan - Accueil">
        <Icon name="logo" class="w-8 h-8 text-bleu-signature" />
        <span class="font-display font-bold text-xl text-encre">Optibilan</span>
      </a>

      <div class="hidden md:flex items-center gap-1">
        <!-- PRODUIT dropdown -->
        <div class="relative group" data-dropdown>
          <button class="flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-encre/60 hover:text-encre rounded-lg transition-colors" aria-haspopup="true" aria-expanded="false" aria-label="Menu Produit">
            Produit
            <Icon name="chevronDown" class="w-4 h-4 transition-transform group-open:rotate-180" />
          </button>
          <div class="absolute left-0 top-full mt-2 w-[600px] opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200 bg-blanc rounded-xl border border-encre/10 shadow-elevated p-4 z-50" role="menu">
            <div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
              <div class="lg:col-span-2">
                <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs">Découvrir Optibilan</div>
                <a href="/product/overview" class="p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                  <span class="block font-medium text-encre">Vue d'ensemble</span>
                  <span class="block text-xs text-encre/50 mt-0.5">Plateforme complète de pilotage</span>
                </a>
              </div>
              <div>
                <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs">Accompagner</div>
                <a href="/product/check-ins" class="p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                  <span class="block font-medium text-encre">Bilans & progression</span>
                  <span class="block text-xs text-encre/50 mt-0.5">Suivi centralisé des accompagnements</span>
                </a>
                <a href="/product/nutrition" class="p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                  <span class="block font-medium text-encre">Nutrition</span>
                  <span class="block text-xs text-encre/50 mt-0.5">Plans, habitudes, compléments, listes de courses</span>
                </a>
                <a href="/product/training" class="p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                  <span class="block font-medium text-encre">Sport & programmes</span>
                  <span class="block text-xs text-encre/50 mt-0.5">Bibliothèque, séances, progression</span>
                </a>
                <a href="/product/mental" class="p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                  <span class="block font-medium text-encre">Préparation mentale</span>
                  <span class="block text-xs text-encre/50 mt-0.5">Exercices, ressources, journal, adhérence</span>
                </a>
              </div>
              <div>
                <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs">Suivre</div>
                <a href="/product/health" class="p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                  <span class="block font-medium text-encre">Santé & biomarqueurs</span>
                  <span class="block text-xs text-encre/50 mt-0.5">Biologie, wearables, tendances</span>
                </a>
                <a href="/product/engagement" class="p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                  <span class="block font-medium text-encre">Habitudes & engagement</span>
                  <span class="block text-xs text-encre/50 mt-0.5">Objectifs, routines, rappels, progression</span>
                </a>
              </div>
              <div class="lg:col-span-3">
                <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs">Dossier client</div>
                <a href="/product/crm" class="p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                  <span class="block font-medium text-encre">Journal & CRM</span>
                  <span class="block text-xs text-encre/50 mt-0.5">Entrées typées, pipeline, relances</span>
                </a>
              </div>
              <div>
                <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs">Automatiser</div>
                <a href="/product/ai" class="p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                  <span class="block font-medium text-encre">IA & Automatisations</span>
                  <span class="block text-xs text-encre/50 mt-0.5">Structuration, synthèses, alertes</span>
                </a>
                <a href="/product/integrations" class="p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                  <span class="block font-medium text-encre">Intégrations & API</span>
                  <span class="block text-xs text-encre/50 mt-0.5">Santé, agenda, webhooks, OpenAPI</span>
                </a>
              </div>
              <div>
                <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs">Personnaliser</div>
                <a href="/product/white-label" class="p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                  <span class="block font-medium text-encre">Marque blanche</span>
                  <span class="block text-xs text-encre/50 mt-0.5">Logo, couleurs, domaine, emails</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- SOLUTIONS dropdown -->
        <div class="relative group" data-dropdown>
          <button class="flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-encre/60 hover:text-encre rounded-lg transition-colors" aria-haspopup="true" aria-expanded="false" aria-label="Menu Solutions">
            Solutions
            <Icon name="chevronDown" class="w-4 h-4 transition-transform group-open:rotate-180" />
          </button>
          <div class="absolute left-0 top-full mt-2 w-[400px] opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200 bg-blanc rounded-xl border border-encre/10 shadow-elevated p-3 z-50" role="menu">
            <div class="grid grid-cols-1 gap-1">
              <a href="/solutions/coaches" class="p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                <span class="block font-medium text-encre">Coach sportif</span>
                <span class="block text-xs text-encre/50 mt-0.5">Programmes, bilans, progression, adhérence</span>
              </a>
              <a href="/solutions/nutrition" class="p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                <span class="block font-medium text-encre">Nutritionniste / Diététicien</span>
                <span class="block text-xs text-encre/50 mt-0.5">Plans, habitudes, suivi, évolution, documents</span>
              </a>
              <a href="/solutions/mental" class="p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                <span class="block font-medium text-encre">Préparateur mental</span>
                <span class="block text-xs text-encre/50 mt-0.5">Exercices, ressources, journal, adhérence, permissions</span>
              </a>
              <a href="/solutions/cabinets" class="p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                <span class="block font-medium text-encre">Cabinet / Équipe</span>
                <span class="block text-xs text-encre/50 mt-0.5">Multi-praticiens, permissions, coordination, audit, marque blanche</span>
              </a>
            </div>
          </div>
        </div>

        <!-- SÉCURITÉ -->
        <a href="/security" class="px-3 py-2 text-sm font-medium text-encre/60 hover:text-encre rounded-lg transition-colors" aria-label="Sécurité et conformité">
          Sécurité
        </a>

        <!-- RESSOURCES dropdown -->
        <div class="relative group" data-dropdown>
          <button class="flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-encre/60 hover:text-encre rounded-lg transition-colors" aria-haspopup="true" aria-expanded="false" aria-label="Menu Ressources">
            Ressources
            <Icon name="chevronDown" class="w-4 h-4 transition-transform group-open:rotate-180" />
          </button>
          <div class="absolute left-0 top-full mt-2 w-[360px] opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200 bg-blanc rounded-xl border border-encre/10 shadow-elevated p-3 z-50" role="menu">
            <div class="grid grid-cols-1 gap-1">
              <a href="/help" class="p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                <span class="block font-medium text-encre">Centre d'aide</span>
                <span class="block text-xs text-encre/50 mt-0.5">Guides, FAQ, démarrage rapide</span>
              </a>
              <a href="/docs" class="p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                <span class="block font-medium text-encre">API & Documentation</span>
                <span class="block text-xs text-encre/50 mt-0.5">OpenAPI, SDK, exemples, sandbox</span>
              </a>
              <a href="/contact" class="p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                <span class="block font-medium text-encre">Contact & Support</span>
                <span class="block text-xs text-encre/50 mt-0.5">Démo, support, partenariats, presse</span>
              </a>
            </div>
          </div>
        </div>

        <!-- POUR LES CABINETS -->
        <div class="relative group" data-dropdown>
          <button class="flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-encre/60 hover:text-encre rounded-lg transition-colors" aria-haspopup="true" aria-expanded="false" aria-label="Menu Cabinets">
            Pour les cabinets
            <Icon name="chevronDown" class="w-4 h-4 transition-transform group-open:rotate-180" />
          </button>
          <div class="absolute left-0 top-full mt-2 w-[360px] opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200 bg-blanc rounded-xl border border-encre/10 shadow-elevated p-3 z-50" role="menu">
            <div class="grid grid-cols-1 gap-1">
              <a href="/product/crm" class="p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                <span class="block font-medium text-encre">Équipes & permissions</span>
                <span class="block text-xs text-encre/50 mt-0.5">Rôles, spécialités, 2FA, administration</span>
              </a>
              <a href="/product/agenda" class="p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                <span class="block font-medium text-encre">Agenda & appels</span>
                <span class="block text-xs text-encre/50 mt-0.5">Cadence, rappels, calendrier ICS partagé</span>
              </a>
              <a href="/product/admin" class="p-3 rounded-lg hover:bg-papier transition-colors" role="menuitem">
                <span class="block font-medium text-encre">Administration</span>
                <span class="block text-xs text-encre/50 mt-0.5">Utilisateurs, modules, conformité, audit</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="hidden md:flex items-center gap-2">
        <a href="https://app.optibilan.com/login" class="btn-header-secondary p-2" aria-label="Connexion">
          <Icon name="user" class="w-5 h-5" />
        </a>
        <a href="https://calendly.com/optibilan/demo" class="btn-header-primary" aria-label="Rejoindre Optibilan">
          <Icon name="arrowRight" class="w-5 h-5" />
          <span class="hidden sm:inline">Rejoindre</span>
        </a>
        <a href="/inscription" class="btn-header-primary ml-2" aria-label="Essayer Optibilan">
          <Icon name="sparkles" class="w-5 h-5" />
          <span class="hidden md:inline">Essai offert</span>
        </a>
      </div>

      <button class="md:hidden p-2 rounded-lg text-encre/60 hover:bg-encre/5" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <Icon name="menu" class="w-6 h-6" />
      </button>
    </div>

    <div class="md:hidden hidden py-4 border-t border-encre/10" id="mobile-menu" role="navigation" aria-label="Menu mobile">
      <div class="flex flex-col gap-2">
        <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs">Produit</div>
        <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs">Découvrir Optibilan</div>
        <a href="/product/overview" class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors">Vue d'ensemble</a>
        <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs border-t border-encre/10 mt-2">Accompagner</div>
        <a href="/product/check-ins" class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors">Bilans & progression</a>
        <a href="/product/nutrition" class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors">Nutrition</a>
        <a href="/product/training" class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors">Sport & programmes</a>
        <a href="/product/mental" class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors">Préparation mentale</a>
        <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs border-t border-encre/10 mt-2">Suivre</div>
        <a href="/product/health" class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors">Santé & biomarqueurs</a>
        <a href="/product/engagement" class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors">Habitudes & engagement</a>
        <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs border-t border-encre/10 mt-2">Dossier client</div>
        <a href="/product/crm" class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors">Journal & CRM</a>
        <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs border-t border-encre/10 mt-2">Automatiser</div>
        <a href="/product/ai" class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors">IA & Automatisations</a>
        <a href="/product/integrations" class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors">Intégrations & API</a>
        <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs border-t border-encre/10 mt-2">Personnaliser</div>
        <a href="/product/white-label" class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors">Marque blanche</a>

        <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs border-t border-encre/10 mt-2">Solutions</div>
        <a href="/solutions/coaches" class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors">Coach sportif</a>
        <a href="/solutions/nutrition" class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors">Nutritionniste / Diététicien</a>
        <a href="/solutions/mental" class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors">Préparateur mental</a>
        <a href="/solutions/cabinets" class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors">Cabinet / Équipe</a>

        <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs border-t border-encre/10 mt-2">Sécurité</div>
        <a href="/security" class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors">Sécurité & conformité</a>

        <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs border-t border-encre/10 mt-2">Ressources</div>
        <a href="/help" class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors">Centre d'aide</a>
        <a href="/docs" class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors">API & Documentation</a>
        <a href="/contact" class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors">Contact & Support</a>

        <div class="px-2 py-1 font-semibold text-encre/50 uppercase tracking-wider text-xs border-t border-encre/10 mt-2">Pour les cabinets</div>
        <a href="/product/crm" class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors">Équipes & permissions</a>
        <a href="/product/agenda" class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors">Agenda & appels</a>
        <a href="/product/admin" class="px-4 py-2 text-base font-medium text-encre/60 hover:text-encre hover:bg-papier rounded-lg transition-colors">Administration</a>

        <div class="flex flex-col gap-2 pt-2 border-t border-encre/10">
          <a href="https://calendly.com/optibilan/demo" class="btn-header-primary text-center flex items-center justify-center gap-2">
            <Icon name="arrowRight" class="w-5 h-5" />
            Rejoindre
          </a>
          <a href="https://app.optibilan.com/login" class="btn-header-secondary text-center flex items-center justify-center gap-2">
            <Icon name="user" class="w-5 h-5" />
            Connexion
          </a>
          <a href="/inscription" class="btn-header-secondary text-center flex items-center justify-center gap-2">
            <Icon name="sparkles" class="w-5 h-5" />
            Essai offert
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  const header = document.querySelector('[data-header]');
  const toggle = document.querySelector('[data-menu-toggle]');
  const mobileMenu = document.querySelector('#mobile-menu');
  const mobileLinks = document.querySelectorAll('[data-mobile-link]');

  let lastScroll = 0;
  window.addEventListener('scroll', () => {
    const currentScroll = window.pageYOffset;
    if (currentScroll > 100) {
      header?.classList.add('shadow-soft');
      header?.classList.add('bg-blanc/98');
    } else {
      header?.classList.remove('shadow-soft');
      header?.classList.remove('bg-blanc/98');
    }
    lastScroll = currentScroll;
  });

  toggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.innerHTML = isOpen
      ? `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>`
      : `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>`;
  });

  mobileLinks?.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle.innerHTML = '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>';
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('[data-dropdown]').forEach(d => d.blur());
    }
  });
</script>

<style is:global>
  [data-header].shadow-soft {
    box-shadow: 0 2px 15px -3px rgba(0, 0, 0, 0.07), 0 10px 20px -2px rgba(0, 0, 0, 0.04);
  }
</style>