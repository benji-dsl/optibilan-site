---
import Layout from '../../layouts/Layout.astro';
import { getPlanDetails } from '../../lib/plans';
import { COUNTRIES, EU_CODES, EU_VAT_RATES } from '../../lib/countries';

export async function getStaticPaths() {
  return ['SOLO', 'STUDIO', 'CABINET'].map(plan => ({
    params: { plan: plan.toLowerCase() },
  }));
}

const { plan } = Astro.params;
const validPlans = ['SOLO', 'STUDIO', 'CABINET'] as const;
type Plan = (typeof validPlans)[number];

const selectedPlan = validPlans.includes(plan?.toUpperCase() as Plan)
  ? (plan?.toUpperCase() as Plan)
  : null;
const planDetails = selectedPlan ? getPlanDetails(selectedPlan) : null;
const savingsYearly = planDetails ? planDetails.priceMonthly * 12 - planDetails.priceYearly : 0;

const pageTitle = selectedPlan
  ? `Commencez avec Optibilan - Offre ${planDetails!.name}`
  : 'Commencez avec Optibilan';
const pageDescription = selectedPlan
  ? `Offre ${planDetails!.name} : 30 jours d'essai offerts. Votre carte est enregistrée aujourd'hui, première facturation à J+30.`
  : 'Optibilan - 30 jours d\'essai offerts, première facturation à J+30.';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://optibilan.com/' },
    { '@type': 'ListItem', position: 2, name: 'Tarifs', item: 'https://optibilan.com/pricing' },
    { '@type': 'ListItem', position: 3, name: 'Paiement', item: `https://optibilan.com/checkout/${plan}` },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={`/checkout/${plan}`}
  noIndex
  ogImage="/og-checkout.png"
  jsonLd={breadcrumbJsonLd}
>
  <header class="sticky top-0 z-50 border-b border-encre/10 bg-blanc">
    <div class="container relative flex h-16 items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-2" aria-label="Optibilan - Accueil">
        <img src="/optibilan-logo-horizontal.png" alt="Optibilan" width="220" height="88" class="h-9 w-auto" />
      </a>
      {selectedPlan && planDetails ? (
        <div class="absolute left-1/2 -translate-x-1/2 min-w-0 text-center">
          <p class="truncate font-display text-base font-bold text-encre md:text-lg">Finalisez votre inscription</p>
          <p class="truncate text-xs text-body-light md:text-sm">30 jours offerts avec Optibilan {planDetails.name}.</p>
        </div>
      ) : null}
    </div>
  </header>

  <main class="bg-blanc">
    {selectedPlan && planDetails ? (
      <section class="container py-10 md:py-14" aria-labelledby="checkout-title">
        <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-12">
          <!-- COLONNE GAUCHE : RÉCAPITULATIF -->
          <aside class="lg:sticky lg:top-8">
            <div class="rounded-2xl border border-encre/10 bg-papier p-6 md:p-8">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <h2 class="font-display text-2xl font-bold text-encre">Optibilan {planDetails.name}</h2>
                  <p class="mt-1 text-body-light">Pour les professionnels indépendants</p>
                </div>
              </div>

              <div class="mt-6">
                <h3 class="text-xs font-semibold uppercase tracking-wider text-muted-light">Inclus</h3>
                <ul class="mt-3 space-y-2.5 text-sm text-body-light">
                  {['Un suivi complet pour vos accompagnements', 'Tous les outils essentiels Optibilan', '1 000 messages IA / mois'].map(f => (
                    <li class="flex items-start gap-2.5" key={f}>
                      <svg class="mt-0.5 w-5 h-5 flex-shrink-0 text-vert-fonce" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                      </svg>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <section class="mt-6" aria-labelledby="choice-title">
                <h3 id="choice-title" class="text-xs font-semibold uppercase tracking-wider text-muted-light">Choix de l'abonnement</h3>
                <div class="mt-3 grid gap-3">
                  <label class="plan-option is-selected" data-billing="monthly">
                    <input type="radio" name="billing" value="monthly" class="sr-only" checked />
                    <div class="flex items-start justify-between gap-2">
                      <div>
                        <div class="font-semibold text-encre">Mensuel</div>
                        <div class="mt-1 text-sm font-medium text-encre"><span id="price-monthly" data-base-price={planDetails.priceMonthly} data-billing-display="HT">{planDetails.priceMonthly} € HT / mois</span></div>
                        <div class="mt-2 text-xs text-muted-light">Flexibilité maximale.</div>
                      </div>
                      <span class="plan-dot" aria-hidden="true"></span>
                    </div>
                  </label>
                  <label class="plan-option" data-billing="yearly">
                    <input type="radio" name="billing" value="yearly" class="sr-only" />
                    <div class="flex items-start justify-between gap-2">
                      <div>
                        <div class="flex items-center gap-2">
                          <span class="font-semibold text-encre">Annuel</span>
                          <span class="rounded-full bg-rose-bordeaux px-2 py-0.5 text-xs font-bold text-bordeaux">2 mois offerts</span>
                        </div>
                        <div class="mt-1 text-sm font-medium text-encre"><span id="price-yearly" data-base-price={planDetails.priceYearly} data-billing-display="HT">{planDetails.priceYearly} € HT / an</span></div>
                        <div class="mt-2 text-xs text-muted-light">Économisez {savingsYearly} € par an.</div>
                      </div>
                      <span class="plan-dot" aria-hidden="true"></span>
                    </div>
                  </label>
                </div>
              </section>
            </div>
          </aside>

          <!-- COLONNE DROITE : FORMULAIRE -->
          <div class="space-y-8">
            <form id="checkout-form" class="space-y-8" novalidate>
              <!-- Vos informations -->
              <section aria-labelledby="info-title">
                <h2 id="info-title" class="font-display text-xl font-bold text-encre">Vos informations</h2>
                <div class="mt-4 grid gap-4 sm:grid-cols-2">
                  <div>
                    <label for="firstName" class="mb-1.5 block text-sm font-medium text-encre">Prénom</label>
                    <input
                      type="text" id="firstName" name="firstName" required autocomplete="given-name"
                      class="checkout-input"
                    />
                  </div>
                  <div>
                    <label for="lastName" class="mb-1.5 block text-sm font-medium text-encre">Nom</label>
                    <input
                      type="text" id="lastName" name="lastName" required autocomplete="family-name"
                      class="checkout-input"
                    />
                  </div>
                </div>
                <div class="mt-4">
                  <label for="email" class="mb-1.5 block text-sm font-medium text-encre">Email professionnel</label>
                  <input
                    type="email" id="email" name="email" required autocomplete="email" placeholder="vous@votrecabinet.fr"
                    class="checkout-input"
                  />
                </div>
              </section>

              <!-- Facturation -->
              <section aria-labelledby="billing-title">
                <h2 id="billing-title" class="font-display text-xl font-bold text-encre">Facturation</h2>
                <div class="mt-4 grid gap-4 sm:grid-cols-2">
                  <div>
                    <label for="country" class="mb-1.5 block text-sm font-medium text-encre">Pays de facturation</label>
                    <select id="country" name="country" required class="checkout-input">
                      <option value="">Sélectionnez un pays</option>
                      {COUNTRIES.map((c) => (
                        <option value={c.code}>{c.name}</option>
                      ))}
                    </select>
                  </div>
                  <div>
                    <label for="vatNumber" class="mb-1.5 block text-sm font-medium text-encre">
                      N° de TVA intracommunautaire <span class="font-normal text-muted-light">(optionnel)</span>
                    </label>
                    <input
                      type="text" id="vatNumber" name="vatNumber" placeholder="FR12345678901"
                      autocomplete="off" class="checkout-input"
                    />
                  </div>
                </div>

                <div class="mt-4">
                  <label for="address" class="mb-1.5 block text-sm font-medium text-encre">Adresse</label>
                  <input
                    type="text" id="address" name="address" required autocomplete="street-address"
                    placeholder="12 rue de la Liberté" class="checkout-input"
                  />
                </div>

                <div class="mt-4 flex items-start gap-2.5 border-t border-encre/10 pt-4">
                  <input type="checkbox" id="acceptCgv" name="acceptCgv" class="mt-0.5 h-4 w-4 shrink-0 accent-bleu-signature" />
                  <label for="acceptCgv" class="text-sm">
                    <span class="text-muted-light">
                      J'accepte les{" "}
                      <a href="/legal/cgv" target="_blank" rel="noopener noreferrer" class="font-medium text-bleu-signature underline hover:text-bleu-fonce">
                        CGV
                      </a>{" "}
                      d'Optibilan.
                    </span>
                  </label>
                </div>

              </section>

              <!-- Carte bancaire -->
              <section aria-labelledby="card-title">
                <h2 id="card-title" class="font-display text-xl font-bold text-encre">Paiement</h2>
                <div id="card-element" class="checkout-card mt-4" aria-label="Carte bancaire"></div>
                <p id="card-error" class="mt-2 min-h-5 text-sm text-danger-600" role="alert"></p>
                <p class="mt-3 flex items-center gap-2 text-sm text-muted-light">
                  <svg class="w-5 h-5 text-vert-fonce" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 4.5V9H7V5.5a3 3 0 016 0z" clip-rule="evenodd"/>
                  </svg>
                  Paiement sécurisé par Stripe
                </p>
              </section>

              <!-- Récapitulatif final + CTA -->
              <section aria-labelledby="final-title">
                <h2 id="final-title" class="sr-only">Récapitulatif final</h2>
                <div class="rounded-xl border border-encre/10 bg-papier p-5">
                  <div class="flex items-center justify-between text-sm">
                    <span class="font-medium text-encre">Optibilan {planDetails.name}</span>
                    <span id="final-cadence" class="font-medium text-encre"></span>
                  </div>
                  <div class="mt-3 flex items-center justify-between text-sm">
                    <span class="text-muted-light">Aujourd'hui</span>
                    <span class="font-semibold text-encre">0 €</span>
                  </div>
                  <div class="mt-2 flex items-center justify-between text-sm">
                    <span class="text-muted-light">Total après l'essai</span>
                    <span id="cta-total" class="font-semibold text-encre"></span>
                  </div>
                  <p id="cta-date" class="mt-3 text-xs text-muted-light"></p>
                </div>

                <button
                  type="submit" id="submit-btn"
                  class="btn-primary mt-5 w-full py-4 px-6 text-lg font-semibold rounded-xl transition-all duration-200"
                >
                  Démarrer mes 30 jours offerts
                </button>
                <p id="cta-zero" class="mt-3 text-center text-sm font-semibold text-vert-fonce">Aujourd'hui : 0 €</p>
                <p class="mt-2 text-center text-xs text-muted-light">
                  Vous pourrez résilier depuis votre espace avant votre première facturation.
                </p>
              </section>
            </form>

            <!-- Réassurance -->
            <div class="grid gap-4 sm:grid-cols-3">
              <div class="rounded-xl border border-encre/10 p-4">
                <svg class="w-6 h-6 text-bleu-signature" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
                </svg>
                <h3 class="mt-2 text-sm font-semibold text-encre">30 jours offerts</h3>
                <p class="mt-1 text-xs text-muted-light">Découvrez Optibilan avant votre première facturation.</p>
              </div>
              <div class="rounded-xl border border-encre/10 p-4">
                <svg class="w-6 h-6 text-bleu-signature" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M9 14L4 9l5-5"/><path d="M4 9h10a6 6 0 016 6v1"/>
                </svg>
                <h3 class="mt-2 text-sm font-semibold text-encre">Annulation simple</h3>
                <p class="mt-1 text-xs text-muted-light">Gérez votre abonnement directement depuis votre espace.</p>
              </div>
              <div class="rounded-xl border border-encre/10 p-4">
                <svg class="w-6 h-6 text-bleu-signature" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 11.5l2 2 4-4"/>
                </svg>
                <h3 class="mt-2 text-sm font-semibold text-encre">Paiement sécurisé</h3>
                <p class="mt-1 text-xs text-muted-light">Paiement traité par Stripe.</p>
              </div>
            </div>

            <p class="text-center text-sm text-muted-light">
              En continuant, vous acceptez nos
              <a href="/legal/cgv" target="_blank" rel="noopener noreferrer" class="underline hover:text-bleu-signature">CGV</a>
              et notre
              <a href="/legal/confidentialite" target="_blank" rel="noopener noreferrer" class="underline hover:text-bleu-signature">Politique de confidentialité</a>.
            </p>
          </div>
        </div>
      </section>
    ) : (
      <section class="section bg-blanc" aria-labelledby="error-title">
        <div class="container mx-auto max-w-md text-center">
          <h1 id="error-title" class="font-display text-3xl font-bold text-encre mb-4">Offre invalide</h1>
          <p class="text-body-light mb-8">L'offre sélectionnée n'existe pas. Retournez sur la page des tarifs pour choisir une offre.</p>
          <a href="/pricing" class="btn-primary inline-flex">Retour aux tarifs</a>
        </div>
      </section>
    )}
  </main>

  <footer class="border-t border-encre/10 bg-blanc">
    <div class="container flex flex-col items-center justify-between gap-3 py-6 text-xs text-muted-light sm:flex-row">
      <span>© {new Date().getFullYear()} Optibilan</span>
      <span class="flex items-center gap-4">
        <a href="/legal/cgv" target="_blank" rel="noopener noreferrer" class="hover:text-bleu-signature">CGV</a>
        <a href="/legal/confidentialite" target="_blank" rel="noopener noreferrer" class="hover:text-bleu-signature">Confidentialité</a>
        <a href="/contact" class="hover:text-bleu-signature">Contact</a>
      </span>
    </div>
  </footer>
</Layout>

<script is:inline define:vars={{
  plan: (selectedPlan || '').toLowerCase(),
  priceMonthly: planDetails?.priceMonthly ?? 0,
  priceYearly: planDetails?.priceYearly ?? 0,
}}>
  const TRIAL_DAYS = 30;
  const $ = (id) => document.getElementById(id);

  const state = {
    billing: 'monthly',
    country: '',
    vatNumber: '',
    vatRates: {},
  };

  let stripe = null;
  let cardElement = null;
  let stripeReady = false;

  const twoDigits = (n) => Math.round(n * 100) / 100;
  const fmt = (n) =>
    new Intl.NumberFormat('fr-FR', { minimumFractionDigits: 0, maximumFractionDigits: 2 }).format(twoDigits(n));
  const eur = (n) => `${fmt(n)} €`;
  const basePrice = () => (state.billing === 'monthly' ? priceMonthly : priceYearly);
  const isVatExempt = () => /^[A-Za-z]{2}[0-9A-Za-z]{6,12}$/.test(state.vatNumber.trim());
  const vatRate = () => (isVatExempt() ? 0 : state.vatRates[state.country] || 0);
  const vatAmount = () => twoDigits(basePrice() * vatRate());
  const totalPrice = () => twoDigits(basePrice() + vatAmount());

  function trialEndDate() {
    const d = new Date();
    d.setDate(d.getDate() + TRIAL_DAYS);
    return new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
  }

  function renderRecap() {
    const yearly = state.billing === 'yearly';
    $('final-cadence').textContent = yearly ? 'Annuel · 2 mois offerts' : 'Mensuel';
    $('cta-total').textContent = `${eur(totalPrice())} TTC`;
    $('cta-date').textContent = `Première facturation le ${trialEndDate()}`;

    const unit = vatRate() > 0 ? 'TTC' : 'HT';
    const priceMonthly = $('price-monthly');
    const priceYearly = $('price-yearly');
    if (priceMonthly) {
      priceMonthly.textContent = `${eur(priceMonthly.dataset.basePrice * (1 + vatRate()))} ${unit} / mois`;
    }
    if (priceYearly) {
      priceYearly.textContent = `${eur(priceYearly.dataset.basePrice * (1 + vatRate()))} ${unit} / an`;
    }
  }

  function showError(message) {
    const el = $('card-error');
    el.textContent = message;
    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function loadStripe(version) {
    return new Promise((resolve, reject) => {
      if (window.Stripe) return resolve(window.Stripe);
      const tag = document.querySelector('script[data-stripe]');
      if (tag) {
        tag.addEventListener('load', () => resolve(window.Stripe));
        tag.addEventListener('error', () => reject(new Error('Chargement du paiement impossible.')));
        return;
      }
      const script = document.createElement('script');
      script.src = 'https://js.stripe.com/v3/';
      script.dataset.stripe = '1';
      script.onload = () => resolve(window.Stripe);
      script.onerror = () => reject(new Error('Chargement du paiement impossible.'));
      document.head.appendChild(script);
    });
  }

  async function initPayment() {
    try {
      const res = await fetch('/api/stripe-config', { cache: 'no-store' });
      if (!res.ok) throw new Error('Paiement indisponible.');
      const cfg = await res.json();
      state.vatRates = cfg.vatRates || {};
      if (!cfg.publishableKey) throw new Error('Paiement temporairement indisponible. Réessayez dans quelques instants.');
      const StripeApi = await loadStripe();
      stripe = StripeApi(cfg.publishableKey);
      cardElement = stripe.elements().create('card', {
        hidePostalCode: true,
        style: {
          base: {
            fontSize: '16px',
            color: '#23211C',
            fontFamily: "'Inter', system-ui, -apple-system, sans-serif",
            '::placeholder': { color: '#66706B' },
          },
          invalid: { color: '#DC2626' },
        },
      });
      cardElement.mount('#card-element');
      cardElement.on('change', (e) => {
        if (e.error) {
          $('card-error').textContent = e.error.message;
        } else {
          $('card-error').textContent = '';
        }
      });
      stripeReady = true;
    } catch (err) {
      showError(err.message || 'Paiement temporairement indisponible.');
      $('submit-btn').disabled = true;
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    initPayment();
    renderRecap();

    document.querySelectorAll('.plan-option').forEach((opt) => {
      opt.addEventListener('click', () => {
        const input = opt.querySelector('input');
        input.checked = true;
        state.billing = input.value;
        document.querySelectorAll('.plan-option').forEach((o) =>
          o.classList.toggle('is-selected', o === opt)
        );
        renderRecap();
      });
    });

    const country = $('country');
    country.addEventListener('change', () => {
      state.country = country.value;
      renderRecap();
    });

    const vatNumber = $('vatNumber');
    vatNumber.addEventListener('input', () => {
      state.vatNumber = vatNumber.value;
      renderRecap();
    });
  });

  $('checkout-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = $('submit-btn');

    const firstName = $('firstName').value.trim();
    const lastName = $('lastName').value.trim();
    const email = $('email').value.trim();
    const country = $('country').value;
    const vatNumber = $('vatNumber').value.trim();
    const address = $('address').value.trim();

    if (!firstName || !lastName) return showError('Veuillez remplir votre prénom et votre nom.');
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return showError('Veuillez entrer un email professionnel valide.');
    if (!country) return showError('Veuillez sélectionner votre pays de facturation.');
    if (!address) return showError('Veuillez renseigner votre adresse de facturation.');
    const cgv = $('acceptCgv');
    if (cgv && !cgv.checked) return showError('Veuillez accepter les CGV pour finaliser votre commande.');
    if (!stripeReady || !stripe || !cardElement) return showError('Le paiement est encore en cours de chargement.');

    const originalLabel = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Sécurisation…';
    showError('');

    const { paymentMethod, error } = await stripe.createPaymentMethod({
      type: 'card',
      card: cardElement,
      billing_details: { name: `${firstName} ${lastName}`, email },
    });

    if (error) {
      btn.disabled = false;
      btn.textContent = originalLabel;
      return showError(error.message);
    }

    try {
      const res = await fetch('/api/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          plan,
          billing: state.billing,
          email,
          firstName,
          lastName,
          country,
          vatNumber,
          address,
          paymentMethodId: paymentMethod.id,
        }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Le paiement a échoué. Votre carte n\'a pas été débitée.');
      window.location.href = data.url;
    } catch (err) {
      btn.disabled = false;
      btn.textContent = originalLabel;
      showError(err.message || 'Le paiement a échoué. Votre carte n\'a pas été débitée.');
    }
  });
</script>

<style is:global>
  .checkout-input {
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    background-color: var(--color-surface);
    border: 1px solid color-mix(in oklab, var(--color-encre-texte) 20%, transparent);
    color: var(--color-encre-texte);
    font-size: 1rem;
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }
  .checkout-input:focus {
    outline: none;
    border-color: var(--color-bleu-signature);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-bleu-signature) 20%, transparent);
  }
  .checkout-card {
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    background-color: var(--color-surface);
    border: 1px solid color-mix(in oklab, var(--color-encre-texte) 20%, transparent);
    min-height: 56px;
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }
  .checkout-card.StripeElement--focus {
    border-color: var(--color-bleu-signature);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-bleu-signature) 20%, transparent);
  }
  .checkout-card.StripeElement--invalid {
    border-color: var(--color-danger-500);
  }
  .plan-option {
