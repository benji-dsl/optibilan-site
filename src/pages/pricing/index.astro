---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import Pricing from '../../components/Pricing.astro';
import CTA from '../../components/CTA.astro';

const pageTitle = 'Tarifs - Optibilan';
const pageDescription = 'Tarification simple et transparente : Solo 49€/mois, Studio 99€/mois, Cabinet 199€/mois. 2 mois offerts en annuel. Essai gratuit 30 jours.';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://optibilan.com/' },
    { '@type': 'ListItem', position: 2, name: 'Tarifs', item: 'https://optibilan.com/tarifs' },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/tarifs"
  ogImage="/og-pricing.svg"
>
  <Header />

  <main>
    <Hero
      title="Tarification simple,
transparente, évolutive"
      variant="page"
      primaryCTA={{ href: '', label: '' }}
      secondaryCTA={{ href: '', label: '' }}
    />

    <Pricing />

    <CTA
      variant="primary"
      title="Choisissez l'offre qui vous correspond"
      subtitle="30 jours pour tester, zéro risque, annulation en 1 clic."
    />
  </main>

  <Footer />
</Layout>