---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';

const pageTitle = 'Contact - Optibilan';
const pageDescription = 'Une question sur Optibilan ? Écrivez-nous. L\'équipe répond sous 4h ouvrées.';

const contactJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Optibilan',
  description: 'Contactez l\'équipe Optibilan pour une démo, du support, des partenariats ou de la presse.',
  url: 'https://optibilan.com/contact',
  mainEntity: {
    '@type': 'Organization',
    name: 'Optibilan',
    url: 'https://optibilan.com',
    contactPoint: [
      {
        '@type': 'ContactPoint',
        telephone: '+33-1-XX-XX-XX-XX',
        contactType: 'customer service',
        availableLanguage: ['French', 'English'],
        areaServed: 'FR',
        hoursAvailable: {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
          opens: '09:00',
          closes: '18:00',
        },
      },
      {
        '@type': 'ContactPoint',
        contactType: 'technical support',
        email: 'support@optibilan.com',
        availableLanguage: ['French', 'English'],
      },
      {
        '@type': 'ContactPoint',
        contactType: 'business development',
        email: 'partners@optibilan.com',
        availableLanguage: ['French', 'English'],
      },
      {
        '@type': 'ContactPoint',
        contactType: 'press',
        email: 'press@optibilan.com',
        availableLanguage: ['French', 'English'],
      },
    ],
    sameAs: [
      'https://twitter.com/optibilan',
      'https://linkedin.com/company/optibilan',
      'https://github.com/optibilan',
      'https://youtube.com/@optibilan',
    ],
  },
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/contact"
  ogImage="/og-contact.png"
  jsonLd={contactJsonLd}
>
  <Header />

  <main>
    <Hero
      variant="page"
      title="Une question ? 
Parlons-en."
      subtitle="Écrivez-nous : l'équipe Optibilan vous répond sous 4h ouvrées."
    />

    <section class="section bg-blanc" aria-labelledby="contact-title">
      <div class="container max-w-4xl">
        <header class="text-center mb-12">
          <h2 id="contact-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
            Envoyez-nous un message
          </h2>
          <p class="text-lg text-encre/60 max-w-2xl mx-auto">
            Démo, question technique, tarifs, partenariat ou presse : dites-nous tout.
          </p>
        </header>

        <div class="bg-gradient-to-br from-bleu-signature/5 via-papier to-bleu-lecture/5 rounded-card-lg p-8 md:p-12">
          <form id="contact-form" action="/api/contact" method="POST" class="space-y-4 max-w-2xl mx-auto" data-track="contact_form">
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="firstName" class="block text-sm font-medium text-encre mb-1">Prénom *</label>
                <input type="text" id="firstName" name="firstName" required autocomplete="given-name" class="w-full px-4 py-3 rounded-lg bg-blanc border border-encre/20 focus:outline-none focus:border-bleu-signature focus:ring-2 focus:ring-bleu-signature/20 transition-all" />
              </div>
              <div>
                <label for="lastName" class="block text-sm font-medium text-encre mb-1">Nom *</label>
                <input type="text" id="lastName" name="lastName" required autocomplete="family-name" class="w-full px-4 py-3 rounded-lg bg-blanc border border-encre/20 focus:outline-none focus:border-bleu-signature focus:ring-2 focus:ring-bleu-signature/20 transition-all" />
              </div>
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-encre mb-1">Email professionnel *</label>
              <input type="email" id="email" name="email" required autocomplete="email" placeholder="vous@votrecabinet.fr" class="w-full px-4 py-3 rounded-lg bg-blanc border border-encre/20 focus:outline-none focus:border-bleu-signature focus:ring-2 focus:ring-bleu-signature/20 transition-all" />
            </div>
            <div>
              <label for="cabinet" class="block text-sm font-medium text-encre mb-1">Nom du cabinet</label>
              <input type="text" id="cabinet" name="cabinet" placeholder="Cabinet Vitalité Plus" class="w-full px-4 py-3 rounded-lg bg-blanc border border-encre/20 focus:outline-none focus:border-bleu-signature focus:ring-2 focus:ring-bleu-signature/20 transition-all" />
            </div>
            <div>
              <label for="subject" class="block text-sm font-medium text-encre mb-1">Sujet *</label>
              <select id="subject" name="subject" required class="w-full px-4 py-3 rounded-lg bg-blanc border border-encre/20 focus:outline-none focus:border-bleu-signature focus:ring-2 focus:ring-bleu-signature/20 transition-all">
                <option value="">Sélectionnez un sujet</option>
                <option value="Démo">Demande de démo</option>
                <option value="Support">Question technique / Support</option>
                <option value="Tarifs">Tarifs / Offres</option>
                <option value="Partenariat">Partenariat / Intégration</option>
                <option value="Presse">Presse / Médias</option>
                <option value="Autre">Autre</option>
              </select>
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-encre mb-1">Message *</label>
              <textarea id="message" name="message" rows="5" required placeholder="Décrivez votre besoin..." class="w-full px-4 py-3 rounded-lg bg-blanc border border-encre/20 focus:outline-none focus:border-bleu-signature focus:ring-2 focus:ring-bleu-signature/20 transition-all resize-none"></textarea>
            </div>
            <label class="flex items-start gap-3 text-sm text-encre/60">
              <input type="checkbox" id="consent" name="consent" required class="mt-1" />
              <span>
                J'accepte que mes informations soient utilisées pour traiter ma demande, conformément à la <a href="/legal/confidentialite" class="underline hover:text-bleu-signature">Politique de confidentialité</a>.
              </span>
            </label>
            <div class="hidden" aria-hidden="true">
              <label for="website">Ne pas remplir :</label>
              <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
            </div>
            <button type="submit" class="btn-demo w-full sm:w-auto mx-auto block" data-track="contact_submit">
              Envoyer le message
            </button>
            <p class="text-xs text-encre/50 text-center">Réponse sous 4h ouvrées.</p>
            <p id="contact-feedback" class="text-center text-sm font-medium hidden" role="status"></p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script is:inline>
  const form = document.getElementById('contact-form');
  const feedback = document.getElementById('contact-feedback');

  async function submitContact(e) {
    e.preventDefault();
    if (!form || !feedback) return;

    const submitBtn = form.querySelector('button[type="submit"]');
    const originalLabel = submitBtn ? submitBtn.textContent : '';
    if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Envoi...'; }
    feedback.classList.add('hidden');

    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.ok) {
        feedback.textContent = 'Merci ! Votre message a bien été envoyé. Nous vous répondrons sous 4h ouvrées.';
        feedback.classList.remove('text-red-600');
        feedback.classList.add('text-emerald-600');
        feedback.classList.remove('hidden');
        form.reset();
      } else {
        feedback.textContent = data.error || 'Une erreur est survenue. Réessayez ou écrivez-nous directement à contact@optibilan.com.';
        feedback.classList.remove('text-emerald-600');
        feedback.classList.add('text-red-600');
        feedback.classList.remove('hidden');
      }
    } catch (err) {
      feedback.textContent = 'Une erreur est survenue. Réessayez ou écrivez-nous directement à contact@optibilan.com.';
      feedback.classList.remove('text-emerald-600');
      feedback.classList.add('text-red-600');
      feedback.classList.remove('hidden');
    } finally {
      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = originalLabel; }
    }
  }

  form?.addEventListener('submit', submitContact);
</script>