---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import CTA from '../../components/CTA.astro';
import Icon from '../../components/Icon.astro';

const pageTitle = 'Contact - Optibilan';
const pageDescription = 'Une question sur Optibilan ? Découvrez la plateforme, contactez le support ou proposez un partenariat. Réponse sous 4h ouvrées.';

const contactJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Optibilan',
  description: 'Contactez l\'équipe Optibilan pour une démo, du support, des partenariats ou de la presse.',
  url: 'https://optibilan.com/contact',
  mainEntity: {
    '@type': 'Organization',
    name: 'Optibilan',
    url: 'https://optibilan.com',
    contactPoint: [
      {
        '@type': 'ContactPoint',
        telephone: '+33-1-XX-XX-XX-XX',
        contactType: 'customer service',
        availableLanguage: ['French', 'English'],
        areaServed: 'FR',
        hoursAvailable: {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
          opens: '09:00',
          closes: '18:00',
        },
      },
      {
        '@type': 'ContactPoint',
        contactType: 'technical support',
        email: 'support@optibilan.com',
        availableLanguage: ['French', 'English'],
      },
      {
        '@type': 'ContactPoint',
        contactType: 'business development',
        email: 'partners@optibilan.com',
        availableLanguage: ['French', 'English'],
      },
      {
        '@type': 'ContactPoint',
        contactType: 'press',
        email: 'press@optibilan.com',
        availableLanguage: ['French', 'English'],
      },
    ],
    sameAs: [
      'https://twitter.com/optibilan',
      'https://linkedin.com/company/optibilan',
      'https://github.com/optibilan',
      'https://youtube.com/@optibilan',
    ],
  },
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/contact"
  ogImage="/og-contact.svg"
  jsonLd={contactJsonLd}
>
  <Header />

  <main>
    <Hero
      title="Une question ?
Parlons-en."
      subtitle="Démo personnalisée, support technique, partenariats. L'équipe répond sous 4h ouvrées."
    />

    <section class="section bg-blanc" aria-labelledby="contact-title">
      <div class="container max-w-4xl">
        <header class="text-center mb-16">
          <h2 id="contact-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
            Trois façons d'échanger
          </h2>
          <p class="text-lg text-encre/60 max-w-2xl mx-auto">
            Choisissez le parcours qui correspond à votre besoin.
          </p>
        </header>

        <div class="grid md:grid-cols-3 gap-6 mb-16">
          <article class="p-6 md:p-8 rounded-xl border border-encre/10 hover:border-bleu-signature/30 hover:shadow-soft transition-all duration-200 text-center">
            <div class="icon-wrapper mx-auto mb-4" aria-hidden="true" style="background-color: var(--color-bleu-clair);">
              <Icon name="calendar" class="w-10 h-10 text-bleu-signature" />
            </div>
            <h3 class="font-display text-xl font-bold text-encre mb-3">Découvrir Optibilan</h3>
            <p class="text-encre/60 mb-6">30 minutes pour voir la plateforme adaptée à votre pratique. Pas de pitch, juste votre cas concret.</p>
            <a href="https://calendly.com/optibilan/demo" class="btn-primary w-full sm:w-auto group" data-track="contact_demo">
              Réserver une démo
              <Icon name="arrowRight" class="w-5 h-5 ml-2 transition-transform group-hover:translate-x-1" />
            </a>
          </article>

          <article class="p-6 md:p-8 rounded-xl border border-encre/10 hover:border-emerald/30 hover:shadow-soft transition-all duration-200 text-center">
            <div class="icon-wrapper mx-auto mb-4" aria-hidden="true" style="background-color: color-mix(in oklab, var(--color-emerald-500) 15%, transparent);">
              <Icon name="mail" class="w-10 h-10 text-emerald-500" />
            </div>
            <h3 class="font-display text-xl font-bold text-encre mb-3">Support</h3>
            <p class="text-encre/60 mb-6">Clients actifs : bulle d'aide dans l'admin, email support@optibilan.com, Slack partagé (Studio/Cabinet). Réponse <4h ouvrées.</p>
            <a href="mailto:support@optibilan.com" class="btn-secondary w-full sm:w-auto group" data-track="contact_support">
              Écrire au support
              <Icon name="arrowRight" class="w-5 h-5 ml-2 transition-transform group-hover:translate-x-1" />
            </a>
          </article>

          <article class="p-6 md:p-8 rounded-xl border border-encre/10 hover:border-bordeaux/30 hover:shadow-soft transition-all duration-200 text-center">
            <div class="icon-wrapper mx-auto mb-4" aria-hidden="true" style="background-color: var(--color-rose-bordeaux);">
              <Icon name="users" class="w-10 h-10 text-bordeaux" />
            </div>
            <h3 class="font-display text-xl font-bold text-encre mb-3">Partenariats</h3>
            <p class="text-encre/60 mb-6">Intégrations (n8n, Make, Zapier), co-marketing, revendeurs, presse. Contactez partners@optibilan.com.</p>
            <a href="mailto:partners@optibilan.com" class="btn-secondary w-full sm:w-auto group" data-track="contact_partnerships">
              Proposer un partenariat
              <Icon name="arrowRight" class="w-5 h-5 ml-2 transition-transform group-hover:translate-x-1" />
            </a>
          </article>
        </div>

        <div class="bg-gradient-to-br from-bleu-signature/5 via-papier to-bleu-lecture/5 rounded-card-lg p-8 md:p-12">
          <h3 class="font-display text-xl md:text-2xl font-bold text-encre mb-6 text-center">Ou envoyez-nous un message direct</h3>

          <form action="https://api.optibilan.com/contact" method="POST" class="space-y-4 max-w-2xl mx-auto" data-track="contact_form">
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="firstName" class="block text-sm font-medium text-encre mb-1">Prénom *</label>
                <input type="text" id="firstName" name="firstName" required class="w-full px-4 py-3 rounded-lg bg-blanc border border-encre/20 focus:outline-none focus:border-bleu-signature focus:ring-2 focus:ring-bleu-signature/20 transition-all" />
              </div>
              <div>
                <label for="lastName" class="block text-sm font-medium text-encre mb-1">Nom *</label>
                <input type="text" id="lastName" name="lastName" required class="w-full px-4 py-3 rounded-lg bg-blanc border border-encre/20 focus:outline-none focus:border-bleu-signature focus:ring-2 focus:ring-bleu-signature/20 transition-all" />
              </div>
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-encre mb-1">Email professionnel *</label>
              <input type="email" id="email" name="email" required placeholder="vous@votrecabinet.fr" class="w-full px-4 py-3 rounded-lg bg-blanc border border-encre/20 focus:outline-none focus:border-bleu-signature focus:ring-2 focus:ring-bleu-signature/20 transition-all" />
            </div>
            <div>
              <label for="cabinet" class="block text-sm font-medium text-encre mb-1">Nom du cabinet</label>
              <input type="text" id="cabinet" name="cabinet" placeholder="Cabinet Vitalité Plus" class="w-full px-4 py-3 rounded-lg bg-blanc border border-encre/20 focus:outline-none focus:border-bleu-signature focus:ring-2 focus:ring-bleu-signature/20 transition-all" />
            </div>
            <div>
              <label for="subject" class="block text-sm font-medium text-encre mb-1">Sujet *</label>
              <select id="subject" name="subject" required class="w-full px-4 py-3 rounded-lg bg-blanc border border-encre/20 focus:outline-none focus:border-bleu-signature focus:ring-2 focus:ring-bleu-signature/20 transition-all">
                <option value="">Sélectionnez un sujet</option>
                <option value="demo">Demande de démo</option>
                <option value="technical">Question technique / Support</option>
                <option value="pricing">Tarifs / Offres</option>
                <option value="partnership">Partenariat / Intégration</option>
                <option value="press">Presse / Médias</option>
                <option value="other">Autre</option>
              </select>
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-encre mb-1">Message *</label>
              <textarea id="message" name="message" rows="5" required placeholder="Décrivez votre besoin..." class="w-full px-4 py-3 rounded-lg bg-blanc border border-encre/20 focus:outline-none focus:border-bleu-signature focus:ring-2 focus:ring-bleu-signature/20 transition-all resize-none"></textarea>
            </div>
            <button type="submit" class="btn-demo w-full sm:w-auto mx-auto block" data-track="contact_submit">
              <Icon name="send" class="w-5 h-5 mr-2" /> Envoyer le message
            </button>
            <p class="text-xs text-encre/50 text-center">En envoyant, vous acceptez notre <a href="/legal/confidentialite" class="underline hover:text-bleu-signature">Politique de confidentialité</a>. Réponse sous 4h ouvrées.</p>
          </form>
        </div>
      </div>
    </section>

    <CTA
      title="Prêt à démarrer ?"
      subtitle="30 jours gratuits, toutes fonctionnalités, sans carte bancaire. Votre cabinet en 5 minutes."
      primaryCTA={{ href: 'https://app.optibilan.com/inscription', label: 'Rejoindre Optibilan' }}
      secondaryCTA={{ href: '/inscription', label: 'Essai offert' }}
      variant="primary"
    />
  </main>

  <Footer />
</Layout>