---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';

const pageTitle = 'Optibilan - Centralisez vos suivis. Scalez votre activité.';
const pageDescription = 'Le système d\'exploitation des coachs et des professionnels de la santé : bilans, programmes, nutrition et données biométriques réunis sur une seule plateforme.';

const socialProof = [
  { name: 'Studio Performance', type: 'Coaching sportif', location: 'Bordeaux', clients: 120, logo: '/images/logos/logo-placeholder-1.svg' },
  { name: 'Cabinet NutriSanté', type: 'Nutrition', location: 'Nantes', clients: 85, logo: '/images/logos/logo-placeholder-2.svg' },
  { name: 'Mental Performance', type: 'Préparation mentale', location: 'Paris', clients: 60, logo: '/images/logos/logo-placeholder-3.svg' },
  { name: 'Méthode Équilibre', type: 'Cabinet pluridisciplinaire', location: 'Lille', clients: 45, logo: '/images/logos/logo-placeholder-4.svg' },
];

const avantAvec = [
  { avant: 'Formulaires dispersés', avec: 'Un dossier client unifié' },
  { avant: 'Excel / PDF / Word', avec: 'Tout dans une interface' },
  { avant: 'Applications multiples', avec: 'Une seule plateforme' },
  { avant: 'Informations éparpillées', avec: 'Données structurées & liées' },
  { avant: 'Suivi manuel & réactif', avec: 'Pilotage proactif & alertes' },
  { avant: 'Client dans le flou', avec: 'Expérience client guidée' },
];

const productDemos = [
  {
    id: 'check-ins',
    title: 'Bilans & progression',
    promise: 'Comprenez ce qui évolue. Sans reconstruire l\'historique.',
    benefits: [
      'Builder visuel : 30+ champs, conditions, pré-remplissage auto',
      'Chronologie unique : bilans, photos, ressentis, habitudes',
      'Validation mobile < 2 min, alertes adherence auto',
    ],
    screenshot: '/images/product/04-mobile-progression.webp',
    href: '/product/check-ins/',
    layout: 'text-left',
  },
  {
    id: 'health',
    title: 'Santé & biomarqueurs',
    promise: 'Toutes les données de santé, enfin lisibles dans le temps.',
    benefits: [
      '130+ biomarqueurs sanguins + wearables (Apple Health, Oura, Garmin)',
      'Corrélations auto : VFC ↓ + charge ↑ + sommeil ↓ = signal',
      'Import PDF labo : IA extrait, structure, signale les valeurs',
    ],
    screenshot: '/images/product/07-utilisatrice-50ans-lifestyle.webp',
    href: '/product/health/',
    layout: 'text-right',
  },
  {
    id: 'nutrition',
    title: 'Nutrition',
    promise: 'Construisez le suivi nutritionnel. Pas une pile de PDF.',
    benefits: [
      'Plans macro/micro par repas, base CIQUAL/USDA 3000+ aliments',
      'Listes de courses auto, compléments documentés & alertes interactions',
      'Journal client photo/scan + validation coach 1 clic + écart plan vs réel',
    ],
    screenshot: '/images/product/02-mobile-nutrition.webp',
    href: '/product/nutrition/',
    layout: 'text-left',
  },
  {
    id: 'training',
    title: 'Sport & programmes',
    promise: 'Construisez, suivez, ajustez. L\'entraînement structuré.',
    benefits: [
      'Bibliothèque 200+ exercices vidéo + régressions/progressions',
      'Drag-and-drop séances, progression auto charge/volume/RPE',
      'Client : vidéo exercice, saisie poids/RPE, coach voit tout temps réel',
    ],
    screenshot: '/images/product/03-mobile-seance-sport.webp',
    href: '/product/training/',
    layout: 'text-right',
  },
  {
    id: 'ai',
    title: 'IA & Automatisations',
    promise: 'L\'IA prépare. Vous décidez.',
    benefits: [
      'PDF → données structurées : bilans, analyses, lettres pré-remplies',
      'Bilan → synthèse auto pour pro + client',
      'Données → alertes adhérence, suggestions ajustement',
    ],
    screenshot: '/images/product/01-mobile-accueil-programme.webp',
    href: '/product/ai/',
    layout: 'text-left',
  },
];

const clientExperience = {
  pro: {
    title: 'Votre tableau de bord',
    desc: 'Tout piloter d\'un seul endroit. Bilans, programmes, nutrition, santé, mental, IA — modules activables selon votre pratique.',
    screenshot: '/images/product/dashboard-coach.webp',
  },
  client: {
    title: 'Leur espace simple',
    desc: 'Vos clients voient leurs bilans, programmes, habitudes, messages. Pas d\'appli à installer, ça marche dans le navigateur.',
    screenshot: '/images/product/interface-client-mobile.webp',
  },
};

const profiles = [
  { role: 'Coach sportif', modules: 'Programmes, bilans, adhérence, agenda, IA programmes', icon: 'zap' },
  { role: 'Nutritionniste / Diététicien', modules: 'Plans nutrition, listes courses, compléments, journal alimentaire, IA plans', icon: 'document' },
  { role: 'Naturopathe', modules: 'Bilans complets, santé connectée, habitudes, compléments, IA synthèses', icon: 'globe' },
  { role: 'Praticien longévité', modules: 'Biomarqueurs 130+, wearables, corrélations, IA alertes, programmes prévention', icon: 'chart' },
  { role: 'Cabinet pluridisciplinaire', modules: 'Multi-praticiens, permissions granulaires, marque blanche, SSO, API, SLA', icon: 'users' },
];

const testimonials = [
  {
    name: 'Thomas Bertrand',
    role: 'Coach sportif & Fondateur',
    company: 'Studio Performance — Bordeaux',
    photo: '/images/avatars/avatar-placeholder-1.svg',
    quote: '"La bibliothèque d\'exercices (200+ vidéos) et les programmes types m\'ont fait gagner 10h/semaine. Mes clients valident leurs séances sur l\'app, je vois leur progression en temps réel. La rétention à 6 mois est passée de 65% à 89%. J\'ai pu passer de 30 à 120 clients sans embaucher."',
    result: '+59% rétention • 4x clients',
  },
  {
    name: 'Sophie Martin',
    role: 'Diététicienne-nutritionniste',
    company: 'Cabinet NutriSanté — Nantes',
    photo: '/images/avatars/avatar-placeholder-2.svg',
    quote: '"Les templates nutrition et les listes de courses automatisées ont changé ma pratique. Mes patients reçoivent leur plan complet + courses en 1 clic. L\'export RGPD est un vrai plus pour la conformité."',
    result: '3x plus rapide • 100% conforme',
  },
  {
    name: 'Julie Moreau',
    role: 'Coach santé & Fondatrice',
    company: 'Méthode Équilibre — Lille',
    photo: '/images/avatars/avatar-placeholder-3.svg',
    quote: '"J\'ai lancé mon accompagnement signature à 1 800€/mois grâce à la marque blanche totale : domaine custom, emails @ma-methode.fr, assistant IA \'Julie\', vocabulaire \'membre\'. Mes membres ne voient jamais Optibilan."',
    result: '81k€ MRR solo • Marque 100% sienne',
  },
];

const marqueBlancheDemo = [
  { label: 'Logo & Couleurs', desc: 'Votre identité visuelle partout', icon: 'shield' },
  { label: 'Domaine custom', desc: 'app.votrecabinet.fr', icon: 'globe' },
  { label: 'Espace client', desc: 'Interface aux couleurs du cabinet', icon: 'users' },
  { label: 'Accueil personnalisé', desc: 'Votre vocabulaire, vos mentions', icon: 'document' },
  { label: 'Application mobile', desc: 'PWA installable, icône à vous', icon: 'zap' },
  { label: 'Emails @vous', desc: 'DKIM/SPF/DMARC configurés', icon: 'mail' },
];

const faq = [
  { q: 'À qui s\'adresse Optibilan ?', a: 'Aux professionnels de l\'accompagnement : coachs sportifs, nutritionnistes, naturopathes, préparateurs mentaux, cabinets pluridisciplinaires. Si vous suivez des clients, Optibilan vous concerne.' },
  { q: 'Comment fonctionne l\'espace client ?', a: 'Vos clients accèdent via un lien unique (pas d\'appli à installer). Ils voient leurs bilans, programmes, habitudes, messages. Vous choisissez ce qui est visible.' },
  { q: 'Puis-je importer mes clients existants ?', a: 'Oui. Import CSV/Excel guidé (noms, emails, données historiques). L\'équipe peut vous accompagner sur la migration.' },
  { q: 'Puis-je utiliser Optibilan avec mon équipe ?', a: 'Oui. Rôles : admin, coach, nutrition, mental, support. Permissions par spécialité. Le coach ne voit pas le mental, le mental ne voit pas la nutrition (sauf partage autorisé).' },
  { q: 'Comment les données sont-elles protégées ?', a: 'Hébergement EU (Supabase Irlande, VPS France), chiffrement AES-256/TLS 1.3, isolation multi-tenant validée 13/13 tests CI, audit trail double niveau, backup chiffré 30j, zéro transfert hors UE.' },
  { q: 'Puis-je personnaliser l\'expérience ?', a: 'Marque blanche : logo, couleurs, domaine, vocabulaire (coaché/patient/membre), assistant IA nommé, emails @vous. Activation instantanée, sans code.' },
  { q: 'Comment tester Optibilan ?', a: '30 jours gratuits, toutes fonctionnalités incluses. Créez votre cabinet, invitez des clients, testez l\'espace client. Aucune limite pendant l\'essai.' },
];

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://optibilan.com/' },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/"
  ogImage="/og-home.png"
  jsonLd={breadcrumbJsonLd}
>
  <Header />

  <main>
    <!-- 1. HERO with spectacular product shot -->
    <Hero
      title="Centralisez vos suivis.
Scalez votre activité."
      subtitle="Le système d'exploitation des coachs et des professionnels de la santé. Bilans, programmes, nutrition et données biométriques réunis sur une seule plateforme."
      badge=""
      primaryCTA={{ href: '/pricing/', label: 'Rejoindre Optibilan' }}
      secondaryCTA={{ href: '/checkout/solo/', label: 'Essai offert' }}
      stats={[]}
    />

    <TrustBar />

    <!-- 2. PREUVE SOCIALE IMMÉDIATE -->
    <section class="section bg-blanc" aria-labelledby="social-proof-title">
      <div class="container">
        <header class="text-center max-w-3xl mx-auto mb-12">
          <h2 id="social-proof-title" class="font-display text-2xl md:text-3xl font-bold text-encre mb-3">
            Ils utilisent Optibilan au quotidien
          </h2>
          <p class="text-encre/60">Cabinets, studios et coachs indépendants qui ont structuré leur pratique avec nous.</p>
        </header>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {socialProof.map(item => (
            <article class="p-6 rounded-xl border border-encre/10 hover:border-bleu-signature/30 hover:shadow-soft transition-all text-center">
              <div class="w-16 h-16 mx-auto mb-4 rounded-lg bg-bleu-clair flex items-center justify-center">
                <Icon name="building" class="w-8 h-8 text-bleu-signature" />
              </div>
              <h3 class="font-display text-lg font-bold text-encre mb-1">{item.name}</h3>
              <p class="text-encre/50 text-sm mb-2">{item.type} — {item.location}</p>
              <div class="flex items-center justify-center gap-4 text-sm text-encre/60">
                <span class="flex items-center gap-1"><Icon name="users" class="w-4 h-4" /> {item.clients}+ clients</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. AVANT / AVEC OPTIBILAN (moved up) -->
    <section class="section bg-encre text-white" aria-labelledby="avant-apres-title">
      <div class="container">
        <header class="text-center max-w-3xl mx-auto mb-12">
          <h2 id="avant-apres-title" class="font-display text-3xl md:text-4xl font-bold mb-4 text-white">
            Pourquoi Optibilan existe
          </h2>
          <p class="text-lg text-white/70 max-w-2xl mx-auto">
            La différence entre disperser vos données et les piloter.
          </p>
        </header>
        <div class="grid md:grid-cols-2 gap-8 mb-16 items-stretch">
          <div class="p-6 md:p-8 rounded-xl border border-bordeaux/20 bg-encre/50 opacity-80">
            <h3 class="font-display text-xl font-bold text-white/80 mb-6 flex items-center gap-2">
              <span class="w-8 h-8 rounded-full bg-bordeaux/25 flex items-center justify-center text-bordeaux font-medium">AVANT</span>
              <span>Optibilan</span>
            </h3>
            <ul class="space-y-4 text-white/60">
              {avantAvec.map((item, i) => (
                <li key={i} class="flex items-center gap-3">
                  <span class="w-8 h-8 rounded-full bg-bordeaux/20 flex items-center justify-center text-bordeaux/70 font-medium flex-shrink-0">{i + 1}</span>
                  <span>{item.avant}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="p-6 md:p-8 rounded-2xl bg-gradient-to-br from-bleu-signature/25 to-bleu-lecture/15 border border-bleu-signature/50 shadow-2xl shadow-bleu-signature/20 ring-1 ring-bleu-signature/40 relative">
            <div class="absolute -top-3 right-6 px-3 py-0.5 bg-bleu-signature text-craie text-xs font-semibold rounded-full">RECOMMANDÉ</div>
            <h3 class="font-display text-2xl font-bold text-white mb-6 flex items-center gap-2">
              <span class="w-9 h-9 rounded-full bg-bleu-signature flex items-center justify-center text-craie font-bold flex-shrink-0">AVEC</span>
              <span>Optibilan</span>
            </h3>
            <ul class="space-y-4 text-white">
              {avantAvec.map((item, i) => (
                <li key={i} class="flex items-center gap-3 font-semibold">
                  <span class="w-8 h-8 rounded-full bg-bleu-signature/40 ring-1 ring-bleu-signature/60 flex items-center justify-center text-bleu-signature font-bold flex-shrink-0">{i + 1}</span>
                  <span>{item.avec}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. DÉMONSTRATION PRODUIT -->
    {productDemos.map((demo, index) => (
      <section class="section" aria-labelledby={`demo-${demo.id}-title`} style={index % 2 === 0 ? 'background: linear-gradient(to bottom, var(--color-papier), var(--color-blanc));' : ''}>
        <div class="container">
          <div class="grid lg:grid-cols-2 gap-12 items-center" style={demo.layout === 'text-right' ? 'direction: rtl;' : ''}>
            <div style={demo.layout === 'text-right' ? '' : 'text-align: left;'}>
              <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-bleu-clair text-bleu-lecture text-sm font-medium mb-4">
                <Icon name="monitor" class="w-4 h-4" /> Module {demo.id}
              </span>
              <h2 id={`demo-${demo.id}-title`} class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
                {demo.title}
              </h2>
              <p class="text-lg text-encre/60 mb-8 max-w-xl">{demo.promise}</p>
              <ul class="space-y-3 mb-8 max-w-xl">
                {demo.benefits.map(b => (
                  <li key={b} class="flex items-start gap-3">
                    <Icon name="check" class="w-5 h-5 text-emerald-500 flex-shrink-0 mt-0.5" />
                    <span class="text-encre/70">{b}</span>
                  </li>
                ))}
              </ul>
              <a href={demo.href} class="btn btn-solid group inline-flex items-center gap-2">
                Voir la démo complète
                <Icon name="arrowRight" class="w-5 h-5 transition-transform group-hover:translate-x-1" />
              </a>
            </div>
            <BrowserFrame
              src={demo.screenshot}
              alt={`Tableau de bord Optibilan — module ${demo.title} : suivi des clients et des données pour les coachs et professionnels de la santé`}
              url={`app.optibilan.com/${demo.id}`}
              aspect="16/10"
              width="1000"
              height="625"
            />
          </div>
        </div>
      </section>
    ))}

    <!-- 5. EXPÉRIENCE CLIENT -->
    <section class="section bg-papier" aria-labelledby="experience-title">
      <div class="container">
        <header class="text-center max-w-3xl mx-auto mb-16">
          <h2 id="experience-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
            Une interface pour vous. Une expérience claire pour vos clients.
          </h2>
          <p class="text-lg text-encre/60">
            Le professionnel pilote. Le client avance. Chacun son espace, la même clarté.
          </p>
        </header>
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <BrowserFrame
            src={clientExperience.pro.screenshot}
            alt="Tableau de bord Optibilan du professionnel : pilotage des suivis, bilans, programmes et appels de tous les clients en un seul endroit"
            url="app.optibilan.com/dashboard"
            aspect="5/2"
            width="998"
            height="381"
            className="mb-8"
          />
          <div>
            <h3 class="font-display text-2xl font-bold text-encre mb-4">{clientExperience.pro.title}</h3>
            <p class="text-encre/60 mb-8">{clientExperience.pro.desc}</p>
            <ul class="space-y-3 mb-8 max-w-xl">
              <li class="flex items-start gap-3"><Icon name="check" class="w-5 h-5 text-emerald-500 flex-shrink-0 mt-0.5" /> Dashboard unifié : bilans, programmes, nutrition, santé, mental</li>
              <li class="flex items-start gap-3"><Icon name="check" class="w-5 h-5 text-emerald-500 flex-shrink-0 mt-0.5" /> IA qui structure, synthétise, alerte — vous validez</li>
              <li class="flex items-start gap-3"><Icon name="check" class="w-5 h-5 text-emerald-500 flex-shrink-0 mt-0.5" /> Marque blanche totale : votre cabinet, votre domaine, vos emails</li>
              <li class="flex items-start gap-3"><Icon name="check" class="w-5 h-5 text-emerald-500 flex-shrink-0 mt-0.5" /> API, webhooks, intégrations : branchez votre écosystème</li>
            </ul>
            <a href="/product/overview/" class="btn btn-solid group inline-flex items-center gap-2">
              Voir toutes les fonctionnalités
              <Icon name="arrowRight" class="w-5 h-5 transition-transform group-hover:translate-x-1" />
            </a>
          </div>
          <BrowserFrame
            src={clientExperience.client.screenshot}
            alt="Espace client Optibilan au nom du cabinet : bilans, programmes, habitudes et messages à portée de main des clients"
            url="espace-client.optibilan.com"
            aspect="3/2"
            width="414"
            height="272"
          />
        </div>
      </div>
    </section>

    <!-- 6. POUR QUI -->
    <section class="section bg-blanc" aria-labelledby="profiles-title">
      <div class="container">
        <header class="text-center max-w-3xl mx-auto mb-16">
          <h2 id="profiles-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
            Optibilan s'adapte à votre pratique
          </h2>
          <p class="text-lg text-encre/60">
            Chaque profil active les modules pertinents, avec les permissions adaptées.
          </p>
        </header>
        <div class="max-w-4xl mx-auto mb-12 rounded-xl border border-encre/10 bg-encre/5 overflow-hidden shadow-soft">
          <img
            src="/images/product/medecins/07-medecin-homme-consultation-longevite.webp"
            alt="Médecin spécialiste de la longévité en consultation : suivi prévention, biomarqueurs et longévité avec Optibilan"
            width="1000"
            height="607"
            class="w-full h-auto"
            loading="lazy"
          />
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6">
          {profiles.map((profile, i) => (
            <article class="p-6 rounded-xl border border-encre/10 hover:border-bleu-signature/30 hover:shadow-soft transition-all text-center" style={{animationDelay: `${i * 100}ms`}}>
              <div class="icon-wrapper mx-auto mb-4" aria-hidden="true" style="background-color: var(--color-bleu-clair);">
                <Icon name={profile.icon} class="w-8 h-8 text-bleu-signature" />
              </div>
              <h3 class="font-display text-xl font-bold text-encre mb-3">{profile.role}</h3>
              <p class="text-encre/60 text-sm leading-relaxed">{profile.modules}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. TÉMOIGNAGES -->
    <section class="section bg-papier" aria-labelledby="testimonials-title">
      <div class="container">
        <header class="text-center max-w-3xl mx-auto mb-16">
          <h2 id="testimonials-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
            Ce qu'ils en disent
          </h2>
          <p class="text-lg text-encre/60">
            Résultats réels de professionnels qui ont structuré leur pratique avec Optibilan.
          </p>
        </header>
        <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
          {testimonials.map((t, i) => (
            <article class="p-6 md:p-8 rounded-xl bg-blanc border border-encre/10 shadow-soft" style={{animationDelay: `${i * 150}ms`}}>
              <div class="flex items-center gap-4 mb-6">
                <div class="w-16 h-16 rounded-full bg-gradient-to-br from-bleu-signature to-bleu-lecture flex items-center justify-center text-craie font-bold text-lg flex-shrink-0">
                  {t.name.split(' ').map(n => n[0]).join('')}
                </div>
                <div>
                  <div class="font-semibold text-encre">{t.name}</div>
                  <div class="text-sm text-encre/50">{t.role}</div>
                  <div class="text-sm text-encre/50">{t.company}</div>
                </div>
              </div>
              <blockquote class="text-encre/70 leading-relaxed mb-6 italic">
                "{t.quote}"
              </blockquote>
              <div class="pt-4 border-t border-encre/10">
                <p class="text-sm font-semibold text-bleu-signature">{t.result}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 8. DÉMO PRODUIT -->
    <section class="section bg-blanc" aria-labelledby="demo-title">
      <div class="container">
        <header class="text-center max-w-3xl mx-auto mb-12">
          <h2 id="demo-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
            Découvrez Optibilan en conditions réelles
          </h2>
          <p class="text-lg text-encre/60">Un tour du vrai logiciel, mené par l'équipe Optibilan.</p>
        </header>
        <div class="max-w-4xl mx-auto rounded-2xl border border-encre/10 bg-blanc shadow-elevated overflow-hidden">
          <div class="flex items-center gap-1.5 px-4 py-3 border-b border-encre/10 bg-papier">
            <span class="w-3 h-3 rounded-full bg-bordeaux/60" aria-hidden="true"></span>
            <span class="w-3 h-3 rounded-full bg-amber-400/70" aria-hidden="true"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-500/70" aria-hidden="true"></span>
            <span class="ml-3 flex-1 h-7 rounded-md bg-blanc border border-encre/10 flex items-center px-3 text-xs text-encre/50 truncate">
              <span class="w-3.5 h-3.5 rounded-full bg-bleu-signature mr-2 flex-shrink-0" aria-hidden="true"></span>
              app.optibilan.com
            </span>
          </div>
          <div class="aspect-video bg-encre/5 overflow-hidden relative" style="background-image: url('/images/product/dashboard-coach.webp'); background-size: cover; background-position: center;">
