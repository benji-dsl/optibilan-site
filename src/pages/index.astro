---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Pricing from '../components/Pricing.astro';
import CTA from '../components/CTA.astro';
import TrustBar from '../components/TrustBar.astro';

const pageTitle = 'Optibilan — SaaS de suivi coaching multi-tenant, marque blanche, RGPD';
const pageDescription = 'Le SaaS pour cabinets, studios et coachs indépendants : bilans, nutrition, sport, prépa mentale, santé connectée. Multi-tenant natif, marque blanche totale, API, webhooks, hébergement EU.';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/"
  ogImage="/og-home.jpg"
>
  <Header />

  <main>
    <Hero
      title="Le SaaS de suivi coaching\npensé pour les pros"
      subtitle="Bilans, nutrition, sport, prépa mentale, santé connectée. Une plateforme multi-tenant, marque blanche, conforme RGPD, hébergée en Europe. Lancez votre espace en 5 minutes."
      badge="Nouveau : Assistant IA + Sync Apple Health"
      illustration="/hero-dashboard.svg"
    />

    <TrustBar />

    <Features />

    <Pricing />

    <CTA />
  </main>

  <Footer />
</Layout>