---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Process from '../components/Process.astro';
import Pillars from '../components/Pillars.astro';
import Benefits from '../components/Benefits.astro';
import Testimonials from '../components/Testimonials.astro';
import TrustBar from '../components/TrustBar.astro';
import CTA from '../components/CTA.astro';

const pageTitle = 'Optibilan — SaaS de suivi coaching multi-tenant, marque blanche, RGPD';
const pageDescription = 'Le SaaS pour cabinets, studios et coachs indépendants : bilans, nutrition, sport, prépa mentale, santé connectée. Multi-tenant natif, marque blanche totale, API, webhooks, hébergement EU.';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/"
  ogImage="/og-home.jpg"
>
  <Header />

  <main>
    <Hero />

    <TrustBar />

    <Process />

    <Pillars />

    <Benefits />

    <Testimonials />

    <CTA
      variant="primary"
      title="Prêt à structurer votre cabinet ?"
      subtitle="Rejoignez 150+ cabinets qui ont choisi Optibilan pour professionnaliser leur suivi."
    />
  </main>

  <Footer />
</Layout>