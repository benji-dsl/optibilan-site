---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Process from '../components/Process.astro';
import Pillars from '../components/Pillars.astro';
import Benefits from '../components/Benefits.astro';
import CTA from '../components/CTA.astro';
import TrustBar from '../components/TrustBar.astro';

const pageTitle = 'Optibilan — Plateforme de pilotage des accompagnements santé & performance';
const pageDescription = 'Pilotez tous vos accompagnements depuis un seul endroit : bilans, programmes, nutrition, données de santé et suivi client réunis dans une plateforme pour les professionnels de la santé et de la performance.';
---
<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/"
  ogImage="/og-home.jpg"
>
  <Header />

  <main>
    <Hero
      title="Pilotez tous vos accompagnements.\nDepuis un seul endroit."
      subtitle="Bilans, programmes, nutrition, données de santé et suivi client réunis dans une plateforme pensée pour les professionnels de la santé et de la performance."
      badge=""
      primaryCTA={{ href: 'https://calendly.com/optibilan/demo', label: 'Réserver une démo' }}
      secondaryCTA={{ href: '/product/overview', label: 'Découvrir la plateforme' }}
      stats={[]}
    />

    <TrustBar />

    <Process />

    <Pillars />

    <Benefits />

    <CTA
      variant="primary"
      title="Prêt à structurer votre cabinet ?"
      subtitle="Découvrez comment Optibilan s'adapte à votre pratique."
    />
  </main>

  <Footer />
</Layout>