---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import CTA from '../../components/CTA.astro';
import TrustBar from '../../components/TrustBar.astro';

const pageTitle = 'Documentation — Optibilan';
const pageDescription = 'Guide de démarrage, référence API, webhooks, déploiement, sécurité. Tout pour intégrer Optibilan dans votre stack.';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/docs"
  ogImage="/og-docs.jpg"
>
  <Header />

  <main>
    <Hero
      title="Documentation technique"
      subtitle="API REST, webhooks, clés API, sync santé, calendrier ICS, déploiement. Tout est documenté avec des exemples prêts à l'emploi."
      badge="OpenAPI 3.1 + exemples cURL/Node/Python"
    />

    <TrustBar />

    <section class="section bg-white" aria-labelledby="docs-nav-title">
      <div class="container">
        <div class="grid lg:grid-cols-4 gap-8">
          <nav class="lg:col-span-1" aria-label="Navigation documentation">
            <div class="sticky top-24 space-y-6">
              {[
                { id: 'debuter', title: 'Démarrage rapide', items: ['Créer son cabinet', 'Inviter ses coachs', 'Premier coaché', 'Configurer la marque'] },
                { id: 'api', title: 'API REST v1', items: ['Authentification', 'Clients', 'Bilans', 'Nutrition', 'Photos', 'Santé', 'Webhooks'] },
                { id: 'integrations', title: 'Intégrations', items: ['Apple Health / Oura', 'Calendrier ICS', 'n8n / Make / Zapier', 'Slack', 'Notion'] },
                { id: 'securite', title: 'Sécurité & Conformité', items: ['Architecture multi-tenant', 'RGPD & Export', 'CSP & Headers', 'Rate limiting', 'Audit trail'] },
                { id: 'deploiement', title: 'Déploiement', items: ['Variables d\'environnement', 'Docker / VPS', 'Cloudflare Tunnel', 'Monitoring', 'Backups'] },
              ].map(section => (
                <div class="mb-8">
                  <h3 class="text-xs font-semibold text-ink-500 uppercase tracking-wider mb-3">{section.title}</h3>
                  <ul class="space-y-2" role="list">
                    {section.items.map(item => (
                      <li>
                        <a href={`#${section.id}-${item.toLowerCase().replace(/\s+/g, '-')}`} class="text-sm text-ink-600 hover:text-primary-600 transition-colors block py-1 px-2 rounded-lg hover:bg-ink-50">
                          {item}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </nav>

          <div class="lg:col-span-3 space-y-12">
            {[
              {
                id: 'debuter',
                title: 'Démarrage rapide',
                content: [
                  { id: 'creer-son-cabinet', title: 'Créer son cabinet', body: 'Inscrivez-vous sur <a href="https://app.optibilan.com/inscription" class="text-primary-600 hover:underline">app.optibilan.com/inscription</a>. Choisissez votre offre (Solo/Studio/Cabinet), renseignez votre marque (nom, logo, couleurs), votre vocabulaire (coaché, patient, membre...), et votre domaine si vous en avez un. En 3 minutes, votre espace est prêt.' },
                  { id: 'inviter-ses-coachs', title: 'Inviter ses coachs', body: 'Depuis l\'admin → Équipe, ajoutez vos coachs, diététiciens, préparateurs mentaux. Définissez leur rôle (coach/mental/diet) pour scoper leurs accès. Ils reçoivent un lien d\'activation pour définir leur mot de passe.' },
                  { id: 'premier-coache', title: 'Premier coaché', body: 'Deux options : (1) Création manuelle depuis l\'espace coach → "Ajouter un client" → lien d\'activation à transmettre. (2) Via l\'API : <code>POST /api/v1/clients</code> avec votre clé API (scope <code>clients:write</code>). Le coaché reçoit son lien, choisit son mot de passe, remplit le questionnaire de lancement.' },
                  { id: 'configurer-la-marque', title: 'Configurer la marque blanche', body: 'Admin → Organisation → Marque : logo, couleurs (thème ou palette custom), nom de l\'assistant IA, vocabulaire, message d\'accueil, modules on/off, mentions légales du cabinet, URL d\'avis, programme parrainage. Tout est appliqué instantanément sur l\'espace coaché.' },
                ]
              },
              {
                id: 'api',
                title: 'API REST v1',
                content: [
                  { id: 'authentification', title: 'Authentification', body: 'Générez une clé API dans Admin → API (format <code>obk_...</code>). Scopez-la (<code>clients:read</code>, <code>checkins:write</code>, <code>cron</code>...). Utilisez le header <code>Authorization: Bearer obk_...</code>. Rate limit : 120 req/min par clé.' },
                  { id: 'clients', title: 'Clients', body: '<code>GET /api/v1/clients</code> (liste, pagination, filtres), <code>GET /api/v1/clients/:id</code>, <code>POST /api/v1/clients</code>, <code>PATCH /api/v1/clients/:id</code>. Réponse JSON standardisée avec <code>data</code>, <code>meta</code>.' },
                  { id: 'bilans', title: 'Bilans', body: '<code>GET /api/v1/clients/:id/checkins</code>, <code>POST /api/v1/clients/:id/checkins</code>. Champs : poids, mensurations (JSON), faim, motivation, sommeil, pas, texte libre. Scope auto par <code>orgId</code> de la clé.' },
                  { id: 'nutrition', title: 'Nutrition', body: '<code>GET/POST /api/v1/clients/:id/nutrition</code>. Structure : protéines, glucides, lipides, légumes, fruits, plaisirs, courses, compléments, méthodes, repas, notes.' },
                  { id: 'photos', title: 'Photos', body: '<code>GET/POST /api/v1/clients/:id/photos</code>. Upload via <code>multipart/form-data</code> ou data-URL. Types : FACE, PROFIL, DOS. Vignettes auto-générées. Stockage Supabase bucket privé.' },
                  { id: 'sante', title: 'Santé', body: '<code>GET/POST /api/v1/clients/:id/health</code>. Métriques : sleep_hours, sleep_score, hrv, resting_hr, vo2max, steps, weight, body_fat. Sources : manual, apple_health, oura, whoop, garmin.' },
                  { id: 'webhooks', title: 'Webhooks', body: 'Admin → Webhooks : URL, événements (client.created, checkin.submitted, badge.earned, nutrition.updated, call.overdue, client.weak_signal...), secret HMAC. Signature dans header <code>x-optibilan-signature</code>. Retry exponentiel (max 5x). Idempotence via <code>externalId</code>.' },
                ]
              },
              {
                id: 'integrations',
                title: 'Intégrations',
                content: [
                  { id: 'apple-health-oura', title: 'Apple Health / Oura / Whoop / Garmin', body: 'Deux voies : (1) Côté coaché : raccourci iOS "Health Auto Export" → POST sur <code>/api/health-sync</code> avec header <code>Authorization: Bearer hsk_...</code> (token généré dans Mon compte). (2) Côté cabinet : n8n/Make/Zapier qui récupère via API partenaire et pousse sur <code>/api/health-sync</code> avec clé API scope <code>cron</code>.' },
                  { id: 'calendrier-ics', title: 'Calendrier ICS', body: 'Chaque staff a un token calendrier dans Mon compte → Calendrier. L\'URL <code>https://app.optibilan.com/api/calendrier/<token>.ics</code> s\'abonne dans Google Calendar, Apple Calendrier, Outlook. Contient les appels planifiés (titre, date, lien fiche coaché). Filtré par rôle (coach ne voit pas les coachés masqués).' },
                  { id: 'n8n-make-zapier', title: 'n8n / Make / Zapier', body: 'Utilisez les clés API (scope <code>cron</code> ou <code>clients:read</code> + <code>checkins:write</code>) + webhooks pour automatiser : nouveau client → créer dossier Notion, bilan déposé → poster sur Slack, paiement Stripe → envoyer email personnalisé.' },
                  { id: 'slack', title: 'Slack', body: 'Admin → Organisation → Webhook Slack entrant. Reçoit : nouveau coaché, bilan déposé, appel en retard, signal faible, demande suppression RGPD. Format message structuré avec liens vers l\'app.' },
                  { id: 'notion', title: 'Notion', body: 'Via n8n webhook <code>note.created</code> : pousse les notes de suivi coaching dans une base Notion (propriétés : client, coach, date, type, contenu, visibilité).' },
                ]
              },
              {
                id: 'securite',
                title: 'Sécurité & Conformité',
                content: [
                  { id: 'architecture-multi-tenant', title: 'Architecture multi-tenant', body: 'Extension Prisma <code>tenant-guard</code> : injection auto de <code>orgId</code> sur TOUTES les requêtes (lecture/écriture/nested). Fail-closed : pas de contexte org = erreur. Testé par <code>test:isolation.mts</code> (13/13).' },
                  { id: 'rgpd-export', title: 'RGPD & Export', body: 'Admin → Export : JSON complet de TOUTES les données du cabinet (37 modèles). Vérifié en CI (<code>check-tenant.mjs</code>) : aucun modèle cloisonné oublié. Purge auto paramétrable (durée + flag). Droit à l\'oubli : suppression client (cascade) par admin.' },
                  { id: 'csp-headers', title: 'CSP & Headers', body: '<code>Content-Security-Policy</code> stricte (<code>script-src \'self\' \'unsafe-inline\'</code>, <code>connect-src \'self\' https://api.stripe.com</code>, <code>frame-ancestors \'none\'</code>, <code>base-uri \'self\'</code>). HSTS, X-Frame-Options: DENY, X-Content-Type-Options: nosniff, Referrer-Policy: strict-origin-when-cross-origin, Permissions-Policy restrictif.' },
                  { id: 'rate-limiting', title: 'Rate limiting', body: 'Persistant en base (survit aux redémarrages). Fenêtres glissantes : login IP (30/15min), login email (5/15min + lock 15min), 2FA (6/15min), IA user (15/min, 25/jour), IA org (plafond mensuel par offre), API keys (120/min), cron (budget 240s). Fail-open : ne bloque jamais un légitime.' },
                  { id: 'audit-trail', title: 'Audit trail', body: 'Deux niveaux : <code>AuditLog</code> (par org, actions utilisateurs) + <code>PlatformAuditLog</code> (équipe Optibilan : suspension org, changement plan, dépannage). Horodaté, IP, user-agent, meta JSON.' },
                ]
              },
              {
                id: 'deploiement',
                title: 'Déploiement',
                content: [
                  { id: 'variables-environnement', title: 'Variables d\'environnement', body: 'Fichier <code>.env</code> (local) ou <code>deploy/prod.env</code> (VPS). Secrets : <code>AUTH_SECRET</code> (≥32c), <code>CRON_SECRET</code> (≥24c), <code>STRIPE_*</code>, <code>RESEND_API_KEY</code>, <code>SUPABASE_*</code>, <code>ANTHROPIC_API_KEY</code>, <code>VAPID_*</code>. <code>NEXT_PUBLIC_APP_URL</code> pour les liens publics.' },
                  { id: 'docker-vps', title: 'Docker / VPS', body: '<code>docker compose -f compose.prod.yml up -d</code>. Image <code>standalone</code> Next.js. Healthcheck <code>/api/health</code>. Traefik reverse proxy (TLS auto via Let\'s Encrypt). Volumes : uploads (Supabase), logs.' },
                  { id: 'cloudflare-tunnel', title: 'Cloudflare Tunnel (recommandé)', body: '<code>cloudflared tunnel run --token $TOKEN optibilan</code>. Pas de port ouvert sur le VPS. WAF, DDoS, cache, analytics inclus. Zéro config nginx/Traefik.' },
                  { id: 'monitoring', title: 'Monitoring', body: 'Healthcheck <code>/api/health</code> (DB, Redis, Supabase). Logs structurés JSON. Cron <code>/api/cron/maintenance</code> rapporte : usage par org, conservation, essais expirés, tokens purgés. Alertes Slack sur erreurs 5xx.' },
                  { id: 'backups', title: 'Backups', body: 'Supabase : PITR (Point-in-Time Recovery) 7 jours + snapshots quotidiens. Script <code>npm run vps:backup</code> déclenche <code>systemctl start optibilan-backup.service</code> (pg_dump compressé, chiffré, stocké sur S3-compatible). Rétention 30 jours.' },
                ]
              },
            ].map(section => (
              <section id={section.id} class="space-y-8">
                <h2 class="font-display text-2xl md:text-3xl font-bold text-ink-950 flex items-center gap-3">
                  <span class="w-8 h-8 rounded-lg bg-primary-100 text-primary-600 flex items-center justify-center text-sm font-bold">
                    {section.id === 'debuter' ? '1' : section.id === 'api' ? '2' : section.id === 'integrations' ? '3' : section.id === 'securite' ? '4' : '5'}
                  </span>
                  {section.title}
                </h2>
                <div class="space-y-6">
                  {section.content.map(item => (
                    <article id={`${section.id}-${item.id}`} class="prose prose-ink max-w-none">
                      <h3 class="text-xl font-semibold text-ink-950 mb-3">{item.title}</h3>
                      <div class="text-ink-600 leading-relaxed" set:html={item.body}></div>
                    </article>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </div>
      </div>
    </section>

    <CTA
      title="Besoin d'aide pour l'intégration ?"
      subtitle="Notre équipe technique répond en quelques heures. Pas de bot, pas de ticket fermé sans réponse."
      primaryCTA={{ href: '/contact', label: 'Contacter le support technique' }}
      secondaryCTA={{ href: 'https://app.optibilan.com/inscription', label: 'Tester l\'API (essai gratuit)' }}
      variant="gold"
    />
  </main>

  <Footer />
</Layout>