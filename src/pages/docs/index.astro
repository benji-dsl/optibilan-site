---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import CTA from '../../components/CTA.astro';
import TrustBar from '../../components/TrustBar.astro';
import Icon from '../../components/Icon.astro';

const pageTitle = 'Documentation API — Optibilan';
const pageDescription = 'Documentation technique complète : OpenAPI 3.1, authentification, endpoints, webhooks, exemples cURL/Node/Python, sandbox de test.';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/docs"
  ogImage="/og-docs.jpg"
>
  <Header />

  <main>
    <Hero
      title="Documentation technique<br>pour développeurs"
      subtitle="API REST v1 OpenAPI 3.1, authentification, endpoints, webhooks, exemples cURL/Node/Python, sandbox de test. Tout pour intégrer Optibilan à votre stack."
      badge="OpenAPI 3.1 · Sandbox · Exemples cURL/Node/Python"
      primaryCTA={{ href: '/docs/reference', label: 'Voir la référence API' }}
      secondaryCTA={{ href: '/docs/sandbox', label: 'Tester dans le sandbox' }}
    />

    <TrustBar />

    <section class="section bg-blanc" aria-labelledby="quickstart-title">
      <div class="container max-w-4xl">
        <header class="mb-12">
          <h2 id="quickstart-title" class="font-display text-2xl md:text-3xl font-bold text-encre mb-4">
            Démarrage rapide
          </h2>
          <p class="text-lg text-encre/60 mb-8">
            De la création de votre première clé API à votre premier appel en 5 minutes.
          </p>

          <div class="grid md:grid-cols-3 gap-6">
            {[
              { step: '1', title: 'Créer une clé API', desc: 'Admin → API → Nouvelle clé → Choisir scopes (clients:read, checkins:write…)', code: 'obk_live_...' },
              { step: '2', title: 'Premier appel', desc: 'GET /api/v1/clients avec header Authorization: Bearer obk_...', code: 'curl -H "Authorization: Bearer obk_..." https://app.optibilan.com/api/v1/clients' },
              { step: '3', title: 'Configurer webhook', desc: 'Admin → Webhooks → URL + événements + secret HMAC → Test', code: 'POST /api/v1/webhooks { "url": "...", "events": ["checkin.submitted"], "secret": "..." }' },
            ].map(item => (
              <article class="p-6 rounded-xl border border-encre/10 bg-blanc">
                <div class="flex items-center gap-3 mb-3">
                  <span class="w-10 h-10 rounded-full bg-bleu-signature text-craie flex items-center justify-center font-display font-bold text-lg">{item.step}</span>
                  <h3 class="font-semibold text-encre">{item.title}</h3>
                </div>
                <p class="text-encre/60 text-sm mb-3">{item.desc}</p>
                <code class="block bg-encre/5 rounded-lg p-3 text-xs text-craie overflow-x-auto">{item.code}</code>
              </article>
            ))}
          </div>
        </header>

        <div class="grid md:grid-cols-2 gap-8 mb-16">
          <article class="p-6 rounded-xl border border-encre/10 bg-blanc">
            <h3 class="font-display text-xl font-bold text-encre mb-4 flex items-center gap-2">
              <Icon name="code" class="w-5 h-5 text-bleu-signature" /> Authentification
            </h3>
            <ul class="space-y-3 text-encre/60 text-sm">
              <li><strong>Format :</strong> <code class="bg-papier px-1.5 py-0.5 rounded">Bearer obk_live_...</code> ou <code class="bg-papier px-1.5 py-0.5 rounded">obk_test_...</code></li>
              <li><strong>Scopes :</strong> clients:read, clients:write, checkins:read, checkins:write, nutrition:read, nutrition:write, health:read, health:write, cron, webhooks:manage</li>
              <li><strong>Rate limit :</strong> 120 req/min (Studio), sans limite pratique (Cabinet)</li>
              <li><strong>Erreurs :</strong> Format RFC 7807 (Problem Details) avec code, message, détails</li>
            </ul>
          </article>

          <article class="p-6 rounded-xl border border-encre/10 bg-blanc">
            <h3 class="font-display text-xl font-bold text-encre mb-4 flex items-center gap-2">
              <Icon name="zap" class="w-5 h-5 text-bleu-signature" /> Webhooks
            </h3>
            <ul class="space-y-3 text-encre/60 text-sm">
              <li><strong>Événements (8) :</strong> client.created, client.updated, checkin.submitted, badge.earned, nutrition.updated, health.updated, call.overdue, client.weak_signal</li>
              <li><strong>Signature :</strong> HMAC-SHA256, header <code class="bg-papier px-1.5 py-0.5 rounded">x-optibilan-signature</code></li>
              <li><strong>Retry :</strong> exponentiel (1s, 2s, 4s, 8s, 16s) max 5x. Idempotence via <code class="bg-papier px-1.5 py-0.5 rounded">externalId</code></li>
              <li><strong>Ordre :</strong> non garanti. Traiter en idempotent.</li>
            </ul>
          </article>
        </div>

        <div class="grid md:grid-cols-3 gap-6 mb-16">
          {[
            { icon: 'code', title: 'Référence complète', desc: 'Tous les endpoints, paramètres, réponses, codes d\'erreur. OpenAPI 3.1 + Redoc.', href: '/docs/reference', color: 'bleu-signature' },
            { icon: 'terminal', title: 'Sandbox interactif', desc: 'Testez l\'API en direct avec vos clés test. Requêtes/réponses en direct.', href: '/docs/sandbox', color: 'bleu-lecture' },
            { icon: 'download', title: 'SDK & Exemples', desc: 'cURL, Node.js, Python. Génération de client TypeScript/OpenAPI.', href: '/docs/sdks', color: 'indigo' },
          ].map(item => (
            <a href={item.href} class="card-hover p-6 text-center group" style={`--mod-color: var(--color-${item.color})`}>
              <div class="icon-wrapper mx-auto mb-4" aria-hidden="true" style={`background-color: color-mix(in oklab, var(--color-${item.color}) 15%, transparent);`}>
                <Icon name={item.icon} class="w-7 h-7" style={`color: var(--color-${item.color});`} />
              </div>
              <h3 class="font-display text-lg font-bold text-encre mb-2">{item.title}</h3>
              <p class="text-sm text-encre/50 mb-4">{item.desc}</p>
              <span class="inline-flex items-center gap-1.5 text-sm font-medium" style={`color: var(--color-${item.color});`}>
                Accéder
                <Icon name="arrowRight" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
              </span>
            </a>
          ))}
        </div>

        <section aria-labelledby="resources-title" class="mb-16">
          <h3 id="resources-title" class="font-display text-xl font-bold text-encre mb-6">Ressources développeurs</h3>
          <div class="grid md:grid-cols-2 gap-6">
            <a href="/docs/postman" class="card-hover p-6" data-track="docs_postman">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-lg bg-orange-100 flex items-center justify-center">
                  <Icon name="code" class="w-6 h-6 text-orange-500" />
                </div>
                <div>
                  <h4 class="font-semibold text-encre">Collection Postman</h4>
                  <p class="text-encre/60 text-sm">Environnements test/live, variables d'env, tests automatisés</p>
                </div>
              </div>
            </a>
            <a href="/docs/webhooks" class="card-hover p-6" data-track="docs_webhooks">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-lg bg-indigo-100 flex items-center justify-center">
                  <Icon name="zap" class="w-6 h-6 text-indigo" />
                </div>
                <div>
                  <h4 class="font-semibold text-encre">Guide Webhooks</h4>
                  <p class="text-encre/60 text-sm">HMAC, retry, idempotence, exemples Node/Python, debugging</p>
                </div>
              </div>
            </a>
            <a href="/docs/rate-limits" class="card-hover p-6" data-track="docs_ratelimits">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-lg bg-rose-100 flex items-center justify-center">
                  <Icon name="shield" class="w-6 h-6 text-rose-500" />
                </div>
                <div>
                  <h4 class="font-semibold text-encre">Rate Limiting & Quotas</h4>
                  <p class="text-encre/60 text-sm">Limites par clé/organisation, headers de réponse, gestion 429</p>
                </div>
              </div>
            </a>
            <a href="/docs/errors" class="card-hover p-6" data-track="docs_errors">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-lg bg-amber-100 flex items-center justify-center">
                  <Icon name="shield" class="w-6 h-6 text-amber-500" />
                </div>
                <div>
                  <h4 class="font-semibold text-encre">Codes d'erreur</h4>
                  <p class="text-encre/60 text-sm">Format RFC 7807, codes par catégorie, retry-after, debugging</p>
                </div>
              </div>
            </a>
          </div>
        </section>

        <section aria-labelledby="changelog-title">
          <h3 id="changelog-title" class="font-display text-xl font-bold text-encre mb-6">Changelog API</h3>
          <div class="space-y-4">
            {[
              { version: 'v1.4.0', date: '2024-01-15', changes: ['Ajout endpoint GET /api/v1/clients/:id/health-history', 'Webhook health.updated ajouté', 'Rate limit headers standardisés (X-RateLimit-*)'] },
              { version: 'v1.3.0', date: '2023-12-01', changes: ['Support SSO/SAML (Offre Cabinet)', 'Webhook call.overdue ajouté', 'Amélioration rate limit headers'] },
              { version: 'v1.2.0', date: '2023-11-01', changes: ['Endpoint santé : sync Apple Health/Oura/Garmin', 'Filtres avancés sur GET /clients', 'Sandbox mis à jour v2'] },
            ].map(item => (
              <article class="p-5 rounded-xl border border-encre/10 bg-blanc">
                <div class="flex items-center justify-between gap-4 mb-3">
                  <div>
                    <span class="font-display text-xl font-bold text-bleu-signature">{item.version}</span>
                    <span class="text-sm text-encre/50 ml-3">{item.date}</span>
                  </div>
                </div>
                <ul class="space-y-1 text-sm text-encre/60">
                  {item.changes.map(change => (
                    <li key={change} class="flex items-start gap-2">• {change}</li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </section>
      </div>
    </section>

    <CTA
      title="Vous avez une question technique ?"
      subtitle="L'équipe technique répond en <4h ouvrées. Pas de bot, pas de ticket fermé sans réponse."
      primaryCTA={{ href: 'mailto:dev@optibilan.com', label: 'Contacter l\'équipe technique' }}
      secondaryCTA={{ href: 'https://calendly.com/optibilan/demo', label: 'Réserver un appel technique' }}
      variant="gold"
    />
  </main>

  <Footer />
</Layout>