---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ArticleCard from '@/components/blog/ArticleCard.astro';
import { getAllPosts, getCategories } from '@/utils/wordpress';

const pageTitle = 'Blog Optibilan : conseils coaching, nutrition et santé pour pros';
const pageDescription = 'Articles et guides pour coachs sportifs, nutritionnistes et professionnels de la santé : bilans, suivi client, nutrition, préparation mentale et business.';

const allPosts = await getAllPosts();
const categories = await getCategories();

const groups = categories
  .map(cat => ({ ...cat, posts: allPosts.filter(p => p.category === cat.slug) }))
  .filter(g => g.posts.length > 0);

const blogJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog Optibilan',
  description: 'Articles et guides pour cabinets, studios et coachs',
  url: 'https://optibilan.com/blog/',
  blogPosts: allPosts.map(a => ({
    '@type': 'BlogPosting',
    headline: a.title,
    url: `https://optibilan.com/blog/${a.slug}/`,
    datePublished: a.date,
    author: { '@type': 'Person', name: a.author },
  })),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://optibilan.com/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://optibilan.com/blog/' },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/blog/"
  ogImage="/og-blog.png"
  jsonLd={[blogJsonLd, breadcrumbJsonLd]}
>
  <Header />

  <main>
    <section class="section pt-16 md:pt-20 bg-papier">
      <div class="container">
        <div class="max-w-3xl mx-auto text-center">
          <h1 class="font-display text-4xl md:text-5xl font-bold text-encre mb-4">Le blog Optibilan</h1>
          <p class="text-lg text-encre/60">
            Conseils, méthodes et études de cas pour coachs, nutritionnistes et professionnels de la santé.
          </p>
          <p class="text-sm text-encre/40 mt-3">{allPosts.length} articles, classés par catégorie</p>
        </div>
      </div>
    </section>

    {groups.length === 0 ? (
      <section class="section bg-blanc">
        <div class="container text-center py-16">
          <h2 class="font-display text-xl font-bold text-encre mb-2">Aucun article pour l'instant</h2>
          <p class="text-encre/50">Revenez plus tard.</p>
        </div>
      </section>
    ) : (
      groups.map((group, gi) => (
        <section class={`section ${gi % 2 === 0 ? 'bg-blanc' : 'bg-papier'}`} aria-labelledby={`cat-${group.slug}`}>
          <div class="container">
            <header class="flex flex-wrap items-end justify-between gap-4 mb-10">
              <div>
                <h2 id={`cat-${group.slug}`} class="font-display text-2xl md:text-3xl font-bold text-encre">
                  {group.label}
                </h2>
                <p class="text-encre/50 text-sm mt-1">
                  {group.posts.length} {group.posts.length > 1 ? 'articles' : 'article'}
                </p>
              </div>
              <a href={`/blog/category/${group.slug}/`} class="btn btn-solid text-sm">
                Voir tout
              </a>
            </header>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {group.posts.map(article => (
                <ArticleCard article={article} />
              ))}
            </div>
          </div>
        </section>
      ))
    )}
  </main>

  <Footer />
</Layout>
