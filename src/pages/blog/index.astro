---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ArticleCard from '@/components/blog/ArticleCard.astro';
import Pagination from '@/components/blog/Pagination.astro';
import Icon from '@/components/Icon.astro';
import { getAllPosts, getCategories, PER_PAGE } from '@/utils/wordpress';

const pageTitle = 'Blog Optibilan : conseils coaching, nutrition et santé pour pros';
const pageDescription = 'Articles et guides pour coachs sportifs, nutritionnistes et professionnels de la santé : bilans, suivi client, nutrition, préparation mentale et business.';

const allPosts = await getAllPosts();
const categories = await getCategories();

const totalPages = Math.max(1, Math.ceil(allPosts.length / PER_PAGE));
const pagePosts = allPosts.slice(0, PER_PAGE);

const blogJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog Optibilan',
  description: 'Articles et guides pour cabinets, studios et coachs',
  url: 'https://optibilan.com/blog/',
  blogPosts: allPosts.map(a => ({
    '@type': 'BlogPosting',
    headline: a.title,
    url: `https://optibilan.com/blog/${a.slug}/`,
    datePublished: a.date,
    author: { '@type': 'Person', name: a.author },
  })),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://optibilan.com/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://optibilan.com/blog/' },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/blog/"
  ogImage="/og-blog.png"
  jsonLd={[blogJsonLd, breadcrumbJsonLd]}
>
  <Header />

  <main>
    <section class="section pt-16 md:pt-20 bg-papier">
      <div class="container">
        <div class="max-w-3xl mx-auto text-center">
          <h1 class="font-display text-4xl md:text-5xl font-bold text-encre mb-4">Le blog Optibilan</h1>
          <p class="text-lg text-encre/60">
            Conseils, méthodes et études de cas pour coachs, nutritionnistes et professionnels de la santé.
          </p>
        </div>

        <div class="flex flex-wrap justify-center gap-3 mt-8">
          {categories.map(c => (
            <a
              href={`/blog/category/${c.slug}/`}
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-card border border-encre/10 bg-blanc hover:border-bleu-signature/40 hover:shadow-soft transition-all font-medium text-encre/80"
            >
              <Icon name={c.icon} class="w-4 h-4" style={`color: var(--color-${c.color});`} />
              {c.label}
            </a>
          ))}
        </div>
      </div>
    </section>

    {pagePosts.length === 0 ? (
      <section class="section bg-blanc">
        <div class="container text-center py-16">
          <h2 class="font-display text-xl font-bold text-encre mb-2">Aucun article pour l'instant</h2>
          <p class="text-encre/50">Revenez plus tard.</p>
        </div>
      </section>
    ) : (
      <section class="section bg-blanc">
        <div class="container">
          <h2 class="sr-only">Articles</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {pagePosts.map(article => (
              <ArticleCard article={article} />
            ))}
          </div>

          <Pagination currentPage={1} totalPages={totalPages} baseUrl="/blog/" />
        </div>
      </section>
    )}

    <section class="section bg-papier">
      <div class="container">
        <h2 class="font-display text-xl font-bold text-encre mb-6 text-center">Nos catégories</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {categories.map(c => {
            const count = allPosts.filter(p => p.category === c.slug).length;
            return (
              <a
                href={`/blog/category/${c.slug}/`}
                class="card-hover flex items-start gap-3 p-5 rounded-card-lg border border-encre/10 bg-blanc"
                style={`--accent: var(--color-${c.color})`}
              >
                <Icon name={c.icon} class="w-5 h-5 flex-shrink-0" style={`color: var(--color-${c.color});`} />
                <span>
                  <span class="block font-semibold text-encre">{c.label}</span>
                  <span class="block text-sm text-encre/50 mt-0.5">
                    {count} {count > 1 ? 'articles' : 'article'}
                  </span>
                </span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>