      author: { '@type': 'Person', name: 'Benjamin Sant' },
    },
  ]
};

const categories = [
  { slug: 'digitalisation', label: 'Digitalisation des cabinets', icon: 'chart', color: 'bleu-signature' },
  { slug: 'performance', label: 'Optimisation de la performance', icon: 'zap', color: 'bleu-lecture' },
  { slug: 'business', label: 'Business & Croissance', icon: 'users', color: 'bordeaux' },
  { slug: 'sante-connectee', label: 'Santé connectée', icon: 'globe', color: 'bleu-ardoise' },
  { slug: 'mental', label: 'Préparation mentale', icon: 'brain', color: 'indigo' },
  { slug: 'nutrition', label: 'Nutrition', icon: 'document', color: 'bleu-clair' },
];

const articles = [
  {
    slug: 'bilans-hebdo-automatises',
    title: 'Comment automatiser vos bilans hebdo et gagner 10h par semaine',
    excerpt: 'Découvrez comment les cabinets qui utilisent les bilans guidés Optibilan réduisent leur temps administratif de 75% tout en améliorant la qualité du suivi.',
    category: 'digitalisation',
    author: 'Marie Dubois',
    date: '2024-01-15',
    readTime: '8 min',
    featured: true,
  },
  {
    slug: 'nutrition-personnalisee-echelle',
    title: 'Nutrition personnalisée à grande échelle : la méthode des templates',
    excerpt: 'Comment créer des plans nutritionnels individualisés pour 50+ coachés sans y passer vos soirées. La puissance des templates réutilisables.',
