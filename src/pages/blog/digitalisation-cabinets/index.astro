---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Hero from '../../../components/Hero.astro';
import CTA from '../../../components/CTA.astro';
import TrustBar from '../../../components/TrustBar.astro';
import Icon from '../../../components/Icon.astro';

const pageTitle = 'Digitalisation des cabinets — Blog Optibilan';
const pageDescription = 'Articles sur la digitalisation des cabinets de santé et coaching : logiciel suivi coaching, SaaS cabinet santé, automatisation administrative, outils numériques praticiens.';
const articles = [
  {
    slug: 'bilans-hebdo-automatises',
    title: 'Comment automatiser vos bilans hebdo et gagner 10h par semaine',
    excerpt: 'Découvrez comment les cabinets qui utilisent les bilans guidés Optibilan réduisent leur temps administratif de 75% tout en améliorant la qualité du suivi.',
    author: 'Marie Dubois',
    date: '2024-01-15',
    readTime: '8 min',
    featured: true,
  },
  {
    slug: 'api-webhooks-integration-n8n',
    title: 'Intégrer Optibilan à votre stack via API et webhooks (n8n, Make, Zapier)',
    excerpt: 'Exemples concrets : nouveau client → créer dossier Notion, bilan déposé → alerte Slack, paiement → email personnalisé. Clés API scopées, HMAC, idempotence.',
    author: 'Dev Team',
    date: '2023-12-12',
    readTime: '12 min',
    featured: false,
  },
];

const categoryLabels: Record<string, string> = {
  'digitalisation-cabinets': 'Digitalisation des cabinets',
  'optimisation-performance': 'Optimisation de la performance',
  'business-coaching': 'Business model du coaching haut de gamme',
  'sante-connectee': 'Santé connectée & biomarqueurs',
  'preparation-mentale': 'Préparation mentale & psychologie',
  'nutrition-coaching': 'Nutrition & coaching alimentaire',
};

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/blog/digitalisation-cabinets"
  ogImage="/og-blog.jpg"
>
  <Header />

  <main>
    <Hero
      title="Digitalisation\ndes cabinets"
      subtitle="Automatisation, SaaS, outils numériques : tout pour moderniser votre pratique sans perdre l'humain."
      badge="Catégorie : Digitalisation des cabinets"
    />

    <TrustBar />

    <section class="section bg-blanc" aria-labelledby="articles-title">
      <div class="container">
        <header class="mb-12">
          <h2 id="articles-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-2">{categoryLabels['digitalisation-cabinets']}</h2>
          <p class="text-encre/60">{articles.length} articles — Guides pratiques et retours d'expérience</p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {articles.map((article, i) => (
            <article class="card-hover group relative overflow-hidden" style={`animation-delay: ${i * 100}ms`}>
              <div class="absolute top-0 left-0 right-0 h-1 bg-[var(--color-bleu-signature)] opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>
              <div class="p-6 md:p-7">
                <div class="flex items-center gap-2 mb-3">
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-puce text-xs font-medium text-bleu-signature bg-[color-mix(in_oklab,_var(--color-bleu-signature)_10%,_transparent)]">
                    {categoryLabels['digitalisation-cabinets']}
                  </span>
                  <time class="text-xs text-encre/40" datetime={article.date}>{formatDate(article.date)}</time>
                </div>
                <h3 class="font-display text-xl font-bold text-encre mb-3 line-clamp-2 group-hover:text-bleu-signature transition-colors">
                  <a href={`/blog/${article.slug}`}>{article.title}</a>
                </h3>
                <p class="text-encre/60 leading-relaxed mb-4 line-clamp-3">{article.excerpt}</p>
                <div class="flex items-center justify-between pt-4 border-t border-encre/10">
                  <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-full bg-gradient-to-br from-bleu-signature to-bleu-lecture flex items-center justify-center text-craie font-bold text-xs">
                      {article.author.split(' ').map(n => n[0]).join('')}
                    </div>
                    <span class="text-sm font-medium text-encre/70">{article.author}</span>
                  </div>
                  <span class="text-xs text-encre/40 flex items-center gap-1">
                    <Icon name="clock" class="w-3 h-3" /> {article.readTime}
                  </span>
                </div>
              </div>
              {article.featured && (
                <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-bleu-signature to-indigo" aria-hidden="true"></div>
              )}
            </article>
          ))}
        </div>

        <div class="text-center mt-12">
          <a href="/blog" class="btn-secondary">
            <Icon name="arrowRight" class="w-4 h-4 mr-2" /> Retour au blog
          </a>
        </div>
      </div>
    </section>

    <CTA
      title="Vous voulez plus de contenu ?"
      subtitle="Recevez chaque mardi un article, une astuce ou un cas client directement dans votre boîte mail."
      primaryCTA={{ href: '/newsletter', label: 'S\'abonner gratuitement' }}
      variant="secondary"
    />
  </main>

  <Footer />
</Layout>

<style is:global>
  .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .line-clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
</style>