---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CTA from '@/components/CTA.astro';
import Icon from '@/components/Icon.astro';
import Pagination from '@/components/Pagination.astro';
import { getAllPosts, getCategories, CATEGORY_MAP, type OptibilanArticle } from '@/utils/wordpress';

export async function getStaticPaths() {
  const categories = await getCategories();
  return categories.map(cat => ({ params: { slug: cat.slug, page: '1' } }));
}

const { slug, page } = Astro.params;
if (!slug || typeof slug !== 'string') throw new Error('Slug requis');

const currentPage = page ? parseInt(page as string, 10) : 1;

const allPosts = await getAllPosts();
const wpCategories = await getCategories();
const categories = wpCategories.length > 0 ? wpCategories : Object.entries(CATEGORY_MAP).map(([s, info]) => ({ slug: s, ...info, count: 0 }));

const categoryLabels: Record<string, string> = {};
for (const cat of categories) categoryLabels[cat.slug] = cat.label;

const catInfo = categories.find(c => c.slug === slug) || CATEGORY_MAP[slug];
if (!catInfo) return Astro.redirect('/blog');

const allCategoryPosts = allPosts.filter(p => p.category === slug);
const postsPerPage = 12;
const totalPages = Math.ceil(allCategoryPosts.length / postsPerPage);
const start = (currentPage - 1) * postsPerPage;
const categoryPosts = allCategoryPosts.slice(start, start + postsPerPage);

const pageTitle = `${catInfo.label} - Blog Optibilan`;
const pageDescription = `Articles sur ${catInfo.label.toLowerCase()} pour cabinets, studios et coachs : guides, études de cas, méthodes.`;
const catCount = categories.find(c => c.slug === slug)?.count || allCategoryPosts.length;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://optibilan.com/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://optibilan.com/blog' },
    { '@type': 'ListItem', position: 3, name: catInfo.label, item: `https://optibilan.com/blog/${slug}` },
    ...(currentPage > 1 ? [{ '@type': 'ListItem', position: 4, name: `Page ${currentPage}`, item: `https://optibilan.com/blog/${slug}/page/${currentPage}` }] : []),
  ],
};

function formatDate(dateStr: string) {
  try { return new Date(dateStr).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }); }
  catch { return dateStr; }
}
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={currentPage === 1 ? `/blog/${slug}` : `/blog/${slug}/page/${currentPage}`}
  ogImage="/og-blog.png"
  jsonLd={[breadcrumbJsonLd]}
>
  <Header />

  <main>
    <section class="section bg-gradient-to-br from-bleu-signature/5 via-papier to-bleu-lecture/5 rounded-card-lg relative overflow-hidden" aria-labelledby="cat-title">
      <div class="absolute inset-0 bg-gradient-to-r from-bleu-signature/5 via-transparent to-bleu-lecture/5" aria-hidden="true"></div>
      <div class="container relative text-center max-w-3xl mx-auto py-16 md:py-24">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-bleu-clair text-bleu-lecture text-sm font-medium mb-4">
          <Icon name={catInfo.icon} class="w-4 h-4" style="color: var(--color-{catInfo.color});" />
          Catégorie
        </span>
        <h1 id="cat-title" class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-encre mb-4">{catInfo.label}</h1>
        <p class="text-lg text-encre/60 max-w-2xl mx-auto mb-8">
          {catCount} articles pour maîtriser {catInfo.label.toLowerCase()} dans votre pratique.
        </p>
        <a href="/newsletter" class="btn-secondary">
          <Icon name="mail" class="w-4 h-4" /> Recevoir les nouveaux articles
        </a>
      </div>
    </section>

    <section class="section bg-blanc" aria-labelledby="cat-articles-title">
      <div class="container">
        <header class="mb-12">
          <h2 id="cat-articles-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-2">Articles {catInfo.label.toLowerCase()}</h2>
          <p class="text-encre/60">{allCategoryPosts.length} articles publiés</p>
        </header>

        {categoryPosts.length === 0 ? (
          <div class="text-center py-16">
            <Icon name="document" class="w-16 h-16 text-encre/20 mx-auto mb-4" />
            <h3 class="font-display text-xl font-bold text-encre mb-2">Aucun article pour l'instant</h3>
            <p class="text-encre/50">La catégorie {catInfo.label.toLowerCase()} sera bientôt enrichie.</p>
          </div>
        ) : (
          <>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {categoryPosts.map((article, i) => (
                <article class="card-hover group relative overflow-hidden" style="animation-delay: {i * 100}ms">
                  <div class="absolute top-0 left-0 right-0 h-1 bg-[var(--color-bleu-signature)] opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>
                  <div class="p-6 md:p-7">
                    <div class="flex items-center gap-2 mb-3">
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-puce text-xs font-medium" style="color: var(--color-{article.category}); background-color: color-mix(in oklab, var(--color-{article.category}) 10%, transparent);">
                        {categoryLabels[article.category]}
                      </span>
                      <time class="text-xs text-encre/40" datetime={article.date}>{formatDate(article.date)}</time>
                    </div>
                    <h3 class="font-display text-xl font-bold text-encre mb-3 line-clamp-2 group-hover:text-bleu-signature transition-colors">
                      <a href={`/blog/${article.slug}`}>{article.title}</a>
                    </h3>
                    <p class="text-encre/60 leading-relaxed mb-4 line-clamp-3">{article.excerpt}</p>
                    <div class="flex items-center justify-between pt-4 border-t border-encre/10">
                      <div class="flex items-center gap-2">
                        {article.authorAvatar ? (
                          <img src={article.authorAvatar} alt="" class="w-8 h-8 rounded-full" loading="lazy" />
                        ) : (
                          <div class="w-8 h-8 rounded-full bg-gradient-to-br from-bleu-signature to-bleu-lecture flex items-center justify-center text-craie font-bold text-xs">
                            {article.author.split(' ').map(n => n[0]).join('')}
                          </div>
                        )}
                        <span class="text-sm font-medium text-encre/70">{article.author}</span>
                      </div>
                      <span class="text-xs text-encre/40 flex items-center gap-1">
                        <Icon name="clock" class="w-3 h-3" /> {article.readTime}
                      </span>
                    </div>
                  </div>
                  {article.featured && (
                    <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-bleu-signature to-indigo" aria-hidden="true"></div>
                  )}
                </article>
              ))}
            </div>

            {totalPages > 1 && (
              <Pagination
                currentPage={currentPage}
                totalPages={totalPages}
                baseUrl={`/blog/${slug}`}
              />
            )}
          </>
        )}
      </div>
    </section>

    <CTA
      title="Vous voulez ne rien rater ?"
      subtitle="Recevez chaque mardi le meilleur de {catInfo.label.toLowerCase()} directement dans votre boîte mail."
      primaryCTA={{ href: '/newsletter', label: 'S\'abonner à la newsletter' }}
      variant="secondary"
    />
  </main>

  <Footer />
</Layout>

<style is:global>
  .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .line-clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
</style>