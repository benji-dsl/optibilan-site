---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ArticleCard from '@/components/blog/ArticleCard.astro';
import Pagination from '@/components/blog/Pagination.astro';
import Icon from '@/components/Icon.astro';
import { getAllPosts, getCategories, PER_PAGE } from '@/utils/wordpress';

export async function getStaticPaths() {
  const allPosts = await getAllPosts();
  const totalPages = Math.max(1, Math.ceil(allPosts.length / PER_PAGE));
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const { page } = Astro.params;
const currentPage = Number(page);
const allPosts = await getAllPosts();
const categories = await getCategories();

const totalPages = Math.max(1, Math.ceil(allPosts.length / PER_PAGE));
if (!Number.isFinite(currentPage) || currentPage < 2 || currentPage > totalPages) {
  return Astro.redirect('/blog/');
}

const pagePosts = allPosts.slice((currentPage - 1) * PER_PAGE, currentPage * PER_PAGE);

const pageTitle = `Blog Optibilan : articles (page ${currentPage} sur ${totalPages})`;
const pageDescription = `Articles et guides pour coachs sportifs, nutritionnistes et professionnels de la santé : bilans, suivi client, nutrition, préparation mentale et business (page ${currentPage} sur ${totalPages}).`;

const blogJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog Optibilan',
  description: 'Articles et guides pour cabinets, studios et coachs',
  url: `https://optibilan.com/blog/page/${currentPage}/`,
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://optibilan.com/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://optibilan.com/blog/' },
    {
      '@type': 'ListItem',
      position: 3,
      name: `Page ${currentPage}`,
      item: `https://optibilan.com/blog/page/${currentPage}/`,
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={`/blog/page/${currentPage}/`}
  ogImage="/og-blog.png"
  jsonLd={[blogJsonLd, breadcrumbJsonLd]}
>
  <Header />

  <main>
    <section class="section pt-16 md:pt-20 bg-papier">
      <div class="container">
        <div class="max-w-3xl mx-auto text-center">
          <a href="/blog/" class="inline-flex items-center gap-1 text-sm text-encre/50 hover:text-encre transition-colors mb-6">
            <Icon name="arrowRight" class="w-4 h-4 rotate-180" /> Page 1
          </a>
          <h1 class="font-display text-4xl md:text-5xl font-bold text-encre mb-4">Le blog Optibilan</h1>
          <p class="text-lg text-encre/60">
            Conseils, méthodes et études de cas pour coachs, nutritionnistes et professionnels de la santé.
          </p>
          <p class="text-sm text-encre/40 mt-3">
            {allPosts.length} articles, page {currentPage} sur {totalPages}
          </p>
        </div>

        <div class="flex flex-wrap justify-center gap-3 mt-8">
          {categories.map(c => (
            <a
              href={`/blog/category/${c.slug}/`}
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-card border border-encre/10 bg-blanc hover:border-bleu-signature/40 hover:shadow-soft transition-all font-medium text-encre/80"
            >
              <Icon name={c.icon} class="w-4 h-4" style={`color: var(--color-${c.color});`} />
              {c.label}
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section bg-blanc">
      <div class="container">
        <h2 class="sr-only">Articles</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {pagePosts.map(article => (
            <ArticleCard article={article} />
          ))}
        </div>

        <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl="/blog/" />
      </div>
    </section>
  </main>

  <Footer />
</Layout>