---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Hero from '@/components/Hero.astro';
import CTA from '@/components/CTA.astro';
import TrustBar from '@/components/TrustBar.astro';
import Icon from '@/components/Icon.astro';
import Pagination from '@/components/Pagination.astro';
import { getAllPosts, getCategories, CATEGORY_MAP, type OptibilanArticle } from '@/utils/wordpress';

export async function getStaticPaths() {
  const allPosts = await getAllPosts();
  const postsPerPage = 12;
  const totalPages = Math.ceil(allPosts.length / postsPerPage);

  return [
    { params: { page: '1' } },
    ...Array.from({ length: totalPages - 1 }, (_, i) => ({
      params: { page: String(i + 2) },
    })),
  ];
}

const { page } = Astro.params;
const currentPage = page ? parseInt(page as string, 10) : 1;

const pageTitle = currentPage === 1 ? 'Blog - Optibilan' : `Blog - Page ${currentPage} - Optibilan`;
const pageDescription = 'Articles, guides et études de cas pour cabinets, studios et coachs indépendants : nutrition, sport, prépa mentale, santé connectée, croissance business.';

const allPosts = await getAllPosts();
const wpCategories = await getCategories();

const categoryLabels: Record<string, string> = {};
const categories = wpCategories.length > 0 ? wpCategories : Object.entries(CATEGORY_MAP).map(([slug, info]) => ({ slug, ...info, count: 0 }));

for (const cat of categories) {
  categoryLabels[cat.slug] = cat.label;
}

const postsPerPage = 12;
const totalPages = Math.ceil(allPosts.length / postsPerPage);
const start = (currentPage - 1) * postsPerPage;
const articles = allPosts.slice(start, start + postsPerPage);

const blogJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog Optibilan',
  description: 'Articles, guides et études de cas pour cabinets, studios et coachs indépendants',
  url: 'https://optibilan.com/blog',
  blogPosts: articles.slice(0, 10).map(a => ({
    '@type': 'BlogPosting',
    headline: a.title,
    url: `https://optibilan.com/blog/${a.slug}`,
    datePublished: a.date,
    author: { '@type': 'Person', name: a.author },
  })),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://optibilan.com/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://optibilan.com/blog' },
    ...(currentPage > 1 ? [{ '@type': 'ListItem', position: 3, name: `Page ${currentPage}`, item: `https://optibilan.com/blog/page/${currentPage}` }] : []),
  ],
};

function formatDate(dateStr: string) {
  try {
    return new Date(dateStr).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
  } catch {
    return dateStr;
  }
}
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={currentPage === 1 ? '/blog' : `/blog/page/${currentPage}`}
  ogImage="/og-blog.png"
  jsonLd={[blogJsonLd, breadcrumbJsonLd]}
>
  <Header />

  <main>
    <Hero
      title="Ressources pour cabinets 
qui veulent grandir"
      subtitle="Guides pratiques, études de cas, méthodes éprouvées. Écrit par des coachs, pour des coachs."
      badge={allPosts.length > 0 ? `Propulsé par WordPress · ${allPosts.length} articles` : 'Nouveau : newsletter hebdo - 2 000+ abonnés'}
    />

    <TrustBar />

    <section class="section bg-papier" aria-labelledby="categories-title">
      <div class="container">
        <header class="text-center max-w-3xl mx-auto mb-12">
          <h2 id="categories-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">Explorer par catégorie</h2>
          <p class="text-lg text-encre/60">Chaque catégorie regroupe des articles spécialisés pour votre pratique.</p>
        </header>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
          {categories.map(cat => (
            <a href={`/blog/${cat.slug}`} class="card-hover group p-5 md:p-6 text-center" style="--pillar-color: var(--color-{cat.color})">
              <div class="icon-wrapper mx-auto mb-4" aria-hidden="true" style="background-color: color-mix(in oklab, var(--color-{cat.color}) 15%, transparent);">
                <Icon name={cat.icon} class="w-6 h-6" style="color: var(--color-{cat.color});" />
              </div>
              <h3 class="font-display text-lg font-bold text-encre mb-1">{cat.label}</h3>
              <p class="text-sm text-encre/50">{cat.count > 0 ? `${cat.count} articles` : 'Articles'}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section bg-gradient-to-br from-bleu-signature/5 via-papier to-bleu-lecture/5 rounded-card-lg relative overflow-hidden" aria-labelledby="lead-magnet-title">
      <div class="absolute inset-0 bg-gradient-to-r from-bleu-signature/5 via-transparent to-bleu-lecture/5" aria-hidden="true"></div>
      <div class="container relative">
        <div class="grid md:grid-cols-2 gap-8 items-center py-12 md:py-16">
          <div class="text-center md:text-left">
            <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-bleu-clair text-bleu-lecture text-sm font-medium mb-4">
              <Icon name="document" class="w-4 h-4" /> Lead Magnet
            </span>
            <h2 id="lead-magnet-title" class="font-display text-2xl md:text-3xl font-bold text-encre mb-4">
              Le protocole d'onboarding parfait pour un accompagnement à +2000€
            </h2>
            <p class="text-encre/60 leading-relaxed mb-6 max-w-xl mx-auto md:mx-0">
              Le guide PDF (28 pages) utilisé par 150+ cabinets pour structurer leur premier mois d'accompagnement : questionnaire lancement, bilan initial, fixation objectifs, contractualisation, mise en place outils. Téléchargement immédiat, sans engagement.
            </p>
            <div class="flex flex-col sm:flex-row items-center justify-center md:justify-start gap-4">
              <a href="/lead-magnet-onboarding" class="btn-demo w-full sm:w-auto" data-track="blog_lead_magnet">
                Télécharger le guide gratuit
                <Icon name="arrowRight" class="w-5 h-5" />
              </a>
              <a href="/newsletter" class="btn-secondary w-full sm:w-auto">
                Ou s'abonner à la newsletter
              </a>
            </div>
          </div>
          <div class="hidden md:block relative">
            <div class="aspect-[3/4] max-w-md mx-auto bg-encre/5 rounded-lg border border-encre/10 p-4 flex flex-col items-center justify-center relative">
              <div class="absolute inset-0 grid grid-cols-4 gap-2 p-4 opacity-10" aria-hidden="true">
                {[...Array(16)].map((_, i) => (
                  <div key={i} class="col-span-1 h-6 bg-bleu-signature/20 rounded animate-pulse" style={{animationDelay: `${i * 80}ms`}} />
                ))}
              </div>
              <Icon name="document" class="w-16 h-16 text-bleu-signature/30 relative z-10 mb-4" />
              <p class="text-encre/40 text-sm text-center relative z-10">Guide PDF 28 pages - Aperçu</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section bg-blanc" aria-labelledby="articles-title">
      <div class="container">
        <header class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-12">
          <div>
            <h2 id="articles-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-2">Derniers articles</h2>
            <p class="text-encre/60">{allPosts.length} articles publiés - mis à jour chaque semaine</p>
          </div>
          <a href="/newsletter" class="btn-secondary self-start whitespace-nowrap">
            <Icon name="mail" class="w-4 h-4" /> S'abonner à la newsletter
          </a>
        </header>

        {articles.length === 0 ? (
          <div class="text-center py-16">
            <Icon name="document" class="w-16 h-16 text-encre/20 mx-auto mb-4" />
            <h3 class="font-display text-xl font-bold text-encre mb-2">Aucun article pour cette page</h3>
            <p class="text-encre/50">Revenez plus tard ou essayez une autre page.</p>
          </div>
        ) : (
          <>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {articles.map((article, i) => (
                <article class="card-hover group relative overflow-hidden" style="animation-delay: {i * 100}ms">
                  <div class="absolute top-0 left-0 right-0 h-1 bg-[var(--color-bleu-signature)] opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>
                  <div class="p-6 md:p-7">
                    <div class="flex items-center gap-2 mb-3">
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-puce text-xs font-medium" style="color: var(--color-{article.category}); background-color: color-mix(in oklab, var(--color-{article.category}) 10%, transparent);">
                        {categoryLabels[article.category]}
                      </span>
                      <time class="text-xs text-encre/40" datetime={article.date}>{formatDate(article.date)}</time>
                    </div>
                    <h3 class="font-display text-xl font-bold text-encre mb-3 line-clamp-2 group-hover:text-bleu-signature transition-colors">
                      <a href={`/blog/${article.slug}`}>{article.title}</a>
                    </h3>
                    <p class="text-encre/60 leading-relaxed mb-4 line-clamp-3">{article.excerpt}</p>
                    <div class="flex items-center justify-between pt-4 border-t border-encre/10">
                      <div class="flex items-center gap-2">
                        {article.authorAvatar ? (
                          <img src={article.authorAvatar} alt="" class="w-8 h-8 rounded-full" loading="lazy" />
                        ) : (
                          <div class="w-8 h-8 rounded-full bg-gradient-to-br from-bleu-signature to-bleu-lecture flex items-center justify-center text-craie font-bold text-xs">
                            {article.author.split(' ').map(n => n[0]).join('')}
                          </div>
                        )}
                        <span class="text-sm font-medium text-encre/70">{article.author}</span>
                      </div>
                      <span class="text-xs text-encre/40 flex items-center gap-1">
                        <Icon name="clock" class="w-3 h-3" /> {article.readTime}
                      </span>
                    </div>
                  </div>
                  {article.featured && (
                    <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-bleu-signature to-indigo" aria-hidden="true"></div>
                  )}
                  {article.featuredImage && (
                    <div class="absolute top-0 left-0 right-0 h-48 bg-cover bg-center opacity-10" style={`background-image: url(${article.featuredImage})`} aria-hidden="true"></div>
                  )}
                </article>
              ))}
            </div>

            {totalPages > 1 && (
              <Pagination
                currentPage={currentPage}
                totalPages={totalPages}
                baseUrl="/blog"
              />
            )}

            <div class="text-center mt-12">
              <CTA
                variant="secondary"
                title="Vous voulez plus de contenu ?"
                subtitle="Recevez chaque mardi un article, une astuce ou un cas client directement dans votre boîte mail."
                primaryCTA={{ href: '/newsletter', label: 'S\'abonner gratuitement' }}
              />
            </div>
          </>
        )}
      </div>
    </section>

    <CTA
      title="Vous avez un sujet à proposer ?"
      subtitle="On cherche toujours des experts pour écrire : nutrition, sport, mental, santé, business. Contactez l'équipe éditoriale."
      primaryCTA={{ href: '/contact', label: 'Proposer un article' }}
      variant="gold"
    />
  </main>

  <Footer />
</Layout>

<style is:global>
  .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .line-clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
</style>