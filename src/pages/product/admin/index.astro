---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Hero from '../../../components/Hero.astro';
import CTA from '../../../components/CTA.astro';
import Icon from '../../../components/Icon.astro';

const pageTitle = 'Administration - Optibilan';
const pageDescription = 'Gestion utilisateurs, offres d\'appel, marque blanche, modules, conformité, audit. Tout configuré en quelques clics. Pas de ticket support pour changer un paramètre.';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://optibilan.com/' },
    { '@type': 'ListItem', position: 2, name: 'Produit', item: 'https://optibilan.com/produit' },
    { '@type': 'ListItem', position: 3, name: 'Administration', item: 'https://optibilan.com/product/admin' },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/product/admin"
  ogImage="/og-admin.png"
  jsonLd={breadcrumbJsonLd}
>
  <Header />

  <main>
    <Hero
      title="L'admin qui ne vous 
prend pas la tête."
      subtitle="Utilisateurs, offres, marque blanche, modules, conformité, audit. Tout configuré en quelques clics. Pas de ticket support pour changer un paramètre."
      primaryCTA={{ href: '/pricing', label: 'Rejoindre Optibilan' }}
      secondaryCTA={{ href: '/contact', label: 'Essayer Optibilan' }}
    />

    <section class="section bg-blanc" aria-labelledby="problem-title">
      <div class="container max-w-3xl">
        <header class="mb-12">
          <h2 id="problem-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
            Le problème : l'admin qui freine
          </h2>
          <p class="text-lg text-encre/60">
            Changer un rôle = ticket support. Activer un module = migration. Modifier une offre = dev. Configurer la marque blanche = code.<br>
            L'admin devrait être un outil, pas un obstacle.
          </p>
        </header>

        <div class="space-y-8">
          {[
            {
              icon: 'users',
              title: 'Gestion utilisateurs - rôles, spécialités, 2FA',
              desc: 'Création / invitation / suspension / suppression en 1 clic. Rôles : admin, coach, mental, diet, support. Spécialités par praticien (coach force, diet clinique, mental performance…). 2FA TOTP obligatoire admins. Lock 5 échecs/15min. Historique connexions.',
              features: [
                'CRUD utilisateurs complet',
                'Rôles : admin, coach, mental, diet, support',
                '2FA TOTP obligatoire admins',
                'Historique connexions + audit trail',
              ],
              icon: 'users',
            },
            {
              icon: 'document',
              title: 'Offres d\'appel personnalisées',
              desc: 'Créez vos propres offres : nom, description, durée, fréquence appels, tarif, inclus/exclus, renouvellement auto. Associez à un client en 1 clic. Facturation auto selon offre. Historique offres par client.',
              features: [
                'Création libre : nom, durée, fréquence, tarif',
                'Inclus/exclus : modules, limites, support',
                'Renouvellement auto / manuel / prorata',
                'Historique offres par client',
              ],
              icon: 'document',
            },
            {
              icon: 'shield',
              title: 'Marque blanche - configuration complète',
              desc: 'Logo, thème, domaine, vocabulaire, assistant IA, emails, mentions légales, CGV, mentions légales cabinet. Tout dans une seule page. Aperçu temps réel. Activation instantanée. Niveaux : Solo (basique), Studio (avancée), Cabinet (totale).',
              features: [
                'Page unique : logo, thème, domaine, vocabulaire, IA, emails',
                'Aperçu temps réel (desktop + mobile)',
                'Niveaux : Solo / Studio / Cabinet',
                'Activation instantanée, rollback 1-clic',
              ],
              icon: 'shield',
            },
            {
              icon: 'code',
              title: 'Modules on/off - activation instantanée',
              desc: '12 modules activables indépendamment. Pas de migration, pas de surcoût. Désactivation = masquage UI + arrêt des fonctionnalités. Réactivation = restauration données intactes. Audit : qui a activé quoi, quand.',
              features: [
                '12 modules indépendants, toggle unique',
                'Pas de migration, pas de surcoût',
                'Désactivation = masquage UI + fonctionnalités',
                'Audit trail : qui a activé quoi, quand',
              ],
              icon: 'code',
            },
            {
              icon: 'document',
              title: 'Questionnaire lancement configurable',
              desc: 'Champs : texte, nombre, choix unique, choix multiple, fichier, date, échelle, oui/non. Ordre par drag-and-drop. Conditionnels (si objectif = perte de gras → tour de taille requis). Pré-remplissage IA depuis données existantes. Prévisualisation temps réel.',
              features: [
                '8 types champs + conditionnels + drag-and-drop',
                'Logique conditionnelle (si X → afficher Y)',
                'Pré-remplissage IA depuis données',
                'Prévisualisation temps réel',
              ],
              icon: 'document',
            },
            {
              icon: 'lock',
              title: 'RGPD & Conformité - pilotage natif',
              desc: 'Export 1-clic (37 modèles JSON), purge paramétrable (durée + flag), droit à l\'oubli cascade, DPA annexé, mentions légales, registre sous-traitants. Vérifié en CI : aucun modèle cloisonné oublié.',
              features: [
                'Export RGPD 1-clic (37 modèles JSON)',
                'Purge auto paramétrable (durée + flag)',
                'Droit à l\'oubli : suppression cascade',
                'DPA annexé, registre Art.28 à jour',
              ],
              icon: 'lock',
            },
            {
              icon: 'chart',
              title: 'Audit trail double niveau - transparence totale',
              desc: 'Niveau organisation : actions staff (création client, modification bilan, export RGPD, invitation staff…). Niveau plateforme : actions équipe Optibilan (suspension org, changement plan, dépannage, accès support). Horodaté, IP, user-agent, meta JSON. Export CSV/JSON.',
              features: [
                'Niveau org : actions staff (création, modif, export)',
                'Niveau plateforme : actions équipe Optibilan',
                'Horodaté, IP, user-agent, meta JSON',
                'Export CSV/JSON pour conformité',
              ],
              icon: 'chart',
            },
            {
              icon: 'zap',
              title: 'Clés API & Webhooks - pilotage externe',
              desc: 'Webhooks : 8 événements, signature, retry exponentiel, idempotence. API Keys : scopées (clients:read, checkins:write, cron, health:sync…), rotation, expiration, rate limit 120 req/min (Studio), sans limite (Cabinet). Sandbox de test.',
              features: [
                '8 événements : client créé, bilan soumis...',
                'Signature, retry exponentiel, idempotence',
                'Clés API scopées (clients:read, checkins:write...)',
                'Rate limit : 120/min (Studio), illimité (Cabinet)',
              ],
              icon: 'zap',
            },
          ].map((section, i) => (
            <article id={section.icon} class="py-8 border-t border-encre/10 first:border-0">
              <header class="flex items-center gap-4 mb-6">
                <div class="icon-wrapper flex-shrink-0" aria-hidden="true" style="background-color: var(--color-bleu-clair);">
                  <Icon name={section.icon} class="w-7 h-7 text-bleu-signature" />
                </div>
                <div>
                  <h3 class="font-display text-2xl font-bold text-encre">{section.title}</h3>
                  <p class="text-encre/60 mt-1">{section.desc}</p>
                </div>
              </header>
              <ul class="space-y-2 text-encre/60">
                {section.features.map(f => (
                  <li key={f} class="flex items-start gap-2">
                    <Icon name="check" class="w-5 h-5 text-emerald-500 flex-shrink-0 mt-0.5" />
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>

      </div>
    </section>

    <CTA
      title="Prêt à configurer votre cabinet en autonomie ?"
      subtitle="30 minutes pour voir comme l'admin vous rend libre."
      primaryCTA={{ href: '/pricing', label: 'Rejoindre Optibilan' }}
      secondaryCTA={{ href: '/inscription', label: 'Essayer Optibilan' }}
      variant="primary"
    />
  </main>

  <Footer />
</Layout>