---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Hero from '../../../components/Hero.astro';
import BilansScreenshot from '../../../../images/product/bilans.svg?raw';
import CTA from '../../../components/CTA.astro';
import TrustBar from '../../../components/TrustBar.astro';
import Icon from '../../../components/Icon.astro';

const pageTitle = 'Bilans & progression — Optibilan';
const pageDescription = 'Centralisez bilans, mesures, photos, ressentis et habitudes pour comprendre ce qui évolue réellement chez vos clients.';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/product/bilans"
  ogImage="/og-checkins.jpg"
>
  <Header />

  <main>
    <Hero
      title="Tous les progrès de votre client.\nEnfin visibles."
      subtitle="Centralisez bilans, mesures, photos, ressentis et habitudes pour comprendre ce qui évolue réellement — sans reconstruire l'historique."
      badge="Module cœur — Inclus dans toutes les offres"
      primaryCTA={{ href: 'https://calendly.com/optibilan/demo', label: 'Voir les bilans en démo' }}
      secondaryCTA={{ href: '/product/overview', label: 'Retour au produit' }}
    />

    <TrustBar />

    <section class="section bg-blanc" aria-labelledby="problem-title">
      <div class="container max-w-3xl">
        <header class="mb-12">
          <h2 id="problem-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
            Le problème : l'information dispersée
          </h2>
          <p class="text-lg text-encre/60">
            Poids sur un carnet, mensurations dans Excel, photos sur le téléphone, ressentis sur WhatsApp, sommeil sur l'application de la montre…<br>
            Reconstruire l'historique d'un client prend 20 minutes. Le comprendre, encore plus.
          </p>
        </header>

        <div class="space-y-8">
          {[
            {
              title: 'Créer le bilan adapté à votre méthode',
              desc: 'Bilans hebdomadaires 100% configurables : poids, mensurations (tour de taille, hanches, cuisses, bras…), photos avant/après avec alignement visuel, ressenti global, sommeil (qualité, durée), faim, motivation, pas, texte libre. Vous définissez les champs obligatoires, l\'ordre, les conditionnels.',
              features: [
                '30+ champs disponibles, activation granulaire',
                'Questionnaires conditionnels (si objectif = perte de gras → tour de taille requis)',
                'Pré-remplissage IA depuis le bilan précédent',
                'Validation client sur mobile en <2 min',
              ],
              icon: 'document',
            },
            {
              title: 'Suivre l\'évolution dans le temps',
              desc: 'Graphiques interactifs : courbes de poids, mensurations, score de progression composite (adhérence + évolution + bien-être). Zooms temporels (semaine, mois, trimestre, année). Corrélations automatiques (ex: sommeil vs faim, charge vs récupération).',
              features: [
                'Courbes multi-séries synchronisées (poids + tour de taille + sommeil)',
                'Score de progression pondéré configurable',
                'Détection automatique de plateaux et régressions',
                'Export PDF brandé (votre logo, vos couleurs) pour le client',
              ],
              icon: 'chart',
            },
            {
              title: 'Repérer ce qui mérite votre attention',
              desc: 'L\'IA analyse les tendances et signale : stagnation > 2 semaines, baisse motivation > 30%, observance compléments < 70%, désengagement (aucun bilan > 10 jours). Vous intervenez au bon moment, sur le bon client.',
              features: [
                'Alertes temps réel dans le cockpit coach',
                'Seuils personnalisables par client ou global',
                'Historique des alertes traitées / en cours',
                'Corrélation multi-facteurs (ex: charge ↑ + sommeil ↓ = risque)',
              ],
              icon: 'zap',
            },
            {
              title: 'Partager un bilan clair avec le client',
              desc: 'Rapport mensuel/trimestriel auto-généré : graphiques, photos, commentaires coach, prochaines étapes. Le client reçoit un lien sécurisé, sans connexion. Version PDF brandée pour impression.',
              features: [
                'Branding automatique (votre logo, couleurs, domaine)',
                'Niveau de détail configurable (complet / synthèse)',
                'Commentaires coach visibles / privés',
                'Partage par email, lien, ou espace client',
              ],
              icon: 'users',
            },
            {
              title: 'Automatiser sans déshumaniser',
              desc: 'Rappels bilans (email/push/Slack), relances inactifs, création bilans récurrents, pré-remplissage depuis le dernier. Vous gardez le contrôle : validation avant envoi, commentaires personnalisés.',
              features: [
                'Cadence configurable par client ou par offre',
                'Relances multi-canal (email, push, Slack équipe)',
                'Bilan pré-rempli = 30 sec pour le client',
                'Journal d\'audit : qui a fait quoi, quand',
              ],
              icon: 'calendar',
            },
          ].map((section, i) => (
            <article id={section.icon} class="py-8 border-t border-encre/10 first:border-0">
              <header class="flex items-center gap-4 mb-6">
                <div class="icon-wrapper flex-shrink-0" aria-hidden="true" style="background-color: var(--color-bleu-clair);">
                  <Icon name={section.icon} class="w-7 h-7 text-bleu-signature" />
                </div>
                <div>
                  <h3 class="font-display text-2xl font-bold text-encre">{section.title}</h3>
                  <p class="text-encre/60 mt-1">{section.desc}</p>
                </div>
              </header>
              <ul class="space-y-2 text-encre/60">
                {section.features.map(f => (
                  <li key={f} class="flex items-start gap-2">
                    <Icon name="check" class="w-5 h-5 text-emerald-500 flex-shrink-0 mt-0.5" />
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>

        <div class="mt-12 p-6 rounded-xl bg-papier border border-encre/10">
          <h3 class="font-display text-xl font-bold text-encre mb-3">Spécifications techniques</h3>
          <ul class="space-y-2 text-sm text-encre/60">
            <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 rounded-full bg-bleu-signature flex-shrink-0 mt-1.5" /> 30+ points de données par bilan, historique illimité</li>
            <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 rounded-full bg-bleu-signature flex-shrink-0 mt-1.5" /> API : GET/POST /api/v1/clients/:id/checkins</li>
            <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 rounded-full bg-bleu-signature flex-shrink-0 mt-1.5" /> Webhook checkin.submitted temps réel</li>
            <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 rounded-full bg-bleu-signature flex-shrink-0 mt-1.5" /> Export RGPD inclus (modèle Checkin)</li>
          </ul>
        </div>
      </div>
    </section>

    <CTA
      title="Prêt à voir les bilans en action ?"
      subtitle="30 minutes pour découvrir comment centraliser le suivi de vos clients."
      primaryCTA={{ href: 'https://calendly.com/optibilan/demo', label: 'Voir les bilans en démo' }}
      variant="primary"
    />
  </main>

  <Footer />
</Layout>