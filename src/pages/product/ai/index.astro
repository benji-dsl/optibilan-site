---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Hero from '../../../components/Hero.astro';
import AiScreenshot from '../../../../images/product/ai.svg?raw';
import CTA from '../../../components/CTA.astro';
import TrustBar from '../../../components/TrustBar.astro';
import Icon from '../../../components/Icon.astro';

const pageTitle = 'IA & Automatisations - Optibilan';
const pageDescription = "L'IA prépare, le professionnel décide. Structuration documents, synthèse bilans, alertes proactives. Transparence totale sur le pipeline IA.";

---
<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/product/ai"
  ogImage="/og-ai.jpg"
>
  <Header />

  <main>
    <Hero
      title="L'IA prépare.<br>Le professionnel décide."
      subtitle="Structuration documents, synthèse bilans, alertes proactives. Transparence totale sur le pipeline IA : fournisseur, données envoyées, rétention, pseudonymisation."
      badge="Module IA - Inclus selon offre (1k/5k/20k msg/mois)"
      primaryCTA={{ href: 'https://calendly.com/optibilan/demo', label: "Voir l'IA en démo" }}
      secondaryCTA={{ href: '/product/overview', label: 'Retour au produit' }}
    />

    <TrustBar />

    <section class="section bg-gradient-to-br from-encre/5 via-papier to-indigo/5 rounded-card-lg relative overflow-hidden" aria-labelledby="ai-disclaimer-title">
      <div class="container relative py-6 px-6 md:py-8 md:px-8">
        <div class="flex items-start gap-4 p-4 bg-encre/5 rounded-lg border border-encre/10">
          <Icon name="brain" class="w-6 h-6 text-indigo flex-shrink-0 mt-0.5" />
          <div>
            <h3 id="ai-disclaimer-title" class="font-semibold text-encre mb-1">Transparence & cadre IA</h3>
            <p class="text-encre/70 text-sm">
              <strong>L'IA n'établit pas de diagnostic. Elle n'agit pas de façon autonome. Le professionnel garde le contrôle total.</strong><br>
              Fournisseur : Anthropic (Claude) via API Enterprise. Région : US (zero-retention garanti). Données pseudonymisées avant envoi. DPA signé. SCC 2021 + Addendum UK.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section bg-blanc" aria-labelledby="ai-problem-title">
      <div class="container max-w-3xl">
        <header class="mb-12">
          <h2 id="ai-problem-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
            Ce que l'IA fait (et ne fait pas)
          </h2>
          <p class="text-lg text-encre/60">
            L'IA réduit le travail répétitif, structure l'information et fait remonter les éléments utiles.<br>
            Elle assiste le professionnel. Elle ne prend pas la décision à sa place.
          </p>
        </header>

        <div class="grid md:grid-cols-2 gap-6 mb-16">
          <article class="p-6 rounded-xl border border-encre/10 bg-emerald-50">
            <h3 class="font-display text-xl font-bold text-emerald-700 mb-3 flex items-center gap-2">
              <Icon name="check" class="w-5 h-5" /> Ce que l'IA FAIT
            </h3>
            <ul class="space-y-2 text-encre/70">
              <li class="flex items-start gap-2"><Icon name="check" class="w-4 h-4 text-emerald-500 flex-shrink-0" /> Lit PDF → extrait, structure, pré-remplit</li>
              <li class="flex items-start gap-2"><Icon name="check" class="w-4 h-4 text-emerald-500 flex-shrink-0" /> Génère synthèses bilans pro + client</li>
              <li class="flex items-start gap-2"><Icon name="check" class="w-4 h-4 text-emerald-500 flex-shrink-0" /> Détecte signaux faibles (stagnation, motivation ↓)</li>
              <li class="flex items-start gap-2"><Icon name="check" class="w-4 h-4 text-emerald-500 flex-shrink-0" /> Propose ajustements nutrition, charge, récup</li>
              <li class="flex items-start gap-2"><Icon name="check" class="w-4 h-4 text-emerald-500 flex-shrink-0" /> Structure prompts par cabinet</li>
            </ul>
          </article>
          <article class="p-6 rounded-xl border border-encre/10 bg-rose-50">
            <h3 class="font-display text-xl font-bold text-rose-700 mb-3 flex items-center gap-2">
              <Icon name="shield" class="w-5 h-5" /> Ce que l'IA NE FAIT PAS
            </h3>
            <ul class="space-y-2 text-encre/70">
              <li class="flex items-start gap-2"><Icon name="shield" class="w-4 h-4 text-rose-500 flex-shrink-0" /> N\'établit PAS de diagnostic</li>
              <li class="flex items-start gap-2"><Icon name="shield" class="w-4 h-4 text-rose-500 flex-shrink-0" /> Ne prescrit PAS (médicaments, doses, exercices)</li>
              <li class="flex items-start gap-2"><Icon name="shield" class="w-4 h-4 text-rose-500 flex-shrink-0" /> N\'agit PAS de façon autonome</li>
              <li class="flex items-start gap-2"><Icon name="shield" class="w-4 h-4 text-rose-500 flex-shrink-0" /> Ne remplace PAS le jugement pro</li>
              <li class="flex items-start gap-2"><Icon name="shield" class="w-4 h-4 text-rose-500 flex-shrink-0" /> N\'entraîne PAS sur vos données</li>
            </ul>
          </article>
        </div>

        <h2 class="font-display text-2xl font-bold text-encre mb-8">Trois usages concrets</h2>

        <div class="space-y-8">
          <article class="py-8 border-t border-encre/10 first:border-0">
            <header class="flex items-center gap-4 mb-6">
              <div class="icon-wrapper flex-shrink-0" aria-hidden="true" style="background-color: var(--color-bleu-clair);">
                <Icon name="document" class="w-7 h-7 text-indigo" />
              </div>
              <div>
                <h3 class="font-display text-2xl font-bold text-encre">PDF → Données structurées</h3>
                <p class="text-encre/60 mt-1">Le client/pro upload un bilan sanguin, une lettre médecin, un compte-rendu. L'IA extrait : biomarqueurs, valeurs, unités, seuils, commentaires. Pré-remplit les champs dans Optibilan. Flags anomalies selon seuils configurés. Gain : 15 min → 30 sec par document.</p>
              </div>
            </header>
            <ul class="space-y-2 text-encre/60">
              <li class="flex items-start gap-2"><Icon name="check" class="w-5 h-5 text-emerald-500 flex-shrink-0" /> OCR + extraction structurée (biomarqueurs, valeurs)</li>
              <li class="flex items-start gap-2"><Icon name="check" class="w-5 h-5 text-emerald-500 flex-shrink-0" /> Flags auto : rouge/orange/vert selon seuils</li>
              <li class="flex items-start gap-2"><Icon name="check" class="w-5 h-5 text-emerald-500 flex-shrink-0" /> Pré-remplissage champs (gain 95% temps)</li>
              <li class="flex items-start gap-2"><Icon name="check" class="w-5 h-5 text-emerald-500 flex-shrink-0" /> Historique imports pour audit</li>
            </ul>
          </article>
          <article class="py-8 border-t border-encre/10 first:border-0">
            <header class="flex items-center gap-4 mb-6">
              <div class="icon-wrapper flex-shrink-0" aria-hidden="true" style="background-color: var(--color-bleu-clair);">
                <Icon name="chart" class="w-7 h-7 text-indigo" />
              </div>
              <div>
                <h3 class="font-display text-2xl font-bold text-encre">Bilan → Synthèse</h3>
                <p class="text-encre/60 mt-1">À chaque bilan client, l'IA génère : résumé pro (points d'attention, tendances, alertes), résumé client (langage accessible, encouragements, prochaines étapes). Ton configurable par cabinet (formel, bienveillant, direct). Gain : 10 min → 30 sec par bilan.</p>
              </div>
            </header>
            <ul class="space-y-2 text-encre/60">
              <li class="flex items-start gap-2"><Icon name="check" class="w-5 h-5 text-emerald-500 flex-shrink-0" /> Double sortie : pro + client (langage adapté)</li>
              <li class="flex items-start gap-2"><Icon name="check" class="w-5 h-5 text-emerald-500 flex-shrink-0" /> Ton personnalisable par cabinet</li>
              <li class="flex items-start gap-2"><Icon name="check" class="w-5 h-5 text-emerald-500 flex-shrink-0" /> Inclut : évolution, alertes, prochaines étapes</li>
              <li class="flex items-start gap-2"><Icon name="check" class="w-5 h-5 text-emerald-500 flex-shrink-0" /> Validation pro avant envoi</li>
            </ul>
          </article>
          <article class="py-8 border-t border-encre/10 first:border-0">
            <header class="flex items-center gap-4 mb-6">
              <div class="icon-wrapper flex-shrink-0" aria-hidden="true" style="background-color: var(--color-bleu-clair);">
                <Icon name="zap" class="w-7 h-7 text-indigo" />
              </div>
              <div>
                <h3 class="font-display text-2xl font-bold text-encre">Données → Proposition / Alerte</h3>
                <p class="text-encre/60 mt-1">L'IA surveille en continu : stagnation > 2 sem, motivation ↓ > 30%, observance < 70%, corrélation charge/sommeil/RPE anormale. Génère : alerte cockpit pro, proposition d'ajustement (charge, récup, nutrition), suggestion message client. Le pro valide / modifie / rejette.</p>
              </div>
            </header>
            <ul class="space-y-2 text-encre/60">
              <li class="flex items-start gap-2"><Icon name="check" class="w-5 h-5 text-emerald-500 flex-shrink-0" /> Surveillance continue (bilans + sync wearables)</li>
              <li class="flex items-start gap-2"><Icon name="check" class="w-5 h-5 text-emerald-500 flex-shrink-0" /> Types : stagnation, désengagement, observance, surentraînement</li>
              <li class="flex items-start gap-2"><Icon name="check" class="w-5 h-5 text-emerald-500 flex-shrink-0" /> Sortie : alerte + proposition concrète</li>
              <li class="flex items-start gap-2"><Icon name="check" class="w-5 h-5 text-emerald-500 flex-shrink-0" /> Validation pro obligatoire</li>
            </ul>
          </article>
        </div>

        <div class="mt-12 p-6 rounded-xl bg-papier border border-encre/10">
          <h3 class="font-display text-xl font-bold text-encre mb-3">Pipeline IA - Transparence technique</h3>
          <ul class="space-y-2 text-sm text-encre/60">
            <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 rounded-full bg-indigo flex-shrink-0 mt-1.5" /> Fournisseur : Anthropic (Claude) - API Enterprise</li>
            <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 rounded-full bg-indigo flex-shrink-0 mt-1.5" /> US - Zero-retention garanti</li>
            <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 rounded-full bg-indigo flex-shrink-0 mt-1.5" /> Pseudonymisation avant envoi (nom → ID)</li>
            <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 rounded-full bg-indigo flex-shrink-0 mt-1.5" /> DPA + SCC 2021 + mesures techniques</li>
            <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 rounded-full bg-indigo flex-shrink-0 mt-1.5" /> Prompting par cabinet : vocab, méthode, ton</li>
            <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 rounded-full bg-indigo flex-shrink-0 mt-1.5" /> Plafonds : Solo 1k / Studio 5k / Cabinet 20k</li>
            <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 rounded-full bg-indigo flex-shrink-0 mt-1.5" /> Désactivable par cabinet (toggle admin)</li>
          </ul>
        </div>
      </div>
    </section>

    <CTA
      title="Vous voulez tester l'IA sur VOS documents ?"
      subtitle="30 minutes pour voir comment l'IA structure vos bilans, analyses et lettres."
      primaryCTA={{ href: 'https://calendly.com/optibilan/demo', label: 'Réserver une démo IA' }}
      variant="primary"
    />
  </main>

  <Footer />
</Layout>