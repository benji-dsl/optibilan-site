---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Hero from '../../../components/Hero.astro';
import CTA from '../../../components/CTA.astro';
import TrustBar from '../../../components/TrustBar.astro';
import Icon from '../../../components/Icon.astro';

const pageTitle = 'Journal Coaching & CRM - Optibilan';
const pageDescription = 'Entrées typées, pièces jointes, partage client, sync Notion, pipeline commercial. Le CRM intégré pour les professionnels de l\'accompagnement.';

---
<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/product/crm"
  ogImage="/og-crm.jpg"
>
  <Header />

  <main>
    <Hero
      title="Le CRM intégré
pour les pros
de l'accompagnement."
      subtitle="Entrées typées, pièces jointes, partage client, sync Notion, pipeline commercial. Tout dans le dossier client."
      badge="Module cœur - Inclus dans toutes les offres"
      primaryCTA={{ href: 'https://calendly.com/optibilan/demo', label: 'Voir le CRM en démo' }}
      secondaryCTA={{ href: '/product/overview', label: 'Retour au produit' }}
    />

    <TrustBar />

    <section class="section bg-blanc" aria-labelledby="problem-title">
      <div class="container max-w-3xl">
        <header class="mb-12">
          <h2 id="problem-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
            Le problème : l'info éparpillée
          </h2>
          <p class="text-lg text-encre/60">
            Notes sur cahier, documents dans Drive, emails dans Gmail, pipeline dans Notion, relances dans la tête…<br>
            L'info n'est jamais là quand vous en avez besoin. L'équipe n'est pas alignée.
          </p>
        </header>

        <div class="space-y-8">
          {[
            {
              icon: 'lock',
              title: 'Entrées typées - structurées, pas du vrac',
              desc: 'Types prédéfinis : lancement, suivi hebdo, bilan mensuel, micronutrition, optimisation, sport, questionnaire, prépa mentale, note libre. Chaque type a ses champs dédiés. Recherche full-text instantanée.',
              features: [
                '9 types entrées + note libre',
                'Champs conditionnels par type',
                'Tags personnalisés + filtres combinés',
                'Recherche full-text PostgreSQL',
              ],
              icon: 'lock',
            },
            {
              icon: 'document',
              title: 'Pièces jointes - tout centralisé',
              desc: 'PDF (analyses, lettres), images (photos, scans), audio (mémos vocaux), vidéo (technique). Stockage Supabase bucket privé, CDN Cloudflare. Aperçu in-app, téléchargement sécurisé (URL signée courte). OCR auto sur PDF/images.',
              features: [
                'Types : PDF, images, audio, vidéo (100Mo)',
                'Stockage Supabase + CDN (URL signée 1h)',
                'Aperçu in-app (PDF, images, audio, vidéo)',
                'OCR auto sur PDF/images',
              ],
              icon: 'document',
            },
            {
              icon: 'users',
              title: 'Partage client - visible / privé / commentaire',
              desc: 'Chaque entrée : visible client (il la voit dans son espace), privée staff (équipe seulement), commentaire seul (client voit juste "votre coach a ajouté une note"). Notification push/email au client si visible. Historique des partages.',
              features: [
                '3 niveaux : visible / privé / commentaire',
                'Notification push/email si partage visible',
                'Journal des partages complet',
                'Révocation partage possible',
              ],
              icon: 'users',
            },
            {
              icon: 'chart',
              title: 'Pipeline CRM - du prospect au client fidèle',
              desc: 'Stages : prospect → essai → client actif → risque churn → réactivation → archive. Valeur vie client (LTV) calculée auto. Segmentation RFM (récence, fréquence, montant). Alertes churn risk (inactivité, signaux faibles). Relances auto : inactivité 7/14/30j, anniversaire, renouvellement, upsell.',
              features: [
                '6 stages personnalisables + archivage',
                'LTV auto + segmentation RFM',
                'Alertes churn risk (inactivité, signaux faibles)',
                'Relances auto : 7/14/30j, anniversaire, upsell',
              ],
              icon: 'chart',
            },
            {
              icon: 'code',
              title: 'Sync Notion via n8n - zéro double saisie',
              desc: 'Webhook note.created → base Notion (client, coach, date, type, contenu, visibilité, tags). Bidirectionnel possible (création client Notion → création client Optibilan). Mapping champs personnalisable. Filtres par visibilité (privé staff non sync).',
              features: [
                'Webhook note.created → Notion (champs config)',
                'Bidirectionnel : Notion → Optibilan',
                'Mapping champs personnalisable',
                'Filtre : privé staff = non sync',
              ],
              icon: 'code',
            },
            {
              icon: 'lock',
              title: 'Relances & tâches - rien ne tombe à l\'eau',
              desc: 'Tâches assignées (coach, admin, mental, diet) avec échéance, priorité, recurrence. Vue "Mes tâches" par staff. Rappels Slack/email/push. Checklist onboarding client (questionnaire, analyses, contrat, outils). Checklist offboarding (export, purge, feedback).',
              features: [
                'Tâches : assigné, échéance, priorité, récurrence',
                'Vue "Mes tâches" par staff',
                'Rappels Slack, email, push, ICS',
                'Checklists onboarding/offboarding',
              ],
              icon: 'lock',
            },
          ].map((section, i) => (
            <article id={section.icon} class="py-8 border-t border-encre/10 first:border-0">
              <header class="flex items-center gap-4 mb-6">
                <div class="icon-wrapper flex-shrink-0" aria-hidden="true" style="background-color: var(--color-bleu-clair);">
                  <Icon name={section.icon} class="w-7 h-7 text-bleu-signature" />
                </div>
                <div>
                  <h3 class="font-display text-2xl font-bold text-encre">{section.title}</h3>
                  <p class="text-encre/60 mt-1">{section.desc}</p>
                </div>
              </header>
              <ul class="space-y-2 text-encre/60">
                {section.features.map(f => (
                  <li key={f} class="flex items-start gap-2">
                    <Icon name="check" class="w-5 h-5 text-emerald-500 flex-shrink-0 mt-0.5" />
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>

        <div class="mt-12 p-6 rounded-xl bg-papier border border-encre/10">
          <h3 class="font-display text-xl font-bold text-encre mb-3">Spécifications techniques</h3>
          <ul class="space-y-2 text-sm text-encre/60">
            <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 rounded-full bg-bleu-signature flex-shrink-0 mt-1.5" /> Full-text search PostgreSQL (tsvector) sur entrées + pièces jointes OCR</li>
            <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 rounded-full bg-bleu-signature flex-shrink-0 mt-1.5" /> API journal : entrées, pièces jointes, partage, tags</li>
            <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 rounded-full bg-bleu-signature flex-shrink-0 mt-1.5" /> Webhook note.created / note.shared</li>
            <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 rounded-full bg-bleu-signature flex-shrink-0 mt-1.5" /> API CRM : pipeline, stages, LTV, RFM, tâches</li>
          </ul>
        </div>
      </div>
    </section>

    <CTA
      title="Prêt à centraliser votre suivi client ?"
      subtitle="30 minutes pour voir comment structurer journal, documents et pipeline."
      primaryCTA={{ href: 'https://calendly.com/optibilan/demo', label: 'Réserver une démo CRM' }}
      variant="primary"
    />
  </main>

  <Footer />
</Layout>