---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Hero from '../../../components/Hero.astro';
import CTA from '../../../components/CTA.astro';
import Icon from '../../../components/Icon.astro';

const pageTitle = 'Marque blanche - Optibilan';
const pageDescription = 'Optibilan disparaît. Votre marque reste. Logo, couleurs, domaine, vocabulaire, assistant IA, emails, mentions légales, CGV - tout est à vous.';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://optibilan.com/' },
    { '@type': 'ListItem', position: 2, name: 'Produit', item: 'https://optibilan.com/produit' },
    { '@type': 'ListItem', position: 3, name: 'Marque blanche', item: 'https://optibilan.com/product/white-label' },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/product/white-label"
  ogImage="/og-white-label.png"
  jsonLd={breadcrumbJsonLd}
>
  <Header />

  <main>
    <Hero
      title="Votre méthode. 
Votre marque."
      subtitle="Logo, couleurs, domaine, vocabulaire, assistant IA, emails, mentions légales, CGV - tout est à vous. Vos clients ne voient jamais Optibilan."
      primaryCTA={{ href: '/pricing', label: 'Rejoindre Optibilan' }}
      secondaryCTA={{ href: '/contact', label: 'Essayer Optibilan' }}
    />

    <section class="section bg-blanc" aria-labelledby="comparison-title">
      <div class="container max-w-4xl">
        <header class="text-center mb-16">
          <h2 id="comparison-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
            AVANT
          </h2>
          <p class="text-lg text-encre/60 max-w-2xl mx-auto">
            Montrez à vos clients VOTRE méthode, VOS couleurs, VOTRE domaine. Optibilan s'efface totalement.
          </p>
        </header>

        <div class="grid md:grid-cols-2 gap-8 mb-16">
          <article class="p-6 rounded-xl border border-encre/10 bg-rose-50">
            <h3 class="font-display text-xl font-bold text-rose-700 mb-4 flex items-center gap-2">
              <Icon name="shield" class="w-5 h-5" /> AVANT
            </h3>
            <ul class="space-y-2 text-encre/70">
              <li class="flex items-start gap-2"><Icon name="shield" class="w-4 h-4 text-rose-500 flex-shrink-0" /> Logo Optibilan visible</li>
              <li class="flex items-start gap-2"><Icon name="shield" class="w-4 h-4 text-rose-500 flex-shrink-0" /> Couleurs Optibilan (bleu/indigo)</li>
              <li class="flex items-start gap-2"><Icon name="shield" class="w-4 h-4 text-rose-500 flex-shrink-0" /> Domaine app.optibilan.com</li>
              <li class="flex items-start gap-2"><Icon name="shield" class="w-4 h-4 text-rose-500 flex-shrink-0" /> Vocabulaire "coaché / client"</li>
              <li class="flex items-start gap-2"><Icon name="shield" class="w-4 h-4 text-rose-500 flex-shrink-0" /> Assistant IA "Optibilan"</li>
              <li class="flex items-start gap-2"><Icon name="shield" class="w-4 h-4 text-rose-500 flex-shrink-0" /> Emails @optibilan.com</li>
              <li class="flex items-start gap-2"><Icon name="shield" class="w-4 h-4 text-rose-500 flex-shrink-0" /> Mentions légales Optibilan</li>
            </ul>
          </article>
          <article class="p-6 rounded-xl border border-encre/10 bg-emerald-50">
            <h3 class="font-display text-xl font-bold text-emerald-700 mb-4 flex items-center gap-2">
              <Icon name="check" class="w-5 h-5" /> AVEC OPTIBILAN
            </h3>
            <ul class="space-y-2 text-encre/70">
              <li class="flex items-start gap-2"><Icon name="check" class="w-4 h-4 text-emerald-500 flex-shrink-0" /> VOTRE logo</li>
              <li class="flex items-start gap-2"><Icon name="check" class="w-4 h-4 text-emerald-500 flex-shrink-0" /> VOS couleurs (thème complet ou palette custom)</li>
              <li class="flex items-start gap-2"><Icon name="check" class="w-4 h-4 text-emerald-500 flex-shrink-0" /> VOTRE domaine (app.votrecabinet.fr)</li>
              <li class="flex items-start gap-2"><Icon name="check" class="w-4 h-4 text-emerald-500 flex-shrink-0" /> VOTRE vocabulaire (membre / patient / client / sportif…)</li>
              <li class="flex items-start gap-2"><Icon name="check" class="w-4 h-4 text-emerald-500 flex-shrink-0" /> VOTRE assistant IA (prénom, ton, spécialité)</li>
              <li class="flex items-start gap-2"><Icon name="check" class="w-4 h-4 text-emerald-500 flex-shrink-0" /> VOS emails (@votrecabinet.fr)</li>
              <li class="flex items-start gap-2"><Icon name="check" class="w-4 h-4 text-emerald-500 flex-shrink-0" /> VOS mentions légales, CGV, RGPD</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section class="section bg-papier" aria-labelledby="visual-title">
      <div class="container">
        <header class="text-center max-w-3xl mx-auto mb-16">
          <h2 id="visual-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
            Voir pour croire
          </h2>
          <p class="text-lg text-encre/60 max-w-2xl mx-auto mb-12">
            La marque blanche, c'est visuel. Voici votre cabinet sur Optibilan.
          </p>
        </header>

        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div class="aspect-square max-w-md mx-auto rounded-xl border border-encre/10 bg-encre/5 overflow-hidden relative">
            <div class="absolute inset-0 flex items-center justify-center">
              <img src="/images/product/white-label.svg" alt="Aperçu de la marque blanche : l'espace client au nom de votre cabinet" class="w-full h-full object-contain p-6" loading="lazy" />
            </div>
          </div>
          <div>
            <h3 class="font-display text-2xl font-bold text-encre mb-4">Desktop + mobile, votre cabinet partout</h3>
            <ul class="space-y-3 text-encre/60 mb-8">
              <li class="flex items-start gap-3"><Icon name="check" class="w-5 h-5 text-bleu-signature flex-shrink-0 mt-0.5" /> Logo, couleurs, thème complet</li>
              <li class="flex items-start gap-3"><Icon name="check" class="w-5 h-5 text-bleu-signature flex-shrink-0 mt-0.5" /> Domaine custom (app.votrecabinet.fr)</li>
              <li class="flex items-start gap-3"><Icon name="check" class="w-5 h-5 text-bleu-signature flex-shrink-0 mt-0.5" /> Emails @votrecabinet.fr (DKIM/SPF/DMARC)</li>
              <li class="flex items-start gap-3"><Icon name="check" class="w-5 h-5 text-bleu-signature flex-shrink-0 mt-0.5" /> Vocabulaire : membre / patient / client / sportif</li>
              <li class="flex items-start gap-3"><Icon name="check" class="w-5 h-5 text-bleu-signature flex-shrink-0 mt-0.5" /> Assistant IA nommé, mentions légales, CGV à vous</li>
            </ul>
            <p class="text-sm text-encre/50">Activation instantanée. Aucune ligne de code.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section bg-papier" aria-labelledby="modules-title">
      <div class="container">
        <header class="text-center max-w-3xl mx-auto mb-16">
          <h2 id="modules-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
            Ce qui est personnalisable
          </h2>
          <p class="text-lg text-encre/60">Tout se configure dans l'admin, sans code. Activation instantanée.</p>
        </header>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {[
            { icon: 'logo', title: 'Logo & Favicon', desc: 'Upload SVG/PNG. Favicon auto-généré. Responsive.' },
            { icon: 'chart', title: 'Thème complet', desc: 'Couleurs primaires, secondaires, backgrounds, bordures. Mode clair/sombre. Palette custom ou presets.' },
            { icon: 'globe', title: 'Domaine custom', desc: 'Sous-domaine (app.votrecabinet.fr) ou domaine racine. DNS géré, SSL auto (Let\'s Encrypt / Cloudflare).' },
            { icon: 'document', title: 'Vocabulaire', desc: 'coaché / patient / membre / client / sportif… Partout : UI, emails, notifications, PDF.' },
            { icon: 'brain', title: 'Assistant IA', desc: 'Prénom, ton (formel/bienveillant/direct), spécialité, garde-fous, exemples de réponses.' },
            { icon: 'mail', title: 'Emails transactionnels', desc: 'Expéditeur @votrecabinet.fr. Templates HTML brandés. DKIM/SPF/DMARC sur votre domaine.' },
            { icon: 'shield', title: 'Mentions & CGV', desc: 'Vos mentions légales, CGV, politique confidentialité. Injectées dans l\'espace client et emails.' },
            { icon: 'code', title: 'CSS/JS custom (Cabinet)', desc: 'Injection code dans <head> / <body>. Tracking, chat, design avancé. Sans casser les mises à jour.' },
          ].map((item, i) => (
            <article class="card-hover p-6 text-center group" style="animation-delay: {i * 100}ms">
              <div class="icon-wrapper mx-auto mb-4" aria-hidden="true" style="background-color: var(--color-bleu-clair);">
                <Icon name={item.icon} class="w-7 h-7 text-bleu-signature" />
              </div>
              <h3 class="font-display text-lg font-bold text-encre mb-2">{item.title}</h3>
              <p class="text-sm text-encre/50">{item.desc}</p>
            </article>
          ))}
        </div>

        <div class="mt-12 p-6 rounded-xl bg-gradient-to-br from-bleu-signature/5 via-papier to-bleu-lecture/5 border border-encre/10">
          <h3 class="font-display text-xl md:text-2xl font-bold text-encre mb-4">Niveaux de marque blanche par offre</h3>
          <div class="grid md:grid-cols-3 gap-6 mt-6 text-sm">
            <article class="p-4 rounded-lg bg-blanc border border-encre/10">
              <h4 class="font-semibold text-encre mb-3">Solo - Basique</h4>
              <ul class="space-y-2 text-encre/60">
                <li class="flex items-center gap-2"><Icon name="check" class="w-4 h-4 text-emerald-500" /> Logo</li>
                <li class="flex items-center gap-2"><Icon name="check" class="w-4 h-4 text-emerald-500" /> Couleurs</li>
                <li class="flex items-center gap-2"><Icon name="shield" class="w-4 h-4 text-rose-500" /> Domaine custom</li>
                <li class="flex items-center gap-2"><Icon name="shield" class="w-4 h-4 text-rose-500" /> Vocabulaire</li>
                <li class="flex items-center gap-2"><Icon name="shield" class="w-4 h-4 text-rose-500" /> Assistant IA</li>
                <li class="flex items-center gap-2"><Icon name="shield" class="w-4 h-4 text-rose-500" /> Emails custom</li>
              </ul>
            </article>
            <article class="p-4 rounded-lg bg-blanc border border-encre/10">
              <h4 class="font-semibold text-encre mb-3">Studio - Avancée</h4>
              <ul class="space-y-2 text-encre/60">
                <li class="flex items-center gap-2"><Icon name="check" class="w-4 h-4 text-emerald-500" /> Logo</li>
                <li class="flex items-center gap-2"><Icon name="check" class="w-4 h-4 text-emerald-500" /> Couleurs</li>
                <li class="flex items-center gap-2"><Icon name="check" class="w-4 h-4 text-emerald-500" /> Domaine custom</li>
                <li class="flex items-center gap-2"><Icon name="check" class="w-4 h-4 text-emerald-500" /> Vocabulaire</li>
                <li class="flex items-center gap-2"><Icon name="check" class="w-4 h-4 text-emerald-500" /> Assistant IA</li>
                <li class="flex items-center gap-2"><Icon name="shield" class="w-4 h-4 text-rose-500" /> Emails custom</li>
              </ul>
            </article>
            <article class="p-4 rounded-lg bg-blanc border border-encre/10 ring-2 ring-bleu-signature">
              <h4 class="font-semibold text-encre mb-3">Cabinet - Totale</h4>
              <ul class="space-y-2 text-encre/60">
                <li class="flex items-center gap-2"><Icon name="check" class="w-4 h-4 text-emerald-500" /> Logo</li>
                <li class="flex items-center gap-2"><Icon name="check" class="w-4 h-4 text-emerald-500" /> Couleurs</li>
                <li class="flex items-center gap-2"><Icon name="check" class="w-4 h-4 text-emerald-500" /> Domaine custom</li>
                <li class="flex items-center gap-2"><Icon name="check" class="w-4 h-4 text-emerald-500" /> Vocabulaire</li>
                <li class="flex items-center gap-2"><Icon name="check" class="w-4 h-4 text-emerald-500" /> Assistant IA</li>
                <li class="flex items-center gap-2"><Icon name="check" class="w-4 h-4 text-emerald-500" /> Emails @votrecabinet.fr</li>
                <li class="flex items-center gap-2"><Icon name="check" class="w-4 h-4 text-emerald-500" /> Mentions légales / CGV</li>
                <li class="flex items-center gap-2"><Icon name="check" class="w-4 h-4 text-emerald-500" /> CSS/JS custom</li>
              </ul>
            </article>
          </div>
        </div>
      </div>
    </section>

    <CTA
      title="Vous voulez voir VOTRE marque sur Optibilan ?"
      subtitle="30 minutes pour configurer votre marque blanche en live."
      primaryCTA={{ href: '/pricing', label: 'Rejoindre Optibilan' }}
      secondaryCTA={{ href: '/checkout/solo', label: 'Essayer Optibilan' }}
      variant="primary"
    />
  </main>

  <Footer />
</Layout>