---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Hero from '../../../components/Hero.astro';
import CTA from '../../../components/CTA.astro';
import Icon from '../../../components/Icon.astro';

const pageTitle = 'Intégrations - Optibilan';
const pageDescription = 'API REST v1 OpenAPI, webhooks HMAC, clés API scopées. Santé, agenda, communication, automatisation, paiement. Connectez ce que vous utilisez déjà.';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://optibilan.com/' },
    { '@type': 'ListItem', position: 2, name: 'Produit', item: 'https://optibilan.com/produit' },
    { '@type': 'ListItem', position: 3, name: 'Intégrations', item: 'https://optibilan.com/product/integrations' },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/product/integrations"
  ogImage="/og-integrations.svg"
  jsonLd={breadcrumbJsonLd}
>
  <Header />

  <main>
    <Hero
      title="Optibilan s'intègre
à votre environnement."
      subtitle="API REST v1 OpenAPI, webhooks HMAC, clés API scopées. Santé, agenda, communication, automatisation, paiement. Connectez ce que vous utilisez déjà."
      primaryCTA={{ href: '/docs', label: 'Documentation API' }}
      secondaryCTA={{ href: 'https://calendly.com/optibilan/demo', label: 'Rejoindre Optibilan' }}
    />

    <section class="section bg-blanc" aria-labelledby="categories-title">
      <div class="container">
        <header class="text-center max-w-3xl mx-auto mb-16">
          <h2 id="categories-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
            Intégrations par catégorie
          </h2>
          <p class="text-lg text-encre/60">Ne montrer le logo d'une intégration QUE si elle fonctionne réellement.</p>
        </header>

        <div class="space-y-12">
          {[
            {
              category: 'Santé & Wearables',
              icon: 'globe',
              color: 'bleu-clair',
              integrations: [
                { name: 'Apple Health', type: 'compatible', desc: 'Sync via Raccourcis iOS (client) - sommeil, VFC, FC, VO2max, pas, poids, %MG', status: 'Fonctionne' },
                { name: 'Oura', type: 'compatible', desc: 'Anneaux Oura Gen 2/3 - sommeil, VFC, température, score récupération, activité', status: 'Fonctionne' },
                { name: 'Whoop', type: 'compatible', desc: 'Ceinture Whoop 4.0 - strain, recovery, sleep, HRV, respiratory rate', status: 'Fonctionne' },
                { name: 'Garmin', type: 'compatible', desc: 'Montres Garmin Connect - activité, sommeil, VFC, VO2max, training status', status: 'Fonctionne' },
                { name: 'n8n / Make / Zapier', type: 'automation', desc: 'Sync santé côté cabinet - récupération API partenaire → push /api/health-sync', status: 'Fonctionne' },
              ],
            },
            {
              category: 'Agenda & Calendrier',
              icon: 'calendar',
              color: 'bleu-signature',
              integrations: [
                { name: 'Google Calendar', type: 'compatible', desc: 'Abonnement ICS par staff - appels planifiés, titre, date, lien fiche client', status: 'Fonctionne' },
                { name: 'Apple Calendar', type: 'compatible', desc: 'Abonnement ICS natif - mêmes données que Google Calendar', status: 'Fonctionne' },
                { name: 'Outlook / Office 365', type: 'compatible', desc: 'Abonnement ICS - compatible Outlook desktop, web, mobile', status: 'Fonctionne' },
                { name: 'Calendly', type: 'webhook', desc: 'Nouveau RDV Calendly → webhook → création appel dans Optibilan', status: 'Fonctionne' },
              ],
            },
            {
              category: 'Communication & Équipe',
              icon: 'users',
              color: 'bordeaux',
              integrations: [
                { name: 'Slack', type: 'compatible', desc: 'Webhook entrant - nouveau client, bilan déposé, appel en retard, signal faible, demande RGPD', status: 'Fonctionne' },
                { name: 'Email (Resend)', type: 'compatible', desc: 'Emails transactionnels - activation, reset MDP, rappels bilans, notifications équipe', status: 'Fonctionne' },
                { name: 'Push (Web)', type: 'compatible', desc: 'Notifications navigateur - rappel bilan, séance, message, alerte IA', status: 'Fonctionne' },
                { name: 'WhatsApp Business', type: 'webhook', desc: 'Via n8n/Make - notifications WhatsApp pour rappels, alertes', status: 'Via automatisation' },
              ],
            },
            {
              category: 'Automatisation & Workflow',
              icon: 'zap',
              color: 'indigo',
              integrations: [
                { name: 'n8n', type: 'automation', desc: 'Auto-hébergé ou cloud - webhooks Optibilan → actions n8n (Notion, Sheets, Airtable, HTTP)', status: 'Fonctionne' },
                { name: 'Make (Integromat)', type: 'automation', desc: 'Scénarios visuels - nouveaux clients, bilans, paiements → actions multiples', status: 'Fonctionne' },
                { name: 'Zapier', type: 'automation', desc: 'Zaps - trigger Optibilan (client.created, checkin.submitted…) → 5000+ apps', status: 'Fonctionne' },
                { name: 'Notion', type: 'webhook', desc: 'Webhook note.created → base Notion (client, coach, date, type, contenu, visibilité)', status: 'Fonctionne' },
              ],
            },
            {
              category: 'Paiement & Facturation',
              icon: 'credit-card',
              color: 'bleu-lecture',
              integrations: [
                { name: 'Stripe', type: 'compatible', desc: 'Paiements, abonnements, portail client, factures, webhooks (payment_failed, invoice.paid, subscription.updated)', status: 'Fonctionne' },
                { name: 'Systeme.io', type: 'manual', desc: 'Facturation manuelle / virement - export CSV factures → import Systeme.io', status: 'Sur demande' },
                { name: 'Virement SEPA', type: 'compatible', desc: 'Prélèvement SEPA via Stripe - mandate, réconciliation auto, relances impayés', status: 'Fonctionne' },
              ],
            },
            {
              category: 'API & Développement',
              icon: 'code',
              color: 'bleu-ardoise',
              integrations: [
                { name: 'API REST v1', type: 'compatible', desc: 'OpenAPI 3.1 complet - clients, bilans, nutrition, sport, santé, webhooks, admin', status: 'Fonctionne' },
                { name: 'Webhooks HMAC', type: 'compatible', desc: '8 événements signés - client.created, checkin.submitted, badge.earned, nutrition.updated, call.overdue, client.weak_signal…', status: 'Fonctionne' },
                { name: 'Sandbox API', type: 'compatible', desc: 'Environnement test - clés API test, données factices, playground Swagger/Redoc', status: 'Fonctionne' },
                { name: 'SSO / SAML', type: 'compatible', desc: 'Offre Cabinet - SAML 2.0, OIDC, provisioning SCIM (bientôt)', status: 'Bientôt' },
              ],
            },
          ].map((category, catIdx) => (
          <section key={category.category} aria-labelledby={category.category} style={`animation-delay: ${category.integrations.length * 50}ms`}>
              <header class="flex items-center gap-3 mb-8">
                <div class="icon-wrapper flex-shrink-0" aria-hidden="true" style={`background-color: color-mix(in oklab, var(--color-${category.color}) 15%, transparent);`}>
                  <Icon name={category.icon} class="w-7 h-7" style={`color: var(--color-${category.color});`} />
                </div>
                <h3 class="font-display text-2xl font-bold text-encre">{category.category}</h3>
              </header>

              <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                {category.integrations.map((int, i) => (
                  <article class="card-hover p-6" style={`animation-delay: ${i * 50}ms`}>
                    <div class="flex items-start justify-between gap-4 mb-4">
                      <div>
                        <h4 class="font-semibold text-encre mb-1">{int.name}</h4>
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-puce text-xs font-medium"
                              style={`color: var(--color-${category.color}); background-color: color-mix(in oklab, var(--color-${category.color}) 10%, transparent);`}>
                          {int.type === 'compatible' ? 'Compatible' : int.type === 'webhook' ? 'Via webhook' : int.type === 'automation' ? 'Via automatisation' : int.type === 'manual' ? 'Manuel / Sur demande' : 'Bientôt'}
                        </span>
                      </div>
                      <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700">
                        {int.status}
                      </span>
                    </div>
                    <p class="text-encre/60 text-sm mb-4">{int.desc}</p>
                    <span class="inline-flex items-center gap-1.5 text-sm font-medium text-bleu-signature hover:opacity-80 transition-opacity group" data-track={`integration_${int.name.toLowerCase().split(' ').filter(Boolean).join('_')}`}>
                      Voir la doc
                      <Icon name="arrowRight" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
                    </span>
                  </article>
                ))}
              </div>
            </section>
            ))}
          </div>
        </div>
      </section>

      <section class="section bg-gradient-to-br from-bleu-signature via-bleu-lecture to-indigo rounded-card-lg relative overflow-hidden" aria-labelledby="api-title">
        <div class="absolute inset-0" style={{ backgroundImage: 'radial-gradient(ellipse at center, var(--tw-gradient-stops))', backgroundColor: 'var(--color-bleu-signature-20)' }} aria-hidden="true"></div>
        <div class="absolute top-0 right-0 w-96 h-96 bg-bleu-signature/10 rounded-full blur-3xl" aria-hidden="true"></div>
        <div class="absolute bottom-0 left-0 w-96 h-96 bg-bleu-signature/10 rounded-full blur-3xl" aria-hidden="true"></div>

        <div class="container relative text-center max-w-3xl mx-auto py-16 md:py-24">
          <h2 id="api-title" class="font-display text-3xl md:text-4xl font-bold mb-4 text-craie">
            API REST v1 - OpenAPI 3.1
          </h2>
          <p class="text-lg mb-8 text-craie/80 max-w-2xl mx-auto">
            Documentation complète, sandbox de test, exemples cURL/Node/Python. Clés API scopées, rate limiting, webhooks HMAC.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="/docs" class="btn-demo w-full sm:w-auto" data-track="integrations_api_docs">
              <Icon name="code" class="w-5 h-5 mr-2" /> Documentation API
            </a>
            <a href="/docs/sandbox" class="btn-secondary w-full sm:w-auto border-craie/30 text-craie hover:bg-craie/10">
              <Icon name="terminal" class="w-5 h-5 mr-2" /> Sandbox de test
            </a>
          </div>
        </div>
      </section>

      <CTA
        title="Vous avez un besoin d'intégration spécifique ?"
        subtitle="L'équipe technique étudie votre stack et propose la meilleure architecture."
        primaryCTA={{ href: '/contact', label: 'Rejoindre Optibilan' }}
        secondaryCTA={{ href: '/inscription', label: 'Essayer Optibilan' }}
        variant="gold"
      />
    </main>

    <Footer />
  </Layout>