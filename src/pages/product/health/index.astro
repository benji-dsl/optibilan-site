---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Hero from '../../../components/Hero.astro';
import HealthScreenshot from '../../../../images/product/health.svg?raw';
import CTA from '../../../components/CTA.astro';
import TrustBar from '../../../components/TrustBar.astro';
import Icon from '../../../components/Icon.astro';

const pageTitle = 'Santé & biomarqueurs — Optibilan';
const pageDescription = 'Centralisez les données autorisées issues des bilans, analyses et appareils compatibles pour suivre leur évolution dans le temps. 130+ biomarqueurs.';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/product/health"
  ogImage="/og-health.jpg"
>
  <Header />

  <main>
    <Hero
      title="Les données de santé prennent du sens\nquand elles sont réunies."
      subtitle="Centralisez les données autorisées issues des bilans, analyses et appareils compatibles pour suivre leur évolution dans le temps."
      badge="Module avancé — Inclus Studio & Cabinet"
      primaryCTA={{ href: 'https://calendly.com/optibilan/demo', label: 'Voir la santé en démo' }}
      secondaryCTA={{ href: '/product/overview', label: 'Retour au produit' }}
    />

    <TrustBar />

    <section class="section bg-gradient-to-br from-encre/5 via-papier to-bleu-signature/5 rounded-card-lg relative overflow-hidden" aria-labelledby="disclaimer-title">
      <div class="container relative py-6 px-6 md:py-8 md:px-8">
        <div class="flex items-start gap-4 p-4 bg-encre/5 rounded-lg border border-encre/10">
          <Icon name="shield" class="w-6 h-6 text-encre/50 flex-shrink-0 mt-0.5" />
          <div>
            <h3 id="disclaimer-title" class="font-semibold text-encre mb-1">Cadre médical & responsabilité</h3>
            <p class="text-encre/70 text-sm">
              <strong>Optibilan est un outil d'organisation et d'aide au suivi. Il ne remplace pas le jugement d'un professionnel de santé et ne fournit pas de diagnostic médical.</strong><br>
              L'interprétation des biomarqueurs, la prescription, l'ajustement thérapeutique relèvent exclusivement de professionnels de santé qualifiés. Optibilan structure, signale, organise — il ne décide pas.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section bg-blanc" aria-labelledby="problem-title">
      <div class="container max-w-3xl">
        <header class="mb-12">
          <h2 id="problem-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
            Le problème : les données de santé en silos
          </h2>
          <p class="text-lg text-encre/60">
            Biologie au labo, sommeil sur Oura, VFC sur Garmin, tension à la pharmacie, poids sur la balance connectée…<br>
            Impossible de croiser, corréler, voir la trajectoire globale.
          </p>
        </header>

        <div class="space-y-8">
          {[
            {
              title: 'Biologie : 130+ biomarqueurs structurés',
              desc: 'Glycémie, HbA1c, insuline, HOMA-IR, CRP, vit D, B9/B12, ferritine, lipidogramme complet, thyroïde (TSH, T3, T4, anticorps), hormones (testostérone, œstradiol, SHBG, cortisol, DHEA), homocystéine, magnésium, zinc, oméga-3… Import PDF labo : IA extrait, structure, pré-remplit, signale anomalies (flags rouge/orange/vert selon seuils de référence).',
              features: [
                '130+ biomarqueurs sanguins pré-configurés (unités, seuils, références)',
                'Import PDF labo : IA OCR → extraction → structuration → pré-remplissage',
                'Flags automatiques : rouge (hors seuils critiques), orange (limite), vert (optimal)',
                'Graphiques tendances temporelles avec seuils de référence superposés',
                'Corrélations auto : ex: HbA1c vs glycémie à jeun, ferritine vs fatigue',
              ],
              icon: 'document',
            },
            {
              title: 'Wearables : sync compatible Apple Health, Oura, Whoop, Garmin',
              desc: 'Via Raccourcis iOS (client) ou n8n/Make/Zapier (cabinet). Métriques quotidiennes : sommeil (stades, score, régularité), VFC (rmssd, CV, tendance), FC repos, VO2max, pas, poids, %MG, température cutanée. Token santé par client (hsk_…) — scope granulaire.',
              features: [
                'Sync compatible : Apple Health, Oura, Whoop, Garmin (Raccourcis iOS / n8n / Make / Zapier)',
                'Métriques : sommeil (stades, score, régularité), VFC (rmssd, CV), FC repos, VO2max, pas, poids, %MG, température',
                'Endpoint /api/health-sync (HMAC signé) pour n8n/Make/Zapier',
                'Stockage Supabase bucket privé, chiffré AES-256',
                'Hébergement EU (Supabase EU West, VPS France)',
              ],
              icon: 'globe',
            },
            {
              title: 'Sommeil, cardio, tendances : tout en un',
              desc: 'Dashboard unifié : sommeil (score, stades, régularité, latence), VFC (rmssd, CV, tendance 7j/30j), FC repos, VO2max, pas, poids, %MG. Graphiques tendances temporelles avec seuils de référence. Corrélations cross-domaines : ex: VFC ↓ + charge ↑ + sommeil ↓ = risque surentraînement.',
              features: [
                'Sommeil : stades, score, régularité, latence',
                'VFC : rmssd, CV, tendance 7j/30j, comparaison baseline',
                'Cardio : FC repos, VO2max, récupération, charge entraînement',
                'Corrélations cross-domaines auto-détectées',
                'Alertes : VFC < baseline - 20%, sommeil < 6h 3 nuits d\'affilée',
              ],
              icon: 'chart',
            },
            {
              title: 'Habitudes quotidiennes & observance',
              desc: 'Eau, suppléments, exposition lumière, respiration, jeûne, médicaments. Rappels push/email, validation scan code-barres, taux d\'adhérence, alertes rupture stock. Corrélation avec biologie : ex: vit D ↑ + supplémentation = efficacité.',
              features: [
                'Habitudes configurables par client (type, fréquence, rappel)',
                'Validation scan code-barres (suppléments, médicaments)',
                'Taux d\'adhérence hebdo/mensuel, alertes < 80%',
                'Corrélation habitude → biomarqueur (ex: magnésium → crampes ↓)',
              ],
              icon: 'calendar',
            },
          ].map((section, i) => (
            <article id={section.icon} class="py-8 border-t border-encre/10 first:border-0">
              <header class="flex items-center gap-4 mb-6">
                <div class="icon-wrapper flex-shrink-0" aria-hidden="true" style="background-color: var(--color-bleu-clair);">
                  <Icon name={section.icon} class="w-7 h-7 text-bleu-ardoise" />
                </div>
                <div>
                  <h3 class="font-display text-2xl font-bold text-encre">{section.title}</h3>
                  <p class="text-encre/60 mt-1">{section.desc}</p>
                </div>
              </header>
              <ul class="space-y-2 text-encre/60">
                {section.features.map(f => (
                  <li key={f} class="flex items-start gap-2">
                    <Icon name="check" class="w-5 h-5 text-emerald-500 flex-shrink-0 mt-0.5" />
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>

        <div class="mt-12 p-6 rounded-xl bg-papier border border-encre/10">
          <h3 class="font-display text-xl font-bold text-encre mb-3">Spécifications techniques & conformité</h3>
          <ul class="space-y-2 text-sm text-encre/60">
            <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 rounded-full bg-bleu-ardoise flex-shrink-0 mt-1.5" /> Sync compatible : Apple Health, Oura, Whoop, Garmin (Raccourcis iOS / n8n / Make / Zapier)</li>
            <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 rounded-full bg-bleu-ardoise flex-shrink-0 mt-1.5" /> 130+ biomarqueurs sanguins structurés (unités, seuils, références OMS/sociétés savantes)</li>
            <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 rounded-full bg-bleu-ardoise flex-shrink-0 mt-1.5" /> Import PDF labo : IA OCR → extraction → structuration → flags anomalies</li>
            <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 rounded-full bg-bleu-ardoise flex-shrink-0 mt-1.5" /> Endpoint /api/health-sync (HMAC signé) pour n8n/Make/Zapier</li>
            <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 rounded-full bg-bleu-ardoise flex-shrink-0 mt-1.5" /> Stockage Supabase bucket privé, chiffré AES-256</li>
            <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 rounded-full bg-bleu-ardoise flex-shrink-0 mt-1.5" /> Hébergement EU (Supabase EU West, VPS France)</li>
            <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 rounded-full bg-bleu-ardoise flex-shrink-0 mt-1.5" /> Token santé par client (hsk_…) — scope granulaire (read/write par métrique)</li>
          </ul>
        </div>
      </div>
    </section>

    <CTA
      title="Prêt à unifier les données de santé de vos clients ?"
      subtitle="30 minutes pour voir comment centraliser biologie, wearables et habitudes."
      primaryCTA={{ href: 'https://calendly.com/optibilan/demo', label: 'Réserver une démo Santé' }}
      variant="primary"
    />
  </main>

  <Footer />
</Layout>