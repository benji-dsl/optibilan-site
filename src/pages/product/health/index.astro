---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Hero from '../../../components/Hero.astro';
import CTA from '../../../components/CTA.astro';
import Icon from '../../../components/Icon.astro';

const pageTitle = 'Santé & biomarqueurs - Optibilan';
const pageDescription = 'Toutes les données de santé, enfin lisibles dans le temps. Analyses biologiques, sommeil, activité, fréquence cardiaque, VFC et données issues des appareils compatibles réunies dans une seule vue.';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://optibilan.com/' },
    { '@type': 'ListItem', position: 2, name: 'Produit', item: 'https://optibilan.com/produit' },
    { '@type': 'ListItem', position: 3, name: 'Santé & biomarqueurs', item: 'https://optibilan.com/product/health' },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/product/health"
  ogImage="/og-health.png"
  jsonLd={breadcrumbJsonLd}
>
  <Header />

  <main>
    <Hero
      title="Toutes les données de santé, 
 enfin lisibles dans le temps."
      subtitle="Analyses biologiques, sommeil, activité, fréquence cardiaque, VFC et données issues des appareils compatibles réunies dans une seule vue."
      primaryCTA={{ href: '/pricing', label: 'Rejoindre Optibilan' }}
      secondaryCTA={{ href: '/contact', label: 'Essayer Optibilan' }}
    />

    <section class="section bg-gradient-to-br from-encre/5 via-papier to-bleu-signature/5 rounded-card-lg relative overflow-hidden" aria-labelledby="disclaimer-title">
      <div class="container relative py-6 px-6 md:py-8 md:px-8">
        <div class="flex items-start gap-4 p-4 bg-encre/5 rounded-lg border border-encre/10">
          <Icon name="shield" class="w-6 h-6 text-encre/50 flex-shrink-0 mt-0.5" />
          <div>
            <h3 id="disclaimer-title" class="font-semibold text-encre mb-1">Cadre médical & responsabilité</h3>
            <p class="text-encre/70 text-sm">
              <strong>Optibilan est un outil d'organisation et d'aide au suivi. Il ne remplace pas le jugement d'un professionnel de santé et ne fournit pas de diagnostic médical.</strong><br>
              L'interprétation des biomarqueurs, la prescription, l'ajustement thérapeutique relèvent exclusivement de professionnels de santé qualifiés. Optibilan structure, signale, organise - il ne décide pas.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section bg-blanc" aria-labelledby="problem-title">
      <div class="container max-w-3xl">
        <header class="mb-12">
          <h2 id="problem-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
            Le problème : les données de santé en silos
          </h2>
          <p class="text-lg text-encre/60">
            Biologie au labo, sommeil sur Oura, VFC sur Garmin, tension à la pharmacie, poids sur la balance connectée…<br>
            Impossible de croiser, corréler, voir la trajectoire globale.
          </p>
        </header>

        <div class="space-y-8">
          {[
            {
              title: 'Biologie : 130+ biomarqueurs structurés',
              desc: 'Glycémie, HbA1c, insuline, HOMA-IR, CRP, vit D, B9/B12, ferritine, lipidogramme complet, thyroïde (TSH, T3, T4, anticorps), hormones (testostérone, œstradiol, SHBG, cortisol, DHEA), homocystéine, magnésium, zinc, oméga-3… Import PDF labo : IA extrait, structure, pré-remplit, signale les valeurs hors des intervalles de référence configurés (flags rouge/orange/vert).',
              features: [
                '130+ biomarqueurs sanguins structurés',
                'Import PDF labo : IA extraction auto',
                'Flags auto : rouge/orange/vert',
                'Graphiques tendances + seuils référence',
                'Corrélations auto (HbA1c vs glycémie)',
              ],
              icon: 'document',
            },
            {
              title: 'Wearables : sync Apple Health, Oura, Whoop, Garmin',
              desc: 'Via Raccourcis iOS (client) ou connecteurs d\'automatisation (cabinet). Métriques quotidiennes : sommeil (stades, score, régularité), VFC (rmssd, CV, tendance), FC repos, VO2max, pas, poids, %MG, température cutanée.',
              features: [
                'Sync : Apple Health, Oura, Whoop, Garmin',
                'Métriques : sommeil, VFC, FC repos, VO2max, pas, poids',
                'Stockage EU chiffré',
                'Hébergement EU (Irlande + France)',
              ],
              icon: 'globe',
            },
{
              title: 'Sommeil, cardio, tendances : tout en un',
              desc: 'Dashboard unifié : sommeil (score, stades, régularité), VFC (rmssd, CV, tendance 7j/30j), FC repos, VO2max, pas, poids, %MG. Graphiques tendances temporelles avec seuils de référence. Visualisez simultanément l\'évolution de la VFC, de la charge d\'entraînement et du sommeil.',
              features: [
                'Sommeil : score, stades, régularité',
                'VFC : rmssd, CV, tendance 7j/30j',
                'Cardio : FC repos, VO2max, charge',
                'Corrélations cross-domaines auto',
                'Alertes : VFC ↓ 20%, sommeil < 6h x3',
              ],
              icon: 'chart',
            },
            {
              title: 'Habitudes quotidiennes & observance',
              desc: 'Eau, suppléments, exposition lumière, respiration, jeûne, médicaments. Rappels push/email, validation scan code-barres, taux d\'adhérence, alertes rupture stock. Mettez en perspective l\'évolution des habitudes renseignées et des biomarqueurs suivis.',
              features: [
                'Habitudes configurables par client',
                'Validation scan code-barres',
                'Taux adhérence + alertes < 80%',
                'Corrélation habitude → biomarqueur',
              ],
              icon: 'calendar',
            },
          ].map((section, i) => (
            <article id={section.icon} class="py-8 border-t border-encre/10 first:border-0">
              <header class="flex items-center gap-4 mb-6">
                <div class="icon-wrapper flex-shrink-0" aria-hidden="true" style="background-color: var(--color-bleu-clair);">
                  <Icon name={section.icon} class="w-7 h-7 text-bleu-ardoise" />
                </div>
                <div>
                  <h3 class="font-display text-2xl font-bold text-encre">{section.title}</h3>
                  <p class="text-encre/60 mt-1">{section.desc}</p>
                </div>
              </header>
              <ul class="space-y-2 text-encre/60">
                {section.features.map(f => (
                  <li key={f} class="flex items-start gap-2">
                    <Icon name="check" class="w-5 h-5 text-emerald-500 flex-shrink-0 mt-0.5" />
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <CTA
      title="Prêt à unifier les données de santé de vos clients ?"
      subtitle="30 minutes pour voir comment centraliser biologie, wearables et habitudes."
      primaryCTA={{ href: '/pricing', label: 'Rejoindre Optibilan' }}
      secondaryCTA={{ href: '/checkout/solo', label: 'Essayer Optibilan' }}
      variant="primary"
    />
  </main>

  <Footer />
</Layout>