---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';

const pageTitle = 'Registre des sous-traitants - Optibilan';
const pageDescription = 'Liste des sous-traitants d\'Optibilan (Art. 28 RGPD) : Supabase, Stripe, Resend, Cloudflare, Anthropic, Plausible. Localisation, finalités, mesures de sécurité, DPA, SCC.';
const lastUpdated = new Date().toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/legal/sous-traitance"
  ogImage="/og-legal.svg"
>
  <Header />

  <main>
    <Hero
      title="Registre des sous-traitants"
      subtitle="Conformément à l'article 28 du RGPD, Optibilan tient à jour la liste de ses sous-traitants. Tous ont signé un DPA et offrent des garanties suffisantes. 5/6 hébergent en UE."
      variant="minimal"
    />

    <section class="section bg-blanc" aria-labelledby="subprocessors-content">
      <div class="container max-w-5xl">
        <div class="mb-8 p-4 bg-amber-50 border border-amber-200 rounded-lg" role="alert">
          <p class="text-sm text-amber-800">
            <strong>⚠ Attention :</strong> Ce registre contient des informations qui doivent être validées contractuellement (DPA signés, SCC, certifications) avant la mise en production.
          </p>
        </div>

        <article class="prose max-w-none" id="subprocessors-content">

          <h2 class="font-display text-2xl font-bold text-encre mb-6 pb-2 border-b border-encre/10">Sous-traitants actuels</h2>

          <div class="space-y-6 mb-12">
            {[
              {
                name: 'Supabase',
                role: 'Base de données PostgreSQL managée, Auth, Storage, Realtime, Edge Functions',
                location: 'EU West (Irlande) - Données stockées exclusivement en UE',
                purposes: ['Hébergement base de données (toutes données Abonnés + Coachés)', 'Authentification (email/password, providers)', 'Stockage fichiers (photos, PDF, dreamboard) - bucket privé', 'Fonctions edge (webhooks, cron, sync santé)'],
                security: ['Chiffrement au repos (AES-256) et en transit (TLS 1.3)', 'Isolation réseau (VPC dédié)', 'PITR 7 jours + snapshots quotidiens', 'Certifications : SOC 2 Type II, ISO 27001, HIPAA, RGPD'],
                dpa: true,
                scc: 'Non requis (UE)',
                website: 'https://supabase.com',
                icon: 'database',
              },
              {
                name: 'Stripe',
                role: 'Paiements, facturation, abonnements, portail client',
                location: 'UE (Irlande) - Entité contractuelle : Stripe Technology Europe Ltd',
                purposes: ['Encaissement cartes, virements SEPA, prélèvements', 'Gestion abonnements (création, modification, annulation)', 'Portail client autogéré (moyens de paiement, factures)', 'Webhooks événements (payment_failed, invoice.paid, subscription.updated)'],
                security: ['PCI DSS Level 1', 'Chiffrement bout en bout', 'Certifications : SOC 1/2, ISO 27001, PCI DSS'],
                dpa: true,
                scc: 'Non requis (UE)',
                website: 'https://stripe.com',
                icon: 'credit-card',
              },
              {
                name: 'Resend',
                role: 'Envoi emails transactionnels (activation, reset MDP, rappels bilans, notifications équipe)',
                location: 'UE (Allemagne) - Serveurs en UE',
                purposes: ['Emails transactionnels uniquement (pas de marketing)', 'Templates HTML/texte avec variables', 'Tracking ouverture/clic (anonymisé, opt-out possible)'],
                security: ['TLS 1.3', 'DKIM, SPF, DMARC sur domaine optibilan.com', 'Rétention logs 30 jours max'],
                dpa: true,
                scc: 'Non requis (UE)',
                website: 'https://resend.com',
                icon: 'mail',
              },
              {
                name: 'Cloudflare',
                role: 'CDN, DNS, WAF, DDoS Protection, Cloudflare Tunnel, Analytics',
                location: 'Réseau mondial (300+ PoP) - Trafic routé via PoP EU pour utilisateurs EU',
                purposes: ['Terminaison TLS, cache statique, compression Brotli', 'WAF (règles OWASP Top 10, rate-limit, bot fight)', 'DDoS mitigation L3/L4/L7', 'Tunnel zero-trust (pas de port ouvert sur VPS)', 'Analytics agrégés (pas d\'IP complète)'],
                security: ['Chiffrement TLS 1.3', 'Certifications : SOC 2 Type II, ISO 27001, FedRAMP'],
                dpa: true,
                scc: 'Oui (SCC 2021 + mesures supplémentaires Art. 28)',
                website: 'https://cloudflare.com',
                icon: 'cloud',
              },
              {
                name: 'Anthropic',
                role: 'Modèle de langage (Claude) pour l\'assistant IA intégrée',
                location: 'USA - Traitement via API (pas de stockage de données)',
                purposes: ['Génération réponses assistant IA (lecture bilans, prises de sang, biomarqueurs)', 'Analyse transcriptions appels (n8n)', 'Extraction pré-remplissage questionnaire lancement'],
                security: ['API zero-retention (pas d\'entraînement, pas de log complet)', 'Prompts anonymisés (pas de données identifiantes envoyées)', 'Contrat Enterprise avec DPA, zero-retention garanti'],
                dpa: true,
                scc: 'Oui (SCC 2021 + Addendum UK + mesures techniques : pseudonymisation prompts, zero-retention)',
                website: 'https://anthropic.com',
                icon: 'brain',
              },
              {
                name: 'Plausible Analytics',
                role: 'Analytique web respectueuse de la vie privée (alternative GA4)',
                location: 'UE (Allemagne) - Données stockées en UE',
                purposes: ['Métriques site public (pages vues, événements, référents, pays)', 'Pas de cookies, pas de données personnelles, anonymisation IP'],
                security: ['Open source, auto-hébergé possible', 'RGPD by design, ePrivacy compliant'],
                dpa: true,
                scc: 'Non requis (UE)',
                website: 'https://plausible.io',
                icon: 'chart',
              },
            ].map((sub, index) => (
              <section class="border border-encre/10 rounded-card-lg p-6 md:p-8 bg-blanc hover:shadow-card transition-shadow duration-300">
                <header class="flex items-start justify-between gap-4 mb-5">
                  <div class="flex items-center gap-3">
                    <span class="w-10 h-10 rounded-lg bg-bleu-clair text-bleu-signature flex items-center justify-center font-display font-bold text-lg">
                      {index + 1}
                    </span>
                    <div>
                      <h3 class="font-display text-xl font-bold text-encre">{sub.name}</h3>
                      <p class="text-encre/60 text-sm mt-0.5">{sub.role}</p>
                    </div>
                  </div>
                  <a href={sub.website} target="_blank" rel="noopener noreferrer" class="text-sm text-bleu-signature hover:underline whitespace-nowrap flex items-center gap-1">
                    Site web
                    <Icon name="arrowRight" class="w-4 h-4" />
                  </a>
                </header>

                <div class="grid md:grid-cols-2 gap-6 mb-5">
                  <div>
                    <h4 class="font-semibold text-encre mb-2 flex items-center gap-1.5">
                      <Icon name={sub.icon} class="w-5 h-5 text-bleu-signature" />
                      Localisation
                    </h4>
                    <p class="text-encre/60">{sub.location}</p>
                  </div>
                  <div>
                    <h4 class="font-semibold text-encre mb-2 flex items-center gap-1.5">
                      <Icon name="lock" class="w-5 h-5 text-bleu-signature" />
                      DPA signé
                    </h4>
                    <p class="text-encre/60">{sub.dpa ? 'Oui (Art. 28 RGPD)' : 'Non'}</p>
                  </div>
                </div>

                <div class="grid md:grid-cols-2 gap-6 mb-5">
                  <div>
                    <h4 class="font-semibold text-encre mb-2 flex items-center gap-1.5">
                      <Icon name="shield" class="w-5 h-5 text-bleu-signature" />
                      Mesures de sécurité
                    </h4>
                    <ul class="space-y-1.5 text-sm text-encre/60">
                      {sub.security.map(s => (
                        <li key={s} class="flex items-start gap-2">• {s}</li>
                      ))}
                    </ul>
                  </div>
                  <div>
                    <h4 class="font-semibold text-encre mb-2 flex items-center gap-1.5">
                      <Icon name="document" class="w-5 h-5 text-bleu-signature" />
                      Finalités
                    </h4>
                    <ul class="space-y-1.5 text-sm text-encre/60">
                      {sub.purposes.map(p => (
                        <li key={p} class="flex items-start gap-2">• {p}</li>
                      ))}
                    </ul>
                  </div>
                </div>

                <div class="flex flex-wrap items-center gap-4 text-sm text-encre/50 pt-4 border-t border-encre/10">
                  <span class="flex items-center gap-1.5">
                    <Icon name="lock" class="w-4 h-4" />
                    SCC : {sub.scc}
                  </span>
                </div>
              </section>
            ))}
          </div>

          <h2 class="font-display text-2xl font-bold text-encre mb-4 pb-2 border-b border-encre/10 mt-12">Engagements d'Optibilan</h2>
          <ul class="space-y-3 mb-12 text-encre/70">
            <li class="flex items-start gap-2">• <strong>Sélection rigoureuse :</strong> seuls des sous-traitants offrant « garanties suffisantes » (Art. 28.1 RGPD) sont retenus.</li>
            <li class="flex items-start gap-2">• <strong>DPA systématique :</strong> contrat écrit incluant les clauses types (Art. 28.3) avant toute mise en production.</li>
            <li class="flex items-start gap-2">• <strong>Localisation UE privilégiée :</strong> 5/6 sous-traitants hébergent en UE. Pour Anthropic (US) : zero-retention, pseudonymisation, SCC + mesures techniques.</li>
            <li class="flex items-start gap-2">• <strong>Audit annuel :</strong> revue des certifications (SOC 2, ISO 27001), tests de pénétration, conformité DPA.</li>
            <li class="flex items-start gap-2">• <strong>Notification sous-traitance ultérieure :</strong> tout nouveau sous-traitant ou changement de localisation notifié 30 jours avant (Art. 28.2).</li>
            <li class="flex items-start gap-2">• <strong>Droit d'instruction :</strong> l'Abonné peut demander l'audit d'un sous-traitant (coût partagé).</li>
          </ul>

          <h2 class="font-display text-2xl font-bold text-encre mb-4 pb-2 border-b border-encre/10">Sous-traitants ultérieurs (chaîne)</h2>
          <p class="text-encre/60 mb-6">Les sous-traitants ci-dessus peuvent faire appel à leurs propres sous-traitants (ex: AWS/GCP pour l'infrastructure, sous-traitants support). Optibilan s'assure contractuellement que la chaîne complète respecte l'Art. 28.4 RGPD (mêmes obligations, même niveau de protection).</p>

          <div class="overflow-x-auto mb-12">
            <table class="w-full text-sm" role="table">
              <thead>
                <tr class="border-b border-encre/20">
                  <th class="text-left pb-2 font-semibold text-encre">Sous-traitant</th>
                  <th class="text-left pb-2 font-semibold text-encre">Sous-traitants ultérieurs connus</th>
                  <th class="text-left pb-2 font-semibold text-encre">Localisation</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-encre/10 text-encre/60">
                <tr><td class="py-2 font-medium">Supabase</td><td>AWS (EU West), Sentry (EU/US), Vercel (EU/US)</td><td>UE (principal)</td></tr>
                <tr><td class="py-2 font-medium">Stripe</td><td>AWS (EU), Google Cloud (EU), Twilio (US/EU pour SMS)</td><td>UE (principal)</td></tr>
                <tr><td class="py-2 font-medium">Resend</td><td>AWS (EU), SendGrid (US) pour relais</td><td>UE (principal)</td></tr>
                <tr><td class="py-2 font-medium">Cloudflare</td><td>Réseau propre (300+ PoP mondiaux)</td><td>Mondial (routing EU)</td></tr>
                <tr><td class="py-2 font-medium">Anthropic</td><td>AWS (US), Google Cloud (US) - zero-retention</td><td>US (zero-retention)</td></tr>
                <tr><td class="py-2 font-medium">Plausible</td><td>Hetzner (DE) - auto-hébergé</td><td>UE</td></tr>
              </tbody>
            </table>
          </div>

          <h2 class="font-display text-2xl font-bold text-encre mb-4 pb-2 border-b border-encre/10">Contact</h2>
          <p class="text-encre/60 mb-8">Pour toute question sur la sous-traitance : <a href="mailto:privacy@optibilan.com" class="text-bleu-signature hover:underline">privacy@optibilan.com</a></p>

          <p class="mt-8 pt-8 border-t border-encre/10 text-sm text-encre/50">
            Ce registre est mis à jour à chaque changement de sous-traitant. Version du {lastUpdated}.
          </p>
        </article>
      </div>
    </section>
  </main>

  <Footer />
</Layout>