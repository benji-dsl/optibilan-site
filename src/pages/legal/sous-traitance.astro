---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';

const pageTitle = 'Registre des sous-traitants — Optibilan';
const pageDescription = 'Liste des sous-traitants d\'Optibilan (Art. 28 RGPD) : Supabase, Stripe, Resend, Cloudflare, Anthropic, Plausible. Localisation, finalités, mesures de sécurité, DPA.';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/sous-traitance"
  ogImage="/og-legal.jpg"
>
  <Header />

  <main>
    <Hero
      title="Registre des sous-traitants"
      subtitle="Conformément à l'article 28 du RGPD, Optibilan tient à jour la liste de ses sous-traitants ultérieurs. Tous ont signé un DPA (Data Processing Agreement) et offrent des garanties suffisantes."
      variant="minimal"
    />

    <section class="section bg-white" aria-labelledby="subprocessors-content">
      <div class="container max-w-5xl">
        <article class="prose prose-ink max-w-none" id="subprocessors-content">
          <p class="lead text-ink-600 mb-8">
            Dernière mise à jour : <strong>{new Date().toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</strong>
          </p>

          <h2>Sous-traitants actuels</h2>

          <div class="space-y-8">
            {[
              {
                name: 'Supabase',
                role: 'Base de données PostgreSQL managée, Auth, Storage, Realtime, Edge Functions',
                location: 'EU West (Irlande) — Données stockées exclusivement en UE',
                purposes: ['Hébergement base de données (toutes données Abonnés + Coachés)', 'Authentification (email/password, providers)', 'Stockage fichiers (photos, PDF, dreamboard) — bucket privé', 'Fonctions edge (webhooks, cron, sync santé)'],
                security: ['Chiffrement au repos (AES-256) et en transit (TLS 1.3)', 'Isolation réseau (VPC dédié)', 'PITR 7 jours + snapshots quotidiens', 'Certifications : SOC 2 Type II, ISO 27001, HIPAA, RGPD'],
                dpa: true,
                scc: 'Non requis (UE)',
                website: 'https://supabase.com',
              },
              {
                name: 'Stripe',
                role: 'Paiements, facturation, abonnements, portail client',
                location: 'UE (Irlande) pour le traitement — Entité contractuelle : Stripe Technology Europe Ltd',
                purposes: ['Encaissement cartes, virements SEPA, prélèvements', 'Gestion abonnements (création, modification, annulation)', 'Portail client autogéré (moyens de paiement, factures)', 'Webhooks événements (payment_failed, invoice.paid, subscription.updated)'],
                security: ['PCI DSS Level 1', 'Chiffrement bout en bout', 'Certifications : SOC 1/2, ISO 27001, PCI DSS'],
                dpa: true,
                scc: 'Non requis (UE)',
                website: 'https://stripe.com',
              },
              {
                name: 'Resend',
                role: 'Envoi emails transactionnels (activation, reset MDP, rappels bilans, notifications équipe)',
                location: 'UE (Allemagne) — Serveurs en UE',
                purposes: ['Emails transactionnels uniquement (pas de marketing)', 'Templates HTML/texte avec variables', 'Tracking ouverture/clic (anonymisé, opt-out possible)'],
                security: ['TLS 1.3', 'DKIM, SPF, DMARC sur domaine optibilan.com', 'Rétention logs 30 jours max'],
                dpa: true,
                scc: 'Non requis (UE)',
                website: 'https://resend.com',
              },
              {
                name: 'Cloudflare',
                role: 'CDN, DNS, WAF, DDoS Protection, Cloudflare Tunnel, Analytics',
                location: 'Réseau mondial (300+ PoP) — Trafic routé via PoP EU pour utilisateurs EU',
                purposes: ['Terminaison TLS, cache statique, compression Brotli', 'WAF (règles OWASP Top 10, rate-limit, bot fight)', 'DDoS mitigation L3/L4/L7', 'Tunnel zero-trust (pas de port ouvert sur VPS)', 'Analytics agrégés (pas d\'IP complète)'],
                security: ['Chiffrement TLS 1.3', 'Certifications : SOC 2 Type II, ISO 27001, FedRAMP'],
                dpa: true,
                scc: 'Oui (SCC 2021 + mesures supplémentaires Art. 28)',
                website: 'https://cloudflare.com',
              },
              {
                name: 'Anthropic',
                role: 'Modèle de langage (Claude) pour l\'assistant IA intégrée',
                location: 'USA — Traitement via API (pas de stockage de données)',
                purposes: ['Génération réponses assistant IA (lecture bilans, prises de sang, biomarqueurs)', 'Analyse transcriptions appels (n8n)', 'Extraction pré-remplissage questionnaire lancement'],
                security: ['API zero-retention (pas d\'entraînement, pas de log complet)', 'Prompts anonymisés (pas de données identifiantes envoyées)', 'Contrat Enterprise avec DPA, zero-retention garanti'],
                dpa: true,
                scc: 'Oui (SCC 2021 + Addendum UK + mesures techniques : pseudonymisation prompts, zero-retention)',
                website: 'https://anthropic.com',
              },
              {
                name: 'Plausible Analytics',
                role: 'Analytique web respectueuse de la vie privée (alternative GA4)',
                location: 'UE (Allemagne) — Données stockées en UE',
                purposes: ['Métriques site public (pages vues, événements, référents, pays)', 'Pas de cookies, pas de données personnelles, anonymisation IP'],
                security: ['Open source, auto-hébergé possible', 'RGPD by design, ePrivacy compliant'],
                dpa: true,
                scc: 'Non requis (UE)',
                website: 'https://plausible.io',
              },
            ].map((sub, index) => (
              <section class="border border-ink-200 rounded-2xl p-6 md:p-8 bg-white">
                <header class="flex items-start justify-between gap-4 mb-4">
                  <div>
                    <h3 class="text-xl font-bold text-ink-950 flex items-center gap-2">
                      <span class="w-8 h-8 rounded-lg bg-primary-100 text-primary-600 flex items-center justify-center text-sm font-bold">{index + 1}</span>
                      {sub.name}
                    </h3>
                    <p class="text-ink-600 mt-1">{sub.role}</p>
                  </div>
                  <a href={sub.website} target="_blank" rel="noopener noreferrer" class="text-sm text-primary-600 hover:underline whitespace-nowrap flex items-center gap-1">
                    Site web
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                  </a>
                </header>

                <div class="grid md:grid-cols-2 gap-6 mb-4">
                  <div>
                    <h4 class="font-semibold text-ink-900 mb-2 flex items-center gap-1.5">
                      <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                      Localisation
                    </h4>
                    <p class="text-ink-600">{sub.location}</p>
                  </div>
                  <div>
                    <h4 class="font-semibold text-ink-900 mb-2 flex items-center gap-1.5">
                      <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                      DPA signé
                    </h4>
                    <p class="text-ink-600">{sub.dpa ? 'Oui (Art. 28 RGPD)' : 'Non'}</p>
                  </div>
                </div>

                <div class="grid md:grid-cols-2 gap-6 mb-4">
                  <div>
                    <h4 class="font-semibold text-ink-900 mb-2 flex items-center gap-1.5">
                      <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                      Mesures de sécurité
                    </h4>
                    <ul class="space-y-1 text-sm text-ink-600">
                      {sub.security.map(s => <li class="flex items-start gap-2">• {s}</li>)}
                    </ul>
                  </div>
                  <div>
                    <h4 class="font-semibold text-ink-900 mb-2 flex items-center gap-1.5">
                      <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
                      Finalités
                    </h4>
                    <ul class="space-y-1 text-sm text-ink-600">
                      {sub.purposes.map(p => <li class="flex items-start gap-2">• {p}</li>)}
                    </ul>
                  </div>
                </div>

                <div class="flex flex-wrap items-center gap-4 text-sm text-ink-500">
                  <span class="flex items-center gap-1.5">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                    SCC : {sub.scc}
                  </span>
                </div>
              </section>
            ))}
          </div>

          <h2 class="mt-12 mb-6">Engagements d'Optibilan</h2>
          <ul class="space-y-3 text-ink-600">
            <li>• Sélection rigoureuse : seuls des sous-traitants offrant « garanties suffisantes » (Art. 28.1 RGPD) sont retenus.</li>
            <li>• DPA systématique : contrat écrit incluant les clauses types (Art. 28.3) avant toute mise en production.</li>
            <li>• Localisation UE privilégiée : 5/6 sous-traitants hébergent en UE. Pour Anthropic (US) : zero-retention, pseudonymisation, SCC + mesures techniques.</li>
            <li>• Audit annuel : revue des certifications (SOC 2, ISO 27001), tests de pénétration, conformité DPA.</li>
            <li>• Notification sous-traitance ultérieure : tout nouveau sous-traitant ou changement de localisation notifié 30 jours avant (Art. 28.2).</li>
            <li>• Droit d'instruction : l'Abonné peut demander l'audit d'un sous-traitant (coût partagé).</li>
          </ul>

          <h2 class="mt-8 mb-6">Sous-traitants ultérieurs (chaîne)</h2>
          <p class="text-ink-600 mb-4">Les sous-traitants ci-dessus peuvent faire appel à leurs propres sous-traitants (ex: AWS/GCP pour l'infrastructure, sous-traitants support). Optibilan s'assure contractuellement que la chaîne complète respecte l'Art. 28.4 RGPD (mêmes obligations, même niveau de protection).</p>

          <div class="overflow-x-auto mt-6">
            <table class="w-full text-sm">
              <thead><tr class="border-b border-ink-200"><th class="text-left pb-2">Sous-traitant</th><th class="text-left pb-2">Sous-traitants ultérieurs connus</th><th class="text-left pb-2">Localisation</th></tr></thead>
              <tbody class="divide-y divide-ink-100">
                <tr><td class="py-2 font-medium">Supabase</td><td>AWS (EU West), Sentry (EU/US), Vercel (EU/US)</td><td>UE (principal)</td></tr>
                <tr><td class="py-2 font-medium">Stripe</td><td>AWS (EU), Google Cloud (EU), Twilio (US/EU pour SMS)</td><td>UE (principal)</td></tr>
                <tr><td class="py-2 font-medium">Resend</td><td>AWS (EU), SendGrid (US) pour relais</td><td>UE (principal)</td></tr>
                <tr><td class="py-2 font-medium">Cloudflare</td><td>Réseau propre (300+ PoP mondiaux)</td><td>Mondial (routing EU)</td></tr>
                <tr><td class="py-2 font-medium">Anthropic</td><td>AWS (US), Google Cloud (US) — zero-retention</td><td>US (zero-retention)</td></tr>
                <tr><td class="py-2 font-medium">Plausible</td><td>Hetzner (DE) — auto-hébergé</td><td>UE</td></tr>
              </tbody>
            </table>
          </div>

          <h2 class="mt-8 mb-6">Contact</h2>
          <p class="text-ink-600">Pour toute question sur la sous-traitance : <a href="mailto:privacy@optibilan.com" class="text-primary-600 hover:underline">privacy@optibilan.com</a></p>

          <p class="mt-8 pt-8 border-t border-ink-200 text-sm text-ink-500">
            Ce registre est mis à jour à chaque changement de sous-traitant. Version du {new Date().toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}.
          </p>
        </article>
      </div>
    </section>
  </main>

  <Footer />
</Layout>