---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import Features from '../../components/Features.astro';
import CTA from '../../components/CTA.astro';
import TrustBar from '../../components/TrustBar.astro';
import Icon from '../../components/Icon.astro';

const pageTitle = 'Fonctionnalités — Optibilan';
const pageDescription = 'Découvrez tous les modules : bilans hebdo, nutrition, sport, prépa mentale, santé connectée, gamification, API, webhooks, marque blanche. Activez seulement ce dont vous avez besoin.';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/fonctionnalites"
  ogImage="/og-features.jpg"
>
  <Header />

  <main>
    <Hero
      title="Des modules qui couvrent\nvotre pratique entière"
      subtitle="Chaque cabinet est différent. Activez seulement les modules dont vous avez besoin : nutrition, sport, prépa mentale, santé, parrainage. Tout est inclus dans votre offre."
      badge="9 modules, 0 surcoût"
    />

    <TrustBar />

    <Features
      title="9 modules, une plateforme"
      subtitle="Construisez votre espace sur mesure. Chaque module s'active d'un clic, sans migration, sans surcoût."
      features={[
        {
          icon: 'chart',
          title: 'Bilans & Progression',
          description: 'Bilans hebdo guidés, mensurations, photos avant/après, biomarqueurs, score de progression. Graphiques interactifs, détection signaux faibles IA, export PDF brandé.',
          link: { href: '/fonctionnalites#bilans', label: 'Voir le détail' }
        },
        {
          icon: 'document',
          title: 'Nutrition Complète',
          description: 'Plan alimentaire (protéines/glucides/lipides/légumes/fruits/plaisirs), listes de courses auto, compléments classés, méthodes OK/à éviter, templates réutilisables.',
          link: { href: '/fonctionnalites#nutrition', label: 'Voir le détail' }
        },
        {
          icon: 'zap',
          title: 'Sport & Programmes',
          description: 'Bibliothèque 200+ exercices (vidéo), programmes types, séances validées coaché, RPE, progression charge/volume. Import FitFocus.',
          link: { href: '/fonctionnalites#sport', label: 'Voir le détail' }
        },
        {
          icon: 'brain',
          title: 'Préparation Mentale',
          description: 'Exercices transversaux (visualisation, respiration, routine), bibliothèque ressources, journal d\'appels, cloisonnement données mental.',
          link: { href: '/fonctionnalites#mental', label: 'Voir le détail' }
        },
        {
          icon: 'globe',
          title: 'Santé Connectée',
          description: 'Sync Apple Health/Oura/Whoop/Garmin, 130+ biomarqueurs sanguins, IA lit PDF labo, habitudes quotidiennes, observance compléments.',
          link: { href: '/fonctionnalites#sante', label: 'Voir le détail' }
        },
        {
          icon: 'users',
          title: 'Gamification & Engagement',
          description: 'XP, badges, objectif ultime/mois, dreamboard, habitudes quotidiennes, observance, jalons parcours (photos, avis, reclosing).',
          link: { href: '/fonctionnalites#gamification', label: 'Voir le détail' }
        },
        {
          icon: 'lock',
          title: 'Journal Coaching & CRM',
          description: 'Entrées typées (lancement, suivi, bilan, micro, sport...), pièces jointes, partage client, sync Notion via n8n, CRM intégré.',
          link: { href: '/fonctionnalites#journal', label: 'Voir le détail' }
        },
        {
          icon: 'calendar',
          title: 'Appels Planifiés & Agenda',
          description: 'Cadence auto selon offre, rappels Slack/email/push, gestion retards, calendrier ICS abonnable, vue agenda coach.',
          link: { href: '/fonctionnalites#agenda', label: 'Voir le détail' }
        },
        {
          icon: 'shield',
          title: 'Admin & Conformité',
          description: 'Gestion utilisateurs (rôles, 2FA), offres appel custom, mentions légales, modules on/off, questionnaire lancement, RGPD, audit trail, webhooks, API keys.',
          link: { href: '/fonctionnalites#admin', label: 'Voir le détail' }
        },
      ]}
    />

    <section class="section bg-blanc" aria-labelledby="details-title">
      <div class="container">
        <header class="text-center max-w-3xl mx-auto mb-16">
          <h2 id="details-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
            Détails par module
          </h2>
          <p class="text-lg text-encre/60">
            Chaque module est complet, sans surcoût. Cliquez sur un module pour voir les spécifications techniques.
          </p>
        </header>

        <div class="space-y-12">
          {[
            {
              id: 'bilans',
              icon: 'chart',
              title: 'Bilans & Progression',
              color: 'bleu-signature',
              description: 'Le cœur du suivi : bilans hebdo guidés, mensurations, photos avant/après, score de progression composite. L\'IA détecte les signaux faibles (stagnation, baisse motivation, observance) avant qu\'ils ne deviennent critiques.',
              features: [
                'Bilans hebdo guidés (poids, mensurations, ressenti, sommeil, faim, motivation, pas, texte libre)',
                'Photos avant/après mensuelles avec alignement visuel automatique',
                'Score de progression composite (adhérence, évolution, bien-être) avec historique',
                'Graphiques interactifs : tendances, corrélations, régression linéaire, seuils de référence',
                'Détection signaux faibles IA : stagnation, désengagement, risque abandon, observance compléments',
                'Export PDF brandé pour le client (rapport mensuel/trimestriel) avec votre logo/couleurs',
              ],
              techSpecs: [
                '30+ points de données par bilan, historique illimité',
                'API : GET/POST /api/v1/clients/:id/checkins',
                'Webhook checkin.submitted temps réel',
                'Export RGPD inclus (modèle Checkin)',
              ],
            },
            {
              id: 'nutrition',
              icon: 'document',
              title: 'Nutrition Complète',
              color: 'bleu-lecture',
              description: 'Plans alimentaires individualisés par macro/micro-nutriments, listes de courses auto-générées, compléments classés (indispensable/optionnel), méthodes validées vs à éviter. Templates réutilisables par pathologie/objectif.',
              features: [
                'Répartition macro/micro-nutriments par repas et par jour, calcul automatique besoins (Mifflin-St Jeor)',
                'Listes de courses hebdo auto-générées (quantités, catégories, magasins préférés)',
                'Compléments : dosage, timing, marque recommandée, niveau de preuve scientifique (A/B/C)',
                'Méthodes validées vs à éviter (basé sur niveau de preuve Cochrane/GRADE)',
                'Templates réutilisables : perte de gras, prise de masse, longévité, pathologie (diabète, thyroïde...)',
                'Notes coach : visibles client / privées staff, journal alimentaire client (photo/texte) + validation coach',
              ],
              techSpecs: [
                'Base CIQUAL + USDA intégrée (3000+ aliments)',
                'API nutrition : GET/POST /api/v1/clients/:id/nutrition',
                'Import/Export JSON pour partage templates entre coachs',
              ],
            },
            {
              id: 'sport',
              icon: 'zap',
              title: 'Sport & Programmes',
              color: 'indigo',
              description: 'Bibliothèque d\'exercices (force/cardio/mobilité) avec vidéos, programmes types réutilisables, séances validées par le coaché avec ressenti/RPE. Import FitFocus. Suivi charge/volume/progression par exercice.',
              features: [
                '200+ exercices (vidéo, points d\'attention, régressions/progressions, muscles ciblés)',
                'Programmes types : force, hypertrophie, endurance, mobilité, réathlétisation, spécifique sport',
                'Création séances drag-and-drop, séries/récup/tempo/RPE, charges cibles, progression auto',
                'Validation coaché : charge réelle, RPE, ressenti, vidéo optionnelle, commentaires',
                'Graphiques progression : charge, volume, tonnage, 1RM estimé (Epley/Brzycki), fatigue',
                'Import FitFocus (JSON/CSV) — migration zéro friction, mapping exercices auto',
                'Périodisation : macros/mesos/microcycles visualisables, deloads programmés',
              ],
              techSpecs: [
                'Bibliothèque extensible (ajout exercices custom illimités)',
                'API sport : programmes, séances, exercices, progression',
                'Webhook session.completed pour sync externes (Notion, Slack...)',
              ],
            },
            {
              id: 'mental',
              icon: 'brain',
              title: 'Préparation Mentale',
              color: 'bleu-ardoise',
              description: 'Exercices transversaux déposés par le préparateur mental (visualisation, respiration, routine pré-compétition), bibliothèque ressources (vidéos, PDF, audio), journal d\'appels dédié, suivi adhérence. Séparation stricte des données mentales (confidentialité renforcée).',
              features: [
                'Exercices transversaux réutilisables : visualisation, cohérence cardiaque, ancrage, routine pré-perf',
                'Bibliothèque ressources : vidéos, PDF, audio guidés (streaming sécurisé, pas de téléchargement)',
                'Journal d\'appels dédié : compte-rendu, objectifs, plan d\'action, prochaine échéance',
                'Techniques : respiration box, cohérence cardiaque (5-5-5), scan corporel, routine pré-sommeil',
                'Suivi adhérence mental : fréquence, durée, ressentis pre/post, corrélation performance',
                'Cloisonnement données : le coach sport ne voit pas le contenu mental (rôle préparateur mental)',
                'Partage sélectif client : ce que le client autorise à voir (niveau 1/2/3)',
              ],
              techSpecs: [
                'Chiffrement supplémentaire au repos pour données mentales (AES-256 + envelope encryption)',
                'Rôle « préparateur mental » avec périmètre strict (RBAC granulaire)',
                'API mental : exercices, ressources, journal, adhérence',
              ],
            },
            {
              id: 'sante',
              icon: 'globe',
              title: 'Santé Connectée & Biomarqueurs',
              color: 'bleu-clair',
              description: 'Sync native Apple Health, Oura, Whoop, Garmin (via Raccourcis iOS ou n8n/Make). 130+ biomarqueurs structurés : sommeil, VFC, FC repos, VO2max, pas, poids, %MG. Analyses sanguines : glycémie, HbA1c, CRP, vit D, ferritine, lipidogramme, thyroïde, hormones. IA lit les PDF de labo et pré-remplit.',
              features: [
                'Sync native : Apple Health, Oura, Whoop, Garmin (Raccourcis iOS / n8n / Make / Zapier)',
                'Métriques quotidiennes : sommeil (stades, score, latency, régularité), VFC (rmssd, cv, tendance), FC repos, VO2max, pas, poids, %MG, température cutanée',
                '130+ biomarqueurs sanguins : glycémie, HbA1c, insuline, HOMA-IR, CRP, vit D, B9/B12, ferritine, lipidogramme, thyroïde (TSH, T3, T4, anticorps), hormones (testostérone, œstradiol, SHBG, cortisol, DHEA)',
                'Import PDF labo : IA extrait, structure, pré-remplit, signale anomalies (flags rouge/orange/vert)',
                'Graphiques tendances temporelles avec seuils cliniques de référence (OMS, sociétés savantes)',
                'Habitudes quotidiennes : eau, suppléments, exposition lumière, respiration, jeûne',
                'Observance compléments : rappels, validation, taux d\'adhérence, alertes rupture stock',
              ],
              techSpecs: [
                'Token santé par client (hsk_...) — scope granulaire (read/write par métrique)',
                'Endpoint /api/health-sync (HMAC signé) pour n8n/Make/Zapier',
                'Stockage Supabase bucket privé, chiffré AES-256',
                'Conformité HDS (hébergement données de santé) — Supabase EU West',
              ],
            },
            {
              id: 'gamification',
              icon: 'users',
              title: 'Gamification & Engagement',
              color: 'bordeaux',
              description: 'Onboarding gamifié (XP, badges), objectif ultime, objectif du mois, dreamboard, habitudes quotidiennes, observance compléments, jalons parcours (photos, avis, témoignage, reclosing). +40% adhérence sur les habitudes quotidiennes.',
              features: [
                'XP progressif : actions quotidiennes (bilan, séance, habitude, lecture) = XP, niveaux débloqués',
                'Badges : premiers pas, régularité, performance, mindset, social, expert (50+ badges)',
                'Objectif ultime : vision long terme (1 an) décomposée en objectifs mensuels/hebdo',
                'Dreamboard : collage visuel objectifs (images, citations, métriques cibles)',
                'Habitudes quotidiennes : config par client (eau, suppléments, mouvement, sommeil, lecture...)',
                'Observance compléments : rappels push/email, validation scan code-barres, taux adhérence',
                'Jalons parcours : photo 1er bilan, 1er avis Google, témoignage vidéo, reclosing automatique',
              ],
              techSpecs: [
                'Moteur de règles configurable par cabinet (XP/action, seuils badges)',
                'Webhook badge.earned pour notifications temps réel',
                'API gamification : XP, badges, habitudes, jalons',
              ],
            },
            {
              id: 'journal',
              icon: 'lock',
              title: 'Journal Coaching & CRM',
              color: 'bleu-ardoise',
              description: 'Entrées typées (lancement, suivi, prépa mentale, bilan mensuel, micronutrition, optimisation, sport, questionnaire, note), pièces jointes, partage client, sync Notion via n8n. CRM intégré : pipeline, statuts, relances, valeur vie client.',
              features: [
                'Entrées typées : lancement, suivi hebdo, bilan mensuel, micronutrition, optimisation, sport, questionnaire, note libre',
                'Pièces jointes : PDF, images, audio, vidéo (stockage Supabase privé, CDN Cloudflare)',
                'Partage client : visible / privé / commentaire seul, notification push/email',
                'Sync Notion via n8n : webhook note.created → base Notion (client, coach, date, type, contenu, visibilité)',
                'CRM pipeline : prospect → essai → client actif → risque churn → réactivation → archive',
                'Relances auto : inactivité 7/14/30j, anniversaire, renouvellement, upsell',
                'Valeur vie client (LTV) : calcul auto, segmentation RFM, alertes churn risk',
              ],
              techSpecs: [
                'API journal : entrées, pièces jointes, partage, tags',
                'Webhook note.created / note.shared',
                'Full-text search (PostgreSQL tsvector) sur entrées + pièces jointes OCR',
              ],
            },
            {
              id: 'agenda',
              icon: 'calendar',
              title: 'Appels Planifiés & Agenda',
              color: 'bleu-signature',
              description: 'Cadence auto selon l\'offre (Starter/Essentiel/Plus/Premium), rappels Slack/email/push, gestion retards, calendrier ICS abonnable, vue agenda coach. Intégré au journal coaching.',
              features: [
                'Cadence auto : fréquence appels selon offre + personnalisation par client',
                'Rappels multi-canal : Slack (équipe), email (client + coach), push (app client), calendrier ICS',
                'Gestion retards : alerte 15min avant, relance 30min après, report 1-clic, stats ponctualité',
                'Calendrier ICS abonnable : token par staff, URL `https://app.optibilan.com/api/calendrier/<token>.ics`, filtre par rôle',
                'Vue agenda coach : semaine/mois, filtres (client, type, statut), drag-and-drop report',
                'Intégré journal : création entrée auto post-appel, pré-remplie (client, date, type, durée)',
              ],
              techSpecs: [
                'Token calendrier par staff (régénérable, révocable)',
                'Sync Google Calendar / Apple Calendar / Outlook natif',
                'Webhook call.scheduled / call.completed / call.missed',
              ],
            },
            {
              id: 'admin',
              icon: 'shield',
              title: 'Admin & Conformité',
              color: 'bordeaux',
              description: 'Gestion utilisateurs (rôles, spécialités, 2FA), offres d\'appel personnalisées, mentions légales du cabinet, modules on/off, questionnaire lancement configurable, RGPD (export, purge), audit trail, webhooks, API keys. Marque blanche totale.',
              features: [
                'Gestion utilisateurs : rôles (admin, coach, mental, diet, support), spécialités, 2FA TOTP obligatoire admins',
                'Offres d\'appel personnalisées : durée, fréquence, tarif, inclus, renouvellement auto',
                'Marque blanche : logo, thème, domaine, vocabulaire, assistant IA, emails, mentions, CGV, mentions légales cabinet',
                'Modules on/off : activation instantanée, pas de migration, pas de surcoût',
                'Questionnaire lancement configurable : champs, ordre, conditionnels, pré-remplissage IA',
                'RGPD : export 1-clic (37 modèles JSON), purge paramétrable (durée + flag), droit à l\'oubli cascade',
                'Audit trail double niveau : org (actions staff) + plateforme (équipe Optibilan : suspension, plan, dépannage)',
                'Webhooks : 8 événements, HMAC, retry exponentiel, idempotence externalId',
                'API keys : scopées (clients:read, checkins:write, cron, health:sync...), rotation, expiration',
              ],
              techSpecs: [
                'Architecture multi-tenant fail-closed (extension Prisma tenant-guard)',
                '13/13 tests d\'isolation en CI (test:isolation.mts)',
                'DPA signé, registre sous-traitants Art.28 RGPD à jour',
                'PITR 7j + snapshots quotidiens + backups chiffrés S3 EU 30j',
                'Certifications : SOC 2 Type II, ISO 27001, HIPAA, RGPD',
              ],
            },
          ].map(module => (
            <article id={module.id} class="py-8 border-t border-encre/10 first:border-0">
              <header class="flex items-center gap-4 mb-6">
                <div class="icon-wrapper flex-shrink-0" aria-hidden="true" style={`background-color: var(--color-${module.color}); background-color: color-mix(in oklab, var(--color-${module.color}) 15%, transparent);`}>
                  <Icon name={module.icon} class="w-7 h-7" style={`color: var(--color-${module.color});`} />
                </div>
                <div>
                  <h3 class="font-display text-2xl font-bold text-encre">{module.title}</h3>
                  <p class="text-encre/60 mt-1">{module.description}</p>
                </div>
              </header>

              <div class="grid md:grid-cols-2 gap-8">
                <div>
                  <h4 class="font-semibold text-encre mb-3 flex items-center gap-2">
                    <Icon name="check" class="w-5 h-5" style={`color: var(--color-${module.color});`} />
                    Fonctionnalités clés
                  </h4>
                  <ul class="space-y-2 text-encre/60">
                    {module.features.map(f => (
                      <li key={f} class="flex items-start gap-2">
                        <span class="w-1.5 h-1.5 rounded-full flex-shrink-0 mt-2" style={`background-color: var(--color-${module.color});`} />
                        <span>{f}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h4 class="font-semibold text-encre mb-3 flex items-center gap-2">
                    <Icon name="code" class="w-5 h-5" style={`color: var(--color-${module.color});`} />
                    Spécifications techniques
                  </h4>
                  <ul class="space-y-2 text-sm text-encre/60">
                    {module.techSpecs.map(s => (
                      <li key={s} class="flex items-start gap-2">
                        <span class="w-1.5 h-1.5 rounded-full flex-shrink-0 mt-1.5" style={`background-color: var(--color-${module.color});`} />
                        <span>{s}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <CTA
      title="Chaque module s'active en un clic"
      subtitle="Pas de migration, pas de surcoût. Votre offre inclut tout."
    />
  </main>

  <Footer />
</Layout>