---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import CTA from '../../components/CTA.astro';
import TrustBar from '../../components/TrustBar.astro';
import Icon from '../../components/Icon.astro';

const pageTitle = 'Solutions - Optibilan';
const pageDescription = 'Optibilan s\'adapte à votre pratique : Coach sportif, Nutritionniste, Préparateur mental, Cabinet. Une plateforme, quatre façons de l\'utiliser.';

const solutions = [
  {
    href: '/solutions/coaches',
    icon: 'zap',
    title: 'Coach sportif',
    desc: 'Programmes, bilans, progression, adhérence, communication. Passez moins de temps à gérer, plus de temps à coacher.',
    color: 'indigo',
    stats: ['×4 capacité coach', '−75% temps admin', '+40% rétention'],
    featured: true,
  },
  {
    href: '/solutions/nutrition',
    icon: 'document',
    title: 'Nutritionniste / Diététicien',
    desc: 'Plans, habitudes, listes de courses, compléments, évolution. La nutrition à l\'échelle. Templates, validation 1 clic, conformité.',
    color: 'bleu-lecture',
    stats: ['Plan en 5 min', 'Courses auto', '100% conforme'],
    featured: false,
  },
  {
    href: '/solutions/mental',
    icon: 'brain',
    title: 'Préparateur mental',
    desc: 'Exercices, ressources, journal d\'appels, adhérence. Cloisonnement strict des données. Le mental structuré.',
    color: 'indigo',
    stats: ['Adhérence +60%', 'Zéro fuite data', '100% cloisonné'],
    featured: false,
  },
  {
    href: '/solutions/cabinets',
    icon: 'users',
    title: 'Cabinet / Équipe',
    desc: 'Multi-praticiens, permissions, coordination, administration, sécurité, audit, marque blanche. L\'OS de votre cabinet.',
    color: 'bordeaux',
    stats: ['Staff illimité', 'Marque 100% invisible', 'SLA + audit trail'],
    featured: true,
  },
];

const solutionsCross = [
  { icon: 'users', title: 'Coach + Nutrition', desc: 'Le coach gère l\'entraînement, le nutritionniste le plan alimentaire. Données partagées selon permissions. Le client a un seul dossier.' },
  { icon: 'brain', title: 'Coach + Mental', desc: 'Le coach suit la performance, le préparateur mental l\'adhérence. Données cloisonnées, partage sélectif. Le sportif au centre.' },
  { icon: 'users', title: 'Cabinet complet', desc: 'Coach + Nutritionniste + Mental + Médecin. Permissions granulaires, journal partagé selon permissions, coordination fluide. Une vision 360°.' },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/solutions"
  ogImage="/og-solutions.jpg"
>
  <Header />

  <main>
    <Hero
      title="Une plateforme.
Quatre façons de l'utiliser."
      subtitle="Optibilan s'adapte à votre pratique : Coach, Nutritionniste, Préparateur mental, Cabinet. Chaque solution active les modules pertinents, avec les permissions adaptées."
      badge="4 solutions, 1 plateforme"
      primaryCTA={{ href: 'https://calendly.com/optibilan/demo', label: 'Choisir ma solution' }}
      secondaryCTA={{ href: '/product/overview', label: 'Voir tous les modules' }}
    />

    <TrustBar />

    <section class="section bg-blanc" aria-labelledby="solutions-title">
      <div class="container">
        <header class="text-center max-w-3xl mx-auto mb-16">
          <h2 id="solutions-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
            Optibilan s'adapte à votre pratique
          </h2>
          <p class="text-lg text-encre/60 max-w-2xl mx-auto">
            Chaque solution active les modules pertinents, avec les permissions adaptées à votre métier.
          </p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {solutions.map((sol, i) => (
            <article class={`card-hover relative overflow-hidden ${sol.featured ? 'ring-2 ring-bleu-signature' : ''}`} style={`animation-delay: ${i * 100}ms`}>
              {sol.featured && (
                <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 bg-bleu-signature text-craie text-xs font-semibold rounded-full">
                  Recommandé
                </div>
              )}
              <div class="p-6 md:p-8">
                <div class="icon-wrapper mb-4" aria-hidden="true" style={`--mod-color: var(--color-${sol.color})`}>
                  <Icon name={sol.icon} class="w-8 h-8" style={`color: var(--color-${sol.color});`} />
                </div>
                <h3 class="font-display text-xl font-bold text-encre mb-3">{sol.title}</h3>
                <p class="text-encre/60 leading-relaxed mb-5">{sol.desc}</p>

                <div class="flex flex-wrap gap-2 mb-6">
                  {sol.stats.map(stat => (
                    <span key={stat} class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-puce text-xs font-medium" style={`color: var(--color-${sol.color}); background-color: color-mix(in oklab, var(--color-${sol.color}) 10%, transparent);`}>
                      {stat}
                    </span>
                  ))}
                </div>

                <a href={sol.href} class="inline-flex items-center gap-1.5 text-sm font-medium" style={`color: var(--color-${sol.color});`} data-track={`solution_${sol.title.toLowerCase().replace(/\s+/g, '_')}_cta`}>
                  Découvrir la solution
                  <Icon name="arrowRight" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
</a>
              </div>
              </article>
            ))}
          </div>

        <div class="text-center mt-16">
          <p class="text-encre/60 mb-8 max-w-xl mx-auto">
            Vous ne vous reconnaissez pas dans ces 4 profils ? Optibilan est modulaire : activez seulement les modules dont vous avez besoin.
          </p>
          <a href="/product/overview" class="btn-secondary" data-track="solutions_view_all_modules">
            <Icon name="grid" class="w-4 h-4 mr-2" /> Voir tous les modules
          </a>
        </div>
      </div>
    </section>

    <section class="section bg-papier" aria-labelledby="cross-title">
      <div class="container">
        <header class="text-center max-w-3xl mx-auto mb-16">
          <h2 id="cross-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
            Une plateforme, des usages croisés
          </h2>
          <p class="text-lg text-encre/60">
            La force d'Optibilan : les modules se combinent. Un coach peut activer la nutrition. Un cabinet coordonne coach + mental + nutrition.
          </p>
        </header>

<div class="grid md:grid-cols-3 gap-8">
          {solutionsCross.map((item, i) => {
            return (
              <article key={item.title} class="card-hover p-6 md:p-8 text-center" style={`animation-delay: ${i * 100}ms`}>
                <div class="icon-wrapper mx-auto mb-4" aria-hidden="true" style="background-color: var(--color-bleu-clair);">
                  <Icon name={item.icon} class="w-8 h-8 text-bleu-signature" />
                </div>
                <h3 class="font-display text-xl font-bold text-encre mb-3">{item.title}</h3>
                <p class="text-encre/60 leading-relaxed">{item.desc}</p>
              </article>
            );
          })}
</div>
      </div>
    </section>

    <CTA
      title="Vous ne trouvez pas votre profil ?"
      subtitle="Optibilan est modulaire. Activez seulement les modules dont vous avez besoin."
      primaryCTA={{ href: '/product/overview', label: 'Voir tous les modules' }}
      secondaryCTA={{ href: 'https://calendly.com/optibilan/demo', label: 'Réserver une démo' }}
      variant="gold"
    />
  </main>

  <Footer />
</Layout>