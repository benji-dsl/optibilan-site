---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import CTA from '../../components/CTA.astro';
import TrustBar from '../../components/TrustBar.astro';
import Icon from '../../components/Icon.astro';

const pageTitle = 'Newsletter Optibilan — Ressources hebdo pour cabinets qui grandissent';
const pageDescription = 'Recevez chaque mardi un article, une astuce ou un cas client directement dans votre boîte mail. 2 000+ abonnés. Désinscription 1 clic.';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/newsletter"
  ogImage="/og-newsletter.jpg"
>
  <Header />

  <main>
    <Hero
      title="La newsletter des cabinets\nqui veulent grandir"
      subtitle="Chaque mardi : un article, une astuce technique ou un cas client concret. Écrit par des coachs, pour des coachs. Pas de spam, que de la valeur."
      badge="2 000+ abonnés — 4,8/5 satisfaction"
    />

    <TrustBar />

    <section class="section bg-blanc" aria-labelledby="benefits-title">
      <div class="container">
        <header class="text-center max-w-3xl mx-auto mb-12">
          <h2 id="benefits-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">Pourquoi s'abonner ?</h2>
          <p class="text-lg text-encre/60">Du contenu actionnable, pas de la théorie.</p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <article class="card-hover p-6 md:p-8 text-center">
            <div class="icon-wrapper mx-auto mb-4" aria-hidden="true">
              <Icon name="document" class="w-10 h-10" />
            </div>
            <h3 class="font-display text-xl font-bold text-encre mb-3">Articles pratiques</h3>
            <p class="text-encre/60 leading-relaxed">Guides step-by-step : automatisation bilans, templates nutrition, config marque blanche, sync wearables.</p>
          </article>
          <article class="card-hover p-6 md:p-8 text-center">
            <div class="icon-wrapper mx-auto mb-4" aria-hidden="true">
              <Icon name="chart" class="w-10 h-10" />
            </div>
            <h3 class="font-display text-xl font-bold text-encre mb-3">Cas clients réels</h3>
            <p class="text-encre/60 leading-relaxed">Retours d'expérience chiffrés : Studio Performance ×4 capacité, Cabinet Vitalité −80% admin, etc.</p>
          </article>
          <article class="card-hover p-6 md:p-8 text-center">
            <div class="icon-wrapper mx-auto mb-4" aria-hidden="true">
              <Icon name="zap" class="w-10 h-10" />
            </div>
            <h3 class="font-display text-xl font-bold text-encre mb-3">Astuces techniques</h3>
            <p class="text-encre/60 leading-relaxed">Raccourcis n8n, prompts IA, config webhooks, optimisation API — applicable immédiatement.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section bg-gradient-to-br from-bleu-signature via-bleu-lecture to-indigo rounded-card-lg relative overflow-hidden" aria-labelledby="subscribe-title">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-bleu-signature/20 via-transparent to-transparent" aria-hidden="true"></div>
      <div class="absolute top-0 right-0 w-96 h-96 bg-bleu-signature/10 rounded-full blur-3xl" aria-hidden="true"></div>
      <div class="absolute bottom-0 left-0 w-96 h-96 bg-bleu-signature/10 rounded-full blur-3xl" aria-hidden="true"></div>

      <div class="container relative text-center max-w-2xl mx-auto py-16 md:py-24">
        <h2 id="subscribe-title" class="font-display text-3xl md:text-4xl font-bold mb-4 text-craie">Rejoignez 2 000+ pros de la santé</h2>
        <p class="text-lg mb-8 text-craie/80 max-w-xl mx-auto">Un email par mardi. Désinscription 1 clic. Vos données ne sont jamais vendues.</p>

        <form action="https://api.optibilan.com/newsletter/subscribe" method="POST" class="flex flex-col sm:flex-row items-center justify-center gap-4 max-w-md mx-auto" data-track="newsletter_signup">
          <input
            type="email"
            name="email"
            placeholder="votre@email.com"
            required
            class="flex-1 px-5 py-3.5 rounded-full bg-blanc/10 border border-craie/30 text-craie placeholder-craie/50 focus:outline-none focus:border-bleu-signature focus:bg-blanc/20 transition-all"
            aria-label="Votre email"
          />
          <button type="submit" class="btn-demo whitespace-nowrap" data-track="newsletter_submit">
            S'abonner gratuitement
            <Icon name="arrowRight" class="w-5 h-5" />
          </button>
        </form>

        <p class="mt-6 text-sm text-craie/60">
          En vous abonnant, vous acceptez notre <a href="/legal/confidentialite" class="underline hover:text-craie">Politique de confidentialité</a>. RGPD compliant.
        </p>
      </div>
    </section>

    <CTA
      title="Vous avez raté les derniers numéros ?"
      subtitle="Consultez les archives complètes sur le blog."
      primaryCTA={{ href: '/blog', label: 'Voir le blog' }}
      variant="gold"
    />
  </main>

  <Footer />
</Layout>