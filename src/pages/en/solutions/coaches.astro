---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Hero from '@/components/Hero.astro';
import CTA from '@/components/CTA.astro';
import TrustBar from '@/components/TrustBar.astro';
import Icon from '@/components/Icon.astro';
import { localizePath } from '@/i18n/config';

const lp = (href: string) => localizePath(href, 'en');

const pageTitle = 'Software for sports coaches: clients, programs, check-ins';
const pageDescription = 'The client-tracking software for sports coaches: programs, check-ins, progress, adherence and communication in a single platform. 30-day free trial.';

const eduOrgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  '@id': 'https://optibilan.com/en/#educational-organization',
  name: 'Optibilan',
  url: 'https://optibilan.com/en/',
  logo: 'https://optibilan.com/optibilan-logo.svg',
  inLanguage: 'en-US',
  areaServed: 'FR',
  sameAs: [
    'https://twitter.com/optibilan',
    'https://linkedin.com/company/optibilan',
    'https://github.com/optibilan',
    'https://youtube.com/@optibilan',
  ],
};
const courseJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  '@id': 'https://optibilan.com/en/solutions/#course',
  name: 'Training and support with Optibilan',
  description: 'Practical training to structure check-ins, nutrition and training follow-up, and automate processes with the Optibilan platform.',
  provider: { '@type': 'EducationalOrganization', '@id': 'https://optibilan.com/en/#educational-organization' },
  url: 'https://optibilan.com/en/solutions/',
  inLanguage: 'en-US',
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://optibilan.com/en/' },
    { '@type': 'ListItem', position: 2, name: 'Solutions', item: 'https://optibilan.com/en/solutions/' },
    { '@type': 'ListItem', position: 3, name: 'Sports coach', item: 'https://optibilan.com/en/solutions/coaches/' },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang="en"
  canonical="/en/solutions/coaches/"
  ogImage="/og/en/solution-coach.png"
  jsonLd={[breadcrumbJsonLd, eduOrgJsonLd, courseJsonLd]}
  heroImage="/images/product/08-utilisateur-course-exterieur.webp"
>
  <Header />

  <main id="contenu">
    <Hero
      variant="page"
      title="Spend less time 
managing. 
More time coaching."
      subtitle="Programs, check-ins, progress, adherence, communication in a single platform. Built for coaches who want to scale without losing quality."
      primaryCTA={{ href: '/pricing/', label: 'Join Optibilan' }}
      secondaryCTA={{ href: '/checkout/solo/', label: 'Free trial' }}
      backgroundImage="/images/product/08-utilisateur-course-exterieur.webp"
    />

    <TrustBar />

    <section class="section bg-papier" aria-labelledby="coaches-visual-title">
      <div class="container">
        <header class="text-center max-w-3xl mx-auto mb-12">
          <h2 id="coaches-visual-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
            Human support, backed by a solid structure
          </h2>
          <p class="text-lg text-encre/60">
            The tools step back so the coach-client relationship can lead.
          </p>
        </header>
        <div class="aspect-video max-w-4xl mx-auto rounded-xl border border-encre/10 bg-blanc overflow-hidden shadow-xl">
          <img
            src="/images/product/08-utilisateur-course-exterieur.webp"
            alt="Sports coach supporting his client during an outdoor session"
            class="w-full h-full object-cover"
            loading="eager"
            fetchpriority="high" width="1000" height="673" />
        </div>
      </div>
    </section>

    <section class="section bg-blanc" aria-labelledby="promise-title">
      <div class="container max-w-3xl">
        <header class="text-center mb-16">
          <h2 id="promise-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
            Your promise: program, track, adjust. Without the admin.
          </h2>
          <p class="text-lg text-encre/60 max-w-2xl mx-auto">
            Optibilan frees you from paperwork so you can focus on what matters: the coach-client relationship and performance.
          </p>
        </header>

        <div class="grid md:grid-cols-2 gap-6 mb-16">
          {[
            { icon: 'zap', title: 'Programs in minutes, not hours', desc: 'Library of 200+ exercises (video), drag-and-drop sessions, automatic progression, visual periodization. Duplicate in 1 click.' },
            { icon: 'chart', title: 'Client check-ins in 30 sec', desc: 'Guided questionnaires, photos, measurements, how they feel. Automatic charts, plateau detection, branded PDF export.' },
            { icon: 'users', title: 'Adherence steered, not endured', desc: 'Gamification (XP, badges, habits), AI alerts, automatic follow-ups. Improved retention.' },
            { icon: 'document', title: 'Centralized communication', desc: 'Coaching journal, scheduled calls, Slack/email/push reminders, ICS calendar. Everything in the client record.' },
          ].map(item => (
            <article class="p-6 rounded-xl border border-encre/10 hover:border-bleu-signature/30 hover:shadow-soft transition-all">
              <div class="icon-wrapper mb-4" aria-hidden="true" style="background-color: var(--color-bleu-clair);">
                <Icon name={item.icon} class="w-7 h-7 text-bleu-signature" />
              </div>
              <h3 class="font-display text-xl font-bold text-encre mb-2">{item.title}</h3>
              <p class="text-encre/60">{item.desc}</p>
            </article>
          ))}
        </div>

        <div class="p-6 md:p-8 rounded-xl bg-gradient-to-br from-bleu-signature/5 via-papier to-bleu-lecture/5 border border-encre/10 mb-16">
          <h3 class="font-display text-xl md:text-2xl font-bold text-encre mb-4">Coach testimonial</h3>
          <blockquote class="text-encre/70 leading-relaxed mb-4 italic max-w-2xl">
            "The exercise library (200+ videos) and the session templates saved me 10 hours a week. My clients log their sessions in the app and I see their progress in real time. Six-month retention went from 65% to 89%. I went from 30 to 120 clients without hiring anyone."
          </blockquote>
          <footer class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-bleu-signature to-bleu-lecture flex items-center justify-center text-craie font-bold text-sm">TB</div>
            <div>
              <div class="font-semibold text-encre">Thomas Bertrand</div>
              <div class="text-sm text-encre/50">Sports coach & Founder · Studio Performance - Bordeaux</div>
            </div>
          </footer>
        </div>

        <h3 class="font-display text-2xl font-bold text-encre mb-8">Key modules for sports coaches</h3>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {[
            { href: '/product/training/', icon: 'zap', title: 'Sport & Programs', desc: 'Library of 200+, drag-and-drop, automatic progression, FitFocus import', color: 'indigo' },
            { href: '/product/check-ins/', icon: 'chart', title: 'Check-ins & Progress', desc: 'Guided questionnaires, charts, plateau detection, PDF export', color: 'bleu-signature' },
            { href: '/product/engagement/', icon: 'users', title: 'Gamification & Habits', desc: 'XP, badges, dreamboard, habits, AI alerts, automatic follow-ups', color: 'bordeaux' },
            { href: '/product/crm/', icon: 'lock', title: 'Coaching Journal & CRM', desc: 'Typed entries, pipeline, follow-ups, sharing, Notion sync', color: 'bleu-ardoise' },
            { href: '/product/agenda/', icon: 'calendar', title: 'Calls & ICS Calendar', desc: 'Automatic cadence, multi-channel reminders, shared calendar', color: 'bleu-signature' },
            { href: '/product/white-label/', icon: 'shield', title: 'White Label', desc: 'Your logo, theme, domain, wording, emails', color: 'bordeaux' },
          ].map(mod => (
            <a href={lp(mod.href)} class="card-hover p-6 text-center group" style={`--mod-color: var(--color-${mod.color})`}>
              <div class="icon-wrapper mx-auto mb-4" aria-hidden="true" style={`background-color: color-mix(in oklab, var(--color-${mod.color}) 15%, transparent);`}>
                <Icon name={mod.icon} class="w-7 h-7" style={`color: var(--color-${mod.color});`} />
              </div>
              <h4 class="font-display text-lg font-bold text-encre mb-2">{mod.title}</h4>
              <p class="text-sm text-encre/50">{mod.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <CTA
      title="Want to see how this applies to YOUR practice?"
      subtitle="30 minutes to set up Optibilan around your coaching method."
      primaryCTA={{ href: '/pricing/', label: 'Join Optibilan' }}
      secondaryCTA={{ href: '/checkout/solo/', label: 'Free trial' }}
      variant="primary"
    />
  </main>

  <Footer />
</Layout>
