---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ArticleCard from '@/components/blog/ArticleCard.astro';
import Pagination from '@/components/blog/Pagination.astro';
import Icon from '@/components/Icon.astro';
import { getAllPostsEn, getCategoriesEn, CATEGORY_MAP_EN, PER_PAGE_EN } from '@/utils/blog-en';

export function getStaticPaths() {
  return getCategoriesEn().map(cat => ({ params: { slug: cat.slug } }));
}

const { slug } = Astro.params;
if (!slug || typeof slug !== 'string') throw new Error('Slug required');

const posts = getAllPostsEn();
const categories = getCategoriesEn();

const catInfo = categories.find(c => c.slug === slug) ?? CATEGORY_MAP_EN[slug];
if (!catInfo) return Astro.redirect('/en/blog/');

const allCategoryPosts = posts.filter(p => p.category === slug);
const totalPages = Math.max(1, Math.ceil(allCategoryPosts.length / PER_PAGE_EN));
const pagePosts = allCategoryPosts.slice(0, PER_PAGE_EN);
const categoryLabel = catInfo.label.toLowerCase();

const pageTitle = `${catInfo.label}: articles and guides | Optibilan blog`;
const pageDescription = `All our ${categoryLabel} articles for coaches, nutritionists and health professionals: methods, tools and field experience.`;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://optibilan.com/en/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://optibilan.com/en/blog/' },
    { '@type': 'ListItem', position: 3, name: catInfo.label, item: `https://optibilan.com/en/blog/category/${slug}/` },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang="en"
  canonical={`/en/blog/category/${slug}/`}
  ogImage="/og/en/blog.png"
  jsonLd={breadcrumbJsonLd}
>
  <Header />

  <main id="contenu">
    <section class="section pt-16 md:pt-20 bg-papier">
      <div class="container">
        <div class="max-w-3xl mx-auto text-center">
          <a href="/en/blog/" class="inline-flex items-center gap-1 text-sm text-encre/50 hover:text-encre transition-colors mb-6">
            <Icon name="arrowRight" class="w-4 h-4 rotate-180" /> All articles
          </a>
          <div
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-puce text-sm font-medium mb-5"
            style={`color: var(--color-${catInfo.color}); background-color: color-mix(in oklab, var(--color-${catInfo.color}) 10%, transparent);`}
          >
            <Icon name={catInfo.icon} class="w-4 h-4" />
            {catInfo.label}
          </div>
          <h1 class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
            {catInfo.label} articles
          </h1>
          <p class="text-encre/50 text-sm">
            {allCategoryPosts.length} article{allCategoryPosts.length === 1 ? '' : 's'}
            {totalPages > 1 ? `, page 1 of ${totalPages}` : ''}
          </p>
        </div>
      </div>
    </section>

    <section class="section bg-blanc">
      <div class="container">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {pagePosts.map(article => (
            <ArticleCard article={article} />
          ))}
        </div>

        <Pagination currentPage={1} totalPages={totalPages} baseUrl={`/en/blog/category/${slug}/`} />
      </div>
    </section>
  </main>

  <Footer />
</Layout>
