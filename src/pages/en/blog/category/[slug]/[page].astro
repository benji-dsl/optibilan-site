---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ArticleCard from '@/components/blog/ArticleCard.astro';
import Pagination from '@/components/blog/Pagination.astro';
import Icon from '@/components/Icon.astro';
import { getAllPostsEn, getCategoriesEn, CATEGORY_MAP_EN, PER_PAGE_EN } from '@/utils/blog-en';

export function getStaticPaths() {
  const posts = getAllPostsEn();
  const paths = [];
  for (const cat of getCategoriesEn()) {
    const count = posts.filter(p => p.category === cat.slug).length;
    const totalPages = Math.max(1, Math.ceil(count / PER_PAGE_EN));
    for (let page = 2; page <= totalPages; page += 1) {
      paths.push({ params: { slug: cat.slug, page: String(page) } });
    }
  }
  return paths;
}

const { slug, page } = Astro.params;
if (!slug || typeof slug !== 'string') throw new Error('Slug required');
const currentPage = Number(page);

const posts = getAllPostsEn();
const categories = getCategoriesEn();
const catInfo = categories.find(c => c.slug === slug) ?? CATEGORY_MAP_EN[slug];
if (!catInfo) return Astro.redirect('/en/blog/');

const allCategoryPosts = posts.filter(p => p.category === slug);
const totalPages = Math.max(1, Math.ceil(allCategoryPosts.length / PER_PAGE_EN));
if (!Number.isFinite(currentPage) || currentPage < 2 || currentPage > totalPages) {
  return Astro.redirect(`/en/blog/category/${slug}/`);
}

const pagePosts = allCategoryPosts.slice((currentPage - 1) * PER_PAGE_EN, currentPage * PER_PAGE_EN);

const pageTitle = `${catInfo.label}: articles (page ${currentPage} of ${totalPages}) | Optibilan blog`;
const pageDescription = `All our ${catInfo.label.toLowerCase()} articles for coaches, nutritionists and health professionals, page ${currentPage} of ${totalPages}.`;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://optibilan.com/en/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://optibilan.com/en/blog/' },
    { '@type': 'ListItem', position: 3, name: catInfo.label, item: `https://optibilan.com/en/blog/category/${slug}/` },
    { '@type': 'ListItem', position: 4, name: `Page ${currentPage}`, item: `https://optibilan.com/en/blog/category/${slug}/page/${currentPage}/` },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang="en"
  canonical={`/en/blog/category/${slug}/page/${currentPage}/`}
  ogImage="/og/en/blog.png"
  jsonLd={breadcrumbJsonLd}
>
  <Header />

  <main>
    <section class="section pt-16 md:pt-20 bg-papier">
      <div class="container">
        <div class="max-w-3xl mx-auto text-center">
          <a href={`/en/blog/category/${slug}/`} class="inline-flex items-center gap-1 text-sm text-encre/50 hover:text-encre transition-colors mb-6">
            <Icon name="arrowRight" class="w-4 h-4 rotate-180" /> Page 1
          </a>
          <h1 class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
            {catInfo.label} articles
          </h1>
          <p class="text-encre/50 text-sm">
            {allCategoryPosts.length} article{allCategoryPosts.length === 1 ? '' : 's'}, page {currentPage} of {totalPages}
          </p>
        </div>
      </div>
    </section>

    <section class="section bg-blanc">
      <div class="container">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {pagePosts.map(article => (
            <ArticleCard article={article} />
          ))}
        </div>

        <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl={`/en/blog/category/${slug}/`} />
      </div>
    </section>
  </main>

  <Footer />
</Layout>
