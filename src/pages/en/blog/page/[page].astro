---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ArticleCard from '@/components/blog/ArticleCard.astro';
import Pagination from '@/components/blog/Pagination.astro';
import Icon from '@/components/Icon.astro';
import { getAllPostsEn, getCategoriesEn, PER_PAGE_EN } from '@/utils/blog-en';

export function getStaticPaths() {
  const allPosts = getAllPostsEn();
  const totalPages = Math.max(1, Math.ceil(allPosts.length / PER_PAGE_EN));
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const { page } = Astro.params;
const currentPage = Number(page);
const allPosts = getAllPostsEn();
const categories = getCategoriesEn();

const totalPages = Math.max(1, Math.ceil(allPosts.length / PER_PAGE_EN));
if (!Number.isFinite(currentPage) || currentPage < 2 || currentPage > totalPages) {
  return Astro.redirect('/en/blog/');
}

const pagePosts = allPosts.slice((currentPage - 1) * PER_PAGE_EN, currentPage * PER_PAGE_EN);

const pageTitle = `Optibilan blog: articles (page ${currentPage} of ${totalPages})`;
const pageDescription = `Articles and guides for sports coaches, nutritionists and health professionals: check-ins, client tracking, nutrition, mental preparation and business (page ${currentPage}/${totalPages}).`;

const blogJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Optibilan blog',
  description: 'Articles and guides for practices, studios and coaches',
  url: `https://optibilan.com/en/blog/page/${currentPage}/`,
  inLanguage: 'en-US',
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://optibilan.com/en/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://optibilan.com/en/blog/' },
    {
      '@type': 'ListItem',
      position: 3,
      name: `Page ${currentPage}`,
      item: `https://optibilan.com/en/blog/page/${currentPage}/`,
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang="en"
  canonical={`/en/blog/page/${currentPage}/`}
  ogImage="/og/en/blog.png"
  jsonLd={[blogJsonLd, breadcrumbJsonLd]}
>
  <Header />

  <main>
    <section class="section pt-16 md:pt-20 bg-papier">
      <div class="container">
        <div class="max-w-3xl mx-auto text-center">
          <a href="/en/blog/" class="inline-flex items-center gap-1 text-sm text-encre/50 hover:text-encre transition-colors mb-6">
            <Icon name="arrowRight" class="w-4 h-4 rotate-180" /> Page 1
          </a>
          <h1 class="font-display text-4xl md:text-5xl font-bold text-encre mb-4">The Optibilan blog</h1>
          <p class="text-lg text-encre/60">
            Advice, methods and case studies for coaches, nutritionists and health professionals.
          </p>
          <p class="text-sm text-encre/40 mt-3">
            {allPosts.length} articles, page {currentPage} of {totalPages}
          </p>
        </div>

        <div class="flex flex-wrap justify-center gap-3 mt-8">
          {categories.map(c => (
            <a
              href={`/en/blog/category/${c.slug}/`}
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-card border border-encre/10 bg-blanc hover:border-bleu-signature/40 hover:shadow-soft transition-all font-medium text-encre/80"
            >
              <Icon name={c.icon} class="w-4 h-4" style={`color: var(--color-${c.color});`} />
              {c.label}
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section bg-blanc">
      <div class="container">
        <h2 class="sr-only">Articles</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {pagePosts.map(article => (
            <ArticleCard article={article} />
          ))}
        </div>

        <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl="/en/blog/" />
      </div>
    </section>
  </main>

  <Footer />
</Layout>
