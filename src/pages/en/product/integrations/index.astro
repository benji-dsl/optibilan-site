---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Hero from '@/components/Hero.astro';
import CTA from '@/components/CTA.astro';
import Icon from '@/components/Icon.astro';
import { localizePath } from '@/i18n/config';

const lp = (href: string) => localizePath(href, 'en');

const pageTitle = 'Optibilan integrations and API: REST, webhooks, calendar';
const pageDescription = 'Connect Optibilan to your ecosystem. Health, calendar, communication, automation, payment: everything integrates natively or through connectors.';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  inLanguage: 'en-US',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://optibilan.com/en/' },
    { '@type': 'ListItem', position: 2, name: 'Product', item: 'https://optibilan.com/en/product' },
    { '@type': 'ListItem', position: 3, name: 'Integrations', item: 'https://optibilan.com/en/product/integrations' },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang="en"
  canonical="/en/product/integrations/"
  ogImage="/og/en/integrations.png"
  jsonLd={breadcrumbJsonLd}
>
  <Header />

  <main>
    <Hero
      title="Optibilan plugs into 
your ecosystem."
      subtitle="Health, calendar, communication, automation, payment. Connect what you already use."
      primaryCTA={{ href: '/docs/', label: 'API documentation' }}
      secondaryCTA={{ href: '/pricing/', label: 'Join Optibilan' }}
    />

    <section class="section bg-blanc" aria-labelledby="visuel-key">
      <div class="container">
        <div class="aspect-video max-w-4xl mx-auto rounded-xl overflow-hidden relative">
          <img
            src="/images/product/08-utilisateur-course-exterieur.webp"
            alt="User running outdoors, data synchronized by Optibilan"
            class="w-full h-full object-cover"
            loading="lazy" width="1000" height="673" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent" aria-hidden="true"></div>
          <div class="absolute bottom-4 left-1/2 -translate-x-1/2 text-center text-white/90 text-sm">
            <span class="flex items-center justify-center gap-1 bg-black/30 px-3 py-1 rounded-full backdrop-blur-sm">
              <Icon name="activity" class="w-4 h-4" />
              Plug in your tools. Data flows.
            </span>
          </div>
        </div>
      </div>
    </section>

    <section class="section bg-blanc" aria-labelledby="categories-title">
      <div class="container">
        <header class="text-center max-w-3xl mx-auto mb-16">
          <h2 id="categories-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">
            A catalog of integrations that work
          </h2>
          <p class="text-lg text-encre/60">Each connection is categorized by how it works.</p>
        </header>

        <div class="space-y-12">
          {[
            {
              category: 'Health & wearables',
              icon: 'globe',
              color: 'bleu-clair',
              integrations: [
                { name: 'Apple Health', type: 'NATIVE', desc: 'Sync via iOS Shortcuts: sleep, HRV, heart rate, VO2max, steps, weight, body fat %', status: 'Available' },
                { name: 'Oura', type: 'NATIVE', desc: 'Oura Ring Gen 2/3: sleep, HRV, temperature, recovery score, activity', status: 'Available' },
                { name: 'Whoop', type: 'NATIVE', desc: 'Whoop 4.0 band: strain, recovery, sleep, HRV, respiratory rate', status: 'Available' },
                { name: 'Garmin', type: 'NATIVE', desc: 'Garmin Connect watches: activity, sleep, HRV, VO2max, training status', status: 'Available' },
                { name: 'Other via automation', type: 'AUTOMATION', desc: 'Via n8n / Make / Zapier: partner API pull → push /api/health-sync', status: 'Available' },
              ],
            },
            {
              category: 'Calendar & scheduling',
              icon: 'calendar',
              color: 'bleu-signature',
              integrations: [
                { name: 'Google Calendar', type: 'NATIVE', desc: 'ICS subscription per staff member: scheduled calls, title, date, link to the client record', status: 'Available' },
                { name: 'Apple Calendar', type: 'NATIVE', desc: 'Native ICS subscription: same data as Google Calendar', status: 'Available' },
                { name: 'Outlook / Office 365', type: 'NATIVE', desc: 'ICS subscription: works with Outlook desktop, web, mobile', status: 'Available' },
                { name: 'Calendly', type: 'CONNECTOR', desc: 'New Calendly appointment → webhook → call created in Optibilan', status: 'Available' },
              ],
            },
            {
              category: 'Communication & team',
              icon: 'users',
              color: 'bordeaux',
              integrations: [
                { name: 'Slack', type: 'CONNECTOR', desc: 'Incoming webhook: new client, check-in submitted, late call, GDPR request', status: 'Available' },
                { name: 'Email (Resend)', type: 'NATIVE', desc: 'Transactional emails: activation, password reset, check-in reminders, team notifications', status: 'Available' },
                { name: 'Push (Web)', type: 'NATIVE', desc: 'Browser notifications: check-in reminder, session, message, alert', status: 'Available' },
                { name: 'WhatsApp Business', type: 'AUTOMATION', desc: 'Via n8n / Make: WhatsApp notifications for reminders and alerts', status: 'Available' },
              ],
            },
            {
              category: 'Automation & workflow',
              icon: 'zap',
              color: 'indigo',
              integrations: [
                { name: 'n8n', type: 'AUTOMATION', desc: 'Self-hosted or cloud: Optibilan webhooks → n8n actions (Notion, Sheets, Airtable, HTTP)', status: 'Available' },
                { name: 'Make (Integromat)', type: 'AUTOMATION', desc: 'Visual scenarios: new clients, check-ins, payments → multiple actions', status: 'Available' },
                { name: 'Zapier', type: 'AUTOMATION', desc: 'Zaps: Optibilan trigger (client created, check-in submitted…) → 5000+ apps', status: 'Available' },
                { name: 'Notion', type: 'CONNECTOR', desc: 'note.created webhook → Notion database (client, coach, date, type, content, visibility)', status: 'Available' },
              ],
            },
            {
              category: 'Payment & invoicing',
              icon: 'credit-card',
              color: 'bleu-lecture',
              integrations: [
                { name: 'Stripe', type: 'NATIVE', desc: 'Payments, subscriptions, client portal, invoices, webhooks (payment failed, invoice paid, subscription updated)', status: 'Available' },
                { name: 'Systeme.io', type: 'AUTOMATION', desc: 'Manual invoicing / bank transfer: CSV invoice export → Systeme.io import', status: 'On request' },
                { name: 'SEPA transfer', type: 'NATIVE', desc: 'SEPA direct debit via Stripe: mandate, automatic reconciliation, unpaid invoice follow-ups', status: 'Available' },
              ],
            },
            {
              category: 'API & development',
              icon: 'code',
              color: 'bleu-ardoise',
              integrations: [
                { name: 'REST API v1', type: 'API', desc: 'Complete OpenAPI 3.1: clients, check-ins, nutrition, training, health, webhooks, admin', status: 'Available' },
                { name: 'Signed webhooks', type: 'API', desc: '8 signed events: client created, check-in submitted, badge earned, nutrition updated, late call…', status: 'Available' },
                { name: 'API sandbox', type: 'API', desc: 'Test environment: test API keys, mock data, Swagger/Redoc playground', status: 'Available' },
                { name: 'SSO / SAML', type: 'API', desc: 'Practice plan: SAML 2.0, OIDC, SCIM provisioning (coming soon)', status: 'Coming soon' },
              ],
            },
          ].map((category, catIdx) => (
          <section key={category.category} aria-labelledby={category.category} style={`animation-delay: ${category.integrations.length * 50}ms`}>
              <header class="flex items-center gap-3 mb-8">
                <div class="icon-wrapper flex-shrink-0" aria-hidden="true" style={`background-color: color-mix(in oklab, var(--color-${category.color}) 15%, transparent);`}>
                  <Icon name={category.icon} class="w-7 h-7" style={`color: var(--color-${category.color});`} />
                </div>
                <h3 class="font-display text-2xl font-bold text-encre">{category.category}</h3>
              </header>

              <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                {category.integrations.map((int, i) => (
                  <article class="card-hover p-6" style={`animation-delay: ${i * 50}ms`}>
                    <div class="flex items-start justify-between gap-4 mb-4">
                      <div>
                        <h4 class="font-semibold text-encre mb-1">{int.name}</h4>
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-puce text-xs font-medium"
                              style={`color: var(--color-${category.color}); background-color: color-mix(in oklab, var(--color-${category.color}) 10%, transparent);`}>
                          {int.type}
                        </span>
                      </div>
                      <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700">
                        {int.status}
                      </span>
                    </div>
                    <p class="text-encre/60 text-sm mb-4">{int.desc}</p>
                    <span class="inline-flex items-center gap-1.5 text-sm font-medium text-bleu-signature hover:opacity-80 transition-opacity group" data-track={`integration_${int.name.toLowerCase().split(' ').filter(Boolean).join('_')}`}>
                      View the docs
                      <Icon name="arrowRight" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
                    </span>
                  </article>
                ))}
              </div>
            </section>
            ))}
          </div>
        </div>
      </section>

      <section class="section bg-gradient-to-br from-bleu-signature via-bleu-lecture to-indigo rounded-card-lg relative overflow-hidden" aria-labelledby="api-title">
        <div class="absolute inset-0" style={{ backgroundImage: 'radial-gradient(ellipse at center, var(--tw-gradient-stops))', backgroundColor: 'var(--color-bleu-signature-20)' }} aria-hidden="true"></div>
        <div class="absolute top-0 right-0 w-96 h-96 bg-bleu-signature/10 rounded-full blur-3xl" aria-hidden="true"></div>
        <div class="absolute bottom-0 left-0 w-96 h-96 bg-bleu-signature/10 rounded-full blur-3xl" aria-hidden="true"></div>

        <div class="container relative text-center max-w-3xl mx-auto py-16 md:py-24">
          <h2 id="api-title" class="font-display text-3xl md:text-4xl font-bold mb-4 text-craie">
            REST API v1 - OpenAPI 3.1
          </h2>
          <p class="text-lg mb-8 text-craie/80 max-w-2xl mx-auto">
            Full documentation, test sandbox, cURL/Node/Python examples. Scoped API keys, rate limiting, signed webhooks.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href={lp('/docs/')} class="btn-demo w-full sm:w-auto" data-track="integrations_api_docs">
              <Icon name="code" class="w-5 h-5 mr-2" /> API documentation
            </a>
            <a href={`${lp('/docs/')}#sandbox`} class="btn-secondary w-full sm:w-auto border-craie/30 text-craie hover:bg-craie/10">
              <Icon name="terminal" class="w-5 h-5 mr-2" /> Test sandbox
            </a>
          </div>
        </div>
      </section>

      <CTA
        title="Do you have a specific integration need?"
        subtitle="Our technical team reviews your stack and proposes the best architecture."
        primaryCTA={{ href: '/contact/', label: 'Join Optibilan' }}
        secondaryCTA={{ href: '/checkout/solo/', label: 'Try Optibilan' }}
        variant="gold"
      />
    </main>

    <Footer />
  </Layout>
