---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Icon from '@/components/Icon.astro';

const pageTitle = 'Subprocessors register - Optibilan';
const pageDescription = 'Optibilan subprocessors (Art. 28 GDPR): Supabase, Stripe, Resend, Cloudflare, Anthropic, Plausible. Location, purposes, security, DPA, SCC.';
const lastUpdated = new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang="en"
  canonical="/en/legal/sous-traitance/"
  ogImage="/og-legal.png"
>
  <Header />

  <main>
    <p class="container max-w-3xl pt-8 text-sm text-encre/60">Courtesy translation. The French version prevails in case of discrepancy.</p>
    <section class="section bg-blanc" aria-labelledby="subprocessors-content">
      <div class="container max-w-5xl">
        <header class="mb-12 pb-8 border-b border-encre/10">
          <h1 id="subprocessors-content" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">Subprocessors register</h1>
          <p class="text-sm text-encre/60"><strong>Version of:</strong> {lastUpdated}</p>
        </header>

        <article class="prose max-w-none" id="subprocessors-content">

          <h2 class="font-display text-2xl font-bold text-encre mb-6 pb-2 border-b border-encre/10">Current subprocessors</h2>

          <div class="space-y-6 mb-12">
            {[
              {
                name: 'Supabase',
                role: 'Managed PostgreSQL database, Auth, Storage, Realtime, Edge Functions',
                location: 'EU West (Ireland) - Data stored exclusively in the EU',
                purposes: ['Database hosting (all Subscriber + Client data)', 'Authentication (email/password, providers)', 'File storage (photos, PDFs, dreamboard) - private bucket', 'Edge functions (webhooks, cron, health sync)'],
                security: ['Encryption at rest (AES-256) and in transit (TLS 1.3)', 'Network isolation (dedicated VPC)', '7-day PITR + daily snapshots', 'Certifications: SOC 2 Type II, ISO 27001, HIPAA, GDPR'],
                dpa: true,
                scc: 'Not required (EU)',
                website: 'https://supabase.com',
                icon: 'database',
              },
              {
                name: 'Stripe',
                role: 'Payments, billing, subscriptions, customer portal',
                location: 'EU (Ireland) - Contracting entity: Stripe Technology Europe Ltd',
                purposes: ['Card payments, SEPA transfers, direct debits', 'Subscription management (creation, change, cancellation)', 'Self-service customer portal (payment methods, invoices)', 'Event webhooks (payment_failed, invoice.paid, subscription.updated)'],
                security: ['PCI DSS Level 1', 'End-to-end encryption', 'Certifications: SOC 1/2, ISO 27001, PCI DSS'],
                dpa: true,
                scc: 'Not required (EU)',
                website: 'https://stripe.com',
                icon: 'credit-card',
              },
              {
                name: 'Resend',
                role: 'Transactional email delivery (activation, password reset, check-in reminders, team notifications)',
                location: 'EU (Germany) - Servers in the EU',
                purposes: ['Transactional emails only (no marketing)', 'HTML/text templates with variables', 'Open and click tracking (anonymized, opt-out possible)'],
                security: ['TLS 1.3', 'DKIM, SPF, DMARC on the optibilan.com domain', 'Log retention 30 days max'],
                dpa: true,
                scc: 'Not required (EU)',
                website: 'https://resend.com',
                icon: 'mail',
              },
              {
                name: 'Cloudflare',
                role: 'CDN, DNS, WAF, DDoS Protection, Cloudflare Tunnel, Analytics',
                location: 'Global network (300+ PoPs) - Traffic routed through EU PoPs for EU users',
                purposes: ['TLS termination, static cache, Brotli compression', 'WAF (OWASP Top 10 rules, rate-limit, bot fight)', 'DDoS mitigation L3/L4/L7', 'Zero-trust tunnel (no open port on the VPS)', 'Aggregated analytics (no full IP)'],
                security: ['TLS 1.3 encryption', 'Certifications: SOC 2 Type II, ISO 27001, FedRAMP'],
                dpa: true,
                scc: 'Yes (SCC 2021 + supplementary measures Art. 28)',
                website: 'https://cloudflare.com',
                icon: 'cloud',
              },
              {
                name: 'Anthropic',
                role: 'Language model (Claude) for the built-in AI assistant',
                location: 'USA - Processing via API (no data storage)',
                purposes: ['AI assistant answer generation (reading check-ins, blood tests, biomarkers)', 'Call transcript analysis (n8n)', 'Extraction and pre-filling of the onboarding questionnaire'],
                security: ['Zero-retention API (no training, no full logs)', 'Anonymized prompts (no identifying data sent)', 'Enterprise contract with DPA, zero retention guaranteed'],
                dpa: true,
                scc: 'Yes (SCC 2021 + UK Addendum + technical measures: prompt pseudonymization, zero retention)',
                website: 'https://anthropic.com',
                icon: 'brain',
              },
              {
                name: 'Plausible Analytics',
                role: 'Privacy-friendly web analytics (GA4 alternative)',
                location: 'EU (Germany) - Data stored in the EU',
                purposes: ['Public site metrics (page views, events, referrers, country)', 'No cookies, no personal data, IP anonymization'],
                security: ['Open source, self-hosting possible', 'GDPR by design, ePrivacy compliant'],
                dpa: true,
                scc: 'Not required (EU)',
                website: 'https://plausible.io',
                icon: 'chart',
              },
            ].map((sub, index) => (
              <section class="border border-encre/10 rounded-card-lg p-6 md:p-8 bg-blanc hover:shadow-card transition-shadow duration-300">
                <header class="flex items-start justify-between gap-4 mb-5">
                  <div class="flex items-center gap-3">
                    <span class="w-10 h-10 rounded-lg bg-bleu-clair text-bleu-signature flex items-center justify-center font-display font-bold text-lg">
                      {index + 1}
                    </span>
                    <div>
                      <h3 class="font-display text-xl font-bold text-encre">{sub.name}</h3>
                      <p class="text-encre/60 text-sm mt-0.5">{sub.role}</p>
                    </div>
                  </div>
                  <a href={sub.website} target="_blank" rel="noopener noreferrer" class="text-sm text-bleu-signature hover:underline whitespace-nowrap flex items-center gap-1">
                    Website
                    <Icon name="arrowRight" class="w-4 h-4" />
                  </a>
                </header>

                <div class="grid md:grid-cols-2 gap-6 mb-5">
                  <div>
                    <h4 class="font-semibold text-encre mb-2 flex items-center gap-1.5">
                      <Icon name={sub.icon} class="w-5 h-5 text-bleu-signature" />
                      Location
                    </h4>
                    <p class="text-encre/60">{sub.location}</p>
                  </div>
                  <div>
                    <h4 class="font-semibold text-encre mb-2 flex items-center gap-1.5">
                      <Icon name="lock" class="w-5 h-5 text-bleu-signature" />
                      DPA signed
                    </h4>
                    <p class="text-encre/60">{sub.dpa ? 'Yes (Art. 28 GDPR)' : 'No'}</p>
                  </div>
                </div>

                <div class="grid md:grid-cols-2 gap-6 mb-5">
                  <div>
                    <h4 class="font-semibold text-encre mb-2 flex items-center gap-1.5">
                      <Icon name="shield" class="w-5 h-5 text-bleu-signature" />
                      Security measures
                    </h4>
                    <ul class="space-y-1.5 text-sm text-encre/60">
                      {sub.security.map(s => (
                        <li key={s} class="flex items-start gap-2">• {s}</li>
                      ))}
                    </ul>
                  </div>
                  <div>
                    <h4 class="font-semibold text-encre mb-2 flex items-center gap-1.5">
                      <Icon name="document" class="w-5 h-5 text-bleu-signature" />
                      Purposes
                    </h4>
                    <ul class="space-y-1.5 text-sm text-encre/60">
                      {sub.purposes.map(p => (
                        <li key={p} class="flex items-start gap-2">• {p}</li>
                      ))}
                    </ul>
                  </div>
                </div>

                <div class="flex flex-wrap items-center gap-4 text-sm text-encre/50 pt-4 border-t border-encre/10">
                  <span class="flex items-center gap-1.5">
                    <Icon name="lock" class="w-4 h-4" />
                    SCC: {sub.scc}
                  </span>
                </div>
              </section>
            ))}
          </div>

          <h2 class="font-display text-2xl font-bold text-encre mb-4 pb-2 border-b border-encre/10 mt-12">Optibilan commitments</h2>
          <ul class="space-y-3 mb-12 text-encre/70">
            <li class="flex items-start gap-2">• <strong>Rigorous selection:</strong> only subprocessors offering "sufficient guarantees" (Art. 28.1 GDPR) are selected.</li>
            <li class="flex items-start gap-2">• <strong>Systematic DPA:</strong> written contract including the standard clauses (Art. 28.3) before any deployment to production.</li>
            <li class="flex items-start gap-2">• <strong>EU location preferred:</strong> 5/6 subprocessors host in the EU. For Anthropic (US): zero retention, pseudonymization, SCC + technical measures.</li>
            <li class="flex items-start gap-2">• <strong>Annual audit:</strong> review of certifications (SOC 2, ISO 27001), penetration tests, DPA compliance.</li>
            <li class="flex items-start gap-2">• <strong>Notification of subsequent subcontracting:</strong> any new subprocessor or change of location is notified 30 days in advance (Art. 28.2).</li>
            <li class="flex items-start gap-2">• <strong>Right of instruction:</strong> the Subscriber may request an audit of a subprocessor (shared cost).</li>
          </ul>

          <h2 class="font-display text-2xl font-bold text-encre mb-4 pb-2 border-b border-encre/10">Downstream subprocessors (chain)</h2>
          <p class="text-encre/60 mb-6">The subprocessors above may engage their own subprocessors (e.g. AWS/GCP for infrastructure, support subprocessors). Optibilan contractually ensures that the entire chain complies with Art. 28.4 GDPR (same obligations, same level of protection).</p>

          <div class="overflow-x-auto mb-12">
            <table class="w-full text-sm" role="table">
              <thead>
                <tr class="border-b border-encre/20">
                  <th class="text-left pb-2 font-semibold text-encre">Subprocessor</th>
                  <th class="text-left pb-2 font-semibold text-encre">Known downstream subprocessors</th>
                  <th class="text-left pb-2 font-semibold text-encre">Location</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-encre/10 text-encre/60">
                <tr><td class="py-2 font-medium">Supabase</td><td>AWS (EU West), Sentry (EU/US), Vercel (EU/US)</td><td>EU (primary)</td></tr>
                <tr><td class="py-2 font-medium">Stripe</td><td>AWS (EU), Google Cloud (EU), Twilio (US/EU for SMS)</td><td>EU (primary)</td></tr>
                <tr><td class="py-2 font-medium">Resend</td><td>AWS (EU), SendGrid (US) for relay</td><td>EU (primary)</td></tr>
                <tr><td class="py-2 font-medium">Cloudflare</td><td>Own network (300+ global PoPs)</td><td>Global (EU routing)</td></tr>
                <tr><td class="py-2 font-medium">Anthropic</td><td>AWS (US), Google Cloud (US) - zero retention</td><td>US (zero retention)</td></tr>
                <tr><td class="py-2 font-medium">Plausible</td><td>Hetzner (DE) - self-hosted</td><td>EU</td></tr>
              </tbody>
            </table>
          </div>

          <h2 class="font-display text-2xl font-bold text-encre mb-4 pb-2 border-b border-encre/10">Contact</h2>
          <p class="text-encre/60 mb-8">For any question about subcontracting: <a href="mailto:privacy@optibilan.com" class="text-bleu-signature hover:underline">privacy@optibilan.com</a></p>

          <address class="not-italic mt-8 pt-8 border-t border-encre/10 text-sm text-encre/50">
            Elite Longevity LLC<br>
            Wyoming, USA<br>
            Email: <a href="mailto:privacy@optibilan.com" class="text-bleu-signature hover:underline">privacy@optibilan.com</a>
          </address>
        </article>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
