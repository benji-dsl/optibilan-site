---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { localizePath } from '@/i18n/config';

const lp = (href: string) => localizePath(href, 'en');

const pageTitle = 'Cookies - Optibilan';
const pageDescription = 'Cookie and tracker management on Optibilan: necessary cookies, analytics cookies, preferences.';
const lastUpdated = new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

const cookies = [
  {
    name: 'optibilan_session',
    category: 'Necessary',
    duration: '30 days',
    description: 'JWT session for user authentication. Required to keep the session signed in.',
  },
  {
    name: 'optibilan_2fa_pending',
    category: 'Necessary',
    duration: '5 minutes',
    description: 'Temporary storage of the 2FA step being validated.',
  },
  {
    name: 'vocab',
    category: 'Necessary',
    duration: '30 days',
    description: 'Custom practice vocabulary (client/patient/member) for the interface.',
  },
  {
    name: '_ga* / _gid / _gat',
    category: 'Analytics',
    duration: '13 months / 24h / 1min',
    description: 'Google Analytics 4 - Anonymized audience measurement (masked IP). Consent required.',
  },
  {
    name: 'plausible_*',
    category: 'Analytics',
    duration: '13 months',
    description: 'Plausible Analytics - Lightweight, privacy-friendly alternative to GA4.',
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang="en"
  canonical="/en/legal/cookies/"
  ogImage="/og-legal.png"
>
  <Header />

  <main>
    <p class="container max-w-3xl pt-8 text-sm text-encre/60">Courtesy translation. The French version prevails in case of discrepancy.</p>
    <section class="section bg-blanc" aria-labelledby="cookies-title">
      <div class="container max-w-3xl">
        <header class="mb-12 pb-8 border-b border-encre/10">
          <h1 id="cookies-title" class="font-display text-3xl md:text-4xl font-bold text-encre mb-4">Cookies & trackers</h1>
          <p class="text-sm text-encre/60"><strong>Last updated:</strong> {lastUpdated}</p>
        </header>
        <p class="text-lg text-encre/60 max-w-2xl mb-8">
          Optibilan only uses cookies that are strictly necessary for the service to work,
          and, with your consent, anonymized analytics cookies. No third-party advertising cookies.
        </p>

        <div class="space-y-6 mb-12">
          {cookies.map((cookie) => (
            <article class="p-6 md:p-6 bg-blanc rounded-xl border border-encre/10 hover:border-bleu-signature/30 transition-colors">
              <header class="flex flex-wrap items-start justify-between gap-4 mb-3">
                <div>
                  <code class="bg-encre/5 px-2.5 py-0.5 rounded font-mono text-sm font-medium text-encre mb-2 inline-block">{cookie.name}</code>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-puce text-xs font-medium"
                    style={`background-color: ${cookie.category === 'Necessary' ? 'var(--color-bleu-signature)' : cookie.category === 'Analytics' ? 'var(--color-vert)' : 'var(--color-bleu-ardoise)'}15; color: ${cookie.category === 'Necessary' ? 'var(--color-bleu-signature)' : cookie.category === 'Analytics' ? 'var(--color-vert)' : 'var(--color-bleu-ardoise)'}`}>
                    {cookie.category}
                  </span>
                </div>
                <time class="text-xs text-encre/40 whitespace-nowrap" datetime={cookie.duration}>{cookie.duration}</time>
              </header>
              <p class="text-encre/70 text-sm leading-relaxed">{cookie.description}</p>
            </article>
          ))}
        </div>

        <div class="mt-8 pt-8 border-t border-encre/10 rounded-xl">
          <h2 class="font-display text-xl font-bold text-encre mb-3">Your rights</h2>
          <p class="text-encre/60 mb-4">In accordance with the GDPR, you have the right to access, rectify, erase, restrict, port and object to the processing of your data.</p>
          <ul class="space-y-2 text-encre/60 text-sm">
            <li>Manage your preferences through the "Cookies" banner at the bottom of the page.</li>
            <li>Delete cookies through your browser settings.</li>
            <li>Exercise your GDPR rights through <a href={lp('/legal/confidentialite/')} class="text-bleu-signature hover:underline">the privacy policy</a> or the admin (My account → My data).</li>
          </ul>
        </div>

        <address class="not-italic mt-12 pt-8 border-t border-encre/10 text-sm text-encre/50">
          Elite Longevity LLC<br>
          Wyoming, USA<br>
          Email: <a href="mailto:legal@optibilan.com" class="text-bleu-signature hover:underline">legal@optibilan.com</a>
        </address>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
