---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import CTA from '../../components/CTA.astro';
import TrustBar from '../../components/TrustBar.astro';
import Icon from '../../components/Icon.astro';

const pageTitle = 'Centre d\'aide — Optibilan';
const pageDescription = 'Guides de démarrage, FAQ, tutoriels vidéo, documentation API. Tout pour prendre en main Optibilan rapidement.';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/help"
  ogImage="/og-help.jpg"
>
  <Header />

  <main>
    <Hero
      title="Centre d'aide<br>Optibilan"
      subtitle="Guides pas à pas, FAQ, tutoriels vidéo, documentation technique. Tout pour prendre en main la plateforme rapidement."
      badge="Recherche instantanée · Articles mis à jour hebdo"
      primaryCTA={{ href: '/docs', label: 'Documentation API' }}
      secondaryCTA={{ href: 'https://calendly.com/optibilan/demo', label: 'Réserver une démo' }}
    />

    <TrustBar />

    <section class="section bg-blanc" aria-labelledby="search-title">
      <div class="container max-w-3xl">
        <header class="text-center mb-12">
          <h2 id="search-title" class="font-display text-2xl md:text-3xl font-bold text-encre mb-4">
            Trouvez votre réponse
          </h2>
        </header>

        <div class="relative max-w-xl mx-auto">
          <Icon name="search" class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-encre/40" aria-hidden="true" />
          <input
            type="search"
            placeholder="Rechercher un guide, une FAQ, un tutoriel…"
            class="w-full px-12 py-4 pl-12 rounded-xl border border-encre/20 focus:outline-none focus:border-bleu-signature focus:ring-2 focus:ring-bleu-signature/20 text-lg text-encre placeholder-encre/40"
            aria-label="Rechercher dans le centre d'aide"
          />
        </div>
      </div>
    </section>

    <section class="section bg-papier" aria-labelledby="quick-links-title">
      <div class="container">
        <header class="text-center max-w-3xl mx-auto mb-12">
          <h2 id="quick-links-title" class="font-display text-2xl md:text-3xl font-bold text-encre mb-4">
            Démarrage rapide
          </h2>
          <p class="text-lg text-encre/60">Les indispensables pour vos premiers pas.</p>
        </header>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {[
            { href: '/help/getting-started', icon: 'rocket', title: 'Premiers pas', desc: 'Créer votre cabinet, inviter l\'équipe, premier client en 15 min', color: 'bleu-signature' },
            { href: '/help/check-ins', icon: 'chart', title: 'Créer un bilan', desc: 'Configurer les champs, inviter le client, suivre l\'évolution', color: 'bleu-lecture' },
            { href: '/help/nutrition', icon: 'document', title: 'Configurer la nutrition', desc: 'Templates, listes de courses, compléments, validation coach', color: 'indigo' },
            { href: '/help/white-label', icon: 'shield', title: 'Activer la marque blanche', desc: 'Logo, couleurs, domaine, vocabulaire, emails en 10 min', color: 'bordeaux' },
          ].map(item => (
            <a href={item.href} class="card-hover p-6 text-center group" style={`--mod-color: var(--color-${item.color})`}>
              <div class="icon-wrapper mx-auto mb-4" aria-hidden="true" style={`background-color: color-mix(in oklab, var(--color-${item.color}) 15%, transparent);`}>
                <Icon name={item.icon} class="w-7 h-7" style={`color: var(--color-${item.color});`} />
              </div>
              <h3 class="font-display text-lg font-bold text-encre mb-2">{item.title}</h3>
              <p class="text-sm text-encre/50">{item.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section bg-blanc" aria-labelledby="categories-title">
      <div class="container">
        <header class="text-center max-w-3xl mx-auto mb-12">
          <h2 id="categories-title" class="font-display text-2xl md:text-3xl font-bold text-encre mb-4">
            Par catégorie
          </h2>
        </header>

        <div class="space-y-12">
          {[
            {
              title: 'Bilans & Progression',
              color: 'bleu-signature',
              articles: [
                { title: 'Créer votre premier bilan guidé', href: '/help/check-ins/first' },
                { title: 'Configurer les champs du bilan', href: '/help/check-ins/fields' },
                { title: 'Inviter un client à son bilan', href: '/help/check-ins/invite' },
                { title: 'Lire et interpréter les graphiques', href: '/help/check-ins/graphs' },
                { title: 'Exporter un bilan en PDF', href: '/help/check-ins/export' },
              ],
            },
            {
              title: 'Nutrition',
              color: 'bleu-lecture',
              articles: [
                { title: 'Créer un plan nutritionnel', href: '/help/nutrition/create' },
                { title: 'Utiliser les templates', href: '/help/nutrition/templates' },
                { title: 'Générer les listes de courses', href: '/help/nutrition/shopping' },
                { title: 'Configurer les compléments', href: '/help/nutrition/supplements' },
                { title: 'Valider le journal alimentaire client', href: '/help/nutrition/validate' },
              ],
            },
            {
              title: 'Sport & Programmes',
              color: 'indigo',
              articles: [
                { title: 'Créer une séance drag-and-drop', href: '/help/training/session' },
                { title: 'Construire un programme complet', href: '/help/training/program' },
                { title: 'Utiliser la bibliothèque d\'exercices', href: '/help/training/library' },
                { title: 'Importer depuis FitFocus', href: '/help/training/import' },
                { title: 'Suivre la progression charge/volume', href: '/help/training/progression' },
              ],
            },
            {
              title: 'Santé & Biomarqueurs',
              color: 'bleu-clair',
              articles: [
                { title: 'Connecter Apple Health / Oura / Garmin', href: '/help/health/sync' },
                { title: 'Importer un bilan sanguin (PDF)', href: '/help/health/import-lab' },
                { title: 'Configurer les biomarqueurs suivis', href: '/help/health/biomarkers' },
                { title: 'Lire les graphiques de tendances', href: '/help/health/trends' },
              ],
            },
            {
              title: 'Préparation Mentale',
              color: 'indigo',
              articles: [
                { title: 'Créer un exercice de visualisation', href: '/help/mental/exercise' },
                { title: 'Ajouter des ressources (vidéo/PDF/audio)', href: '/help/mental/resources' },
                { title: 'Rédiger un compte-rendu d\'appel', href: '/help/mental/journal' },
                { title: 'Suivre l\'adhérence mentale', href: '/help/mental/adherence' },
              ],
            },
            {
              title: 'Marque Blanche & Admin',
              color: 'bordeaux',
              articles: [
                { title: 'Configurer votre marque blanche', href: '/help/white-label/setup' },
                { title: 'Ajouter un domaine personnalisé', href: '/help/white-label/domain' },
                { title: 'Inviter votre équipe', href: '/help/admin/team' },
                { title: 'Créer une offre d\'appel', href: '/help/admin/offers' },
                { title: 'Configurer les webhooks', href: '/help/admin/webhooks' },
              ],
            },
          ].map(category => (
            <section aria-labelledby={category.title} style="animation-delay: {category.articles.length * 50}ms">
              <header class="flex items-center gap-3 mb-6">
                <div class="icon-wrapper flex-shrink-0" aria-hidden="true" style={`background-color: color-mix(in oklab, var(--color-${category.color}) 15%, transparent);`}>
                  <Icon name="document" class="w-6 h-6" style={`color: var(--color-${category.color});`} />
                </div>
                <h3 class="font-display text-xl font-bold text-encre">{category.title}</h3>
              </header>
              <ul class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
                {category.articles.map(article => (
                  <li>
                    <a href={article.href} class="p-4 rounded-xl border border-encre/10 hover:border-{category.color}/30 hover:shadow-soft transition-all group">
                      <h4 class="font-medium text-encre group-hover:text-{category.color} transition-colors">{article.title}</h4>
                      <Icon name="arrowRight" class="w-4 h-4 text-encre/40 group-hover:text-{category.color} transition-colors mt-2 inline-block" />
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </div>
    </section>

    <section class="section bg-gradient-to-br from-bleu-signature via-bleu-lecture to-indigo rounded-card-lg relative overflow-hidden" aria-labelledby="contact-title">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-bleu-signature/20 via-transparent to-transparent" aria-hidden="true"></div>
      <div class="absolute top-0 right-0 w-96 h-96 bg-bleu-signature/10 rounded-full blur-3xl" aria-hidden="true"></div>
      <div class="absolute bottom-0 left-0 w-96 h-96 bg-bleu-signature/10 rounded-full blur-3xl" aria-hidden="true"></div>

      <div class="container relative text-center max-w-2xl mx-auto py-16 md:py-24">
        <h2 id="contact-title" class="font-display text-2xl md:text-3xl font-bold mb-4 text-craie">
          Pas trouvé votre réponse ?
        </h2>
        <p class="text-lg mb-8 text-craie/80 max-w-xl mx-auto">
          L'équipe support répond en <4h ouvrées. Pas de bot, pas de ticket fermé sans réponse.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="mailto:support@optibilan.com" class="btn-demo w-full sm:w-auto" data-track="help_contact_support">
            <Icon name="mail" class="w-5 h-5 mr-2" /> Contacter le support
          </a>
          <a href="https://calendly.com/optibilan/demo" class="btn-secondary w-full sm:w-auto border-craie/30 text-craie hover:bg-craie/10">
            <Icon name="calendar" class="w-5 h-5 mr-2" /> Réserver un appel
          </a>
        </div>
      </div>
    </section>

    <CTA
      title="Vous voulez contribuer au centre d'aide ?"
      subtitle="On cherche des experts pour écrire des guides : nutrition, sport, mental, santé, business."
      primaryCTA={{ href: '/contact', label: 'Proposer un article' }}
      variant="gold"
    />
  </main>

  <Footer />
</Layout>